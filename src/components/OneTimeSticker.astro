---
// OneTimeSticker.astro — the sticker a one-time pot wears (Darko, 2026-10-17
// 12:07 EDT: "It needs to be very apparent and clear that this is different
// from the other quests. and this is a one-time thing, I would suggest putting
// that like somewhere big and bright as like a sticker on the thing").
//
// Worn by every pot whose file says closes_at_fill (funding.mjs § toPot's
// closesAtFill), on its card (PotCards.astro, so /fund/, /town/#pots and
// /stamps/#pots alike) and on its own page. A monthly pot never wears it.
//
// The bulletin's sticker idiom (town/pages/bulletin/index.astro § the
// stickers): die-cut, perforated like a stamp, slapped on at a lean, in the
// style guide's inks. Gold, not paper, so it is the brightest thing on the
// card. The words are real text, so the sticker says what it says to every
// reader and every search.
const { size = "card" } = Astro.props;
---
<span class:list={["once-sticker", size === "page" && "is-page"]} data-once-sticker>
  <span class="once-big">ONE-TIME</span>
  <span class="once-small">closes when it fills</span>
</span>

<style>
  .once-sticker {
    flex: none; align-self: flex-start;
    display: inline-flex; flex-direction: column; align-items: center; justify-content: center;
    gap: .2em; padding: .75em 1em .7em; margin-left: auto;
    color: var(--pm-ink);
    /* the stamp's perforated edge: a gold field inset 8px, ringed by half-circles */
    background:
      linear-gradient(var(--pm-gold), var(--pm-gold)) center / calc(100% - 8px) calc(100% - 8px) no-repeat,
      radial-gradient(circle, transparent 2.4px, var(--pm-gold) 2.9px) -4px -4px / 8px 8px;
    filter: drop-shadow(0 3px 3px rgba(0, 0, 0, .5));
    transform: rotate(4deg);
    text-align: center; line-height: 1.1;
  }
  .once-big {
    font-family: var(--pm-mono); font-weight: 700; font-size: .95rem; letter-spacing: .1em;
    color: var(--pm-wax);
  }
  .once-small {
    font-family: var(--pm-mono); font-size: .62rem; letter-spacing: .06em; text-transform: uppercase;
    white-space: nowrap;
  }
  .once-sticker.is-page { padding: 1em 1.35em .95em; transform: rotate(-3deg); }
  .once-sticker.is-page .once-big { font-size: 1.45rem; }
  .once-sticker.is-page .once-small { font-size: .78rem; }
  @media (max-width: 520px) {
    .once-sticker.is-page .once-big { font-size: 1.15rem; }
    .once-sticker.is-page .once-small { font-size: .66rem; }
  }
</style>
