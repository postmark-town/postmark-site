---
// ResidentMention — the build's adapter for the one way the site names a resident (CORE-178; resident-mention.mjs holds the form).
//
// <ResidentMention handle="wright" />                 the resident's picture, then their name in their colour, underlined, linking to their page
// <ResidentMention handle={h} link={false} />          the same, as a span (inside a card or a chip that is already a link)
// <ResidentMention handle={h} href={seat} />           linking somewhere else (the house's seat); href={null} for no link
// <ResidentMention handle={h} face={f} />              with a face the page already holds (faces.mjs residentFace), instead of the build's
// <ResidentMention handle={h} cls="hx-who" />          keeping a surface's own hook class (the Hearth's styles name it)
// <ResidentMention handle={h} surface="paper" />       on the letter paper outside a `.pm-paper` box
// <ResidentMention handle={h} surface="#2f3a56" />     on a solid plate of the page's own, known at build time: the ink for that colour
//
// It decides the model (the build's roll, resident-mentions.mjs, which follows renames and wears faces.mjs's face) and draws it with
// ResidentMentionModel.astro. A page that builds incrementally can't import this file (the roll reads the residents file): it gets its
// models as props and draws them with ResidentMentionModel directly.
import ResidentMentionModel from "./ResidentMentionModel.astro";
import { mentionModel } from "@/lib/resident-mention.mjs";
import { mentionOf } from "@/lib/resident-mentions.mjs";

interface Props {
  handle: string;
  /** words to show instead of the resident's name */
  label?: string;
  /** a link other than the resident's page; null for none */
  href?: string | null;
  /** false: a span, for a mention inside another link */
  link?: boolean;
  /** a face the page already holds (faces.mjs residentFace's fields) */
  face?: any;
  /** extra classes, kept as a surface's hooks */
  cls?: string;
  /** "paper" off a `.pm-paper` box, or the hex of a solid plate the page puts under the mention */
  surface?: "night" | "paper" | string;
  /** the name's styling only, for a card or chip whose own portrait is the picture (Darko b, 2026-11-24 12:25 EST) */
  noFace?: boolean;
}
const { handle, label, href, link = true, face, cls = "", surface, noFace = false } = Astro.props;
const model = face
  ? mentionModel({ handle, face, href: href !== undefined ? href : (mentionOf(handle) as any).href ?? null, label })
  : mentionOf(handle, { label, href });
---
<ResidentMentionModel model={model} link={link} cls={cls} surface={surface} noFace={noFace} />
