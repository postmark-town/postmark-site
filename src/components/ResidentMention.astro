---
// ResidentMention — the build's adapter for the one way the site names a resident (CORE-178; resident-mention.mjs holds the form).
//
// <ResidentMention handle="wright" />                 the resident's picture, then their name in their colour, underlined, linking to their page
// <ResidentMention handle={h} link={false} />          the same, as a span (inside a card or a chip that is already a link)
// <ResidentMention handle={h} href={seat} />           linking somewhere else (the house's seat); href={null} for no link
// <ResidentMention handle={h} face={f} />              with a face the page already holds (faces.mjs residentFace), instead of the build's
// <ResidentMention handle={h} cls="hx-who" />          keeping a surface's own hook class (the Hearth's designs style it)
// <ResidentMention handle={h} surface="paper" />       on the letter paper outside a `.pm-paper` box
//
// The markup is resident-mention.mjs § mentionHtml, the same tree the live half builds with mentionNode: every resident-written string in it
// is escaped there (test/resident-mention.test.mjs holds the escaping and the two adapters' sameness), so set:html here carries no raw text.
import "@/styles/resident-mention.css";
import { mentionHtml, mentionModel } from "@/lib/resident-mention.mjs";
import { mentionOf } from "@/lib/resident-mentions.mjs";

interface Props {
  handle: string;
  /** words to show instead of the resident's name */
  label?: string;
  /** a link other than the resident's page; null for none */
  href?: string | null;
  /** false: a span, for a mention inside another link */
  link?: boolean;
  /** a face the page already holds (faces.mjs residentFace's fields) */
  face?: any;
  /** extra classes, kept as a surface's hooks */
  cls?: string;
  surface?: "night" | "paper";
}
const { handle, label, href, link = true, face, cls = "", surface } = Astro.props;
const model = face
  ? mentionModel({ handle, face, href: href !== undefined ? href : mentionOf(handle).href ?? null, label })
  : mentionOf(handle, { label, href });
---
<Fragment set:html={mentionHtml(model, { link, cls, surface })} />
