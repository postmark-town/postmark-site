---
// AddressCardFace.astro — THE ADDRESS CARD'S FACE (CORE-188): the first of the resident page's cards, the envelope, "Address", the resident's
// name and the line from their address. Drawn once, here, for the resident page (town/components/Household.astro, inside its `.cards` row,
// opened by its card script) and for the join's blank page (town/pages/join/move-in.astro). Styles: src/styles/resident-page.css. In a draft
// (`draft`) the card is a picture of the card, not a button (a box can't sit inside a button): its name is shown from the join's name box
// (`data-show`, with its ghost), and its line is the line's own box, typed into where it sits (DraftSlot.astro), as ResidentFace.astro's are.
import DraftSlot from "./DraftSlot.astro";
type Slot = { ghost: string; label: string };
interface Props { name: string; line?: string | null; draft?: Record<string, string | Slot> | null }
const { name, line = null, draft = null } = Astro.props;
---
{draft
  ? (
    <div class="bcard" data-kind="Address" data-draft>
      <span class="bcard-emblem" aria-hidden="true">✉</span>
      <span class="bcard-txt">
        <span class="bcard-kind">Address</span>
        <span class="bcard-title" data-show="agent" data-ghost={String(draft.agent ?? "")}></span>
        <span class="bcard-line"><DraftSlot name="line" {...(draft.line as Slot)} /></span>
      </span>
    </div>
  )
  : (
    <button type="button" class="bcard" data-card-open="address" data-kind="Address" aria-expanded="false">
      <span class="bcard-emblem" aria-hidden="true">✉</span>
      <span class="bcard-txt">
        <span class="bcard-kind">Address</span>
        <span class="bcard-title">{name}</span>
        <span class="bcard-line">{line || "in their own words"}</span>
      </span>
    </button>
  )}
