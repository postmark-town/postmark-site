---
// ClassicWorld — the World page in its Halloween colours.
//
// The lit marks (the world's own: a mark that carries `mechanic: signal`, the
// rule assembleWorld uses) glow as jack-o'-lanterns, and as the season deepens
// the houses light pumpkins too: none at the Mists' first crossing, every
// parcel by 284. A harvest moon rises at the north-east pole in the sun's
// place, the map takes a purple cast, and bats cross it now and then.
//
// Keyed to the crossing the MAP is showing (live, or the time-travel dial), read
// from the viewer's own caption, and ramped from the skeleton's first Mists
// crossing to 284. The pumpkins sit in their own layer over the viewer's marks,
// at the marks' own places. Under reduced motion the bats stay home and nothing
// flickers.
//
// Emitted only while the Mists stand for the crossing this build reflects; in
// the page it takes itself down for any crossing with no Mists.
import { siteMists } from "@/lib/mists-season.mjs";
const mists = siteMists();
const STYLE = `<style>
  .pm-jacks { pointer-events: none; }
  .pm-jack-glow { fill: url(#pm-jack-glow); animation: pm-jack-flicker 2.3s steps(1, end) infinite; }
  @keyframes pm-jack-flicker { 0% { opacity: 1; } 21% { opacity: 0.75; } 26% { opacity: 1; } 63% { opacity: 0.82; } 66% { opacity: 1; } }
  .pm-classic-mapfx { position: fixed; pointer-events: none; z-index: 30; overflow: hidden; }
  .pm-classic-mapfx .g1 { position: absolute; inset: 0; background: #4a1f6e; mix-blend-mode: color; }
  .pm-wbat { position: absolute; left: -60px; width: 44px; height: 20px; color: #170a22; filter: drop-shadow(0 0 3px rgba(255, 140, 50, 0.6));
    animation: pm-wbat-fly var(--fly, 15s) linear infinite; animation-delay: var(--delay, 0s); }
  .pm-wbat path { animation: pm-wbat-flap 0.25s ease-in-out infinite alternate; transform-box: fill-box; transform-origin: 50% 40%; }
  @keyframes pm-wbat-fly { 0% { transform: translate(0, 0); } 25% { transform: translate(calc(var(--w) * 0.33), calc(var(--dy) * -1)); } 50% { transform: translate(calc(var(--w) * 0.66 + 40px), var(--dy)); } 60% { transform: translate(calc(var(--w) + 120px), 0); } 100% { transform: translate(calc(var(--w) + 120px), 0); } }
  @keyframes pm-wbat-flap { from { transform: scaleY(1); } to { transform: scaleY(0.3); } }
  @media (prefers-reduced-motion: reduce) { .pm-jack-glow { animation: none; } .pm-wbat { display: none; } }
  html[data-pmc-dock] .pm-classic-mapfx { display: none; }
</style>`;
---
{mists && (<><Fragment set:html={STYLE} /><script is:inline>
  (function () {
    var SVGNS = "http://www.w3.org/2000/svg", FULL = 284;
    var ready = Promise.all([
      fetch("/WORLD/skeleton.json").then(function (r) { return r.ok ? r.json() : null; }),
      fetch("/WORLD/world-state.json").then(function (r) { return r.ok ? r.json() : null; }),
      import("/world-engine/tools/world-engine.mjs"),
    ]).then(function (a) {
      if (!a[0] || !a[1]) return null;
      // the world's lit marks, by assembleWorld's rule; and its parcels, for the houses
      var lit = new Set(), parcels = [];
      (a[1].marks || []).forEach(function (m) {
        if (m.mechanic === "signal") lit.add(m.kind === "predicated" || m.kind === "naming" ? m.parent : m.id);
        if (m.kind === "parcel") parcels.push(m.id);
      });
      parcels.sort();
      return { sk: a[0], eng: a[2], lit: lit, parcels: parcels };
    }).catch(function () { return null; });
    var shown = null, fx = null;
    function el(tag, attrs) { var e = document.createElementNS(SVGNS, tag); for (var a in attrs) e.setAttribute(a, attrs[a]); return e; }
    function rnd(i) { var x = Math.sin(i * 12.9898 + 78.233) * 43758.5453; return x - Math.floor(x); }
    function jack(x, y, s) {
      var g = el("g", { transform: "translate(" + x.toFixed(1) + " " + y.toFixed(1) + ") scale(" + s.toFixed(2) + ")" });
      g.appendChild(el("circle", { "class": "pm-jack-glow", r: 30 }));
      g.appendChild(el("ellipse", { rx: 13, ry: 11, fill: "#f07a1c", stroke: "#8a3a0c", "stroke-width": 1.4 }));
      g.appendChild(el("path", { d: "M-5 -11c-1 4-1 18 0 22M5 -11c1 4 1 18 0 22", stroke: "#b9520f", "stroke-width": 1.2, fill: "none" }));
      g.appendChild(el("path", { d: "M-1 -11l1-5 2 1-1 4z", fill: "#3d6b22" }));
      g.appendChild(el("path", { d: "M-8 -3l3-3 3 3zM2 -3l3-3 3 3zM-8 3q8 6 16 0l-3 2-2-2-3 3-3-3-2 2z", fill: "#ffe08a" }));
      return g;
    }
    function jacks(svg, ctx, t) {
      var old = svg.querySelector("#pm-jacks"); if (old) old.remove();
      var g = el("g", { id: "pm-jacks", "class": "pm-jacks", "aria-hidden": "true" }), defs = el("defs", {}), rg = el("radialGradient", { id: "pm-jack-glow" });
      rg.appendChild(el("stop", { offset: "0", "stop-color": "#ff9a2a", "stop-opacity": "0.85" })); rg.appendChild(el("stop", { offset: "1", "stop-color": "#ff6a00", "stop-opacity": "0" }));
      defs.appendChild(rg); g.appendChild(defs);
      var houses = ctx.parcels.slice(0, Math.round(t * ctx.parcels.length));
      var want = new Set(Array.from(ctx.lit).concat(houses)), inv = svg.getScreenCTM().inverse(), placed = 0;
      svg.querySelectorAll(".ov-pip[data-id]").forEach(function (p) {
        var id = p.getAttribute("data-id"); if (!want.has(id)) return;
        var m = p.getScreenCTM(); if (!m) return;
        var pt = svg.createSVGPoint(); pt.x = 0; pt.y = 0; var q = pt.matrixTransform(m).matrixTransform(inv);
        var s = ctx.lit.has(id) ? 3.4 : 2.3;
        g.appendChild(jack(q.x, q.y, s)); placed++;
      });
      svg.appendChild(g);
      return placed;
    }
    function moon(svg, k) {
      var poles = svg.querySelector(".day-axis-poles"); if (!poles || poles.children.length < 2) return;
      var sun = poles.children[0], rays = poles.children[1], cx = +sun.getAttribute("cx"), cy = +sun.getAttribute("cy");
      if (!(cx > 0)) return;
      sun.style.display = "none"; rays.style.display = "none";
      var old = svg.querySelector("#pm-harvest"); if (old) old.remove();
      var g = el("g", { id: "pm-harvest" }), defs = el("defs", {}), rg = el("radialGradient", { id: "pm-harvest-halo" }), fg = el("radialGradient", { id: "pm-harvest-face", cx: "0.4", cy: "0.38" });
      rg.appendChild(el("stop", { offset: "0", "stop-color": "#ff9a3a", "stop-opacity": "0.7" })); rg.appendChild(el("stop", { offset: "1", "stop-color": "#ff7a1a", "stop-opacity": "0" }));
      [["0", "#ffe2b0"], ["0.45", "#ffab4a"], ["1", "#d85a16"]].forEach(function (s) { fg.appendChild(el("stop", { offset: s[0], "stop-color": s[1] })); });
      defs.appendChild(rg); defs.appendChild(fg); g.appendChild(defs);
      var r = 30 + 30 * k;
      g.appendChild(el("circle", { cx: cx, cy: cy, r: r * 4.5, fill: "url(#pm-harvest-halo)" }));
      g.appendChild(el("circle", { cx: cx, cy: cy, r: r, fill: "url(#pm-harvest-face)" }));
      svg.appendChild(g);
    }
    function mapFx(k, t) {
      if (!fx) { fx = document.createElement("div"); fx.className = "pm-classic-mapfx"; fx.setAttribute("aria-hidden", "true"); fx.innerHTML = '<div class="g1"></div>'; document.body.appendChild(fx); }
      fx.querySelector(".g1").style.opacity = (0.08 + 0.22 * k).toFixed(3);
      fx.querySelectorAll(".pm-wbat").forEach(function (c) { c.remove(); });
      for (var i = 0, n = 1 + Math.round(4 * t); i < n; i++) {
        var c = document.createElementNS(SVGNS, "svg"); c.setAttribute("class", "pm-wbat"); c.setAttribute("viewBox", "0 0 40 18");
        c.innerHTML = '<path fill="currentColor" d="M20 6c1-2 2-3 3-3-.4 1-.3 2 .5 2.6C26 3 30 1.5 34 2c-1.4 1-2 2.2-2 3.6 2-.4 4.4 0 6 1.4-2.2.2-4 1.1-5.2 2.6C30 8.6 27 8.8 24.8 10.6 23 11.8 21.4 13.6 20 16c-1.4-2.4-3-4.2-4.8-5.4C13 8.8 10 8.6 7.2 9.6 6 8.1 4.2 7.2 2 7c1.6-1.4 4-1.8 6-1.4C8 4.2 7.4 3 6 2c4-.5 8 1 10.5 3.6.8-.6.9-1.6.5-2.6 1 0 2 1 3 3z"/>';
        c.style.top = (10 + 17 * i + 8 * rnd(i + 3)) + "%";
        c.style.setProperty("--fly", (13 + 5 * rnd(i + 5)) + "s"); c.style.setProperty("--delay", (-3 - 5 * i) + "s");
        c.style.setProperty("--dy", (20 + 30 * rnd(i + 9)) + "px");
        fx.appendChild(c);
      }
    }
    function place() {
      var map = document.querySelector(".wv-map"); if (!fx || !map) return;
      var r = map.getBoundingClientRect();
      fx.style.left = r.left + "px"; fx.style.top = r.top + "px"; fx.style.width = r.width + "px"; fx.style.height = r.height + "px";
      fx.style.setProperty("--w", r.width + "px");
    }
    function off(svg) {
      shown = null;
      if (svg) { ["#pm-jacks", "#pm-harvest"].forEach(function (s) { var e = svg.querySelector(s); if (e) e.remove(); });
        var poles = svg.querySelector(".day-axis-poles"); if (poles && poles.children.length > 1) { poles.children[0].style.display = ""; poles.children[1].style.display = ""; } }
      if (fx) { fx.remove(); fx = null; }
    }
    function tick() {
      ready.then(function (ctx) {
        var svg = document.getElementById("map-svg"), b = document.querySelector(".crossnow b"), n = b ? Number(b.textContent) : NaN;
        if (!ctx || !svg || !Number.isInteger(n)) return;
        var m = ctx.eng.mistsAt(n, ctx.sk.mists);
        if (!m) { if (shown !== null) off(svg); return; }
        var first = ctx.sk.mists.schedule[0].crossing, t = Math.max(0, Math.min(1, (n - first) / (FULL - first))), k = 0.35 + 0.65 * t;
        // the marks move with the camera, so the pumpkins follow them when it moves
        var p0 = svg.querySelector(".ov-pip[data-id]"), cm = p0 && p0.getScreenCTM();
        var sig = n + "|" + svg.querySelectorAll(".ov-pip[data-id]").length + "|" + (cm ? [cm.a, cm.e, cm.f].map(function (v) { return v.toFixed(1); }).join(",") : "");
        if (sig !== jacks.sig || !svg.querySelector("#pm-jacks")) { jacks.sig = sig; jacks(svg, ctx, t); }
        if (shown !== n || !svg.querySelector("#pm-harvest")) { shown = n; moon(svg, k); mapFx(k, t); }
        else { var h = svg.querySelector("#pm-harvest"); svg.appendChild(h); }
        place();
      });
    }
    tick(); setInterval(tick, 1000); window.addEventListener("resize", place);
  })();
</script></>)}
