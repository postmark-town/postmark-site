---
// ClassicLeaves — autumn leaves falling past the home page, light: six at the
// Mists' first crossing, sixteen by 284 (mists-season.mjs § seasonRamp). They
// fall behind nothing and catch no clicks, and under reduced motion there are
// none at all.
//
// Before the Mists this renders nothing, and the page is the page it was.
import { siteMists } from "@/lib/mists-season.mjs";
const mists = siteMists();
const t = mists ? mists.t : 0;
const n = 6 + Math.round(10 * t);
const rnd = (i) => { const x = Math.sin(i * 12.9898 + 78.233) * 43758.5453; return x - Math.floor(x); };
const n3 = (v) => v.toFixed(3);
const INKS = ["#e8661c", "#c9481a", "#f0a030", "#8a3a14", "#d9822b"];
const LEAF = (c) => `<svg viewBox="0 0 24 24"><path fill="${c}" d="M12 2c1.2 2.2 1.2 3.6.6 5 1.6-1.2 3.4-1.6 5.4-1.2-.8 1.6-.6 3 .4 4.2-1.8.2-3 1-3.6 2.4 1.8-.2 3.4.4 4.8 1.8-2 .6-3.4.4-4.8-.2.4 1.6.2 3.2-.8 4.6-1-1.2-1.6-2.6-1.6-4.2l-.4 7.6h-1l-.4-7.6c0 1.6-.6 3-1.6 4.2-1-1.4-1.2-3-.8-4.6-1.4.6-2.8.8-4.8.2 1.4-1.4 3-2 4.8-1.8-.6-1.4-1.8-2.2-3.6-2.4 1-1.2 1.2-2.6.4-4.2 2-.4 3.8 0 5.4 1.2-.6-1.4-.6-2.8.6-5z"/></svg>`;
const LEAVES = Array.from({ length: n }, (_, i) =>
  `<span class="pm-leaf" style="left:${n3(100 * rnd(i + 5))}%;--s:${n3(0.7 + 0.8 * rnd(i + 15))};--dur:${n3(11 + 9 * rnd(i + 25))}s;--delay:-${n3(20 * rnd(i + 35))}s;--sway:${n3(30 + 50 * rnd(i + 45))}px">${LEAF(INKS[i % INKS.length])}</span>`).join("");
const HTML = !mists ? "" : `<div class="pm-leaves" aria-hidden="true">${LEAVES}</div><style>
  .pm-leaves { position: fixed; inset: 0; z-index: 5995; pointer-events: none; overflow: hidden; }
  .pm-leaf { position: absolute; top: -40px; width: calc(22px * var(--s)); opacity: 0.85;
    animation: pm-leaf-fall var(--dur) linear infinite; animation-delay: var(--delay); }
  .pm-leaf svg { display: block; width: 100%; animation: pm-leaf-spin calc(var(--dur) / 3) ease-in-out infinite alternate; }
  @keyframes pm-leaf-fall { 0% { transform: translate(0, 0); } 25% { transform: translate(var(--sway), 27vh); } 50% { transform: translate(0, 54vh); } 75% { transform: translate(calc(var(--sway) * -1), 81vh); } 100% { transform: translate(0, 110vh); } }
  @keyframes pm-leaf-spin { from { transform: rotate(-35deg); } to { transform: rotate(40deg); } }
  @media (prefers-reduced-motion: reduce) { .pm-leaves { display: none; } }
</style>`;
---
{HTML && <Fragment set:html={HTML} />}
