<script>
  // THE LANDING'S ISLAND. The pins open their home's card (a button each: a click, Enter or Space, a tap); the next crossing and every "how long
  // ago" are counted on the reader's own clock, from the absolute times the build wrote; the calendar's times move into the reader's zone,
  // and an event under way says "on now". Without JavaScript the floor stands: the first home's card, the crossing times, UTC times.
  import { nextCrossing, agoWords } from "@/lib/visitor-landing.mjs";

  const root = document.querySelector("[data-visitor-landing]");
  if (root) {
    const HOMES = {};
    try { for (const h of JSON.parse(root.querySelector("[data-landing-homes]")?.textContent || "[]")) HOMES[h.key] = h; } catch { /* the first card stands */ }
    const pins = [...root.querySelectorAll(".pin[data-home]")];
    const card = root.querySelector("[data-parcel]");
    const show = (k) => {
      const h = HOMES[k];
      if (!h || !card) return;
      pins.forEach((p) => { const on = p.dataset.home === k; p.classList.toggle("on", on); p.setAttribute("aria-pressed", on ? "true" : "false"); });
      card.querySelector("[data-p-img]").src = h.img;
      card.querySelector("[data-p-who]").textContent = h.who;
      card.querySelector("[data-p-title]").textContent = h.title;
      card.querySelector("[data-p-desc]").textContent = h.desc;
      card.querySelector("[data-p-link]").href = h.href;
      const m = card.querySelector("[data-p-marks]");
      m.textContent = "";
      h.marks.forEach((t) => { const s = document.createElement("span"); s.textContent = "✦ " + t; m.appendChild(s); });
    };
    pins.forEach((p) => p.addEventListener("click", () => show(p.dataset.home)));

    const local = (iso, opts) => { try { return new Intl.DateTimeFormat(undefined, opts).format(new Date(iso)); } catch { return null; } };
    const tick = () => {
      const now = Date.now();
      root.querySelectorAll("time.ago[datetime]").forEach((t) => { const w = agoWords(t.getAttribute("datetime"), now); if (w) t.textContent = w; });
      const n = root.querySelector("[data-next-crossing]");
      if (n) n.textContent = nextCrossing(now).text;
      root.querySelectorAll("[data-event-starts]").forEach((ev) => {
        const s = ev.getAttribute("data-event-starts"), e = ev.getAttribute("data-event-ends");
        const when = ev.querySelector("[data-event-when]");
        if (!when) return;
        const at = local(s, { weekday: "short", day: "numeric", month: "short", hour: "2-digit", minute: "2-digit", timeZoneName: "short" });
        const live = Date.parse(s) <= now && (!e || now < Date.parse(e));
        if (at) when.textContent = (live ? "on now · " : "") + at;
        const day = local(s, { day: "numeric" }), mon = local(s, { month: "short" });
        if (day) ev.querySelector("[data-event-day]").textContent = day;
        if (mon) ev.querySelector("[data-event-mon]").textContent = mon.toUpperCase();
      });
    };
    tick();
    setInterval(tick, 60000);
  }
</script>
