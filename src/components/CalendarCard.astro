---
// CalendarCard — one event from the office's calendar (POS-211, 2026-09-24).
//
// The same card on /calendar/ and, with `full`, on the event's own page. The
// reading law holds for `title` and `invitation`: they are a resident's words,
// so they render as TEXT through Astro's escaping and never through set:html.
//
// Every instant is a <time> whose text is its UTC reading (the static floor,
// true for every reader) and whose `datetime` and `title` carry the record. The
// island below rewrites the text into the reader's own zone with the browser's
// Intl, which is the only thing that knows the zone.
//
// THE WORDS (POS-855). The phase badge is the office's phase in plain words
// ("announced" reads "coming up", since the host's announcements are a
// different list). The "starts in 4 d 17 h" line is the office's count from its
// `as_of`, frozen into the page at build, so it is followed by that instant
// ("as of ...") rather than left to read as live. The place prints its readable
// name and its coordinates as text; a place with neither prints no row. A
// cancelled event's badge says "cancelled" and nothing else: it is not "coming
// up" or "under way", and it does not "start in" anything. On the
// event's own page the card carries the page's one sentence about time zones.
import {
  PHASE_WORDS, ZONE_FLOOR, eventHref, placeOf, residentHref, whenLine, utcText, zoneLine,
} from "@/lib/calendar.mjs";

interface Props {
  event: any;
  /** handles that have a page under /residents/ */
  roll: Set<string>;
  /** the event page's card: the title is not a link, and the RSVP list shows */
  full?: boolean;
  /** calendar.json's as_of: the instant the "starts in" count was read at */
  asOf?: string | null;
}
const { event: e, roll, full = false, asOf = null } = Astro.props;
const place = placeOf(e.place);
const hostHref = residentHref(e.host, roll);
const href = eventHref(e.id);
const phase = PHASE_WORDS[e.phase] ?? e.phase;
const when = whenLine(e);
const rsvpTotal = Number(e.rsvps?.total ?? 0);
const rsvpNames = Array.isArray(e.rsvps?.residents) ? e.rsvps.residents : [];
const revised = Number(e.revised ?? 0);
const times = [
  ...(e.doors_open && e.doors_open !== e.starts ? [["doors open", e.doors_open]] : []),
  ["starts", e.starts],
  ["ends", e.ends],
];
---
<article class:list={["cal-card", "pm-paper", { "is-cancelled": e.cancelled }]} data-event={e.id} data-phase={e.phase}>
  <p class="cal-phase">
    {e.cancelled
      ? <span class="cal-cancelled" data-cancelled>cancelled</span>
      : <>
          <span class="cal-phase-word">{phase}</span>
          {when && (
            <span class="cal-when"> · {when}{" "}
              <span class="cal-when-asof" data-when-asof>(as of {asOf
                ? <time datetime={asOf} title={`${asOf} (UTC)`} data-local>{utcText(asOf)}</time>
                : "the last build"})</span>
            </span>
          )}
        </>}
  </p>
  {full
    ? <h1 class="cal-title">{e.title}</h1>
    : <h3 class="cal-title">{href ? <a href={href}>{e.title}</a> : e.title}</h3>}
  {e.invitation && <p class="cal-invitation">{e.invitation}</p>}

  <dl class="cal-facts">
    <dt>hosted by</dt>
    <dd>{hostHref ? <a href={hostHref}>{e.host}</a> : e.host}</dd>
    {place.label && <dt>at</dt>}
    {place.label && (
      <dd data-place>
        {place.href
          ? <a class="cal-place" href={place.href}>{place.label}</a>
          : <span class="cal-place">{place.label}</span>}
        {place.name && place.point && <span class="cal-coords" data-place-point> {place.point}</span>}
      </dd>
    )}
    {times.map(([label, iso]) => (
      <>
        <dt>{label}</dt>
        <dd><time datetime={iso} title={`${iso} (UTC)`} data-local>{utcText(iso)}</time></dd>
      </>
    ))}
    <dt>RSVPs</dt>
    <dd class="cal-rsvps">
      {rsvpTotal === 1 ? "1 resident" : `${rsvpTotal} residents`}
      {revised > 0 && <span class="cal-revised" data-revised> · revised {revised}×</span>}
    </dd>
  </dl>

  {full && <p class="cal-zone" data-cal-zone-card>{ZONE_FLOOR}</p>}

  {full && (
    <section class="cal-rsvp-list">
      <h2>Who is coming</h2>
      {rsvpNames.length
        ? (
          <ul>
            {rsvpNames.map((h) => {
              const rh = residentHref(h, roll);
              return <li>{rh ? <a href={rh}>{h}</a> : h}</li>;
            })}
          </ul>
        )
        : <p class="soft">No one has RSVPed yet.</p>}
    </section>
  )}
</article>

<script>
  import { LOCAL_FORMAT, zoneLine } from "@/lib/calendar.mjs";
  // The reader's zone, from the reader's browser. A <time> that will not parse
  // keeps its UTC floor, which is still true.
  for (const el of document.querySelectorAll("time[data-local]")) {
    try {
      const d = new Date(el.getAttribute("datetime"));
      if (!Number.isNaN(d.getTime())) el.textContent = d.toLocaleString(undefined, LOCAL_FORMAT);
    } catch {}
  }
  // The event page's one sentence about the zone, once the times are the reader's.
  const said = document.querySelector("[data-cal-zone-card]");
  if (said) {
    try {
      const zone = new Intl.DateTimeFormat(undefined, { timeZoneName: "short" })
        .formatToParts(new Date()).find((x) => x.type === "timeZoneName")?.value;
      said.textContent = zoneLine(zone);
    } catch {}
  }
</script>

<style>
  .cal-card { padding: 1.1em 1.3em 1em; margin: 0 0 1em; }
  .cal-card.is-cancelled { opacity: 0.8; }
  .cal-card.is-cancelled .cal-title { text-decoration: line-through; text-decoration-thickness: 1px; }
  .cal-phase {
    margin: 0 0 0.3em; font-family: var(--pm-mono); font-size: 0.72rem;
    letter-spacing: 0.08em; text-transform: uppercase; color: var(--pm-ink-soft);
  }
  .cal-phase-word { color: var(--pm-accent); font-weight: 600; }
  .cal-cancelled {
    display: inline-block; margin-right: 0.6em; padding: 0.05em 0.5em;
    border: 1.5px solid var(--pm-wax); border-radius: 3px;
    color: var(--pm-wax); font-weight: 700;
  }
  .cal-title { margin: 0 0 0.35em; font-size: 1.3em; overflow-wrap: anywhere; }
  h1.cal-title { font-size: clamp(1.5rem, 4vw, 2rem); }
  .cal-title a { text-decoration: none; }
  .cal-title a:hover { text-decoration: underline; }
  .cal-invitation { margin: 0 0 0.9em; font-style: italic; line-height: 1.55; overflow-wrap: anywhere; white-space: pre-line; }
  .cal-facts {
    display: grid; grid-template-columns: max-content 1fr; gap: 0.25em 0.9em;
    margin: 0; font-size: 0.93rem;
  }
  .cal-facts dt { color: var(--pm-ink-soft); font-family: var(--pm-mono); font-size: 0.78rem; padding-top: 0.15em; }
  .cal-facts dd { margin: 0; overflow-wrap: anywhere; }
  .cal-coords, .cal-when-asof { color: var(--pm-ink-soft); font-family: var(--pm-mono); font-size: 0.82em; }
  .cal-when-asof { text-transform: none; letter-spacing: 0; font-weight: 400; }
  .cal-zone { margin: 0.7em 0 0; color: var(--pm-ink-soft); font-size: 0.85rem; }
  .cal-revised { color: var(--pm-ink-soft); font-size: 0.85em; }
  .cal-rsvp-list h2 { font-size: 1.05em; margin: 1.2em 0 0.4em; }
  .cal-rsvp-list ul { margin: 0; padding-left: 1.2em; }
</style>
