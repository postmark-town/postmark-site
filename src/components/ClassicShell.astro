---
// ClassicShell — the town in its Halloween colours, site-wide.
//
// Orange and purple: the gold turns pumpkin (so every gold button is a
// pumpkin-orange one), the night deepens toward purple, a harvest moon rises
// over the top-right corner, and bats flit along the header. All of it keyed
// to the crossing this build reflects and ramped from the Mists' first crossing
// to 284 (mists-season.mjs § seasonRamp): a few bats and a low moon at first,
// a colony and a full orange moon by 284. Under reduced motion the bats keep
// still. Text keeps WCAG AA (tools/classic-contrast.mjs).
//
// Before the Mists this renders nothing, and the page is the page it was.
import { siteMists } from "@/lib/mists-season.mjs";
const mists = siteMists();
const t = mists ? mists.t : 0;
const k = 0.35 + 0.65 * t;
const pct = (n) => `${Math.round(k * n)}%`;
const n3 = (v) => v.toFixed(3);
const bats = 2 + Math.round(6 * t);
const rnd = (i) => { const x = Math.sin(i * 12.9898 + 78.233) * 43758.5453; return x - Math.floor(x); };
const BAT = `<svg viewBox="0 0 40 18"><path fill="currentColor" d="M20 6c1-2 2-3 3-3-.4 1-.3 2 .5 2.6C26 3 30 1.5 34 2c-1.4 1-2 2.2-2 3.6 2-.4 4.4 0 6 1.4-2.2.2-4 1.1-5.2 2.6C30 8.6 27 8.8 24.8 10.6 23 11.8 21.4 13.6 20 16c-1.4-2.4-3-4.2-4.8-5.4C13 8.8 10 8.6 7.2 9.6 6 8.1 4.2 7.2 2 7c1.6-1.4 4-1.8 6-1.4C8 4.2 7.4 3 6 2c4-.5 8 1 10.5 3.6.8-.6.9-1.6.5-2.6 1 0 2 1 3 3z"/></svg>`;
const BATS = Array.from({ length: bats }, (_, i) =>
  `<span class="pm-bat" style="left:${n3(4 + 92 * rnd(i + 1))}%;top:${n3(8 + 70 * rnd(i + 21))}%;--s:${n3(0.7 + 0.6 * rnd(i + 41))};--dur:${n3(5 + 5 * rnd(i + 61))}s;--delay:-${n3(9 * rnd(i + 81))}s">${BAT}</span>`).join("");
const HTML = !mists ? "" : `<div class="pm-harvest-moon" aria-hidden="true"></div><div class="pm-bats" aria-hidden="true">${BATS}</div><style>
  body .pm {
    --pm-gold: color-mix(in srgb, #e8c48b, #ff8a2a ${pct(90)});
    --pm-gold-bright: color-mix(in srgb, #f6dcae, #ffb468 ${pct(90)});
    --pm-accent: color-mix(in srgb, #a4632a, #5e2f91 ${Math.round(55 + 45 * k)}%);
    --pm-wax: color-mix(in srgb, #9c3f2e, #b8431a ${pct(60)});
    --pm-night: color-mix(in srgb, #070b15, #160a26 ${pct(100)});
    --pm-harbor: color-mix(in srgb, #0d1426, #22113a ${pct(100)});
    --pm-harbor-2: color-mix(in srgb, #1c2c4f, #3b1f5c ${pct(100)});
  }
  body { background-color: color-mix(in srgb, #0d1426, #1c0d30 ${pct(100)}); }
  .pm .pm-townnav-links a.pm-nav-join { box-shadow: inset 0 0 0 1px rgba(255, 138, 42, ${n3(0.4 + 0.5 * k)}), 0 0 18px rgba(255, 120, 30, ${n3(0.35 * k)}); }
  .pm-harvest-moon { position: fixed; z-index: -1; pointer-events: none; border-radius: 50%;
    width: ${Math.round(90 + 110 * k)}px; height: ${Math.round(90 + 110 * k)}px; top: ${Math.round(-50 + 50 * k)}px; right: ${Math.round(-60 + 50 * k)}px;
    background: radial-gradient(circle at 38% 36%, #ffd9a0 0%, #ffab4a 38%, #e8661c 72%, #b9420f 100%);
    box-shadow: 0 0 ${Math.round(40 + 80 * k)}px rgba(255, 140, 40, ${n3(0.35 + 0.35 * k)}); opacity: ${n3(0.55 + 0.45 * k)}; }
  .pm-shell { position: relative; z-index: 1; }
  .pm-bats { position: absolute; left: 0; right: 0; top: 0; height: 120px; z-index: 6000; pointer-events: none; overflow: hidden; }
  .pm-bat { position: absolute; width: calc(46px * var(--s)); color: #1a0d26; filter: drop-shadow(0 0 4px rgba(255, 150, 60, 0.7));
    animation: pm-bat-flit var(--dur) ease-in-out infinite alternate; animation-delay: var(--delay); }
  .pm-bat svg { display: block; width: 100%; animation: pm-bat-flap 0.28s ease-in-out infinite alternate; transform-origin: 50% 40%; }
  @keyframes pm-bat-flit { 0% { transform: translate(0, 0); } 50% { transform: translate(60px, -12px); } 100% { transform: translate(120px, 8px); } }
  @keyframes pm-bat-flap { from { transform: scaleY(1); } to { transform: scaleY(0.35); } }
  @media (prefers-reduced-motion: reduce) { .pm-bat, .pm-bat svg { animation: none; } }
</style>`;
---
{HTML && <Fragment set:html={HTML} />}
