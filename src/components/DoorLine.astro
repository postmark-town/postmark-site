---
// DoorLine — the foot of every town page: the door this page is a picture of,
// and one row of the town's rooms beyond the door (the socials).
//
// Rendered ONCE, by PostmarkLayout, from the `door` prop every page declares
// (see src/lib/door-line.mjs for the law and the socials' sources). A page
// that is not a door's picture declares `door={null}` and gets the socials row
// alone — no door line, so nothing on Join claims a read it does not show.
//
// The age clause is an island over the site's own /build.json, the same stamp
// and the same agePhrase PageFreshness uses. Its failure is silence: no stamp,
// no clause. It uses its own data attributes so it never collides with a
// PageFreshness on the same page (the mail explorer and the resident pages).
import { doorLine, SOCIALS } from "@/lib/door-line.mjs";

interface Props {
  door: { mcp?: string | null; get?: string | null } | null;
}
const line = doorLine(Astro.props.door);
// THE CONCISENESS PASS (part 8): the line reads `this page is <read>` — the
// MCP read when the page has one, else its plain GET. The plain GET (when it
// is not already the read) and the age ride the read's hover and stay in the
// DOM for a screen reader. The read LINKS the plain GET, so the click the
// line used to offer on the GET is still one click.
const shown = line ? (line.mcp ?? `GET ${line.get}`) : null;
const hover = line?.mcp && line?.get ? `GET ${line.get}` : undefined;
---

<footer class="pm-doorfoot" data-door-foot>
  {line && (
    <p class="pm-doorline" data-door-line>
      <span class="pm-doorline-lead">this page is</span>
      {line.getHref
        ? <a class="pm-doorline-read" href={line.getHref} title={hover} data-door-hover>
            <code data-door-mcp={line.mcp ? "" : undefined} data-door-get={line.mcp ? undefined : ""}>{shown}</code>
          </a>
        : <code class="pm-doorline-read" title={hover} tabindex={hover ? "0" : undefined} data-door-hover
                data-door-mcp={line.mcp ? "" : undefined} data-door-get={line.mcp ? undefined : ""}>{shown}</code>}
      {line.mcp && line.get && <span class="pm-sr" data-door-get> · GET {line.get}</span>}
      <span class="pm-sr" data-door-age hidden> · as the office read it <span data-door-ago></span></span>
    </p>
  )}
  <ul class="pm-socials" aria-label="Postmark beyond the door">
    {SOCIALS.map((s) => (
      <li class:list={["pm-social", { "is-soon": s.soon, "is-unlinked": !s.href && !s.soon }]} data-social={s.key}>
        {s.href ? (
          <a href={s.href} target="_blank" rel="noopener" title={s.note ? `${s.name} — ${s.note}` : s.name}>
            <svg viewBox="0 0 24 24" width="15" height="15" aria-hidden="true" fill="currentColor"><path d={s.path} /></svg>
            <span class="pm-social-name">{s.name}</span>
            {s.note && <span class="pm-social-note">{s.note}</span>}
          </a>
        ) : (
          <span>
            <svg viewBox="0 0 24 24" width="15" height="15" aria-hidden="true" fill="currentColor"><path d={s.path} /></svg>
            <span class="pm-social-name">{s.name}</span>
            {s.soon && <span class="pm-social-note">soon</span>}
          </span>
        )}
      </li>
    ))}
  </ul>
</footer>

{line && (
  <script>
    import { agePhrase } from "@/lib/page-freshness.mjs";
    (async function () {
      const age = document.querySelector("[data-door-age]");
      const ago = document.querySelector("[data-door-ago]");
      if (!age || !ago) return;
      try {
        const r = await fetch("/build.json", { headers: { accept: "application/json" } });
        if (!r.ok) return;
        const stamp = await r.json();
        const phrase = agePhrase(Date.now() - Date.parse(String(stamp?.built_at ?? "")));
        if (!phrase) return;
        ago.textContent = phrase;
        age.hidden = false;
        // the age rides the read's hover with the plain GET
        const read = document.querySelector("[data-door-hover]");
        if (read) read.title = [read.title, `as the office read it ${phrase}`].filter(Boolean).join(" · ");
      } catch { /* the floor: no clause */ }
    })();
  </script>
)}

<style>
  .pm-doorfoot {
    margin: 2.6rem auto 0;
    padding: 1.1rem 16px 1.6rem;
    max-width: 72rem;
    border-top: 1px solid rgba(232, 196, 139, 0.16);
    text-align: center;
    font-family: var(--pm-mono);
    color: rgba(232, 196, 139, 0.6);
  }
  .pm-doorline {
    margin: 0 0 0.8rem;
    font-size: 0.7rem;
    line-height: 1.8;
    letter-spacing: 0.04em;
    overflow-wrap: anywhere;
  }
  .pm-doorline code {
    font-family: inherit;
    color: rgba(246, 220, 174, 0.88);
    background: rgba(232, 196, 139, 0.07);
    border: 1px solid rgba(232, 196, 139, 0.14);
    border-radius: 4px;
    padding: 0 0.35em;
  }
  .pm-doorline a.pm-doorline-read { color: inherit; text-decoration: none; }
  .pm-doorline a.pm-doorline-read:hover code { border-color: rgba(232, 196, 139, 0.5); }
  .pm-doorline code[data-door-hover][title] { cursor: help; }
  .pm-doorline-lead { margin-right: 0.4em; }
  .pm-doorline-dot { margin: 0 0.45em; opacity: 0.6; }
  .pm-socials {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.35rem 1.1rem;
    font-size: 0.72rem;
    letter-spacing: 0.05em;
  }
  .pm-social a, .pm-social > span {
    display: inline-flex;
    align-items: center;
    gap: 0.42em;
    color: rgba(232, 196, 139, 0.78);
    text-decoration: none;
  }
  .pm-social a:hover { color: var(--pm-gold-bright); }
  .pm-social svg { flex: none; }
  .pm-social-note { opacity: 0.6; }
  .pm-social.is-unlinked > span { color: rgba(232, 196, 139, 0.55); }
  .pm-social.is-soon > span { color: rgba(232, 196, 139, 0.32); }
  /* A phone's last row would sit under the fixed corner buttons (the back-to-
     top chip and the resident pages' egg slot), so the foot gives them room. */
  @media (max-width: 640px) {
    .pm-doorfoot { padding-bottom: 7.5rem; }
  }
</style>
