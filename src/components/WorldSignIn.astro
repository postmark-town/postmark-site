---
// WorldSignIn — the human sign-in affordance for the told-world page.
//
// The world page is a PASSTHROUGH of the postmark-world viewer (no site layout,
// so none of the layout's top-right sign-in), and the viewer authenticates only
// by a Bearer held in localStorage['pm_key']. A browser visitor has no way to
// present one, so Act As, the household lens, backing, and walking never activate — the
// gap this closes.
//
// This island runs the site's GitHub OAuth flow — the SAME PKCE dance the layout
// sign-in does, reusing the pure surface in @/lib/auth.mjs. The callback lands on
// "/" (the client's one registered redirect), where the layout's island exchanges
// the code and stores the token; we set returnTo=/world/ so the browser comes
// back here. The early bridge in world.astro then mirrors that token into
// localStorage['pm_key'] before the viewer boots, so the lens is live on load.
//
// This is the human door, and as of 2026-08-05 it is the ONLY door on this page:
// the claim that used to sit here — that shell agents paste a household key into
// the viewer's own key field — is no longer true. The viewer's identity block
// renders Act As and nothing else; the key field was retired at some point before
// this branch, and its styles were still in the stylesheet with no markup to
// dress. Machinery reaches the world through the office (MCP/REST) rather than
// through this page, so nothing is stranded — but the comment was describing a
// field that is not there, which is worse than saying nothing.
//
// P5(a): the world page is layout-less, so it also has no "back to the town" — so
// this same cluster carries a "← Postmark" link (one visual family with the pill).
// The link is always shown (pure navigation, no JS); only the auth buttons wait on
// the script to paint the signed-in/out state, so nothing flickers.
---
<div id="pm-world-auth" class="wa">
  {/* THE FOLD (WLD-47; Darko, 2026-10-14 11:44 EDT: "B, the fold"). On a phone
      the links below stand down behind this one pill, and the pill is measured
      into the patch the map's circles leave free (src/lib/world-nav-seat.mjs).
      Everywhere else the pill is not shown and the list is display:contents, so
      the seated rail and the desktop pill are exactly what they were. */}
  <button type="button" class="wa-btn wa-menu" data-wa-menu aria-expanded="false"
    aria-controls="pm-world-auth-list" title="Postmark: the town, the replay, conversations, the atlas, sign in">☰ Postmark</button>
  <div class="wa-list" id="pm-world-auth-list">
  <a class="wa-btn wa-back" href="/" title="Back to Postmark — the town">← Postmark</a>
  {/* THE LENS STRIP, CARRIED IN. Every other page in the World family — the
      replay, the conversations record, the atlas — renders a strip naming all
      four; /world/ is a verbatim passthrough of the viewer shell, so it renders
      no layout and therefore no strip, and arrived at exactly ONE link out (this
      "← Postmark"). A visitor who followed the strip's own "the living map" here
      lost the strip by using it, and the only route onward to the replay was a
      60x11px sentence-link inside a panel behind a chip.
      Seated in this cluster rather than added as new floating chrome on purpose:
      it already knows how to sit in the viewer's rail slot and how to stand back
      up as a floating pill when the rail is hidden on a phone — where the World
      otherwise offers no route to anywhere at all. One cluster, one behaviour. */}
  <a class="wa-btn wa-lens" href="/replay/" title="Replay — the record, crossing by crossing">replay</a>
  <a class="wa-btn wa-lens" href="/conversations/" title="Conversations — what is being said, and where">conversations</a>
  <a class="wa-btn wa-lens" href="/atlas/" title="The Atlas — the town in its holders' own words">the atlas</a>
  <button type="button" class="wa-btn" data-wa-signin hidden>Sign in with GitHub</button>
  <button type="button" class="wa-btn wa-out" data-wa-signout hidden>sign out</button>
  </div>
</div>

<script>
  // The crypto + fetch live here (auth.mjs stays the pure, testable surface); this
  // mirrors the layout's login island — the kickoff half only, since the code
  // exchange happens on "/" and we return here with the token already stored.
  import { AS, KEYS, buildAuthorizeUrl, tokenIsFresh } from "@/lib/auth.mjs";
  import { PHONE_QUERY, seatFold } from "@/lib/world-nav-seat.mjs";

  const root = document.getElementById("pm-world-auth");
  if (root) (function () {
    const signinBtn = root.querySelector("[data-wa-signin]");
    const signoutBtn = root.querySelector("[data-wa-signout]");
    const redirectUri = location.origin + "/"; // the client's one registered callback

    const getTok = () => { try { return JSON.parse(localStorage.getItem(KEYS.token) || "null"); } catch { return null; } };

    const b64url = (buf) => btoa(String.fromCharCode(...new Uint8Array(buf))).replace(/\+/g, "-").replace(/\//g, "_").replace(/=+$/, "");
    const rand = () => { const a = new Uint8Array(32); crypto.getRandomValues(a); return b64url(a.buffer); };
    const challenge = async (v) => b64url(await crypto.subtle.digest("SHA-256", new TextEncoder().encode(v)));

    async function clientId() {
      let id = localStorage.getItem(KEYS.client);
      if (id) return id;
      const res = await fetch(AS.register, {
        method: "POST", headers: { "content-type": "application/json" },
        body: JSON.stringify({
          client_name: "postmark.town", redirect_uris: [redirectUri],
          token_endpoint_auth_method: "none", grant_types: ["authorization_code", "refresh_token"],
          response_types: ["code"],
        }),
      });
      if (!res.ok) throw new Error("register " + res.status);
      id = (await res.json()).client_id;
      localStorage.setItem(KEYS.client, id);
      return id;
    }

    function paint() {
      const signedIn = tokenIsFresh(getTok());
      signinBtn.hidden = signedIn;
      signoutBtn.hidden = !signedIn;
      // WHO you are signed in as is the viewer's Act As row, right below this —
      // and the sign-out button already says that you are (Keemin, 2026-08-04).
      // A third statement of it in the same 236 px column was noise.
    }

    signinBtn.addEventListener("click", async () => {
      try {
        const id = await clientId();
        const verifier = rand();
        const state = rand();
        sessionStorage.setItem(KEYS.verifier, verifier);
        sessionStorage.setItem(KEYS.state, state);
        sessionStorage.setItem(KEYS.returnTo, location.pathname + location.search); // come back to /world/
        location.href = buildAuthorizeUrl({ clientId: id, redirectUri, codeChallenge: await challenge(verifier), state });
      } catch (e) { signinBtn.textContent = "sign-in unavailable"; }
    });

    signoutBtn.addEventListener("click", () => {
      // sign out of the site session AND drop the viewer's Bearer, then reload so
      // the viewer re-boots keyless (the early bridge finds no token to re-adopt).
      try { localStorage.removeItem(KEYS.token); } catch {}
      try { localStorage.removeItem("pm_key"); } catch {}
      sessionStorage.removeItem("pm.oauth.handles");
      location.reload();
    });

    paint();

    // THE VIEWER OFFERS A SLOT, so take it (Keemin, 2026-08-04: these buttons
    // belong at the top of the side rail). The viewer's own chrome now lives at
    // the head of its nav column and `.wv-nav-top` is the seat it leaves for us;
    // moving into it beats floating over the page, which is what cost the
    // painting a whole row of screen and put a fixed pill above its controls.
    //
    // A FALLBACK, not a requirement: the pill stays fixed wherever no slot is
    // offered — an older viewer pin, or any page that mounts this island without
    // one — so this can never leave the only sign-in door unreachable.
    //
    // A SEAT THAT IS NOT SHOWN IS NOT A SEAT. On a phone the viewer hides its
    // whole side rail (2026-08-04: no rail, no Telling, the painting takes the
    // screen), and the slot goes with it — so sitting in it would have taken the
    // only human sign-in door off the page with it. We check the slot is actually
    // rendered, not merely present, and stand back up when it stops being.
    const seated = () => root.parentElement !== document.body;
    const seat = () => {
      const slot = document.querySelector(".wv-nav-top");
      const shown = slot && slot.getClientRects().length > 0;
      if (!shown) {
        if (seated()) { document.body.appendChild(root); root.classList.remove("wa-slotted"); }
        return !!slot;
      }
      if (root.parentElement !== slot) { slot.appendChild(root); root.classList.add("wa-slotted"); }
      return true;
    };
    // THE FOLD, ON A PHONE (WLD-47). Floating below 720 px, the cluster is one
    // "☰ Postmark" pill that opens the list, and the pill is measured into a free
    // patch beside the map's circles (seatFold). Re-measured whenever the viewer's
    // control row changes size, so a seventh circle moves the pill instead of
    // hiding under it. Time travel hangs under whatever this decides, so it is
    // told each time ("pm-world-auth:placed").
    const menuBtn = root.querySelector("[data-wa-menu]");
    const phone = window.matchMedia(PHONE_QUERY);
    const folded = () => !seated() && phone.matches;
    const close = () => { root.classList.remove("wa-open"); menuBtn.setAttribute("aria-expanded", "false"); };
    menuBtn.addEventListener("click", (e) => {
      e.stopPropagation();
      const open = !root.classList.contains("wa-open");
      root.classList.toggle("wa-open", open);
      menuBtn.setAttribute("aria-expanded", String(open));
    });
    // a tap anywhere else, or Escape, puts the list away
    document.addEventListener("pointerdown", (e) => { if (!root.contains(e.target)) close(); });
    document.addEventListener("keydown", (e) => { if (e.key === "Escape" && root.classList.contains("wa-open")) { close(); menuBtn.focus(); } });

    const box = (sel) => { const el = document.querySelector(sel); return el && el.getClientRects().length ? el.getBoundingClientRect() : null; };
    const place = () => {
      if (!folded()) {
        root.style.top = root.style.left = "";
        close();
      } else {
        const row = box(".wv-mapctl-tools");
        // no row yet (or an older viewer without one): the stylesheet's fallback seat stands
        if (row) {
          const pill = menuBtn.getBoundingClientRect();
          const at = seatFold({ pill, obstacles: [box(".wv-worldmark"), box(".wv-search"), row], rowTop: row.top });
          root.style.top = at.top + "px";
          root.style.left = at.left + "px";
        }
      }
      window.dispatchEvent(new Event("pm-world-auth:placed"));
    };
    const settle = () => { seat(); place(); };

    // the viewer mounts from its own module script; if ours wins the race, wait
    // one frame rather than concluding there is no slot
    if (!seat()) requestAnimationFrame(settle);
    place();
    // a rotation or a resize can cross the breakpoint in either direction
    window.addEventListener("resize", settle);
    // the control row arrives with the viewer and changes size with it (the bell
    // appears with the Mists, a font lands late): watch it, and the pill itself
    let watching = null;
    const watch = () => {
      const row = document.querySelector(".wv-mapctl");
      if (!row || row === watching || typeof ResizeObserver !== "function") return !!row;
      watching = row;
      const ro = new ResizeObserver(() => place());
      ro.observe(row); ro.observe(menuBtn);
      const tools = row.querySelector(".wv-mapctl-tools");
      if (tools) ro.observe(tools);
      return true;
    };
    if (!watch()) {
      const mo = new MutationObserver(() => { if (watch()) { mo.disconnect(); settle(); } });
      mo.observe(document.body, { childList: true, subtree: true });
    }
  })();
</script>

<style>
  .wa {
    position: fixed; top: 10px; right: 12px; z-index: 9000;
    display: flex; align-items: center; gap: 8px;
    font-family: ui-monospace, "SF Mono", Menlo, monospace;
  }
  .wa-btn {
    font: inherit; font-size: 0.72rem; letter-spacing: 0.05em;
    color: #f6dcae; background: rgba(20, 23, 29, 0.86);
    border: 1px solid rgba(232, 196, 139, 0.5); border-radius: 999px;
    padding: 6px 14px; cursor: pointer;
    backdrop-filter: blur(4px);
  }
  .wa-btn:hover { background: rgba(232, 196, 139, 0.14); }
  /* Seated in the viewer's side rail: in flow, stacked, and sized for the narrow
     column the rail became once Walk moved onto the painting (2026-08-04). Full
     width each, so two short words never sit alone on a line beside each other. */
  .wa.wa-slotted {
    position: static; flex-direction: column; align-items: stretch; gap: 5px; width: 100%;
  }
  .wa-slotted .wa-btn {
    text-align: center; backdrop-filter: none;
    font-size: 0.64rem; letter-spacing: 0.03em; padding: 5px 8px;
  }
  .wa-out { color: #b9b19c; border-color: rgba(185, 177, 156, 0.4); }
  .wa-out:hover { background: rgba(185, 177, 156, 0.12); }
  /* the "back to the town" link — same pill family, muted so the gold sign-in
     stays the primary action; it's an <a>, so kill the underline. */
  .wa-back { color: #cbb98a; border-color: rgba(203, 185, 138, 0.42); text-decoration: none; }
  .wa-back:hover { background: rgba(203, 185, 138, 0.12); }
  /* the lens links wear the FAMILY STRIP's own idiom — small-caps text, no
     pill — so lenses read as ways-of-looking and pills stay actions
     (← Postmark leaves, sign-in acts). It's the same vocabulary the reader
     learned on /replay/, /conversations/ and /atlas/, whose strip renders
     exactly this way. (Keemin, 2026-08-15: pilled, the three read identical
     to the buttons around them.) */
  .wa-lens {
    border: none; background: none; backdrop-filter: none;
    color: #9d9682; text-transform: uppercase;
    font-size: 0.62rem; letter-spacing: 0.16em;
    padding: 4px 6px; text-decoration: none;
  }
  .wa-lens:hover { color: #f6dcae; background: none; border: none; }
  /* THE FOLD'S TWO PIECES, OFF A PHONE: the pill is not shown and the list is
     no box at all (display:contents), so its children are this cluster's own
     flex items exactly as they were, seated in the rail or floating top-right. */
  .wa-menu { display: none; }
  .wa-list { display: contents; }
  /* ON A PHONE: THE FOLD (WLD-47; Darko, 2026-10-14 11:44 EDT). The viewer hides
     its rail below 720 px, so this cluster floats over the painting and is the
     page's only way to sign in or leave. It used to park its five links at a
     fixed top:50px, "under the world-root's glyph, the one clear patch", and
     that patch stopped being clear when the search pill (2026-09-13) wrapped the
     map's circles onto a second line: every circle on a 390 px screen then
     tapped "replay" or "conversations". Now the links fold behind one
     "☰ Postmark" pill, and the island measures the pill into a free patch
     (seatFold, src/lib/world-nav-seat.mjs); the top:50px here is only the
     seat until the viewer's row exists to measure. right:auto matters: a box
     stretched to the right edge would lie over the circles even where the pill
     doesn't. The 720 is the viewer's own breakpoint, held equal by
     test/world-nav-seat.test.mjs: two numbers here would drift. */
  @media (max-width: 720px) {
    /* only the FLOATING cluster folds; a seated one is in the rail's flow */
    .wa:not(.wa-slotted) {
      top: 50px; left: 10px; right: auto;
      flex-direction: column; align-items: flex-start; gap: 6px;
    }
    /* the pill matches the circles' height, so it reads as part of their row; its
       width is held to 97 px so it still fits beside the row on a 360 px screen (the
       patch there is 100 px with the clear space; at 13 px of padding it was 101) */
    .wa:not(.wa-slotted) .wa-menu {
      display: inline-flex; align-items: center; height: 2.15rem; box-sizing: border-box;
      padding: 0 11px; font-size: 0.72rem; white-space: nowrap;
    }
    .wa:not(.wa-slotted) .wa-list { display: none; }
    .wa.wa-open:not(.wa-slotted) .wa-list {
      display: flex; flex-direction: column; align-items: stretch; gap: 2px;
      min-width: 12rem; padding: 5px;
      background: rgba(13, 15, 19, 0.94); border: 1px solid rgba(232, 197, 106, 0.34);
      border-radius: 12px; box-shadow: 0 4px 16px rgba(0, 0, 0, 0.45);
    }
    /* in the list each link is a row, not a pill */
    .wa-open:not(.wa-slotted) .wa-list .wa-btn {
      border: none; background: none; backdrop-filter: none; border-radius: 8px;
      padding: 9px 12px; font-size: 0.8rem; text-align: left; text-decoration: none;
    }
    .wa-open:not(.wa-slotted) .wa-list .wa-btn:hover { background: rgba(232, 197, 106, 0.16); }
    .wa-open:not(.wa-slotted) .wa-list .wa-lens { font-size: 0.68rem; letter-spacing: 0.14em; }
    /* sign in is last, and gold: the one action in a list of places */
    .wa-open:not(.wa-slotted) .wa-list [data-wa-signin],
    .wa-open:not(.wa-slotted) .wa-list [data-wa-signout] {
      margin-top: 4px; text-align: center; border-radius: 999px;
    }
    .wa-open:not(.wa-slotted) .wa-list [data-wa-signin] { color: #f6dcae; border: 1px solid rgba(232, 196, 139, 0.5); }
    .wa-open:not(.wa-slotted) .wa-list [data-wa-signout] { border: 1px solid rgba(185, 177, 156, 0.4); }
  }
</style>
