---
// Hearth — the household page's body: the house, drawn in the household's chosen design, and one thin strip of the site's own above it.
//
// THE PAGE IS THE DESIGN (POS-984, Darko 2026-11-10 17:14 EST, on dev: "My intent is for the resident-submitted household hearth theme to be
// the only thing for the household dashboard"; 17:28: "such that the resident designed submissions take up the vast majority of the visual
// space in the household page, and we literally just have the bare minimum that … we couldn't include in the template"). Under the site's
// shell this is all there is: the strip (below), then the design. There is no second pane, no copy of what a design draws, no rail of residents
// (the design draws each resident once, and its card links to that resident's own page).
//
// THE STRIP (`hearth-bar`), the only thing here that is the site's and not a design's. One line on a desktop, two on a phone:
//   - the breadcrumb the page hands in (`crumbs`);
//   - the Hearth dropdown (HearthPicker.astro), for EVERY reader: anyone may preview any registered design on this house (`?entry=` does the same),
//     and only the house's own signed-in human gets the save, behind a second yes (the office decides who may);
//   - for the house's own signed-in human only: "+ add a resident", and the likeness answer.
// Why these two are the site's and not a template slot: each is an act of the house's human that must stay reachable whichever design the house
// chose, and a design may leave any slot out (that is the household's choice of design). A consent answer (likeness) that a theme could omit
// would be a consent the human could not change. Both are one link each: they take no room a design could use.
// And the one plain line that says the page is still part-read ("still reading 1 resident…", paintReading), which is about the page, not a design.
//
// WHAT A DESIGN IS (unchanged by this page): HTML and CSS in the page, sanitized at build (lib/hearth/sanitize-html.mjs, sanitize-css.mjs): no script,
// no event handler, no frame, no external load. The slots are the site's own (HearthSlot.astro draws each; the dashboard's reads fill them);
// private ones (Needs you, Mail, the boat line) show only to the house's own sign-in. A design places a slot; it never receives what is in it.
//
//   - EVERY HOUSEHOLD HAS ONE: it opens on Postmark's default entry, or its saved choice (POS-962; lib/hearth/choice.mjs).
//   - ANY REGISTERED ENTRY PREVIEWS ON ANY HOUSEHOLD: `?entry=<id>` or the dropdown. A preview is not saved: nothing is written to the office.
//
// The page is server-rendered with the design it opens on (so the house's public face is there without a script); lib/hearth/stage.mjs then reads
// the house, paints the live parts, and swaps designs for a preview. Which design to draw is lib/hearth/which-design.mjs's answer, and nothing else's.
import HearthSlot from "./HearthSlot.astro";
import HearthPicker from "./HearthPicker.astro";
import "./hearth-host.css";
import media from "@/data/postmark/media.json";
import bulletinAll from "@/data/postmark/bulletin.json";
import { residentFace } from "@/lib/household-dashboard/faces.mjs";
import { homePictureOf } from "@/lib/home-picture.mjs";
import { likenessLink, likenessWords } from "@/lib/appearance.mjs";
import { entries } from "@/lib/hearth/registry.mjs";
import { whichDesign } from "@/lib/hearth/which-design.mjs";
import { SLOT_NAMES } from "@/lib/hearth/slots.mjs";
import { HOLO_LINE, HOLO_NAME_LINE } from "@/lib/funding.mjs";

interface Props {
  house: any;
  members: any[];
  plate: string;
}
const { house, members, plate } = Astro.props;
// TWO NAMES, NEVER ONE FOR BOTH: `slug` is the page's path (a registry key over 96 bytes is a hash there: houses.mjs § housePath), and `key` is the registry key
// the office knows the house by. The address, the look-since storage and the words about the page use the path; the saved choice's read and its PATCH use the
// KEY (data-hearth-key), or a long-keyed house reads nothing and saves to a path the office has no household at.
const slug = house.path ?? house.slug ?? "";
// the ONE question the page asks about its design (POS-984): the server draws the design the page opens on, and the
// browser asks the same function for a preview
// BAKED: the build's households.json is the registry GET /households answers, so a house's saved choice (`hearth`, office migration 093)
// is here once the office carries it, and the server draws it: no flash of the default. The browser read (stage.mjs) corrects a stale one.
const entry = whichDesign(entries, { saved: house.hearth ?? null });
const faces = members.map((r) => residentFace(r, media, homePictureOf(r.handle)));
const facesByHandle = Object.fromEntries(faces.map((f) => [f.handle, {
  name: f.name, accent: f.accent, avatar: f.avatar, monogram: f.monogram, windowHung: f.windowHung,
}]));
// the dropdown lists the registered designs and starts on the one the server draws
const pickable = entries.map((e) => ({ id: e.id, title: e.title, author: e.author }));
const likeness = likenessWords(house, faces.length);

// the bulletin's open notices, newest first: public, baked, the same file the bulletin page reads
const bulletin = (bulletinAll as any[])
  .filter((b) => b?.data?.status === "open" && b.slug && b.data?.title)
  .sort((a, b) => String(b.data.posted ?? "").localeCompare(String(a.data.posted ?? "")))
  .slice(0, 3)
  .map((b) => ({ slug: String(b.slug), title: String(b.data.title), posted: b.data.posted ? String(b.data.posted) : null }));

const forClient = entries.map((e) => ({ id: e.id, title: e.title, author: e.author, line: e.line, css: e.css, html: e.html }));
const json = (v: unknown) => JSON.stringify(v).split("<").join("\\u003c").split("\u2028").join("\\u2028").split("\u2029").join("\\u2029");
const slotProps = { house, faces, plate, slug, bulletin };
---
<section class="hearth" data-hearth data-hearth-slug={slug} data-hearth-baked={house.hearth ?? ""} data-hearth-key={house.slug ?? ""} aria-label={`${plate}, the Hearth`}>
  <script type="application/json" data-hearth-faces set:html={json({ handles: faces.map((f) => f.handle), faces: facesByHandle })} />
  <script type="application/json" data-hearth-entries set:html={json(forClient)} />

  <header class="hearth-bar" data-hearth-bar>
    <nav class="hearth-crumbs" aria-label="Where this page is"><slot name="crumbs" /></nav>
    <div class="hearth-tools">
      <p class="hearth-reading" data-hd-reading role="status" hidden></p>
      <HearthPicker entries={pickable} selected={entry?.id ?? null} />
      {/* the house's own human only (stage.mjs shows them when the reader's sign-in holds a resident of this house; they ship hidden) */}
      <p class="hearth-own" data-hearth-own hidden>
        <a class="house-add" data-house-add href="/join/move-in/">+ add a resident</a>
        {house.declared && house.slug && (
          <span class="hearth-likeness" data-hd-likeness={likeness.state} title={likeness.line}>
            likeness: {likeness.state} · <a href={likenessLink(house.slug)}>{house.likeness?.answer ? "Change" : "Answer"} the likeness question</a>
          </span>
        )}
      </p>
    </div>
    <h1 class="hd-sr">{plate || "a shared household"}</h1>
    <p class="hearth-note" data-hearth-note hidden></p>
  </header>

  {/* THE ENTRY'S REGION, marked for the build's security policy (tools/lib/hearth-csp.mjs): everything an entry
      contributes to this page is between the two comments, and nothing the host runs is. The policy trusts the
      inline scripts OUTSIDE the region and fails the build on any inside it. */}
  {/* THE HOST'S FRAME around the region: a design's `:root`/`html`/`body` rule is rewritten onto its own stage, where a margin or a
      transform could move the stage up over the strip above it, and the stage's own `contain: paint` clips its children, not itself.
      This box clips the stage, and keeps a negative margin from collapsing out through it, so the most a design can move is itself,
      inside its own frame. */}
  <div class="hearth-frame">
<!--hearth-entry-->
  {entry ? (
    <>
      <style is:inline data-hearth-css set:html={entry.css}></style>
      <div class="hearth-stage" data-hearth-stage data-hearth-entry={entry.id} data-hd data-hd-view="public" data-hd-slug={slug}>
        {entry.segments.map((s: any) => s.slot
          ? <HearthSlot name={s.slot} {...slotProps} />
          : <Fragment set:html={s.html} />)}
      </div>
    </>
  ) : (
    <p class="hearth-note">No Hearth design is registered yet.</p>
  )}
<!--/hearth-entry-->
  </div>

  {/* the house's holo expansion, once for the page (test/funding.test.mjs); shown when the stamps slot shows a holo count */}
  <p class="hearth-holo-note" data-hearth-holo hidden>✧ holo is {HOLO_NAME_LINE} It is {HOLO_LINE} — and since 2026-09-17 it spends like any stamp: the word names its source and its ink.</p>

  {SLOT_NAMES.map((name) => (
    <template data-hearth-slot-tpl={name}><HearthSlot name={name} {...slotProps} /></template>
  ))}
</section>

<script>
  import { mountHearth } from "@/lib/hearth/stage.mjs";
  const root = document.querySelector<HTMLElement>("[data-hearth]");
  if (root) mountHearth(root);
</script>
