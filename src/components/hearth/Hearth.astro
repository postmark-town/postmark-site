---
// Hearth — a household's public face, drawn from a registered template with the site's live parts
// in its slots (POS-959, Darko 2026-11-08 15:43 EST: "a), and let's try to get this out as a hotfix").
//
// The Household Hearth sitting ruled the shape (POS-845, 2026-11-01): HTML and CSS in the page, with
// the site's live parts in slots; templates live in the town repo at PROJECTS/household-hearths/,
// submitted by PR; about six approved behaviors. This page is that, whole and small:
//
//   - EVERY HOUSEHOLD HAS ONE: it opens on Postmark's default entry.
//   - ANY REGISTERED ENTRY PREVIEWS ON ANY HOUSEHOLD: `?entry=<id>` (or the signed-in human's picker, in the band). Preview only: it is
//     not saved, nothing is written to the office, and the address is the whole state.
//   - A HOUSEHOLD'S OWN CHOICE (POS-962) is kept by the office and read signed out: lib/hearth/choice.mjs
//     answers which entry to draw (the saved one, else the default), and the picker (HearthPicker.astro, in the
//     site's band: HouseBand.astro) lets the signed-in human save one, behind a second yes. A preview never saves.
//     Visitors see the house's kept choice and no picker.
//   - THE TEMPLATE IS SANITIZED AT BUILD (lib/hearth/sanitize-html.mjs, sanitize-css.mjs): no script, no
//     event handler, no frame, no external load. What is on this page for an entry is what those
//     modules wrote, nothing the template typed.
//   - THE SLOTS ARE THE SITE'S OWN: HearthSlot.astro draws each, the dashboard's reads fill them, and
//     private ones (Needs you, Mail) show only to the house's own sign-in, as on the household page.
//     A template places a slot; it never receives what is in it.
//
// The page is server-rendered with the default entry (so the house's public face is there without a
// script); lib/hearth/stage.mjs then reads the house, paints the live parts, and swaps entries for a preview.
//
// ONE PAGE (POS-984, Darko 2026-11-09 14:34 EST, POS-684 sitting): this is no longer a page of its own. It is the
// house seat of the household page (/households/<slug>/, drawn by town/components/Household.astro), for everyone.
// /households/<slug>/hearth/ forwards there. Which design it draws is lib/hearth/which-design.mjs's answer.
// The site's band for the signed-in human rides in through the `band` slot.
import HearthSlot from "./HearthSlot.astro";
import "./hearth-host.css";
import media from "@/data/postmark/media.json";
import bulletinAll from "@/data/postmark/bulletin.json";
import { residentFace } from "@/lib/household-dashboard/faces.mjs";
import { homePictureOf } from "@/lib/home-picture.mjs";
import { entries } from "@/lib/hearth/registry.mjs";
import { whichDesign } from "@/lib/hearth/which-design.mjs";
import { SLOT_NAMES } from "@/lib/hearth/slots.mjs";
import { HOLO_LINE, HOLO_NAME_LINE } from "@/lib/funding.mjs";

interface Props {
  house: any;
  members: any[];
  plate: string;
}
const { house, members, plate } = Astro.props;
const slug = house.path ?? house.slug ?? "";
// the ONE question the page asks about its design (POS-984): the server draws the design the page opens on, and the
// browser asks the same function for a preview (?entry=)
// BAKED (review of 80af398fb): the build's households.json is the registry GET /households answers, so a house's saved choice (`hearth`, office migration 093)
// is here once the office carries it, and the server draws it: no flash of the default. The browser read (stage.mjs) corrects a stale one.
const entry = whichDesign(entries, { saved: house.hearth ?? null });
const faces = members.map((r) => residentFace(r, media, homePictureOf(r.handle)));
const facesByHandle = Object.fromEntries(faces.map((f) => [f.handle, {
  name: f.name, accent: f.accent, avatar: f.avatar, monogram: f.monogram, windowHung: f.windowHung,
}]));

// the bulletin's open notices, newest first: public, baked, the same file the bulletin page reads
const bulletin = (bulletinAll as any[])
  .filter((b) => b?.data?.status === "open" && b.slug && b.data?.title)
  .sort((a, b) => String(b.data.posted ?? "").localeCompare(String(a.data.posted ?? "")))
  .slice(0, 3)
  .map((b) => ({ slug: String(b.slug), title: String(b.data.title), posted: b.data.posted ? String(b.data.posted) : null }));

const forClient = entries.map((e) => ({ id: e.id, title: e.title, author: e.author, line: e.line, css: e.css, html: e.html }));
const json = (v: unknown) => JSON.stringify(v).split("<").join("\\u003c").split("\u2028").join("\\u2028").split("\u2029").join("\\u2029");
const slotProps = { house, faces, plate, slug, bulletin };
---
<section class="hearth" data-hearth data-hearth-slug={slug} data-hearth-saved={house.hearth ?? ""} aria-label={`${plate}, the Hearth`}>
  <script type="application/json" data-hearth-faces set:html={json({ handles: faces.map((f) => f.handle), faces: facesByHandle })} />
  <script type="application/json" data-hearth-entries set:html={json(forClient)} />

  {/* the site's own band for the house's signed-in human (HouseBand.astro): above the design, outside it, so no
      design can hide or break it. Visitors get its sign-in line only. */}
  <slot name="band" />

  <header class="hearth-bar">
    <h1 class="hd-sr">{plate || "a shared household"}</h1>
    {/* the picker lives in the site's band, for the house's signed-in human (HouseBand.astro, POS-984 folding POS-962): visitors see the house's kept choice, with no picker */}
    <p class="hearth-note" data-hearth-note hidden></p>
  </header>

  {/* THE ENTRY'S REGION, marked for the build's security policy (tools/lib/hearth-csp.mjs): everything an entry
      contributes to this page is between the two comments, and nothing the host runs is. The policy trusts the
      inline scripts OUTSIDE the region and fails the build on any inside it. */}
  {/* THE HOST'S FRAME around the region (POS-984, Truey's review of ba023e9d9): a design's `:root`/`html`/`body` rule is
      rewritten onto its own stage, where a margin or a transform could move the stage up over the band above it, and the
      stage's own `contain: paint` clips its children, not itself. This box clips the stage, and keeps a negative margin
      from collapsing out through it, so the most a design can move is itself, inside its own frame. */}
  <div class="hearth-frame">
<!--hearth-entry-->
  {entry ? (
    <>
      <style is:inline data-hearth-css set:html={entry.css}></style>
      <div class="hearth-stage" data-hearth-stage data-hearth-entry={entry.id} data-hd data-hd-view="public" data-hd-slug={slug}>
        {entry.segments.map((s: any) => s.slot
          ? <HearthSlot name={s.slot} {...slotProps} />
          : <Fragment set:html={s.html} />)}
      </div>
    </>
  ) : (
    <p class="hearth-note">No Hearth design is registered yet.</p>
  )}
<!--/hearth-entry-->
  </div>

  {/* the house's holo expansion, once for the page (test/funding.test.mjs); shown when the stamps slot shows a holo count */}
  <p class="hearth-holo-note" data-hearth-holo hidden>✧ holo is {HOLO_NAME_LINE} It is {HOLO_LINE} — and since 2026-09-17 it spends like any stamp: the word names its source and its ink.</p>

  {SLOT_NAMES.map((name) => (
    <template data-hearth-slot-tpl={name}><HearthSlot name={name} {...slotProps} /></template>
  ))}
</section>

<script>
  import { mountHearth } from "@/lib/hearth/stage.mjs";
  const root = document.querySelector<HTMLElement>("[data-hearth]");
  if (root) mountHearth(root);
</script>
