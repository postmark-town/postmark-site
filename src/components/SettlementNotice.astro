---
// SettlementNotice — a small notice while the World settlement is running late (POS-1004, part 2 of 2).
//
// Darko, 2026-11-11 16:32 EST: "some kind of like temporary exclamation point ... on the site, like an alarm for the settlement
// being delayed." RULED 20:08 EST: "a small notice on the World page and the town's front page, cleared automatically when the
// settlement lands". Wright's 2026-11-12 02:14Z approval: ONE state only. The words are in ONE home, src/lib/sentinel-alert.mjs
// (SETTLEMENT_NOTICE_TEXT), rendered here at build time; the judgment is `settlementNoticeFromBoard` there too.
//
// IT IS HIDDEN BY DEFAULT AND HIDDEN BY ABSENCE. The markup ships `hidden`; the script reveals it only for a readable board no
// more than 20 minutes old whose `settlement` probe reads DOWN, and hides it again the moment a later board says anything else.
// No board, an old board, OK, STALE, UNKNOWN: the same outcome as no markup at all. It reads the board through the shared reader
// (one fetch per page, on load, once a minute while the page is visible, and on return), so the header glyph and this notice
// never ask twice.
//
// A temporary exclamation point, not a banner: one small line, a small mark, no colour block, no close button (it clears itself).
//
// `variant="flow"` sits in the page's own flow (the front page: below the live ticker, above the hero). `variant="over"` floats
// over the World viewer (a layout-less passthrough of the viewer shell: below its top controls, above the view).
import { SETTLEMENT_NOTICE_TEXT } from "@/lib/sentinel-alert.mjs";

const { variant = "flow", origin = "" } = Astro.props;
---
<p class={`sn sn-${variant}`} data-settlement-notice data-sn-origin={origin} role="status" hidden>
  <span class="sn-mark" aria-hidden="true">!</span><span class="sn-text">{SETTLEMENT_NOTICE_TEXT}</span>
</p>

<script>
  // The browser half. Failing silent is the contract: a missing board is the ordinary answer on a dev or local build.
  (async function () {
    const els = document.querySelectorAll("[data-settlement-notice]");
    if (!els.length) return;
    try {
      const { readBoardEvery, settlementNoticeFromBoard } = await import("@/lib/sentinel-alert.mjs");
      for (const el of els) {
        readBoardEvery(el.dataset.snOrigin || "", (board) => { el.hidden = !settlementNoticeFromBoard(board).show; });
      }
    } catch (error) {
      console.debug("pm-settlement-notice: stood down (" + (error && error.message) + ")");
    }
  })();
</script>

<style>
  .sn {
    margin: 0;
    display: flex; align-items: center; justify-content: center; gap: 0.5em;
    font-family: ui-monospace, "SF Mono", Menlo, monospace;
    font-size: 0.74rem; line-height: 1.4; letter-spacing: 0.02em;
    color: #f6dcae;
  }
  .sn[hidden] { display: none; }
  /* the temporary exclamation point: a small wax-gold ring, not a block of colour */
  .sn-mark {
    flex: none; display: inline-flex; align-items: center; justify-content: center;
    width: 1.35em; height: 1.35em; border-radius: 50%;
    border: 1px solid rgba(232, 196, 139, 0.7); color: #e8c48b;
    font-weight: 700; font-size: 0.85em;
  }
  .sn-text { text-wrap: balance; text-align: center; }
  /* the front page: in flow, a quiet line between the ticker and the hero */
  .sn-flow { padding: 8px 14px; background: rgba(20, 23, 29, 0.55); border-bottom: 1px solid rgba(232, 196, 139, 0.16); }
  /* the World: floats over the viewer, UNDER its top controls, never across them. The viewer draws three layouts (its own breakpoints):
       · 721–1160 px   the Telling stacks above the painting and the page scrolls: seat it below the Telling's filter-chip row (chips end ~107 px);
       · 1161 px up    the app frame: the painting is the right column and its search and icon row end ~90 px: seat it under that row, right-aligned,
                       no wider than the painting's column (the Telling is 740 px wide);
       · 720 px down   the painting alone: the top ~170 px is the search, the icon row and the Time travel / by-mail row, and their cards open below
                       at ~174 px, so the notice goes to the foot of the painting, above the elevation pill.
     PAINT ORDER: it is passive (takes no clicks) and sits at z-index 1, under the site's own panels (the Time travel body 8000, the sign-in cluster 9000).
     The viewer's by-mail card, search list and bell menu live INSIDE the painting's own stacking context (.wv-sticky is position:sticky), so no z-index
     can put a notice between the painting and them: the World notice STEPS ASIDE while any of the three is open (the rule below, the same pattern as
     WLD-47's "chrome steps aside for an open list" in world.astro) and returns the moment it closes. The front page's notice never does. */
  .sn-over {
    box-sizing: border-box; position: fixed; top: 118px; left: 12px; right: 12px; margin-inline: auto; width: fit-content; z-index: 1;
    max-width: min(27rem, calc(100vw - 24px)); padding: 6px 14px;
    background: rgba(20, 23, 29, 0.86); border: 1px solid rgba(232, 196, 139, 0.4); border-radius: 999px;
    backdrop-filter: blur(4px); pointer-events: none;
  }
  @media (min-width: 1161px) {
    .sn-over { top: 100px; left: auto; right: 12px; margin-inline: 0; max-width: min(27rem, calc(100vw - 764px)); }
  }
  /* all widths: an open by-mail card, search-results list or bell menu is in front; the notice is hidden for as long as one is open */
  :global(body:has(.wv-bymail.pm-bymail-open:not([hidden]), .wv-search-results:not([hidden]), .wv-bell-menu:not([hidden]))) .sn-over { visibility: hidden; }
  @media (max-width: 720px) {
    .sn-over { top: auto; bottom: 56px; border-radius: 14px; font-size: 0.7rem; }
  }
</style>
