---
// OpsNav.astro — the ops family's shared nav strip, site half.
//
// The ops surface is one family served by two builders: the box GENERATES the
// hub and the dashboards (office tools/*-report.mjs + ops-index.mjs), and the
// site BUILDS the two consoles (/ops/graph/, /ops/desk/). Before this strip,
// the generated half chromed itself with ops-viz's `nav()` pills and the site
// half wore only the town header — the same family, dressed as two.
//
// THE GENERATED HALF IS NEVER IN THIS MARKUP (POS-395). Those pages answer only
// to the operators, so a signed-out reader of the graph is not sent to them:
// the strip renders the site-built half, and the browser adds the generated
// half only when the office's GET /me says `principal: true`. The family lists
// live in src/lib/ops-family.mjs, which carries the office-twin note.
import { OPS_PUBLIC } from "@/lib/ops-family.mjs";

const { here = "" } = Astro.props;
---
<nav class="pm-opsnav" data-opsnav>
  {OPS_PUBLIC.map(([href, name]) => (
    <a href={href} aria-current={href === here ? "page" : undefined}>{name}</a>
  ))}
</nav>
<script>
  import { KEYS, officeBase, tokenIsFresh } from "@/lib/auth.mjs";
  import { OPS_GATED } from "@/lib/ops-family.mjs";

  // The principal's half of the strip, added in the browser and only for them.
  // Any failure leaves the public strip as it is: quiet, never an error.
  (async () => {
    const strips = document.querySelectorAll("[data-opsnav]");
    if (!strips.length) return;
    let tok = null;
    try { tok = JSON.parse(localStorage.getItem(KEYS.token) || "null"); } catch {}
    if (!tokenIsFresh(tok)) return;
    let me;
    try {
      const r = await fetch(officeBase() + "/me", { headers: { accept: "application/json", authorization: "Bearer " + tok.access_token } });
      if (!r.ok) return;
      me = await r.json();
    } catch { return; }
    if (me?.principal !== true) return;
    for (const strip of strips) {
      const first = strip.firstChild;
      for (const [href, name] of OPS_GATED) {
        const a = document.createElement("a");
        a.href = href;
        a.textContent = name;
        strip.insertBefore(a, first);
      }
    }
  })();
</script>
<style>
  /* the same pill grammar ops-viz's `.opsnav` draws on the generated pages,
     in the site's own tokens — one family, one strip */
  .pm-opsnav { display: flex; flex-wrap: wrap; gap: 0.3rem; margin: 0.2rem 0 1rem; }
  .pm-opsnav a {
    text-decoration: none; color: #7b8ba7;
    border: 1px solid rgba(123, 139, 167, 0.24); border-radius: 999px;
    padding: 0.16rem 0.7rem; font-size: 0.72rem; letter-spacing: 0.08em;
    font-family: var(--pm-mono);
  }
  .pm-opsnav a:hover { color: var(--pm-gold-bright); border-color: rgba(232, 196, 139, 0.6); }
  .pm-opsnav a[aria-current="page"] {
    color: #070b15; background: var(--pm-gold, #e8c48b); border-color: var(--pm-gold, #e8c48b);
  }
</style>
