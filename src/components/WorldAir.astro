---
// WorldAir — the air under the map, in the words an agent is told.
//
// One quiet caption over the foot of the map: the air at the ferry landing (the
// Origin, {0,0}) for the crossing the map is showing, and the season's line when
// there is one. Every word is the engine's (world-verbs.mjs § airLine,
// seasonLine), computed in the page from the same record the viewer reads, so
// the caption and the map always name the same crossing: live, or wherever the
// time-travel dial has taken them.
//
// Emitted only while the Mists stand for the crossing this build reflects
// (mists-season.mjs); before that this component renders nothing at all. In the
// page it hides again for any crossing the engine tells no air for.
import { siteMists } from "@/lib/mists-season.mjs";
const mists = siteMists();
// Raw markup, not an Astro <style>: Astro bundles every <style> it compiles,
// rendered or not, and before the Mists the page must be byte for byte what it was.
const STYLE = `
      .pm-air {
        position: fixed; bottom: 64px; z-index: 7000; transform: translateX(-50%);
        width: max-content; padding: 0.7em 1em 0.75em; border-radius: 12px;
        background: rgba(13, 20, 38, 0.82); border: 1px solid rgba(183, 190, 200, 0.28);
        box-shadow: 0 8px 26px rgba(0, 0, 0, 0.45);
        font-family: var(--pm-serif, Georgia, serif); color: #d9d2c2;
        pointer-events: none;
      }
      .pm-air-kicker {
        margin: 0 0 0.45em; font: 0.58rem/1.3 var(--pm-mono, ui-monospace, monospace);
        letter-spacing: 0.16em; text-transform: uppercase; color: rgba(183, 190, 200, 0.75);
      }
      .pm-air-kicker b { color: #e8e0cf; font-weight: 600; }
      .pm-air-line { margin: 0; font-size: 0.86rem; line-height: 1.5; font-style: italic; }
      .pm-air-season { margin: 0.5em 0 0; font-size: 0.86rem; line-height: 1.5; color: #e8e0cf; }
      @media (max-width: 40rem) { .pm-air { bottom: 76px; font-size: 0.8em; } }
      html[data-pmc-dock] .pm-air { display: none; }
`;
---
{mists && (
  <>
    <aside class="pm-air" data-pm-air hidden aria-label="The air at the ferry landing">
      <p class="pm-air-kicker">the air at the ferry landing · crossing <b data-pm-air-n></b></p>
      <p class="pm-air-line" data-pm-air-line></p>
      <p class="pm-air-season" data-pm-air-season hidden></p>
    </aside>
    <script is:inline>
      (function () {
        var box = document.querySelector("[data-pm-air]");
        if (!box) return;
        var nEl = box.querySelector("[data-pm-air-n]");
        var lineEl = box.querySelector("[data-pm-air-line]");
        var seasonEl = box.querySelector("[data-pm-air-season]");
        var json = function (u) { return fetch(u).then(function (r) { return r.ok ? r.json() : null; }); };
        // the same record and the same engine the viewer reads, same-origin
        var ready = Promise.all([
          json("/WORLD/world-state.json"), json("/WORLD/skeleton.json"),
          import("/world-engine/tools/world-build.mjs"), import("/world-engine/tools/world-verbs.mjs"),
          import("/world-engine/tools/world-engine.mjs"),
        ]).then(function (a) {
          if (!a[0] || !a[1] || !a[3].airLine) return null;
          return { skeleton: a[1], world: a[2].assembleWorld({ worldState: a[0], skeleton: a[1] }), verbs: a[3], engine: a[4] };
        }).catch(function () { return null; });
        var shown = null;
        function place() {
          var map = document.querySelector(".wv-map");
          var r = map && map.getBoundingClientRect();
          if (!r || !r.width) return;
          box.style.left = (r.left + r.width / 2) + "px";
          box.style.maxWidth = Math.max(220, Math.min(560, r.width - 32)) + "px";
        }
        function tick() {
          var b = document.querySelector(".crossnow b");
          var n = b ? Number(b.textContent) : NaN;
          place();
          if (!Number.isInteger(n) || n === shown) return;
          shown = n;
          ready.then(function (k) {
            if (!k || shown !== n) return;
            var m = k.engine.mistsAt(n, k.skeleton.mists);
            var air = m ? k.verbs.airLine(k.verbs.orient({ x: 0, y: 0, name: "the ferry landing" }, k.world, { crossing: n }).you, n) : null;
            if (!air) { box.hidden = true; return; }
            var season = k.verbs.seasonLine(m, n);
            var weather = season && air.slice(-season.length) === season ? air.slice(0, -season.length).trim() : air;
            nEl.textContent = String(n);
            lineEl.textContent = weather;
            seasonEl.textContent = season || "";
            seasonEl.hidden = !season;
            box.hidden = false;
          });
        }
        tick();
        setInterval(tick, 1000);
        window.addEventListener("resize", place);
      })();
    </script>
    <Fragment set:html={`<style>${STYLE}</style>`} />
  </>
)}
