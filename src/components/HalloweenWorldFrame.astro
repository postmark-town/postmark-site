---
// HalloweenWorldFrame — the World page's frame in the season's skin (POS-553):
// the rail, the telling and the controls take the palette through the viewer's
// own .wv tokens, at the same strength as the rest of the site this release.
// The map is not touched; the Mists are the map's own.
import { siteMists } from "@/lib/mists-season.mjs";
import { VARIANTS, worldFrameCSS } from "@/lib/halloween-skin.mjs";
const SKIN_MAX = 0.5;   // as HalloweenSkin's, this release
const mists = siteMists();
const k = mists ? Math.min(SKIN_MAX, 0.25 + 0.75 * mists.t) : 0;
const HTML = !mists ? "" : `<style>${worldFrameCSS(VARIANTS[2], k)}</style>`;
---
{HTML && <Fragment set:html={HTML} />}
