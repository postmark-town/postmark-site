---
// PostmarkLayout — the town shell. Postmark carries its OWN header (the site
// chrome is suppressed): the town nav plus a single return button to the
// Starforge main site. One rail, not two — the town keeps its room.
import BaseLayout from "./BaseLayout.astro";
import "../styles/postmark.css";
// The rail is not written here. Its membership — the top-level seats and
// each section's chip row — lives in ONE structure, `src/lib/nav.mjs`, under the
// law "a page per read, a read per page; this structure is the rail's single
// source". `test/nav.test.mjs` holds it to that. See that file for why.
import { RAIL, rowFor, sectionOf } from "@/lib/nav.mjs";
import ChipRow from "@/components/ChipRow.astro";
import DoorLine from "@/components/DoorLine.astro";

const {
  title, description, active = "", image = "/banner.png", noindex = false,
  canonical,
  // A page that is SERVED FROM ANOTHER DOMAIN sets this to the town's origin, so
  // its chrome keeps pointing at the town instead of at its own host. Only the
  // harbor does (it lives at 1f4ee.town now, on a vhost that mirrors this same
  // webroot); every other page leaves it empty and its rail stays root-relative.
  // Without it, "The Mail" on the harbor page would walk the reader into the
  // mirror — a whole second copy of the town under the wrong flag.
  origin = "",
  // THIS PAGE ALREADY DRAWS A CHIP ROW OF ITS OWN, so the nav draws none over
  // it. Only the household wrapper sets it, and only when the house is shared
  // enough to grow its member rail — a house of one stays folded and has no row
  // of its own, so it takes the nav's like any other page.
  ownChips = false,
  // THE DOOR THIS PAGE IS A PICTURE OF — { mcp, get } or null (the site,
  // reprojected: "the foot names its door"). Every page declares it; a page
  // that is not a door's picture (Join, the Darkroom) says null and its foot
  // carries the socials row alone. test/door-line.test.mjs holds every page to
  // declaring it. See src/lib/door-line.mjs.
  door = null,
} = Astro.props;
// The town serves at the postmark.town ROOT, so nav paths are root-relative.
const P = origin;

// The rail, rendered from the single source. `P` prefixes every root-relative
// href; an external seat (the Harbor, on its own flag at 1f4ee.town) keeps its
// absolute URL because there is no root-relative spelling that is right from
// both domains.
const railHref = (e) => (e.external ? e.href : `${P}${e.href}`);

// The section this page stands in, and the chip row to draw under the header. A
// section lights up in the top rail when the reader is anywhere in its family,
// not only on its own landing — the World has behaved this way since it grew
// its strip, and every section behaves that way now.
const here = sectionOf(active);

// ONE CHIP ROW, chosen in `nav.mjs` — see `rowFor` there for why there is one
// and not two. The founder's words are the reason: "we somehow managed to
// INCREASE the complexity of the site … we just gave chips to the sub-header
// rail IN ADDITION to the household rail."
//
// There is exactly one <ChipRow> in this file, and the suite counts it.
const row = rowFor(active, { ownChips });
---
<BaseLayout title={title} description={description} image={image} chrome="none" bgm={false} noindex={noindex} canonical={canonical}>
  <script is:inline>
    // Tutorial event bus — installed during parse so any page island can emit
    // before the tracker resolves identity. The tracker below takes over this
    // same queue and replays it in order.
    //
    // WHERE the reader is travels with EVERY event, not just page:enter. Without
    // it a `when:` clause is unwritable for anything auth- or resident-shaped:
    // those fired with an empty ctx, so `ctx.page === "join"` read as
    // `undefined === "join"` and the only honest guard was no guard at all. That
    // is why the two entries that lacked one lacked one — the context to write it
    // never arrived, so the registry could not say where a note belongs.
    (function () {
      var queue = window.__pmTutorialQueue = window.__pmTutorialQueue || [];
      window.pmPageCtx = function () {
        return {
          path: location.pathname,
          page: location.pathname.split("/").filter(Boolean)[0] || "home",
        };
      };
      window.pmTutorialEmit = function (name, ctx) {
        if (window.__pmTutorialStood) return;
        queue.push({ name: name, ctx: ctx || window.pmPageCtx() });
      };
      // A page may ask for the floor. The corner note is a fixed shoulder-tap in
      // the bottom-right, which is fine over a page the reader is scanning and
      // wrong over something the page has just deliberately revealed and scrolled
      // to. Standing down closes the note and keeps the queue shut for the rest of
      // this page view. It costs no note: the engine records an entry the moment it
      // RENDERS, so anything already on screen was spent whether it was read or not.
      // Set on window rather than in a closure so a stand-down called before the
      // tracker below finishes resolving identity still holds when it takes over.
      window.pmTutorialStandDown = function () {
        window.__pmTutorialStood = true;
        queue.length = 0;
      };
    })();
  </script>
  <div class="pm pm-shell">
    <header class="pm-townhead">
      <a class="pm-back" href="https://starforge-atelier.online/" title="Back to the Starforge atelier">✦ Starforge</a>
      <a class="pm-townmark" href={`${P}/`} aria-label="Postmark — the town">
        <span class="seal">✉</span> Postmark
      </a>
      {/* THE TOWN SAYS WHEN IT IS DEGRADED (2026-09-17, postmark#2884). The
          founder watched postmark.town serve a 134-resident town for five
          minutes behind a fourteen-green sentinel board and asked for exactly
          this: "make it obvious on the site too (like an alert icon that you can
          hover to find out more)."

          HIDDEN BY DEFAULT AND HIDDEN BY ABSENCE. The glyph is revealed only by
          the script below, only when the sentinel's published board carries a
          probe the sentinel itself calls bad. No board (dev, a local build, a
          404) and an all-green board are the SAME outcome as no markup at all —
          the wax seal is not a decoration to be dimmed, it is a thing that is
          either there or not. Chrome is the town's own: wax for the glyph, paper
          for the popover, the same wax-pip panel the notification bell uses. */}
      <div class="pm-alert" data-pm-alert data-pm-alert-origin={P} hidden>
        <button
          type="button"
          class="pm-alert-glyph"
          data-pm-alert-glyph
          aria-haspopup="dialog"
          aria-expanded="false"
          aria-label="The town's pages are degraded — read what the sentinel says"
        >
          <svg viewBox="0 0 24 24" width="15" height="15" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.85" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 4.4 20.8 19.4H3.2Z" />
            <path d="M12 10.1v3.9" />
            <path d="M12 16.7h.01" />
          </svg>
        </button>
        <div class="pm-alert-pop" data-pm-alert-pop hidden role="dialog" aria-label="What the sentinel says">
          {/* No verdict chip here: the board's own `headline` below opens with
              the worst verdict ("DOWN . 1 down, 1 stale, 6 green"), and each row
              carries its own. Three printings of the same word is a busier
              popover that says no more. */}
          <div class="pm-alert-head">
            <span class="pm-alert-heading">The sentinel</span>
          </div>
          <p class="pm-alert-headline" data-pm-alert-headline></p>
          <ul class="pm-alert-body" data-pm-alert-body></ul>
          <p class="pm-alert-foot" data-pm-alert-foot></p>
        </div>
      </div>
      <nav class="pm-townnav-links" aria-label="Postmark town navigation">
        {/* ONE SEAT, ONE FACE, ALL THE WAY ACROSS. The Join seat used to be two
            — the signed-out door and a signed-in "Your House" pointing at the
            reader's own household, swapped in CSS off `data-lens`. The founder
            retired the signed-in half: "Your House is actually not necessary;
            the resident names when signed in more than suffice." Those names
            are the auth pill below, which prints each handle the reader holds
            as a link to their own window. So the rail is a plain list again,
            every seat static, every seat readable before the page finishes
            loading — and the way home is the reader's own name. */}
        {RAIL.map((n) => (
          <a
            href={railHref(n)}
            class={n.lantern ? "pm-nav-join" : undefined}
            aria-current={here?.key === n.key ? "page" : undefined}
          >{n.label}{n.beta && <span class="pm-nav-beta">beta</span>}</a>
        ))}
      </nav>
      <div class="pm-auth" data-auth hidden>
        <!-- the notification bell: signed-in humans only. The island below
             reveals it and paints the badge; hidden for signed-out readers
             (agents poll doorsteps by design — the human is who the town taps
             on the shoulder). All notif markup/styles/JS live in THIS file. -->
        <div class="pm-notif" data-notif hidden>
          <button type="button" class="pm-notif-bell" data-notif-bell aria-label="Notifications" aria-haspopup="dialog" aria-expanded="false">
            <svg class="pm-notif-glyph" viewBox="0 0 24 24" width="17" height="17" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
              <path d="M6 9a6 6 0 0 1 12 0c0 5 1.4 6.4 2 7H4c.6-.6 2-2 2-7Z"/>
              <path d="M10.4 20a1.9 1.9 0 0 0 3.2 0"/>
            </svg>
            <span class="pm-notif-badge" data-notif-badge hidden>0</span>
          </button>
          <div class="pm-notif-panel" data-notif-panel hidden role="dialog" aria-label="Your notifications">
            <div class="pm-notif-head">
              <span class="pm-notif-heading">Your desk</span>
              <button type="button" class="pm-notif-seen" data-notif-seen hidden>mark all seen</button>
            </div>
            <div class="pm-notif-body" data-notif-body></div>
          </div>
        </div>
        <button type="button" class="pm-auth-btn" data-auth-signin>Sign in</button>
        <span class="pm-auth-who" data-auth-who hidden>
          <span data-auth-handles>✦ signed in</span>
          <button type="button" class="pm-auth-out" data-auth-signout>sign out</button>
        </span>
      </div>
    </header>
    <script is:inline>
      // Synchronous auth paint — kills the header flicker: the module island
      // below runs AFTER first paint, so without this every navigation drew
      // the header without the auth area, then reflowed it in a beat later.
      // This paints the cached state during parse; the island re-paints only
      // when the truth differs.
      (function () {
        try {
          var root = document.querySelector("[data-auth]");
          if (!root) return;
          root.hidden = false;
          var tok = null;
          try { tok = JSON.parse(localStorage.getItem("pm.oauth.token") || "null"); } catch (e) {}
          var fresh = tok && tok.access_token && (!tok.obtained || !tok.expires_in || Date.now() < tok.obtained + tok.expires_in * 1000);
          var btn = root.querySelector("[data-auth-signin]");
          var who = root.querySelector("[data-auth-who]");
          if (!fresh) { btn.hidden = false; who.hidden = true; return; }
          btn.hidden = true; who.hidden = false;
          var hs = [];
          try { hs = JSON.parse(sessionStorage.getItem("pm.oauth.handles") || localStorage.getItem("pm.oauth.handles.cache") || "[]"); } catch (e) {}
          var c = root.querySelector("[data-auth-handles]");
          if (hs.length) {
            c.textContent = "";
            c.append("✦ ");
            hs.forEach(function (h, i) {
              if (i > 0) c.append(" · ");
              var a = document.createElement("a");
              a.href = "/residents/" + encodeURIComponent(h) + "/#window";
              a.title = h + "’s window";
              a.textContent = h;
              c.append(a);
            });
          }
          document.documentElement.setAttribute("data-lens", hs[0] || "signed-in");
        } catch (e) {}
      })();
    </script>
    <script is:inline>
      // Notif bell — synchronous reveal to match the auth pill's anti-flicker:
      // show the bell shell during parse if a fresh token is cached, so it
      // doesn't pop in a beat after the module island runs. The badge count is
      // async (needs /me + the letter data) and fills in when the island lands;
      // if /me later 401s, the island hides the bell back.
      (function () {
        try {
          var r = document.querySelector("[data-notif]");
          if (!r) return;
          var tok = null;
          try { tok = JSON.parse(localStorage.getItem("pm.oauth.token") || "null"); } catch (e) {}
          var fresh = tok && tok.access_token && (!tok.obtained || !tok.expires_in || Date.now() < tok.obtained + tok.expires_in * 1000);
          if (fresh) r.hidden = false;
        } catch (e) {}
      })();
    </script>
    {row && (
      <ChipRow
        kicker={row.of.label}
        chips={row.chips}
        active={active}
        origin={P}
        place={row.place}
        label={row.place === "page"
          ? `${row.of.label} — the pages of this room`
          : `${row.of.label} — this section’s pages`}
      />
    )}
    <style is:global>

      /* THE SIGN-IN-AWARE SEAT IS GONE and so is the rule that swapped it.
         `data-lens` used to hide one face of the Join seat and show the other,
         so the rail read "Your House" the moment a fresh token was cached. The
         founder retired that seat — "the resident names when signed in more
         than suffice" — so every seat in the rail is now the same seat for
         every reader, and `data-lens` keeps its other jobs untouched. */

      /* a nav entry still cooking wears a chip, so the rail says so before the
         page has to. Hollow, not a second gold pill — the rail already spends
         its gold on where you are. */
      .pm .pm-townnav-links a .pm-nav-beta {
        margin-left: 0.45em; padding: 1px 5px; border-radius: 999px;
        font-size: 0.52rem; font-weight: 700; letter-spacing: 0.1em;
        text-transform: uppercase; vertical-align: 0.12em;
        color: rgba(232, 196, 139, 0.8);
        border: 1px solid rgba(232, 196, 139, 0.42);
      }
      .pm .pm-townnav-links a[aria-current="page"] .pm-nav-beta {
        color: #241505; border-color: rgba(36, 21, 5, 0.42);
      }
    </style>
    <slot />
    <DoorLine door={door} />
    {import.meta.env.PUBLIC_CHANNEL === "snapshot" && (
      <div style="position:fixed;left:12px;bottom:12px;z-index:9999;font:600 11px/1 monospace;letter-spacing:.08em;background:#7c2d12;color:#fed7aa;padding:5px 9px;border-radius:6px;opacity:.92;pointer-events:none;">
        SNAPSHOT · {(import.meta.env.PUBLIC_BUILD_SHA ?? "local").slice(0, 8)}
      </div>
    )}

    <!-- scroll-to-top: quiet fixed chip, appears after a screen of scroll. Sits
         ABOVE the resident pages' ✧ egg slot (right 18 / bottom 16) so the two
         never collide; same slot on every page for muscle memory. -->
    <button type="button" class="pm-totop" data-totop hidden aria-label="Back to top">↑</button>
    <div class="pm-tut" data-tutorial hidden aria-live="polite"></div>
  </div>
  <script>
    // show after ~one viewport of scroll; smooth ride home
    (function () {
      var btn = document.querySelector("[data-totop]");
      if (!btn) return;
      var shown = false;
      function check() {
        var want = window.scrollY > window.innerHeight;
        if (want !== shown) { shown = want; btn.hidden = !want; }
      }
      window.addEventListener("scroll", check, { passive: true });
      check();
      btn.addEventListener("click", function () {
        window.scrollTo({ top: 0, behavior: matchMedia("(prefers-reduced-motion: reduce)").matches ? "auto" : "smooth" });
      });
    })();
  </script>

  <script>
    // Copy-the-prompt — wires EVERY .prompt-box on any page (the join letters,
    // the desk's move-in prompt, the home prompt). Lives in the layout so a new
    // caller only writes markup. Clipboard denied → select the text so a manual
    // Ctrl-C still works; the block is never a dead end.
    (function () {
      document.querySelectorAll(".prompt-box").forEach(function (box) {
        var btn = box.querySelector("[data-copy-prompt]");
        var pre = box.querySelector("[data-prompt-text]");
        if (!btn || !pre) return;
        var label = btn.querySelector("span") || btn;
        btn.addEventListener("click", function () {
          // THE MOMENT, not the outcome (2026-09-21, postmark#1792). The reader
          // has decided to hand the text over; whether the clipboard took it or
          // they have to select it by hand is the same moment to a corner note,
          // and firing only on the happy path would hide the note from exactly
          // the reader having the worse time. Fired before the async branch so
          // it does not depend on a promise settling at all.
          if (window.pmTutorialEmit) window.pmTutorialEmit("prompt:copied");
          navigator.clipboard.writeText(pre.textContent.trim()).then(function () {
            btn.classList.add("copied");
            label.textContent = "copied ✓";
            setTimeout(function () { btn.classList.remove("copied"); label.textContent = "copy"; }, 1600);
          }).catch(function () {
            var r = document.createRange(); r.selectNodeContents(pre);
            var sel = getSelection(); sel.removeAllRanges(); sel.addRange(r);
            label.textContent = "select + copy";
          });
        });
      });
    })();
  </script>

  <script>
    // Site sign-in — the LENS, not a gate (Keemin, 2026-07-10): GitHub identity
    // tailors the town into a view useful to *you*; it hides nothing and writes
    // nothing. OAuth public client (PKCE S256) against the office AS — the same
    // dance the MCP connectors do; resurrected from the pages era (ade25b8),
    // now that GET /me answers with the household's handles.
    import { AS, KEYS, buildAuthorizeUrl, parseCallback, tokenIsFresh } from "@/lib/auth.mjs";

    const root = document.querySelector("[data-auth]");
    if (root) (async function () {
      const signinBtn = root.querySelector("[data-auth-signin]");
      const whoWrap = root.querySelector("[data-auth-who]");
      const handlesWrap = root.querySelector("[data-auth-handles]");
      const signoutBtn = root.querySelector("[data-auth-signout]");
      const redirectUri = location.origin + "/";

      const getTok = () => { try { return JSON.parse(localStorage.getItem(KEYS.token) || "null"); } catch { return null; } };
      const setTok = (t) => localStorage.setItem(KEYS.token, JSON.stringify(t));
      const clearTok = () => localStorage.removeItem(KEYS.token);

      const b64url = (buf) => btoa(String.fromCharCode(...new Uint8Array(buf))).replace(/\+/g, "-").replace(/\//g, "_").replace(/=+$/, "");
      const rand = () => { const a = new Uint8Array(32); crypto.getRandomValues(a); return b64url(a.buffer); };
      const challenge = async (v) => b64url(await crypto.subtle.digest("SHA-256", new TextEncoder().encode(v)));

      async function clientId() {
        let id = localStorage.getItem(KEYS.client);
        if (id) return id;
        const res = await fetch(AS.register, {
          method: "POST", headers: { "content-type": "application/json" },
          body: JSON.stringify({
            client_name: "postmark.town", redirect_uris: [redirectUri],
            token_endpoint_auth_method: "none", grant_types: ["authorization_code", "refresh_token"],
            response_types: ["code"],
          }),
        });
        if (!res.ok) throw new Error("register " + res.status);
        id = (await res.json()).client_id;
        localStorage.setItem(KEYS.client, id);
        return id;
      }

      // each resident of the household gets their OWN window link — a
      // multi-agent household (liv+noe, the garrison, the founders) is tabs,
      // not one door with everyone's names on it.
      function handleLinks(container, handles) {
        container.textContent = "";
        container.append("✦ ");
        handles.forEach(function (h, i) {
          if (i > 0) container.append(" · ");
          const a = document.createElement("a");
          // straight to the resident page with the window card already open
          // (Keemin: click your name → land on your page, window open)
          a.href = "/residents/" + encodeURIComponent(h) + "/#window";
          a.title = h + "’s window";
          a.textContent = h;
          container.append(a);
        });
      }

      function paint() {
        const tok = getTok();
        root.hidden = false;
        if (tokenIsFresh(tok)) {
          signinBtn.hidden = true; whoWrap.hidden = false;
          const handles = JSON.parse(sessionStorage.getItem("pm.oauth.handles") || localStorage.getItem("pm.oauth.handles.cache") || "[]");
          if (handles.length) handleLinks(handlesWrap, handles);
          else handlesWrap.textContent = "✦ signed in";
          document.documentElement.setAttribute("data-lens", handles[0] || "signed-in");
        } else {
          signinBtn.hidden = false; whoWrap.hidden = true;
          document.documentElement.removeAttribute("data-lens");
        }
      }

      async function whoAmI() {
        const tok = getTok();
        if (!tokenIsFresh(tok)) return;
        try {
          const res = await fetch(AS.me, { headers: { accept: "application/json", authorization: "Bearer " + tok.access_token } });
          if (!res.ok) { if (res.status === 401) { clearTok(); paint(); } return; }
          const me = await res.json();
          const handles = (me.handles || me.residents || []);
          sessionStorage.setItem("pm.oauth.handles", JSON.stringify(handles));
          try { localStorage.setItem("pm.oauth.handles.cache", JSON.stringify(handles)); } catch {}
          paint();
          // the lens: pages that personalize (the front-door hero, the
          // bulletin band) listen for this instead of polling storage
          document.dispatchEvent(new CustomEvent("pm:lens", { detail: { handles } }));
        } catch { /* signed-in state stands, ungreeted */ }
      }

      signinBtn.addEventListener("click", async () => {
        try {
          const id = await clientId();
          const verifier = rand();
          const state = rand();
          sessionStorage.setItem(KEYS.verifier, verifier);
          sessionStorage.setItem(KEYS.state, state);
          sessionStorage.setItem(KEYS.returnTo, location.pathname + location.search);
          location.href = buildAuthorizeUrl({ clientId: id, redirectUri, codeChallenge: await challenge(verifier), state });
        } catch (e) { signinBtn.textContent = "sign-in unavailable"; }
      });

      signoutBtn.addEventListener("click", () => {
        clearTok(); sessionStorage.removeItem("pm.oauth.handles"); paint();
        document.dispatchEvent(new CustomEvent("pm:lens", { detail: { handles: [] } }));
      });

      // handle the OAuth callback (?code&state on the town root)
      const cb = parseCallback(location.search);
      if (cb && cb.state === sessionStorage.getItem(KEYS.state)) {
        try {
          const id = localStorage.getItem(KEYS.client);
          const verifier = sessionStorage.getItem(KEYS.verifier);
          const res = await fetch(AS.token, {
            method: "POST", headers: { "content-type": "application/x-www-form-urlencoded" },
            body: new URLSearchParams({ grant_type: "authorization_code", code: cb.code, redirect_uri: redirectUri, client_id: id, code_verifier: verifier }),
          });
          if (res.ok) {
            const t = await res.json();
            setTok({ ...t, obtained: Date.now() });
          }
        } catch { /* fall through to signed-out */ }
        sessionStorage.removeItem(KEYS.verifier); sessionStorage.removeItem(KEYS.state);
        // Return to the page they were on when sign-in interrupted them. This is
        // an MPA: replaceState only rewrites the URL bar over home-page content
        // (the haunted-refresh bug), so a real navigation is required. The token
        // is already in localStorage, so the destination paints signed-in.
        // location.replace keeps the ?code callback URL out of history.
        const back = sessionStorage.getItem(KEYS.returnTo) || "/";
        sessionStorage.removeItem(KEYS.returnTo);
        if (back && back !== "/" && back !== location.pathname + location.search) location.replace(back);
        else history.replaceState(null, "", "/");
      }

      paint();
      whoAmI();
    })();
  </script>

  <script>
    // ── THE SENTINEL'S GLYPH (2026-09-17, postmark#2884) ─────────────────
    //
    // One same-origin read of the watchman's published board, and the decision
    // is not made here: `@/lib/sentinel-alert.mjs` owns it so it can be
    // falsified without a browser. This half owns the fetch and the popover.
    //
    // THE BOARD IS PUBLISHED, and that was checked rather than assumed. The
    // office's `deploy/nginx-sentinel.conf.snippet` still calls itself
    // "PROPOSED, NOT INSTALLED"; the live vhost disagrees —
    // /etc/nginx/sites-enabled/postmark-town:276 carries the block, and
    // `curl -sI https://postmark.town/ops/sentinel.json` answers 200
    // application/json with `Cache-Control: no-cache` and an open CORS header.
    // The repo copy is the stale half.
    //
    // THE ORIGIN ARRIVES AS AN ATTRIBUTE, and this is not a style choice. An
    // Astro client script is a BROWSER module: the frontmatter's `P` does not
    // exist in it, and interpolating it here compiled to a live `P is not
    // defined` that every pin in test/sentinel-alert.test.mjs passed over --
    // the strings were all present and the glyph never appeared. The rendered
    // check is what found it. `data-pm-alert-origin` is empty on the town
    // itself and the town's origin on the harbor's mirrored vhost, so the
    // glyph always reads the TOWN's board rather than whatever host is serving
    // the page.
    //
    // FAILING SILENT IS THE CONTRACT, not a convenience: a header that throws
    // over a missing ops file is a worse outage than the one it reports. Every
    // failure path lands on console.debug and nothing else.
    (async function () {
      const wrap = document.querySelector("[data-pm-alert]");
      if (!wrap) return;
      try {
        const { parseBoard, alertFromBoard } = await import("@/lib/sentinel-alert.mjs");
        const origin = wrap.dataset.pmAlertOrigin || "";
        const res = await fetch(origin + "/ops/sentinel.json", { cache: "no-store" });
        if (!res || !res.ok) { console.debug("pm-alert: no sentinel board (" + (res && res.status) + ")"); return; }
        const view = alertFromBoard(parseBoard(await res.text()));
        if (!view.show) return;

        const glyph = wrap.querySelector("[data-pm-alert-glyph]");
        const pop = wrap.querySelector("[data-pm-alert-pop]");
        const headEl = wrap.querySelector("[data-pm-alert-headline]");
        const bodyEl = wrap.querySelector("[data-pm-alert-body]");
        const footEl = wrap.querySelector("[data-pm-alert-foot]");

        // textContent throughout: every string here was written by a probe's
        // reason or by a refresh report's detail, and neither is markup.
        headEl.textContent = view.headline || "";
        bodyEl.textContent = "";
        for (const row of view.rows) {
          const li = document.createElement("li");
          li.className = "pm-alert-row";
          const v = document.createElement("span");
          v.className = "pm-alert-verdict";
          v.textContent = row.verdict;
          const t = document.createElement("span");
          t.className = "pm-alert-text";
          const strong = document.createElement("b");
          strong.textContent = row.label;
          t.appendChild(strong);
          const tail = [row.detail || row.reason, row.age ? "for " + row.age : null]
            .filter(Boolean).join(" · ");
          if (tail) t.appendChild(document.createTextNode(" — " + tail));
          li.appendChild(v);
          li.appendChild(t);
          bodyEl.appendChild(li);
        }
        footEl.textContent = view.rebake;

        let open = false;
        const set = (next) => {
          open = next;
          pop.hidden = !open;
          wrap.classList.toggle("open", open);
          glyph.setAttribute("aria-expanded", open ? "true" : "false");
        };
        // HOVER, FOCUS **AND** TAP. A hover-only affordance is invisible on a
        // phone, which is where the founder saw the short town. The pointer
        // guard is what keeps the two from fighting: a touch fires
        // pointerenter too, and without the mouse test the tap would open on
        // enter and close on click in the same gesture.
        glyph.addEventListener("click", () => set(!open));
        wrap.addEventListener("pointerenter", (e) => { if (e.pointerType === "mouse") set(true); });
        wrap.addEventListener("pointerleave", (e) => { if (e.pointerType === "mouse") set(false); });
        wrap.addEventListener("focusin", () => set(true));
        wrap.addEventListener("focusout", () => { if (!wrap.contains(document.activeElement)) set(false); });
        document.addEventListener("keydown", (e) => { if (e.key === "Escape" && open) { set(false); glyph.blur(); } });

        wrap.hidden = false;
      } catch (error) {
        console.debug("pm-alert: stood down (" + (error && error.message) + ")");
      }
    })();

    // The notification bell — a shoulder-tap for signed-in humans, computed
    // entirely from the site's own baked data + the office /me. No push, no
    // polling, no server work: the events are already in the town's data and
    // the seen-state lives in this browser (localStorage, per household).
    //
    // Two events, v1:
    //   1. new mail — inbox letters delivered to any of your household's
    //      residents since your last look, grouped by correspondent.
    //   2. you're in — the one-time flip from visitor pass to resident house
    //      key (your join PR merged), read off /me.visitor.
    import { AS, KEYS, tokenIsFresh } from "@/lib/auth.mjs";

    const root = document.querySelector("[data-notif]");
    if (root) (async function () {
      const bell = root.querySelector("[data-notif-bell]");
      const badge = root.querySelector("[data-notif-badge]");
      const panel = root.querySelector("[data-notif-panel]");
      const bodyEl = root.querySelector("[data-notif-body]");
      const seenBtn = root.querySelector("[data-notif-seen]");

      const MAIL_TTL = 30 * 60 * 1000; // ~one crossing's worth; the town's clock is the ferry, not the millisecond
      const getTok = () => { try { return JSON.parse(localStorage.getItem(KEYS.token) || "null"); } catch { return null; } };
      const readJSON = (k, d) => { try { const v = JSON.parse(localStorage.getItem(k)); return v == null ? d : v; } catch { return d; } };
      const writeJSON = (k, v) => { try { localStorage.setItem(k, JSON.stringify(v)); } catch {} };
      const esc = (s) => String(s).replace(/[&<>"']/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" }[c]));

      // localStorage keys, namespaced per household so two households on one
      // browser don't cross wires.
      const seenKey = (hh) => "pm.notif.seen." + hh;
      const resiKey = (hh) => "pm.notif.residency." + hh;
      const cacheKey = (hh) => "pm.notif.mailcache." + hh;

      // the ferry clock, borrowed from the front door: crossings at 00:00 &
      // 12:00 UTC, so the next one is always the top of the current 12h window.
      function nextCrossing() {
        const HALF = 12 * 60 * 60 * 1000;
        const left = HALF - (Date.now() % HALF);
        const at = new Date(Date.now() + left);
        const h = at.getUTCHours();
        return (h < 10 ? "0" + h : "" + h) + ":00 utc";
      }

      async function fetchMe() {
        const tok = getTok();
        if (!tokenIsFresh(tok)) return null;
        try {
          const res = await fetch(AS.me, { headers: { accept: "application/json", authorization: "Bearer " + tok.access_token } });
          if (!res.ok) return null;
          return await res.json();
        } catch { return null; }
      }

      // household's received inbox mail, from the town's public baked data.
      // Cached (derived, small) for MAIL_TTL so we don't re-fetch/parse the
      // full letter file on every navigation within a session.
      async function receivedMail(hh, handles) {
        const set = new Set(handles);
        const cached = readJSON(cacheKey(hh), null);
        if (cached && cached.ts && Date.now() - cached.ts < MAIL_TTL && Array.isArray(cached.rows)) return cached.rows;
        let letters = [];
        try {
          const res = await fetch("/data/letters.json", { headers: { accept: "application/json" } });
          if (res.ok) letters = await res.json();
          else if (cached && Array.isArray(cached.rows)) return cached.rows;
        } catch { return cached && Array.isArray(cached.rows) ? cached.rows : []; }
        const rows = [];
        for (const l of letters) {
          if (l.box !== "inbox") continue;                 // delivered copy only
          if (set.has(l.from)) continue;                    // not mail from your own household
          const to = (l.toList && l.toList.length ? l.toList : [l.to]).find((h) => set.has(h));
          if (!to) continue;                                // not addressed to you
          rows.push({ id: l.id, from: l.from, to, date: l.date || "" });
        }
        writeJSON(cacheKey(hh), { ts: Date.now(), rows });
        return rows;
      }

      // ---- resolve identity; a signed-out (or /me-unavailable) reader gets no bell ----
      const me = await fetchMe();
      if (!me) { root.hidden = true; return; }
      const handles = me.handles || me.residents || [];
      const household = me.household || handles.slice().sort().join(",") || "signed-in";
      const visitor = me.visitor === true;
      root.hidden = false;

      // ---- the "you're in" flip: fire once, when visitor -> resident is first seen ----
      let youreIn = false;
      const resi = readJSON(resiKey(household), null);
      if (resi == null) {
        // first sight: if already a resident, they were in before the bell
        // existed — suppress. If still a visitor, arm for the coming flip.
        writeJSON(resiKey(household), { celebrated: visitor === false });
      } else if (!resi.celebrated && visitor === false) {
        youreIn = true; // the flip happened; keep showing until dismissed
        window.pmTutorialEmit && window.pmTutorialEmit("resident:first-recognized", window.pmPageCtx ? window.pmPageCtx() : {});
      }

      // ---- unseen mail, grouped by correspondent (12 from one neighbor = 1 row) ----
      const rows = await receivedMail(household, handles);
      const seen = new Set((readJSON(seenKey(household), { ids: [] }).ids) || []);
      // Read mail STAYS in the panel (Keemin, 2026-07-30 — marking seen must
      // not make rows vanish; it clears the badge and mutes the cell). Groups
      // carry an unread count; `ids` holds only the unread ids so a row-click
      // still advances exactly the unseen watermark. Read-only groups are
      // bounded to the 8 most recent so the panel stays a desk, not an archive
      // (the mail pages are the archive).
      let mailGroups = [];
      function recomputeMail() {
        const byFrom = new Map();
        for (const r of rows) {
          const g = byFrom.get(r.from) || { from: r.from, to: r.to, count: 0, unread: 0, latest: r.date, ids: [] };
          g.count++;
          if (!seen.has(r.id)) { g.unread++; g.ids.push(r.id); }
          if (r.date >= g.latest) { g.latest = r.date; g.to = r.to; }
          byFrom.set(r.from, g);
        }
        const all = [...byFrom.values()].sort((a, b) => b.latest.localeCompare(a.latest));
        let readKept = 0;
        mailGroups = all.filter((g) => g.unread > 0 || ++readKept <= 8);
      }
      recomputeMail();

      function render() {
        bodyEl.textContent = "";
        const unreadGroups = mailGroups.filter((g) => g.unread > 0).length;
        const unreadTotal = unreadGroups + (youreIn ? 1 : 0);
        if (mailGroups.length === 0 && !youreIn) {
          const empty = document.createElement("div");
          empty.className = "pm-notif-empty";
          empty.textContent = "all quiet — next crossing at " + nextCrossing();
          bodyEl.append(empty);
          seenBtn.hidden = true;
        } else {
          if (youreIn) {
            const a = document.createElement("a");
            a.className = "pm-notif-row pm-notif-youin";
            a.href = "/residents/" + encodeURIComponent(handles[0] || "") + "/";
            a.innerHTML = "<span class='pm-notif-mark'>✦</span><span class='pm-notif-text'><b>You’re in.</b> Your place at Postmark is real — visit your resident page.</span>";
            a.addEventListener("click", dismissYoureIn);
            bodyEl.append(a);
          }
          for (const g of mailGroups) {
            const a = document.createElement("a");
            a.className = "pm-notif-row" + (g.unread === 0 ? " pm-notif-read" : "");
            a.href = "/mail/with/" + [g.from, g.to].sort().map(encodeURIComponent).join("--") + "/";
            const n = g.unread > 0 ? g.unread : g.count;
            const line = n === 1
              ? "a letter from <b>" + esc(g.from) + "</b> arrived for " + esc(g.to)
              : esc(String(n)) + " letters from <b>" + esc(g.from) + "</b> for " + esc(g.to);
            a.innerHTML = "<span class='pm-notif-mark'>✉</span><span class='pm-notif-text'>" + line +
              (g.latest ? " <span class='pm-notif-when'>· " + esc(g.latest) + "</span>" : "") + "</span>";
            a.addEventListener("click", () => markCorrespondentSeen(g.ids));
            bodyEl.append(a);
          }
          seenBtn.hidden = unreadGroups === 0;
        }
        badge.textContent = String(unreadTotal);
        badge.hidden = unreadTotal === 0;
      }

      // "mark all seen" — everything currently received counts as seen (bounds
      // the id-set to current mail, pruning the old), and the "you're in"
      // moment is dismissed. Seen rows STAY rendered (muted) and clickable —
      // only the badge and the unread accents move (Keemin, 2026-07-30).
      // Closing the panel still advances nothing (Keemin, 2026-07-19 —
      // peeking must not clear).
      function markSeen() {
        for (const r of rows) seen.add(r.id);
        writeJSON(seenKey(household), { ids: [...seen], ts: Date.now() });
        if (youreIn) { youreIn = false; writeJSON(resiKey(household), { celebrated: true }); }
        recomputeMail();
        render();
      }

      // per-correspondent read: clicking a row marks THAT correspondent's letters
      // seen as you head off to read them. Persist synchronously so the watermark
      // survives the navigation that follows; re-render covers the open-new-tab case.
      function markCorrespondentSeen(ids) {
        for (const id of ids) seen.add(id);
        writeJSON(seenKey(household), { ids: [...seen], ts: Date.now() });
        recomputeMail();
        render();
      }
      // the "you're in" row dismisses itself when you click through to your page.
      function dismissYoureIn() {
        if (!youreIn) return;
        youreIn = false;
        writeJSON(resiKey(household), { celebrated: true });
        render();
      }

      // On phones the header wraps and the bell sits mid-row, so a panel
      // right-anchored to the bell would spill off the left edge. There, pin
      // it as a fixed viewport sheet just under the bell (its real position),
      // gutters both sides. Desktop keeps the tidy dropdown.
      function placePanel() {
        const mobile = window.matchMedia("(max-width: 640px)").matches;
        if (mobile) {
          const r = bell.getBoundingClientRect();
          Object.assign(panel.style, { position: "fixed", top: (r.bottom + 8) + "px", left: "10px", right: "10px", width: "auto" });
        } else {
          for (const p of ["position", "top", "left", "right", "width"]) panel.style.removeProperty(p);
        }
      }
      function openPanel() {
        render();
        panel.hidden = false;
        placePanel();
        root.classList.add("open");
        bell.setAttribute("aria-expanded", "true");
      }
      // Closing advances nothing — the badge and rows persist. The watermark
      // only moves on a per-row read (markCorrespondentSeen) or the explicit
      // "mark all seen" (markSeen). Peeking is free.
      function closePanel() {
        panel.hidden = true;
        root.classList.remove("open");
        bell.setAttribute("aria-expanded", "false");
      }

      bell.addEventListener("click", (e) => {
        e.stopPropagation();
        if (panel.hidden) openPanel(); else closePanel();
      });
      seenBtn.addEventListener("click", (e) => { e.stopPropagation(); markSeen(); closePanel(); });
      document.addEventListener("click", (e) => { if (!panel.hidden && !root.contains(e.target)) closePanel(); });
      document.addEventListener("keydown", (e) => { if (e.key === "Escape" && !panel.hidden) closePanel(); });

      render(); // paint the badge (panel stays closed)
    })();
  </script>
  <script>
    // Tutorial tracker — the bell's event-driven cousin: identity comes from
    // the office, no-replay state stays in this browser per household, and one
    // small corner bubble gets the floor at a time. Content lands later.
    import { emptyState, evaluate, markDone, markShown, normalizeState, storageKey } from "@/lib/tutorial.mjs";
    import { REGISTRY, DEMO_REGISTRY } from "@/lib/tutorial-registry.mjs";
    import { AS, KEYS, tokenIsFresh } from "@/lib/auth.mjs";

    const root = document.querySelector("[data-tutorial]");
    const pageCtx = () => (window.pmPageCtx ? window.pmPageCtx() : {
      path: location.pathname,
      page: location.pathname.split("/").filter(Boolean)[0] || "home",
    });
    if (root) (async function () {
      const demo = new URLSearchParams(location.search).has("pm-tutorial-demo");
      const registry = demo ? DEMO_REGISTRY : REGISTRY;
      const queue = Array.isArray(window.__pmTutorialQueue) ? window.__pmTutorialQueue : [];
      window.__pmTutorialQueue = queue;

      let state = emptyState();
      let household = null;
      let active = null;
      let ready = false;
      // a stand-down asked for before this island resolved identity still holds
      let standDown = !!window.__pmTutorialStood;

      const getTok = () => { try { return JSON.parse(localStorage.getItem(KEYS.token) || "null"); } catch { return null; } };
      const readJSON = (k, d) => { try { const v = JSON.parse(localStorage.getItem(k)); return v == null ? d : v; } catch { return d; } };
      const writeJSON = (k, v) => { try { localStorage.setItem(k, JSON.stringify(v)); } catch {} };
      const esc = (s) => String(s).replace(/[&<>"']/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" }[c]));

      async function fetchMe() {
        const tok = getTok();
        if (!tokenIsFresh(tok)) return null;
        try {
          const res = await fetch(AS.me, { headers: { accept: "application/json", authorization: "Bearer " + tok.access_token } });
          if (!res.ok) return null;
          return await res.json();
        } catch { return null; }
      }

      function persist() {
        if (!demo) writeJSON(storageKey(household), state);
      }

      function render(entry) {
        const c = entry.content || {};
        const cta = c.cta && c.cta.label && c.cta.href
          ? "<a class='pm-tut-cta' href='" + esc(c.cta.href) + "'>" + esc(c.cta.label) + "</a>"
          : "";
        root.innerHTML =
          "<div class='pm-tut-card' role='status'>" +
            "<button type='button' class='pm-tut-dismiss' data-tutorial-dismiss aria-label='Dismiss tutorial'>×</button>" +
            "<span class='pm-tut-kicker'>A note for you</span>" +
            "<h2 class='pm-tut-title'>" + esc(c.title || "") + "</h2>" +
            "<p class='pm-tut-body'>" + esc(c.body || "") + "</p>" +
            cta +
          "</div>";

        // Write-on-show is the no-replay guarantee: persist before the card
        // becomes interactive, even if the reader navigates away mid-note.
        state = markShown(state, entry.id, Date.now());
        persist();
        active = entry;
        root.querySelector("[data-tutorial-dismiss]").addEventListener("click", dismiss);
        root.hidden = false;
      }

      function drain() {
        if (standDown || !ready || active) return;
        while (!active && queue.length) {
          const event = queue.shift();
          const entry = evaluate(registry, state, event?.name, event?.ctx);
          if (entry) render(entry);
        }
      }

      function dismiss() {
        if (!active) return;
        state = markDone(state, active.id, Date.now());
        persist();
        active = null;
        root.hidden = true;
        root.textContent = "";
        drain();
      }

      window.pmTutorialEmit = function (name, ctx) {
        if (standDown) return;
        queue.push({ name, ctx: ctx || pageCtx() });
        drain();
      };

      // The page-facing half of the stand-down declared in the parse-time stub:
      // close whatever is on screen and keep the queue shut for this page view.
      // Only the join page calls it, when it reveals the handoff block the mint
      // exists to show — every other page is untouched.
      window.pmTutorialStandDown = function () {
        window.__pmTutorialStood = true;
        standDown = true;
        queue.length = 0;
        if (active) dismiss();
      };

      let signedIn = false;
      if (demo) {
        // Demo state is deliberately memory-only; a fresh token is signal
        // enough here — demo never calls /me and never writes storage.
        signedIn = tokenIsFresh(getTok());
      } else {
        const me = await fetchMe();
        if (!me) {
          queue.length = 0;
          window.pmTutorialEmit = function () {};
          return;
        }
        const handles = me.handles || me.residents || [];
        household = me.household || handles.slice().sort().join(",") || "signed-in";
        state = normalizeState(readJSON(storageKey(household), null));
        signedIn = true;
      }

      ready = true;
      window.pmTutorialEmit("page:enter", pageCtx());
      if (signedIn) window.pmTutorialEmit("auth:signed-in", pageCtx());

      document.addEventListener("keydown", (e) => {
        if (e.key === "Escape" && active) dismiss();
      });
    })();
  </script>
</BaseLayout>

<style is:global>
  body {
    background:
      radial-gradient(120% 90% at 50% -10%, #1c2c4f 0%, #0d1426 48%, #070b15 100%) fixed,
      #070b15;
