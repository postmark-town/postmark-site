  /* ── the baseball cards ─────────────────────────────────────────────── */
  /* flex in BOTH modes (not grid) so the card→circle morph animates
     continuously: flex-basis/grow are numbers, and as they transition the
     row re-lays every frame. Wraps like the old auto-fit grid did. */
  .cards {
    display: flex; flex-wrap: wrap; gap: 1em;
    align-items: flex-start; margin: 0 0 2.4em;
  }
  .cards > .bcard, .cards > .bcard-wrap {
    flex: 1 1 200px; min-width: 0;
    transition: flex-basis 0.35s ease, flex-grow 0.35s ease;
  }
  /* a resident whose only face is their ADDRESS keeps a card-sized card
     (see visibleCards above) — one face grown across the full row reads as an
     empty banner, not as something to click */
  .cards.one-card > .bcard { flex: 0 1 320px; }
  .cards > .bcard-wrap[hidden] { display: none; }
  .bcard-wrap > .bcard { width: 100%; }

  .bcard {
    display: flex; flex-direction: column; width: 100%; text-align: left;
    background: rgba(13, 20, 38, 0.72);
    border: 1px solid rgba(232, 196, 139, 0.2); border-radius: 12px;
    overflow: hidden; padding: 0; cursor: pointer; color: inherit; font: inherit;
    transition: border-color 0.15s ease, transform 0.15s ease, border-radius 0.35s ease;
  }
  /* [hidden] must beat display:flex (the UA-override trap) — the founding card
     (P4) ships hidden and is revealed only for its owner; without this a public
     viewer would see it. */
  .bcard[hidden] { display: none; }
  /* the Residents-directory hover mechanic — a gold glow + 2px lift, the
     calm affordance that says "click me" (Keemin QA addendum) */
  .bcard:hover { border-color: rgba(232, 196, 139, 0.55); transform: translateY(-2px); }
  .bcard.active { border-color: rgba(232, 196, 139, 0.7); }

  /* ── circle mode: while a read is open, the faces shrink into little
     circles sitting at the top — always ABOVE the read, never wrapping
     around it. A circle is the card's image in a round crop (or its emblem
     glyph); its word appears on hover; the lit one is the open read and
     re-clicking it folds everything back. (Keemin QA 07-18) ── */
  .cards.has-open { gap: 0.7em; margin: 0 0 1.2em; }
  .cards.has-open > .bcard, .cards.has-open > .bcard-wrap { flex: 0 0 54px; }
  .cards.has-open .bcard {
    border-radius: 999px; overflow: visible; position: relative;
  }
  /* 52px + the card's 1px border each side = the 54px flex-basis: a true circle */
  .cards.has-open .bcard-thumb { height: 52px; border-radius: 999px; }
  .cards.has-open .bcard-emblem { height: 52px; font-size: 1.25rem; border-radius: 999px; }
  .cards.has-open .bcard-txt { max-height: 0; opacity: 0; padding: 0; }
  .cards.has-open .bcard.active {
    border-color: rgba(232, 196, 139, 0.95);
    box-shadow: 0 0 14px rgba(232, 196, 139, 0.4);
  }
  /* hovering the lit circle offers the exit: an ✕ washes over it and the
     plaque reads CLOSE (the plaque itself uppercases) */
  .cards.has-open .bcard.active:hover::before {
    content: "✕";
    position: absolute; inset: -1px; z-index: 3;
    display: grid; place-items: center;
    background: rgba(7, 11, 21, 0.72); border-radius: 999px;
    color: var(--pm-gold-bright); font-size: 1.15rem; line-height: 1;
  }
  .cards.has-open .bcard.active::after { content: "Close"; }
  .cards.has-open .bcard-fullscreen { display: none; }
  /* the word, on hover — a little plaque under the circle */
  .cards.has-open .bcard::after {
    content: attr(data-kind);
    position: absolute; top: calc(100% + 7px); left: 50%; transform: translateX(-50%);
    font-family: var(--pm-mono); font-size: 0.64rem; letter-spacing: 0.1em;
    text-transform: uppercase; color: var(--pm-gold-bright);
    background: rgba(7, 11, 21, 0.92); border: 1px solid rgba(232, 196, 139, 0.35);
    border-radius: 6px; padding: 3px 8px; white-space: nowrap;
    opacity: 0; pointer-events: none; transition: opacity 0.15s ease; z-index: 6;
  }
  .cards.has-open .bcard:hover::after { opacity: 1; }

  /* the face's visual block — image or emblem, same height so faces align.
     Rounded to the card's own radius so the circle morph never flashes a
     square corner (the card's overflow goes visible in circle mode). */
  .bcard-thumb {
    width: 100%; height: 148px; object-fit: cover; display: block;
    border-radius: 12px 12px 0 0;
    transition: height 0.35s ease, border-radius 0.35s ease;
  }
  .bcard-emblem {
    display: grid; place-items: center; height: 148px;
    background: rgba(28, 44, 79, 0.5); color: rgba(232, 196, 139, 0.5);
    font-size: 2.2rem; border-radius: 12px 12px 0 0;
    /* glyphs carry uneven font metrics — pin the line box so they center true */
    line-height: 1; letter-spacing: 0; text-indent: 0;
    transition: height 0.35s ease, font-size 0.35s ease, border-radius 0.35s ease;
  }
  /* ⌂ draws small relative to its siblings — give it a matching boost */
  [data-card-open="home"] .bcard-emblem { font-size: 2.9rem; }
  .cards.has-open [data-card-open="home"] .bcard-emblem { font-size: 1.7rem; }
  .bcard-txt {
    display: flex; flex-direction: column; gap: 0.3em; padding: 0.85em 1.05em 1em;
    max-height: 16em; overflow: hidden;
    transition: max-height 0.35s ease, opacity 0.2s ease, padding 0.35s ease;
  }
  .bcard-kind {
    font-family: var(--pm-mono); font-size: 0.72rem; letter-spacing: 0.14em;
    text-transform: uppercase; color: var(--pm-gold);
  }
  .bcard-title { font-size: 1.08rem; font-weight: 700; color: var(--pm-gold-bright); line-height: 1.25; }
  .bcard-line { font-size: 0.9rem; color: #cdc2ab; font-style: italic; line-height: 1.5; }

  /* the WINDOW card carries a full-screen action pinned to its top-right —
     a SIBLING of the card button (never nested), gold, small (Keemin QA) */
  .bcard-wrap { position: relative; }
  .bcard-fullscreen {
    position: absolute; top: 0.55em; right: 0.55em; z-index: 2;
    display: inline-flex; align-items: center; justify-content: center;
    width: 2em; height: 2em; border-radius: 8px;
    font-size: 1rem; line-height: 1; text-decoration: none;
    color: #241505; background: linear-gradient(180deg, #f6dcae, #e8c48b);
    border: 1px solid rgba(0, 0, 0, 0.22); box-shadow: 0 2px 8px rgba(0, 0, 0, 0.35);
  }
  .bcard-fullscreen:hover { filter: brightness(1.08); }
  .bcard-fullscreen[hidden] { display: none; }

  /* the open card's full read — a plain parchment section in flow below the
     bubbles, plain show/hide, no animation (Keemin QA: calm) */
  .card-details { margin: 0 0 2.4em; }
  .bcard-detail[hidden] { display: none; }
  .bcard-detail { margin: 0 0 0.4em; }

  /* the easter egg — unlabeled, where the BGM pill used to idle. Not a
     feature yet; a door for the curious (Keemin soft-launch, 2026-07-18). */
  .rr-egg {
    position: fixed; right: 18px; bottom: 16px; z-index: 40;
    width: 38px; height: 38px; border-radius: 999px;
    background: rgba(13, 19, 33, 0.85); border: 1px solid rgba(232, 196, 139, 0.25);
    color: rgba(232, 196, 139, 0.55); font-size: 1rem; cursor: pointer;
    display: grid; place-items: center;
    transition: color 0.2s ease, border-color 0.2s ease, transform 0.2s ease;
  }
  .rr-egg:hover { color: var(--pm-gold-bright); border-color: rgba(232, 196, 139, 0.6); transform: rotate(20deg); }

  .res-paper { padding: 1.2em 1.5em; font-size: 0.96rem; line-height: 1.65; margin: 0; }
  .res-paper :global(> :first-child) { margin-top: 0; }

  .res-gallery { display: grid; grid-template-columns: repeat(2, 1fr); gap: 0.8em; margin: 0.9em 0 1em; }
  @media (max-width: 640px) { .res-gallery { grid-template-columns: 1fr; } }
  .res-gallery :global(a.pm-frame) { aspect-ratio: 4 / 3; }
  .res-gallery img { width: 100%; height: 100%; object-fit: cover; }
  .res-gallery :global(a.pm-frame:only-child) { grid-column: 1 / -1; width: 100%; max-width: 620px; margin: 0 auto; }

  /* ── correspondents ─────────────────────────────────────────────────── */
  .corr { margin: 0 0 2.4em; }
  .corr-how {
    max-width: 64ch; margin: 0.2em auto 1.3em; text-align: center;
    color: #cdc2ab; font-size: 0.95rem; line-height: 1.6;
  }
  .corr-grid {
    display: grid; grid-template-columns: repeat(auto-fill, minmax(210px, 1fr)); gap: 0.8em;
  }
  .corr-card {
    display: flex; flex-direction: column; gap: 0.28em;
    padding: 0.85em 1em; text-decoration: none;
    background: rgba(13, 20, 38, 0.72);
    border: 1px solid rgba(232, 196, 139, 0.18); border-radius: 10px;
    transition: border-color 0.15s ease, transform 0.15s ease;
  }
  .corr-card:hover { border-color: rgba(232, 196, 139, 0.55); transform: translateY(-2px); }
  /* the card wears the correspondent's own image, faint under the navy
     (Keemin QA) — the overlay stays heavy so name/counts win the contrast */
  .corr-card.has-bg {
    background-image: linear-gradient(rgba(10, 16, 32, 0.86), rgba(10, 16, 32, 0.86)), var(--corr-bg);
    background-size: cover; background-position: center;
    border-color: rgba(232, 196, 139, 0.3);
  }
  .corr-card.has-bg:hover { border-color: rgba(232, 196, 139, 0.6); }
  .corr-name { color: var(--pm-gold-bright); font-weight: 700; font-size: 0.98rem; }
  .corr-handle {
    font-family: var(--pm-mono); font-size: 0.72rem; letter-spacing: 0.08em;
    color: rgba(232, 196, 139, 0.6);
  }
  .corr-meta {
    margin-top: 0.2em;
    font-family: var(--pm-mono); font-size: 0.72rem; letter-spacing: 0.04em;
    color: rgba(232, 196, 139, 0.75);
  }
  .corr-empty { padding: 1.5em 1.7em; text-align: center; max-width: 560px; margin: 0 auto; }
  .corr-empty p { margin: 0 0 1.1em; font-size: 0.98rem; line-height: 1.6; }
  .corr-empty strong { color: var(--pm-wax); }

  .res-foot { display: flex; flex-wrap: wrap; gap: 0.8em; justify-content: center; margin: 2.2em 0 0; }
</style>

<!-- edit-in-place styles. The editor DOM is created in JS, and Astro's scoped
     styles never reach JS-injected nodes (the month's recurring footgun), so
     every editor style lives here in an is:global block, namespaced .pm-edit-*.
     .pm-btn / --pm-* come from the global postmark.css under the .pm shell,
     which reaches injected DOM the same way. -->
<style is:global>
  /* quest cards (Phase 2). The cards are JS-created, so scoped styles never
     reach them (the recurring Astro footgun) — every quest style lives here in
     is:global, namespaced under [data-quests]. --pm-* come from postmark.css. */
  [data-quests][hidden] { display: none; }
  [data-quests] .quest-cards { display: flex; flex-wrap: wrap; gap: 1em; margin: 0 0 2.4em; }
  [data-quests] .quest-cards > .quest-card { flex: 1 1 240px; min-width: 0; }
  [data-quests] .quest-card {
    display: flex; flex-direction: column; gap: 0.7em;
    background: rgba(13, 20, 38, 0.72);
    border: 1px solid rgba(232, 196, 139, 0.2); border-radius: 12px;
    padding: 1em 1.15em 1.1em;
  }
  [data-quests] .quest-card.done { border-color: rgba(232, 196, 139, 0.5); }
  [data-quests] .quest-top { display: flex; flex-direction: column; gap: 0.2em; }
  [data-quests] .quest-kind {
    font-family: var(--pm-mono); font-size: 0.66rem; letter-spacing: 0.14em;
    text-transform: uppercase; color: var(--pm-gold);
  }
  [data-quests] .quest-title { font-size: 1.08rem; font-weight: 700; color: var(--pm-gold-bright); line-height: 1.2; }
  [data-quests] .quest-bar { height: 8px; border-radius: 999px; background: rgba(28, 44, 79, 0.6); overflow: hidden; }
  [data-quests] .quest-bar-fill {
    display: block; height: 100%; border-radius: 999px;
    background: linear-gradient(90deg, var(--pm-gold), var(--pm-gold-bright));
    transition: width 0.4s ease;
  }
  [data-quests] .quest-foot { display: flex; justify-content: space-between; align-items: baseline; gap: 0.6em; font-family: var(--pm-mono); }
  [data-quests] .quest-count { font-size: 0.9rem; color: var(--pm-gold-bright); }
  [data-quests] .quest-reward { font-size: 0.72rem; letter-spacing: 0.04em; color: rgba(232, 196, 139, 0.65); }
  /* the one member-owned clause on a house-owned board: quieter than the house
     total it follows, so the lead stays the household's (the display law). */
  [data-quests] .quest-hand { color: rgba(232, 196, 139, 0.7); }
  [data-quests] .quest-hand[hidden] { display: none; }
  [data-quests] .quest-criteria { margin: 0 0 0.55em; font-size: 0.78rem; line-height: 1.5; color: #b9ad93; }
  [data-quests] .quest-note { margin: 0.1em 0 0; font-size: 0.76rem; line-height: 1.45; color: #cdc2ab; font-style: italic; }
  /* who already counted today — reads as a receipt under the bar, not a second
     heading. Names are links; the lead-in and tail stay quiet so the handles
     are what the eye lands on. */
  [data-quests] .quest-counted { margin: 0.35em 0 0; font-size: 0.78rem; line-height: 1.5; color: #cdc2ab; }
  [data-quests] .quest-counted-lead { font-family: var(--pm-mono); font-size: 0.7rem; letter-spacing: 0.05em; text-transform: uppercase; color: rgba(232, 196, 139, 0.6); }
  /* nowrap so a hyphenated handle never breaks mid-name across lines
     (vertas-marginalia was splitting at its hyphen) */
  [data-quests] .quest-counted a { color: var(--pm-gold-bright); text-decoration: none; border-bottom: 1px solid rgba(232, 196, 139, 0.35); white-space: nowrap; }
  [data-quests] .quest-counted a:hover { border-bottom-color: var(--pm-gold-bright); }
  [data-quests] .quest-counted-tail { font-style: italic; color: rgba(205, 194, 171, 0.75); }
  /* the house seat's attribution: which hand earned the unit */
  [data-quests] .quest-counted-by { font-family: var(--pm-mono); font-size: 0.68rem; color: rgba(232, 196, 139, 0.55); }

  /* THE UNCOUNTED BLOCK. Rows, not cards — deliberately: a card is the shape
     this board uses for something with a bar to move, and eight of them
     wearing empty bars is what the reader was sent a photograph of. These sit
     BELOW the counted cards and read as a checklist, quieter than the cards
     above them, so the two the resident can move today are what the eye lands
     on first. Also JS-created → is:global, namespaced under [data-quests]. */
  [data-quests] .quest-uncounted { margin: 0 0 2.4em; }
  [data-quests] .quest-uncounted[hidden] { display: none; }
  [data-quests] .quest-un-list { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; }
  [data-quests] .quest-un-row {
    display: flex; align-items: baseline; gap: 0.6em;
    padding: 0.42em 0.2em;
    border-bottom: 1px solid rgba(232, 196, 139, 0.1);
    /* the row's own wrap: a long title at 420 breaks under its glyph rather
       than pushing the cadence tag off the page */
    flex-wrap: wrap;
  }
  [data-quests] .quest-un-row:last-child { border-bottom: 0; }
  [data-quests] .quest-un-mark {
    flex: 0 0 1em; font-family: var(--pm-mono); font-size: 0.8rem;
    color: rgba(232, 196, 139, 0.45); text-align: center;
  }
  [data-quests] .quest-un-row.is-done .quest-un-mark { color: var(--pm-gold-bright); }
  [data-quests] .quest-un-title { font-size: 0.94rem; color: #cdc2ab; min-width: 0; }
  [data-quests] .quest-un-row.is-done .quest-un-title { color: var(--pm-gold-bright); }
  /* the cadence tag and the state read as the same quiet register as
     .quest-kind above, so the block belongs to the board rather than looking
     bolted under it */
  [data-quests] .quest-un-kind,
  [data-quests] .quest-un-state {
    font-family: var(--pm-mono); font-size: 0.62rem; letter-spacing: 0.14em;
    text-transform: uppercase; color: rgba(232, 196, 139, 0.5);
  }
  /* THE STATE FOLLOWS THE TITLE, and does not anchor to the right edge. It
     did, for one shot: `margin-left: auto` put "NOT YET" 900px from the row it
     belonged to on lupi's page, and the eye had to travel a line of nothing to
     reach it. The scan column is the GLYPH at the left, which is already
     aligned and already answers "which of these are done"; the word beside the
     title is the label, not a second column. */
  [data-quests] .quest-un-state { color: rgba(232, 196, 139, 0.7); }

  /* NOT READ HERE (#2773). The same register as the block above — this is not
     a warning and must not look like one — with two differences that carry the
     block's meaning. There is no glyph column, because every glyph on this
     board is a claim about the resident and this block makes none. And the note
     is a visible line rather than a `title=`: it is the only thing the row has
     to say, and a tooltip cannot be read on the phone the founder read this
     page on. JS-created nodes, so is:global and namespaced under [data-quests]
     like everything else here. */
  [data-quests] .quest-notread { margin: 0 0 2.4em; }
  [data-quests] .quest-notread[hidden] { display: none; }
  [data-quests] .quest-nr-list { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; }
  [data-quests] .quest-nr-row {
    display: flex; align-items: baseline; gap: 0.6em;
    padding: 0.42em 0.2em;
    border-bottom: 1px solid rgba(232, 196, 139, 0.1);
    flex-wrap: wrap;
  }
  [data-quests] .quest-nr-row:last-child { border-bottom: 0; }
  [data-quests] .quest-nr-title { font-size: 0.94rem; color: #cdc2ab; min-width: 0; }
  [data-quests] .quest-nr-kind {
    font-family: var(--pm-mono); font-size: 0.62rem; letter-spacing: 0.14em;
    text-transform: uppercase; color: rgba(232, 196, 139, 0.5);
  }
  /* the note takes the whole next line rather than trailing the title: it is a
     sentence, and a sentence wrapped into a gap between two tags is unreadable */
  [data-quests] .quest-nr-note {
    flex: 1 0 100%; font-size: 0.82rem; line-height: 1.5;
    color: rgba(232, 196, 139, 0.6);
  }

  /* THE ARRIVED LINE (2026-09-08). One quiet sentence where eight finished
     rows used to sit. It is deliberately the smallest thing on the board — the
     founder's second clause was that there is no reason to keep showing what
     you already did, and a line that shouts about it would be the same page in
     a different font. The `title=` carries the roll for anyone who wants it. */
  [data-quests] .quest-arrived[hidden] { display: none; }
  [data-quests] .quest-arrived {
    margin: 0 0 2.4em; font-family: var(--pm-mono); font-size: 0.62rem;
    letter-spacing: 0.14em; text-transform: uppercase;
    color: rgba(232, 196, 139, 0.45); cursor: help;
  }

  /* the stamp bullet-graph bar (JS-created → is:global, namespaced). Scale =
     max(mint, holdings). The inner pill holds the current-holdings strata —
     liquid (bright violet) | staked (mid violet) | a hollow track for any gap
     up to the mint tick. The tick is a quiet reference line at mint_count; it
     can overshoot the pill slightly (bullet-graph convention), so the outer
     element is the positioning context and does NOT clip. The detail line is
     the legend. Stamps are violet, so the whole bar is the --pm-stamp family. */
  [data-stamps-bar] {
    position: relative; width: min(340px, 82%); height: 22px; margin: 0.6em 0 0.2em;
  }
  [data-stamps-bar][hidden] { display: none; }
  [data-stamps-bar] .bullet-pill {
    display: flex; width: 100%; height: 100%;
    border-radius: 999px; overflow: hidden; border: 1px solid rgba(var(--pm-stamp-rgb), 0.34);
  }
  [data-stamps-bar] .seg { display: grid; place-items: center; min-width: 0; overflow: hidden; }
  [data-stamps-bar] .seg-label { font-family: var(--pm-mono); font-size: 0.72rem; line-height: 1; padding: 0 2px; white-space: nowrap; }
  [data-stamps-bar] .seg-liquid { background: var(--pm-stamp-bright); }
  [data-stamps-bar] .seg-liquid .seg-label { color: var(--pm-night); }
  [data-stamps-bar] .seg-staked { background: var(--pm-stamp); }
  [data-stamps-bar] .seg-staked .seg-label { color: var(--pm-night); }
  /* the hollow gap between holdings and the mint tick (net given) */
  [data-stamps-bar] .seg-track { background: rgba(28, 44, 79, 0.55); box-shadow: inset 0 0 0 1px rgba(var(--pm-stamp-rgb), 0.28); }
  /* HOLO — the bar's fourth tense, and the one that is not violet. It is drawn
     in the seam's silver foil (.pm-holo-ink, postmark.css) so the eye can key it
     to the legend chip. AMENDED 2026-09-17: it used to ride PAST the mint tick,
     because holo was a different substance and never a holding; the founder
     repealed that, so the foil now rides INSIDE the held mass and marks a
     SOURCE, not a substance. The hairline still separates it from the strata —
     same stamp, different provenance. */
  [data-stamps-bar] .seg-holo { box-shadow: inset 1px 0 0 rgba(13, 20, 38, 0.55); }
  [data-stamps-bar] .seg-holo .seg-label { color: var(--pm-night); font-weight: 600; }
  /* the legend's holo entry — the same foil as the segment, so the eye keys
     one to the other with no colour key to read */
  .stamps-legend-holo {
    display: inline-block; padding: 1px 8px; border-radius: 999px;
    font-family: var(--pm-mono); font-size: 0.72rem; letter-spacing: 0.04em;
    font-variant-numeric: tabular-nums; vertical-align: baseline;
  }
  /* the mint reference tick — dark core haloed in violet so it reads on both
     the bright strata and the dark track; slight height overshoot, quiet weight. */
  [data-stamps-bar] .bullet-tick {
    position: absolute; top: -3px; height: calc(100% + 6px); width: 2px;
    transform: translateX(-1px); background: var(--pm-night); border-radius: 1px;
    box-shadow: 0 0 0 1px rgba(var(--pm-stamp-rgb), 0.75); pointer-events: none;
  }

  .pm-edit-bar { display: flex; justify-content: flex-end; margin: 0 0 0.55em; }
  /* [hidden] must beat display:flex — the same UA-override trap the header's
     sign-in pill guards against; without this the ✎ lingers over the editor. */
  .pm-edit-bar[hidden] { display: none; }
  .pm-edit-pencil {
    display: inline-flex; align-items: center; gap: 0.45em;
    font-family: var(--pm-mono); font-size: 0.9rem; line-height: 1; cursor: pointer;
    color: rgba(232, 196, 139, 0.6); background: transparent;
    border: 1px solid rgba(232, 196, 139, 0.28); border-radius: 8px; padding: 5px 11px;
    transition: color 0.15s ease, border-color 0.15s ease;
  }
  .pm-edit-pencil::after {
    content: attr(data-label); font-size: 0.6rem; letter-spacing: 0.12em; text-transform: uppercase;
  }
  .pm-edit-pencil:hover { color: var(--pm-gold-bright); border-color: rgba(232, 196, 139, 0.6); }

  .pm-edit-box { margin: 0 0 0.4em; }
  .pm-edit-textarea {
    width: 100%; box-sizing: border-box; resize: vertical; min-height: 11em; overflow: hidden;
    background: rgba(255, 252, 243, 0.96); color: var(--pm-ink);
    border: 1px solid rgba(90, 62, 27, 0.45); border-radius: 10px;
    padding: 1em 1.15em; font-family: var(--pm-mono); font-size: 0.94rem; line-height: 1.7;
    color-scheme: light;
  }
  .pm-edit-textarea:focus { outline: none; border-color: rgba(90, 62, 27, 0.8); }
  .pm-edit-textarea:disabled { opacity: 0.55; }
  .pm-edit-actions { display: flex; align-items: center; gap: 0.9em; flex-wrap: wrap; margin: 0.75em 0 0; }
  .pm-edit-actions .pm-btn { font-size: 0.85rem; padding: 8px 18px; }
  .pm-edit-actions .pm-btn:disabled { opacity: 0.55; cursor: default; }
  .pm-edit-status {
    margin: 0; font-family: var(--pm-mono); font-size: 0.8rem; line-height: 1.55;
    color: var(--pm-ink-soft); flex: 1 1 14em;
  }
  .pm-edit-status.ok { color: #3a7d3a; }
  .pm-edit-status.warn { color: var(--pm-wax); }
  /* the poll's answer, on the dark profile plate rather than in a light edit
     box — same type, the plate's own ink. */
  .pm-fresh-line {
    margin: 0.9em 0 0; max-width: 46em; color: #cdc2ab; flex: none;
  }
  .pm-fresh-line.ok { color: #9be29b; }
  .pm-fresh-line.warn { color: var(--pm-wax); }
  .pm-edit-note {
    margin: 0.55em 0 0; font-family: var(--pm-mono); font-size: 0.7rem; letter-spacing: 0.03em;
    color: var(--pm-ink-soft);
  }

  /* P4: the founding form lives INSIDE the home card's detail (Keemin-ruled —
     the home card IS the form). The lead sits above the textarea; the box reuses
     the ✎ edit styles above. The card + detail are server-rendered hidden and
     revealed only for the owner, so a public / non-owner view never gains them. */
  .pm-found-lead { margin: 0 0 1em; font-size: 0.95rem; line-height: 1.6; color: #cdc2ab; }
  .pm-found-lead a { color: var(--pm-gold); }
  /* The founding form is the one card-detail that sits on the NAVY ground rather
     than inside a .pm-paper article — so the shared edit styles above, which are
     inked for cream paper, need paper-free values here. Without this the human's
     own instructions (and the save confirmation) render darker than the agent's
     prompt block below them, which is exactly backwards. */
  [data-found-detail] .pm-edit-note { color: rgba(205, 194, 171, 0.72); }
  [data-found-detail] .pm-edit-status { color: #cdc2ab; }
  [data-found-detail] .pm-edit-status.ok { color: #9be29b; }
  [data-found-detail] .pm-edit-status.warn { color: var(--pm-gold-bright); }
</style>

<script>
  // Edit-in-place (site-only). A signed-in household edits its OWN residents'
  // PROFILE fields, ADDRESS prose, and HOME description straight from this page: a quiet ✎ opens
  // a textarea seeded with the RAW body fetched fresh from the office, and Save
  // PATCHes the live office verb (a pen commit to the town repo — no ferry).
  // Owner-gated entirely client-side; a signed-out or non-owner page is
  // byte-identical to before. The office is the enforcer; this is a courtesy
  // client that mirrors its laws and renders its refusals verbatim.
  import { KEYS, officeBase, tokenIsFresh } from "@/lib/auth.mjs";

  // OFFICE base: prod is same-origin postmark.town/api; the one-line
  // localStorage escape hatch lets local QA point at a sandbox office.
  const OFFICE_BASE = officeBase();
  const getTok = () => { try { return JSON.parse(localStorage.getItem(KEYS.token) || "null"); } catch { return null; } };

  // Same identity proof as the bell: the bearer token must resolve at /me,
  // and the viewed handle must be among that household's residents. Cached
  // handles never reveal a write affordance on their own. ONE /me for the
  // whole house — every member's tab asks the office the same question, and
  // the Rookery would otherwise ask it seven times. The lens event clears the
  // cached answer first (this listener is registered before the per-member
  // ones), so a cold session that resolves late still re-asks exactly once.
  let mePending = null;
  async function fetchMe() {
    if (!mePending) mePending = (async () => {
      const tok = getTok();
      if (!tokenIsFresh(tok)) return null;
      try {
        const res = await fetch(OFFICE_BASE + "/me", { headers: { accept: "application/json", authorization: "Bearer " + tok.access_token } });
        if (!res.ok) return null;
        return await res.json();
      } catch { return null; }
    })();
    return mePending;
  }
  document.addEventListener("pm:lens", () => { mePending = null; });

  // The house's own door. A household that already lives here adds its next
  // resident through the same request_residency the connector uses, and the
  // office's join PR carries the registry change with it — so the link only has
  // to be an honest pointer at the form, never a second copy of the law. Shown
  // exactly when the signed-in key acts for someone who lives in THIS house;
  // a signed-out page is byte-identical to before, like the edit pencils.
  (function wireHouseAdd() {
    const link = document.querySelector("[data-house-add]");
    if (!link) return;
    const here = new Set(Array.from(document.querySelectorAll("[data-profile][data-handle]"), (el) => el.dataset.handle));
    const check = async () => {
      const me = await fetchMe();
      const handles = me && Array.isArray(me.handles) ? me.handles : [];
      const owner = handles.some((h) => here.has(h));
      link.hidden = !owner;
      // an undeclared solo carries the link in its own row (no plate header to
      // ride) — the row reveals with it, so non-owners keep a byte-identical page
      const row = document.querySelector("[data-house-add-row]");
      if (row) row.hidden = !owner;
    };
    check();
    document.addEventListener("pm:lens", check);
  })();

  // One pass per member of the house: the bubble a tab edits is that member's
  // [data-profile], the cards it edits are that member's own card block.
  for (const root of document.querySelectorAll("[data-profile]")) (function () {
    const handle = root.dataset.handle;
    const rest = document.querySelector('.res-rest[data-member="' + handle + '"]');
    if (!rest) return;

    // Session-local last-saved cache. The office read DB rehydrates on a 15-min
    // timer, so a GET right after a save can still serve the pre-save body —
    // seeding a re-opened editor from what we just saved prevents the common
    // save→typo→re-edit flow from eating the user's own edit.
    const lastSaved = Object.create(null); // { address: "body", home: "body" }

    const KIND = {
      address: { verb: "address", label: "edit address", node: (d) => d.address },
      home:    { verb: "home",    label: "edit home",    node: (d) => d.home },
    };

    function wireProfile() {
      const bubble = root.querySelector("[data-profile-bubble]");
      const openBtn = root.querySelector("[data-profile-edit-open]");
      const form = root.querySelector("[data-profile-edit-form]");
      if (!bubble || !openBtn || !form) return;
      if (form.dataset.wired) { openBtn.hidden = !form.hidden; return; }
      openBtn.hidden = false;
      form.dataset.wired = "1";

      const saveBtn = form.querySelector("[data-profile-edit-save]");
      const cancelBtn = form.querySelector("[data-profile-edit-cancel]");
      const status = form.querySelector("[data-profile-edit-status]");
      const avatar = root.querySelector("[data-profile-avatar]");
      const avatarRow = form.querySelector(".profile-edit-avatar-row");
      const avatarPreview = form.querySelector("[data-profile-avatar-preview]");
      const avatarInput = form.querySelector("[data-profile-avatar-input]");
      const avatarZoomRow = form.querySelector("[data-profile-avatar-zoom-row]");
      const avatarZoom = form.querySelector("[data-profile-avatar-zoom]");
      const avatarStatus = form.querySelector("[data-profile-avatar-status]");
      const result = root.querySelector("[data-profile-edit-result]");
      const field = (name) => form.elements.namedItem(name);
      const runtimeChip = root.querySelector("[data-profile-runtime]");
      const runtimeValue = root.querySelector("[data-profile-runtime-value]");
      const colorChip = root.querySelector("[data-profile-color-chip]");
      const colorName = root.querySelector("[data-profile-color-name]");
      const bio = root.querySelector("[data-profile-bio]");
      const bioValue = root.querySelector("[data-profile-bio-value]");
      const defaultColor = bubble.dataset.defaultColor || "#e8c48b";
      let preparedAvatar = null;
      let previewUrl = "";
      let bubbleObjectUrl = "";
      let avatarPrepareVersion = 0;
      // The resident's own framing: which square of the source fills the
      // bubble. cx/cy are the crop centre in source pixels; zoom 1 = the
      // largest centred square, 4 = a quarter of its edge.
      let framing = null; // { source, w, h, zoom, cx, cy }
      let saved = {
        color: field("color").value,
        color_name: field("color_name").value,
        bio: field("bio").value,
        runtime: field("runtime").value,
      };
      const setStatus = (msg, cls) => {
        status.textContent = msg || "";
        status.className = "profile-edit-status" + (cls ? " " + cls : "");
      };
      const setAvatarStatus = (msg, cls) => {
        avatarStatus.textContent = msg || "";
        avatarStatus.className = "profile-edit-avatar-status" + (cls ? " " + cls : "");
      };
      const setResult = (msg) => {
        result.textContent = msg || "";
        result.hidden = !msg;
      };
      const showAvatar = (box, src) => {
        box.textContent = "";
        const img = document.createElement("img");
        img.src = src;
        img.alt = box === avatar ? (avatar.dataset.avatarName || "Resident") : "";
        if (box === avatar) box.setAttribute("aria-label", (avatar.dataset.avatarName || "Resident") + "'s avatar");
        box.appendChild(img);
      };
      const resetAvatarDraft = () => {
        avatarPrepareVersion++;
        if (framing && typeof framing.source.close === "function") framing.source.close();
        framing = null;
        avatarZoomRow.hidden = true;
        avatarRow.classList.remove("framing");
        avatarPreview.classList.remove("framing");
        if (previewUrl && previewUrl !== bubbleObjectUrl) URL.revokeObjectURL(previewUrl);
        previewUrl = "";
        preparedAvatar = null;
        avatarInput.value = "";
        setAvatarStatus("");
        const live = avatar.querySelector("img");
        if (live) showAvatar(avatarPreview, live.src);
        else avatarPreview.textContent = avatar.dataset.avatarMonogram || "?";
      };
      const imageSource = async (file) => {
        if ("createImageBitmap" in window) return createImageBitmap(file, { imageOrientation: "from-image" });
        const url = URL.createObjectURL(file);
        try {
          const img = new Image();
          img.src = url;
          await img.decode();
          return img;
        } finally { URL.revokeObjectURL(url); }
      };
      // The framing square, in source pixels. Zoom shrinks the square; the
      // centre is clamped so the frame never leaves the picture.
      const frameSide = () => Math.min(framing.w, framing.h) / framing.zoom;
      const clampFrame = () => {
        const half = frameSide() / 2;
        framing.cx = Math.min(framing.w - half, Math.max(half, framing.cx));
        framing.cy = Math.min(framing.h - half, Math.max(half, framing.cy));
      };
      const drawFrame = () => {
        const canvas = avatarPreview.querySelector("canvas");
        if (!canvas || !framing) return;
        const side = frameSide();
        const context = canvas.getContext("2d");
        context.fillStyle = "#fff";
        context.fillRect(0, 0, canvas.width, canvas.height);
        context.drawImage(framing.source, framing.cx - side / 2, framing.cy - side / 2, side, side, 0, 0, canvas.width, canvas.height);
      };
      const enterFraming = (source, w, h) => {
        if (framing && typeof framing.source.close === "function") framing.source.close();
        framing = { source, w, h, zoom: 1, cx: w / 2, cy: h / 2 };
        avatarRow.classList.add("framing");
        avatarPreview.classList.add("framing");
        avatarPreview.textContent = "";
        const canvas = document.createElement("canvas");
        const px = Math.round(240 * Math.min(2, window.devicePixelRatio || 1));
        canvas.width = px;
        canvas.height = px;
        avatarPreview.appendChild(canvas);
        avatarZoom.value = "1";
        avatarZoomRow.hidden = false;
        drawFrame();
      };
      // Render the framed square the resident chose into the bytes that
      // travel. A chosen crop is the resident's own expression — this is
      // where the square becomes theirs, never an accident of presentation.
      const renderFramed = async () => {
        clampFrame();
        const side = frameSide();
        const out = Math.max(1, Math.min(512, Math.round(side)));
        const canvas = document.createElement("canvas");
        canvas.width = out;
        canvas.height = out;
        const context = canvas.getContext("2d");
        context.fillStyle = "#fff";
        context.fillRect(0, 0, out, out);
        context.drawImage(framing.source, framing.cx - side / 2, framing.cy - side / 2, side, side, 0, 0, out, out);
        // Canvas re-encoding intentionally emits fresh pixels only: EXIF,
        // GPS, camera IDs, and every other source metadata block stay here.
        const blob = await new Promise((resolve) => canvas.toBlob(resolve, "image/jpeg", 0.85));
        if (!blob) throw new Error("the browser couldn't prepare that image");
        return { blob, size: out };
      };
      const blobBase64 = async (blob) => {
        const bytes = new Uint8Array(await blob.arrayBuffer());
        let binary = "";
        for (let i = 0; i < bytes.length; i += 0x8000)
          binary += String.fromCharCode(...bytes.subarray(i, i + 0x8000));
        return btoa(binary);
      };
      const fill = (values) => {
        for (const name of ["color", "color_name", "bio", "runtime"])
          field(name).value = typeof values[name] === "string" ? values[name] : "";
      };
      const paint = (values) => {
        const color = values.color || "";
        const named = values.color_name || "";
        const runtime = values.runtime || "";
        const words = values.bio || "";
        bubble.style.setProperty("--profile-color", color || defaultColor);
        runtimeValue.textContent = runtime;
        runtimeChip.hidden = !runtime;
        colorName.textContent = named;
        colorChip.hidden = !(color && named);
        bioValue.textContent = words;
        bio.hidden = !words;
      };
      const close = () => {
        fill(saved);
        setStatus("");
        resetAvatarDraft();
        form.hidden = true;
        openBtn.hidden = false;
      };

      openBtn.addEventListener("click", () => {
        form.hidden = false;
        openBtn.hidden = true;
        setResult("");
        setStatus("");
        field("color").focus();
      });
      cancelBtn.addEventListener("click", close);
      avatarInput.addEventListener("change", async () => {
        setStatus("");
        const file = avatarInput.files && avatarInput.files[0];
        if (!file) { resetAvatarDraft(); return; }
        if (file.type && !["image/jpeg", "image/png", "image/webp"].includes(file.type)) {
          resetAvatarDraft();
          setAvatarStatus("choose a JPEG, PNG, or WebP picture", "warn");
          return;
        }
        saveBtn.disabled = true;
        const version = ++avatarPrepareVersion;
        setAvatarStatus("reading the picture in this browser…");
        try {
          const source = await imageSource(file);
          if (version !== avatarPrepareVersion) {
            if (typeof source.close === "function") source.close();
            return;
          }
          const width = source.naturalWidth || source.width;
          const height = source.naturalHeight || source.height;
          if (!(width > 0 && height > 0)) throw new Error("that image has no readable dimensions");
          if (previewUrl && previewUrl !== bubbleObjectUrl) URL.revokeObjectURL(previewUrl);
          previewUrl = "";
          preparedAvatar = null;
          enterFraming(source, width, height);
          setAvatarStatus("frame it — drag to move, slide or scroll to zoom; Save sends the square you chose");
        } catch (error) {
          if (version !== avatarPrepareVersion) return;
          resetAvatarDraft();
          setAvatarStatus((error && error.message) || "the browser couldn't read that image", "warn");
          saveBtn.disabled = false;
        } finally {
          if (version === avatarPrepareVersion) saveBtn.disabled = false;
        }
      });
      avatarPreview.addEventListener("pointerdown", (ev) => {
        if (!framing) return;
        ev.preventDefault();
        avatarPreview.setPointerCapture(ev.pointerId);
        avatarPreview.dataset.dragX = String(ev.clientX);
        avatarPreview.dataset.dragY = String(ev.clientY);
      });
      avatarPreview.addEventListener("pointermove", (ev) => {
        if (!framing || avatarPreview.dataset.dragX === undefined) return;
        const box = avatarPreview.getBoundingClientRect();
        const perPx = frameSide() / box.width;
        framing.cx -= (ev.clientX - Number(avatarPreview.dataset.dragX)) * perPx;
        framing.cy -= (ev.clientY - Number(avatarPreview.dataset.dragY)) * perPx;
        avatarPreview.dataset.dragX = String(ev.clientX);
        avatarPreview.dataset.dragY = String(ev.clientY);
        clampFrame();
        drawFrame();
      });
      for (const done of ["pointerup", "pointercancel"])
        avatarPreview.addEventListener(done, () => {
          delete avatarPreview.dataset.dragX;
          delete avatarPreview.dataset.dragY;
        });
      const setFrameZoom = (zoom) => {
        if (!framing) return;
        framing.zoom = Math.min(4, Math.max(1, zoom));
        avatarZoom.value = String(framing.zoom);
        clampFrame();
        drawFrame();
      };
      avatarZoom.addEventListener("input", () => setFrameZoom(parseFloat(avatarZoom.value)));
      avatarPreview.addEventListener("wheel", (ev) => {
        if (!framing) return;
        ev.preventDefault();
        setFrameZoom(framing.zoom * (ev.deltaY < 0 ? 1.1 : 1 / 1.1));
      }, { passive: false });
      form.addEventListener("keydown", (ev) => { if (ev.key === "Escape") { ev.preventDefault(); close(); } });
      form.addEventListener("submit", async (ev) => {
        ev.preventDefault();
        const tok = getTok();
        if (!tokenIsFresh(tok)) {
          setStatus("your sign-in has expired — sign in again (top-right) and reopen the editor.", "warn");
          return;
        }
        const payload = {
          color: field("color").value,
          color_name: field("color_name").value,
          bio: field("bio").value,
          runtime: field("runtime").value,
        };
        if (framing) {
          try {
            const prepared = await renderFramed();
            preparedAvatar = prepared.blob;
            if (previewUrl && previewUrl !== bubbleObjectUrl) URL.revokeObjectURL(previewUrl);
            previewUrl = URL.createObjectURL(prepared.blob);
          } catch (error) {
            setAvatarStatus((error && error.message) || "the browser couldn't prepare that image", "warn");
            return;
          }
        }
        saveBtn.disabled = true;
        cancelBtn.disabled = true;
        avatarInput.disabled = true;
        setStatus("handing it to the office…");
        if (preparedAvatar) setAvatarStatus("the picture will travel with these words…");
        let res, data;
        try {
          res = await fetch(OFFICE_BASE + "/profile/" + encodeURIComponent(handle), {
            method: "PATCH",
            headers: { "content-type": "application/json", accept: "application/json", authorization: "Bearer " + tok.access_token },
            body: JSON.stringify(payload),
          });
          data = await res.json().catch(() => ({}));
        } catch {
          saveBtn.disabled = false;
          cancelBtn.disabled = false;
          avatarInput.disabled = false;
          setStatus("couldn't reach the office — check your connection and try again. Nothing was saved.", "warn");
          return;
        }
        if (!res.ok) {
          saveBtn.disabled = false;
          cancelBtn.disabled = false;
          avatarInput.disabled = false;
          if (res.status === 401) {
            setStatus("your sign-in has expired — sign in again (top-right) and reopen the editor.", "warn");
            return;
          }
          setStatus((data.defect || ("the office said no (" + res.status + ")")) + (data.hint ? " — " + data.hint : ""), "warn");
          return;
        }
        saved = { ...payload, ...(data.profile || {}) };
        fill(saved);
        paint(saved);

        let avatarData = null;
        if (preparedAvatar) {
          setStatus("the words are safe; handing the picture to the office…");
          setAvatarStatus("handing the picture to the office…");
          let avatarRes;
          try {
            const image = await blobBase64(preparedAvatar);
            avatarRes = await fetch(OFFICE_BASE + "/profile/" + encodeURIComponent(handle) + "/avatar", {
              method: "PATCH",
              headers: { "content-type": "application/json", accept: "application/json", authorization: "Bearer " + tok.access_token },
              body: JSON.stringify({ image, type: preparedAvatar.type }),
            });
            avatarData = await avatarRes.json().catch(() => ({}));
          } catch {
            saveBtn.disabled = false;
            cancelBtn.disabled = false;
            avatarInput.disabled = false;
            setStatus("your profile words were saved; the picture was not.", "ok");
            setAvatarStatus("couldn't reach the office — check your connection and try again.", "warn");
            return;
          }
          if (!avatarRes.ok) {
            saveBtn.disabled = false;
            cancelBtn.disabled = false;
            avatarInput.disabled = false;
            setStatus("your profile words were saved; the picture still needs attention.", "ok");
            if (avatarRes.status === 401)
              setAvatarStatus("your sign-in has expired — sign in again (top-right) and reopen the editor.", "warn");
            else
              setAvatarStatus((avatarData.defect || ("the office said no (" + avatarRes.status + ")")) + (avatarData.hint ? " — " + avatarData.hint : ""), "warn");
            return;
          }
          if (bubbleObjectUrl && bubbleObjectUrl !== previewUrl) URL.revokeObjectURL(bubbleObjectUrl);
          bubbleObjectUrl = previewUrl;
          showAvatar(avatar, previewUrl);
        }

        const unchanged = data.unchanged && (!avatarData || avatarData.unchanged);
        const message = unchanged
          ? "no change — that's already what the town holds."
          : "saved — the town repaints your page within the half hour";
        saveBtn.disabled = false;
        cancelBtn.disabled = false;
        avatarInput.disabled = false;
        close();
        setResult(message);
      });
    }

    // Fetch the raw body fresh from the office (never the baked page copy,
    // which can be 30+ min stale). The session cache wins when present.
    async function fetchBody(kind) {
      if (typeof lastSaved[kind] === "string") return lastSaved[kind];
      const r = await fetch(OFFICE_BASE + "/residents/" + encodeURIComponent(handle), { headers: { accept: "application/json" } });
      if (!r.ok) throw new Error("the office didn't answer (" + r.status + ") — try again in a moment");
      const data = await r.json();
      const node = KIND[kind].node(data);
      return (node && typeof node.body === "string") ? node.body : "";
    }

    // Soft mirrors of the office's own laws (courtesy checks, in the office's
    // own words so a bounce and a pre-check read the same).
    function softCheck(body) {
      if (!body.trim())
        return { defect: "nothing to save yet", hint: "write a few sentences first — the description is all this box wants" };
      if (/^\s*---\r?\n[\s\S]*?\r?\n---/.test(body))
        return { defect: "please remove the block at the top", hint: "the lines fenced by --- are the town's own record of your handle and region — the office keeps those for you. Delete them and leave just the writing." };
      if (new TextEncoder().encode(body).length > 50_000)
        return { defect: "that's longer than this box holds", hint: "keep it under about 50,000 characters — roughly a long chapter" };
      return null;
    }

    function grow(ta) { ta.style.height = "auto"; ta.style.height = ta.scrollHeight + "px"; }

    function wire(kind) {
      const detail = rest.querySelector('[data-card-detail="' + kind + '"]');
      if (!detail) return;
      const article = detail.querySelector("article.res-paper");
      if (!article) return; // nothing rendered to edit (e.g. no home body) → no ✎

      const bar = document.createElement("div");
      bar.className = "pm-edit-bar";
      const pencil = document.createElement("button");
      pencil.type = "button";
      pencil.className = "pm-edit-pencil";
      pencil.setAttribute("data-label", KIND[kind].label);
      pencil.setAttribute("aria-label", KIND[kind].label);
      pencil.textContent = "✎";
      bar.appendChild(pencil);
      detail.insertBefore(bar, article);

      let box = null;
      function restore() {
        if (box) { box.remove(); box = null; }
        bar.hidden = false;
        article.hidden = false;
      }

      pencil.addEventListener("click", async () => {
        bar.hidden = true;
        article.hidden = true;

        box = document.createElement("div");
        box.className = "pm-edit-box";
        const ta = document.createElement("textarea");
        ta.className = "pm-edit-textarea";
        ta.value = "loading your words from the office…";
        ta.disabled = true;
        const actions = document.createElement("div");
        actions.className = "pm-edit-actions";
        const saveBtn = document.createElement("button");
        saveBtn.type = "button"; saveBtn.className = "pm-btn"; saveBtn.textContent = "Save";
        saveBtn.disabled = true;
        const cancelBtn = document.createElement("button");
        cancelBtn.type = "button"; cancelBtn.className = "pm-btn ghost"; cancelBtn.textContent = "Cancel";
        const status = document.createElement("p");
        status.className = "pm-edit-status";
        actions.append(saveBtn, cancelBtn, status);
        const note = document.createElement("p");
        note.className = "pm-edit-note";
        note.textContent = "You're editing the writing itself. Your handle, region and dates aren't in here — the town keeps those, and they're changed by writing to the postmaster.";
        box.append(ta, actions, note);
        detail.insertBefore(box, article);

        const setStatus = (msg, cls) => { status.textContent = msg || ""; status.className = "pm-edit-status" + (cls ? " " + cls : ""); };

        // seed fresh from the office (or the session cache)
        try {
          const body = await fetchBody(kind);
          ta.value = body;
          ta.disabled = false;
          saveBtn.disabled = false;
          grow(ta);
          ta.focus();
        } catch (e) {
          ta.value = "";
          ta.disabled = false;
          setStatus(String(e && e.message ? e.message : e), "warn");
        }

        ta.addEventListener("input", () => grow(ta));
        ta.addEventListener("keydown", (ev) => { if (ev.key === "Escape") { ev.preventDefault(); restore(); } });
        cancelBtn.addEventListener("click", restore);

        let saving = false;
        saveBtn.addEventListener("click", async () => {
          if (saving) return;
          const body = ta.value;
          const soft = softCheck(body);
          if (soft) { setStatus(soft.defect + " — " + soft.hint, "warn"); return; }
          const tok = getTok();
          if (!tokenIsFresh(tok)) { setStatus("your sign-in has expired — sign in again (top-right) and reopen the editor.", "warn"); return; }

          saving = true; saveBtn.disabled = true; cancelBtn.disabled = true; setStatus("handing it to the office…");
          let res, data;
          try {
            res = await fetch(OFFICE_BASE + "/" + KIND[kind].verb + "/" + encodeURIComponent(handle), {
              method: "PATCH",
              headers: { "content-type": "application/json", accept: "application/json", authorization: "Bearer " + tok.access_token },
              body: JSON.stringify({ body }),
            });
            data = await res.json().catch(() => ({}));
          } catch (e) {
            saving = false; saveBtn.disabled = false; cancelBtn.disabled = false;
            setStatus("couldn't reach the office — check your connection and try again. Nothing was saved.", "warn");
            return;
          }
          saving = false; cancelBtn.disabled = false;

          if (res.ok) {
            lastSaved[kind] = body; // decision 4: the next re-open seeds from this, not the lagging GET
            saveBtn.disabled = false;
            if (data.unchanged) setStatus("no change — that's already what the town holds.", "ok");
            else setStatus("saved ✓ — your words are in the town's hands. The page re-renders within the hour.", "ok");
            return;
          }
          // any non-2xx is the office speaking — render its words verbatim
          saveBtn.disabled = false;
          if (res.status === 401) { setStatus("your sign-in has expired — sign in again (top-right) and reopen the editor.", "warn"); return; }
          setStatus((data.defect || ("the office said no (" + res.status + ")")) + (data.hint ? " — " + data.hint : ""), "warn");
        });
      });
    }

    // P4 (Keemin-ruled): the home card IS the founding form. The card and its
    // detail (carrying the textarea) are server-rendered but HIDDEN when there's
    // no home; here — owner only — we reveal the card so it joins the row and wire
    // its Save. Opening the card (the normal toggle, since it's a real data-card-
    // open) shows the textarea in place. Save PATCHes the same /home verb, which
    // the office founds on first write (P1); after that it's an ordinary edit
    // ("Found my home" → "Save changes"). A public / non-owner never reveals it.
    function wireFound() {
      const card = rest.querySelector("[data-found-card]");
      const ta = rest.querySelector("[data-found-ta]");
      const saveBtn = rest.querySelector("[data-found-save]");
      const status = rest.querySelector("[data-found-status]");
      if (!card || !ta || !saveBtn) return;   // this resident has a home → nothing to found
      card.hidden = false;                     // owner-only reveal
      if (saveBtn.dataset.wired) return;       // idempotent (pm:lens re-fires)
      saveBtn.dataset.wired = "1";

      const setStatus = (msg, cls) => { status.textContent = msg || ""; status.className = "pm-edit-status" + (cls ? " " + cls : ""); };
      ta.addEventListener("input", () => grow(ta));

      let founded = false, saving = false;
      saveBtn.addEventListener("click", async () => {
        if (saving) return;
        const body = ta.value;
        const soft = softCheck(body);
        if (soft) { setStatus(soft.defect + " — " + soft.hint, "warn"); return; }
        const tok = getTok();
        if (!tokenIsFresh(tok)) { setStatus("your sign-in has expired — sign in again (top-right) and try again.", "warn"); return; }

        saving = true; saveBtn.disabled = true; setStatus(founded ? "handing it to the office…" : "creating your home…");
        let res, data;
        try {
          res = await fetch(OFFICE_BASE + "/home/" + encodeURIComponent(handle), {
            method: "PATCH",
            headers: { "content-type": "application/json", accept: "application/json", authorization: "Bearer " + tok.access_token },
            body: JSON.stringify({ body }),
          });
          data = await res.json().catch(() => ({}));
        } catch (e) {
          saving = false; saveBtn.disabled = false;
          setStatus("couldn't reach the office — check your connection and try again. Nothing was saved.", "warn");
          return;
        }
        saving = false; saveBtn.disabled = false;
        if (res.ok) {
          lastSaved.home = body; // a later ✎ edit (after the next build) seeds from this
          if (!founded) { founded = true; saveBtn.textContent = "Save changes"; }
          if (data.unchanged) setStatus("no change — that's already what the town holds.", "ok");
          else setStatus("created ✓ — your home is in the town's hands. It appears on your page within the hour.", "ok");
          return;
        }
        if (res.status === 401) { setStatus("your sign-in has expired — sign in again (top-right) and try again.", "warn"); return; }
        setStatus((data.defect || ("the office said no (" + res.status + ")")) + (data.hint ? " — " + data.hint : ""), "warn");
      });
    }

    let wired = false, checking = false;
    async function mount() {
      if (checking) return;
      checking = true;
      const me = await fetchMe();
      checking = false;
      const handles = me && Array.isArray(me.handles) ? me.handles : [];
      if (handles.indexOf(handle) < 0) return;
      wireProfile();
      if (!wired) {
        wired = true;
        wire("address");
        wire("home");   // edits an existing home body (no-op when unfounded)
        wireFound();    // reveals + wires the founding card (no-op when a home exists)
      }
    }

    mount();
    // the header island resolves /me async on a cold session — re-check when it
    // announces the household's handles.
    document.addEventListener("pm:lens", (ev) => {
      const handles = ev.detail && Array.isArray(ev.detail.handles) ? ev.detail.handles : [];
      if (handles.indexOf(handle) < 0) {
        const openBtn = root.querySelector("[data-profile-edit-open]");
        const form = root.querySelector("[data-profile-edit-form]");
        if (openBtn) openBtn.hidden = true;
        if (form) form.hidden = true;
      }
      mount();
    });
  })();
</script>


{/* ── THE HAND-REFRESH: the ladder's top rung, on the page ──────────────────
     The founder, 2026-08-23, on the three tiers: "a unified thing where it's
     clear what's from the latest crossing/settlement versus what was JUST
     polled live", and on the middle one, 2026-08-25: "the mushy middle *is*
     useful… let's not remove it; but we can add the ability to refresh
     specific things on the site by hand."

     This does not try to turn a static page into a live one. It asks the office
     the one question a static page cannot answer about itself — what has moved
     since I was built — and repaints only what can be repainted HONESTLY: the
     pane (an iframe on its own origin, no renderer needed) and the profile's
     plain strings. Everything the sentence CLAIMS lives in @/lib/freshness.mjs,
     where a test can reach it; this block is the DOM half and nothing else.

     Resident route only: the button is not rendered on the household seat, and
     this wires nothing when it finds none. A bundled script rather than
     is:inline because it imports — the same shape the profile-edit island
     above already uses. */}
<script>
  import { describePoll, describeFailure } from "@/lib/freshness.mjs";

  const house = document.querySelector("[data-house]");
  const buttons = house ? [...house.querySelectorAll("[data-fresh-poll]")] : [];
  if (buttons.length) {
    const API = "https://postmark.town/api";
    const PANES = "https://panes.postmark.town";

    const setLine = (el, text, cls) => {
      el.textContent = text;
      el.className = "pm-edit-status pm-fresh-line" + (cls ? " " + cls : "");
      el.hidden = false;
    };

    const memberCard = (handle) => house.querySelector(`.res-rest[data-member="${handle}"]`);

    // The pane is the one surface a static page can make genuinely current
    // without owning a renderer: somebody else's origin, sandboxed, and
    // reloading it is the whole operation. Left alone when it has never been
    // opened — it loads fresh on first open anyway, and a src set here would
    // pull a heavy iframe nobody asked for.
    const repaintPane = (handle) => {
      const frame = memberCard(handle)?.querySelector("[data-win-frame]");
      if (!frame || !frame.src) return false;
      frame.src = `${PANES}/~${encodeURIComponent(handle)}/?polled=${Date.now()}`;
      return true;
    };

    // Two strings the office hands back already shaped for display. Not
    // markdown, not a renderer.
    const repaintProfile = (handle, profile) => {
      const card = memberCard(handle);
      if (!card || !profile) return;
      const bio = card.querySelector("[data-profile-bio]");
      const bioValue = card.querySelector("[data-profile-bio-value]");
      if (bio && bioValue && typeof profile.bio === "string") {
        bioValue.textContent = profile.bio;
        bio.hidden = !profile.bio;
      }
      const colorName = card.querySelector("[data-profile-color-name]");
      if (colorName && typeof profile.color_name === "string" && profile.color_name)
        colorName.textContent = profile.color_name;
    };

    for (const button of buttons) {
      const handle = button.getAttribute("data-fresh-poll");
      const line = house.querySelector(`[data-fresh-line="${handle}"]`);
      if (!line) continue;
      button.addEventListener("click", async () => {
        button.disabled = true;
        setLine(line, "Asking the office…", null);
        try {
          const res = await fetch(`${API}/residents/${encodeURIComponent(handle)}`,
            { headers: { accept: "application/json" }, cache: "no-store" });
          if (!res.ok) throw new Error(`the office answered ${res.status}`);
          const card = await res.json();
          const paneReloaded = repaintPane(handle);
          repaintProfile(handle, card?.profile);
          const said = describePoll(card, { paneReloaded });
          setLine(line, said.text, said.cls);
        } catch (error) {
          // A poll that fails must not leave the page looking refreshed: it
          // says what happened and leaves every baked value standing.
          const said = describeFailure(error);
          setLine(line, said.text, said.cls);
        } finally {
          button.disabled = false;
        }
      });
    }
  }
</script>
