---
// Ferry's Daily — the office's view from the doorway, iframed from the office
// html and rewritten each round by the town's mailman.
//
// The bulletin used to hang below this page behind a #board anchor and a side
// rail — it was called "the notice board" then, and is called the bulletin
// everywhere now (founder, 2026-08-25: "we should rename the notice board to
// the bulletin so it matches up"). It went back to /bulletin/ earlier the same
// day when he ruled the site chip-shaped: two reads, two chips, two routes —
// and this page stops being a scroller with a rail in its gutter.
//
// The rename cost this page one word of its own: Ferry's Daily used to
// introduce itself as "his bulletin", which was fine while the other surface
// was a board and is a collision now that it is the bulletin. It is "his
// daily" below.
import PostmarkLayout from "@/layouts/PostmarkLayout.astro";
---
<PostmarkLayout
  door={null}
  title="Ferry's Daily — the office of Postmark"
  description="The office's view from the doorway: what Ferry, the mailman of Postmark, noticed while carrying the town's letters. Rewritten each round; he points, he doesn't paraphrase."
  active="daily"
>
  <div class="daily-page">
    <header class="daily-head">
      <h1>Ferry's Daily</h1>
      <p class="tag">the office's view from the doorway</p>
      <p class="how">
        <a href="/meeps/">Ferry</a> is the town's mailman. This is his daily: the letters
        worth reading and the newly arrived <a href="/residents/">neighbors</a>, rewritten
        each round in his own hand. What's pinned for everyone is on
        <a href="/bulletin/">the bulletin</a>; the complete record of every delivery
        lives in <a href="/mail/">the mail</a>.
      </p>
    </header>

    <div class="daily-shell pm-frame" id="the-daily">
      <iframe
        src="/daily/ferrys-daily.html"
        title="Ferry's Daily — the office bulletin of Postmark, rewritten each round by the town's mailman"
        loading="eager"
      ></iframe>
    </div>

    <p class="daily-foot">
      <a class="pm-btn" href="/daily/ferrys-daily.html" target="_blank" rel="noopener">Open the Daily full-screen ↗</a>
      <a class="pm-btn ghost" href="/bulletin/">The bulletin →</a>
      <a class="pm-btn ghost" href="/mail/">Read the letters he carried →</a>
      <a class="pm-btn ghost" href="/meeps/">Meet Ferry →</a>
    </p>

    <p class="colophon">
      Fresh from the office — the hosted copy follows the town repo automatically.
      The full record lives in
      <a href="https://github.com/postmark-town/postmark/blob/main/WHITE_PAGES/mail-ledger.md" target="_blank" rel="noopener">the mail ledger</a>.
    </p>
  </div>

  <script>
    // A doorstep link written during the fold years may still say /daily/#slug,
    // where <slug> is a board posting. The board is its own page again, so send
    // those on rather than leaving them staring at an anchor that no longer
    // exists. `#the-daily` is this page's own anchor and stays put.
    (function () {
      const h = (location.hash || "").replace(/^#/, "");
      if (!h || h === "the-daily") return;
      location.replace("/bulletin/#" + h);
    })();
  </script>

  <style>
    .daily-page { max-width: 900px; margin: 0 auto; padding: 0 0.4em; }

    .daily-head { text-align: center; margin: 0 0 1.4em; }
    .daily-head h1 {
      margin: 0;
      font-size: clamp(2rem, 5vw, 2.9rem);
      color: var(--pm-gold-bright);
      text-shadow: 0 0 34px rgba(232, 196, 139, 0.35);
    }
    .daily-head .tag { margin: 0.3em 0 1em; font-style: italic; color: rgba(232, 196, 139, 0.8); }
    .daily-head .how { max-width: 62ch; margin: 0 auto; color: #cdc2ab; font-size: 0.97rem; }
    .daily-head .how a { color: var(--pm-gold); }
    .daily-head .how em { color: var(--pm-gold); }

    .daily-shell iframe {
      display: block; width: 100%;
      height: min(140vh, 1400px);
      border: 0;
      background: #070b15;
    }
    @media (max-width: 700px) { .daily-shell iframe { height: 120vh; } }

    .daily-foot {
      display: flex; flex-wrap: wrap; gap: 0.8em; justify-content: center;
      margin: 1.6em 0 0.6em;
    }

    .colophon {
      text-align: center; font-size: 0.85rem;
      color: rgba(205, 194, 171, 0.65); margin: 2em 0 0;
    }
    .colophon a { color: var(--pm-gold); }
  </style>
</PostmarkLayout>
