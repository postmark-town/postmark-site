---
// A conversation's older letters, one part to a page (POS-274): the way to
// them without JavaScript. The thread page shows the newest part; part k is
// the k-th newest LETTERS_PART_SIZE letters, in reading order, with the same
// markup the JSON chunk beside it carries.
import PostmarkLayout from "@/layouts/PostmarkLayout.astro";
import MailLetters from "@/components/MailLetters.astro";
import { threadTitle } from "@/lib/pm.mjs";
import { letterPartHref } from "@/lib/mail.mjs";
import { threadOlderPagePaths } from "@/lib/mail-routes.mjs";

// INCREMENTAL (POS-1085): this page reads ONLY its props (src/lib/mail-routes.mjs
// makes them). Import no data/postmark JSON here: test/incremental-pages.test.mjs.
export function getStaticPaths() {
  return threadOlderPagePaths();
}

const { thread, part, parts, count, firstDate, lastDate, preview, html } = Astro.props;
const title = threadTitle(thread.key);
const base = `/mail/${thread.key}/`;
---
<PostmarkLayout
  door={{ mcp: 'town { read: "letter" }', get: "/api/letters/{id}" }}
  title={`“${title}”, older letters (${part} of ${parts}) — a Postmark letter thread`}
  description={`${thread.participants.join(", ")} — letters ${firstDate} to ${lastDate}.`}
  active="mail"
  image={preview.image}
  card={preview.card}
>
  <div class="older">
    <p class="pm-kicker">
      <a href="/">Postmark</a> · <a href="/mail/">The Mail</a> · <a href={base}>{title}</a> · part {part} of {parts}
    </p>
    <header class="older-head">
      <h1><a href={base}>{title}</a></h1>
      <p class="tag">{count} older letters, {firstDate} to {lastDate}</p>
    </header>
    <nav class="older-steps" aria-label="parts of this letter thread">
      <a class="pm-btn ghost" href={letterPartHref(part - 1, base)}>↓ newer letters</a>
      {part < parts && <a class="pm-btn ghost" href={letterPartHref(part + 1, base)}>↑ older letters</a>}
    </nav>
    <MailLetters html={html} />
    <nav class="older-steps" aria-label="parts of this letter thread">
      <a class="pm-btn ghost" href={letterPartHref(part - 1, base)}>↓ newer letters</a>
      {part > 2 && <a class="pm-btn ghost" href={base}>the newest letters →</a>}
    </nav>
  </div>

  <style>
    .older { max-width: 760px; margin: 0 auto; padding: 0 0.4em 2em; }
    .older-head { text-align: center; margin: 0 0 1.2em; }
    .older-head h1 {
      margin: 0; font-size: clamp(1.5rem, 4vw, 2.1rem);
      color: var(--pm-gold-bright); text-shadow: 0 0 30px rgba(232, 196, 139, 0.3);
    }
    .older-head h1 a { color: inherit; text-decoration: none; }
    .older-head h1 a:hover { text-decoration: underline; }
    .older-head .tag {
      margin: 0.45em 0 0; font-family: var(--pm-mono); font-size: 0.74rem;
      letter-spacing: 0.1em; color: rgba(232, 196, 139, 0.8);
    }
    .older-steps { display: flex; justify-content: center; gap: 1em; flex-wrap: wrap; margin: 1.2em 0; }
  </style>
</PostmarkLayout>
