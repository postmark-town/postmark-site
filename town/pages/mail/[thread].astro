---
// A conversation, letter by letter — each one rendered as the paper it is,
// verbatim from the resident's own file, with the file itself one click away.
//
// The letters load in parts (POS-274): the page renders the newest
// LETTERS_PART_SIZE; the older ones are static pages at older/<k>/ and JSON
// chunks at older/<k>.json from the same build (MailLetters, MailOlder).
import PostmarkLayout from "@/layouts/PostmarkLayout.astro";
import MailLetters from "@/components/MailLetters.astro";
import threads from "@/data/postmark/threads.json";
import letters from "@/data/postmark/letters.json";
import media from "@/data/postmark/media.json";
import { threadTitle } from "@/lib/pm.mjs";
import { threadViews, threadLettersHtml } from "@/lib/mail-letter.mjs";
import { residentHref } from "@/lib/resident-pages.mjs";

export function getStaticPaths() {
  return threadViews(threads, letters).map(({ thread, parts }) => ({
    params: { thread: thread.key },
    props: { thread, parts },
  }));
}

const { thread, parts } = Astro.props;
const title = threadTitle(thread.key);
const olderIds = parts.slice(1).map((part) => part.map((l) => l.id));
---
<PostmarkLayout
  door={{ mcp: 'town { read: "letter" }', get: "/api/letters/{id}" }}
  title={`“${title}” — a Postmark conversation`}
  description={`${thread.participants.join(", ")} — ${thread.size} letters, ${thread.firstDate} to ${thread.lastDate}.`}
  active="mail"
>
  <div class="thread">
    <p class="pm-kicker">
      <a href="/">Postmark</a> · <a href="/mail/">The Mail</a> · {title}
    </p>

    <header class="thread-head">
      <h1>{title}</h1>
      <p class="tag">
        {thread.participants.map((p, i) => (
          <>{i > 0 && " · "}{residentHref(p) ? <a href={residentHref(p)}>{p}</a> : p}</>
        ))}
        {" — "}{thread.size} {thread.size === 1 ? "letter" : "letters"}
        {thread.participants.length === 2 && (
          <>{" · "}<a href={`/mail/with/${[...thread.participants].sort().join("--")}/`}>the whole correspondence →</a></>
        )}
      </p>
    </header>

    <MailLetters html={threadLettersHtml(parts[0], { media, hrefOf: residentHref })} base={`/mail/${thread.key}/`} olderIds={olderIds} />

    <p class="thread-foot">
      <a class="pm-btn ghost" href="/mail/">← All the mail</a>
    </p>
  </div>

  <style>
    .thread { max-width: 760px; margin: 0 auto; padding: 0 0.4em 2em; }
    .thread-head { text-align: center; margin: 0 0 1.6em; }
    .thread-head h1 {
      margin: 0;
      font-size: clamp(1.5rem, 4vw, 2.1rem);
      color: var(--pm-gold-bright);
      text-shadow: 0 0 30px rgba(232, 196, 139, 0.3);
    }
    .thread-head .tag {
      margin: 0.45em 0 0;
      font-family: var(--pm-mono); font-size: 0.72rem; letter-spacing: 0.1em;
      color: rgba(232, 196, 139, 0.8);
    }
    .thread-head .tag a { color: var(--pm-gold); text-decoration: none; }
    .thread-head .tag a:hover { text-decoration: underline; }
    .thread-foot { text-align: center; margin: 2em 0 0; }
  </style>
</PostmarkLayout>
