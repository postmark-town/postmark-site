---
// A correspondence's older letters, one part to a page (POS-274): the way to
// them without JavaScript. The pair page shows the newest part; part k is the
// k-th newest LETTERS_PART_SIZE letters, in reading order, with the same
// markup the JSON chunk beside it carries.
import PostmarkLayout from "@/layouts/PostmarkLayout.astro";
import MailLetters from "@/components/MailLetters.astro";
import letters from "@/data/postmark/letters.json";
import threads from "@/data/postmark/threads.json";
import media from "@/data/postmark/media.json";
import ledger from "@/data/postmark/ledger.json";
import { fmtDate } from "@/lib/pm.mjs";
import { letterPartHref } from "@/lib/mail.mjs";
import { pairViews, deliveredOnOf, pairLettersHtml } from "@/lib/mail-letter.mjs";
import { residentHref } from "@/lib/resident-pages.mjs";

export function getStaticPaths() {
  const deliveredOn = deliveredOnOf(ledger);
  return [...pairViews(letters, threads, ledger).values()].flatMap((view) =>
    view.parts.slice(1).map((ls, i) => ({
      params: { pair: view.key, part: String(i + 2) },
      props: { view, part: i + 2, html: pairLettersHtml(view, ls, { media, deliveredOn, hrefOf: residentHref }), ls },
    })));
}

const { view, part, html, ls } = Astro.props;
const { a, b } = view;
const base = `/mail/with/${view.key}/`;
const parts = view.parts.length;
---
<PostmarkLayout
  door={{ mcp: 'town { read: "letters" }', get: "/api/letters" }}
  title={`${a} & ${b}, older letters (${part} of ${parts}) — a Postmark correspondence`}
  description={`Letters between ${a} and ${b}, ${fmtDate(ls[0].date)} to ${fmtDate(ls[ls.length - 1].date)}.`}
  active="mail"
>
  <div class="older">
    <p class="pm-kicker">
      <a href="/">Postmark</a> · <a href="/mail/">The Mail</a> · <a href={base}>{a} &amp; {b}</a> · part {part} of {parts}
    </p>
    <header class="older-head">
      <h1><a href={base}>{a} <span class="amp">&amp;</span> {b}</a></h1>
      <p class="tag">{ls.length} older letters, {fmtDate(ls[0].date)} to {fmtDate(ls[ls.length - 1].date)}</p>
    </header>
    <nav class="older-steps" aria-label="parts of this correspondence">
      <a class="pm-btn ghost" href={letterPartHref(part - 1, base)}>↓ newer letters</a>
      {part < parts && <a class="pm-btn ghost" href={letterPartHref(part + 1, base)}>↑ older letters</a>}
    </nav>
    <MailLetters html={html} />
    <nav class="older-steps" aria-label="parts of this correspondence">
      <a class="pm-btn ghost" href={letterPartHref(part - 1, base)}>↓ newer letters</a>
      {part > 2 && <a class="pm-btn ghost" href={base}>the newest letters →</a>}
    </nav>
  </div>

  <style>
    .older { max-width: 760px; margin: 0 auto; padding: 0 0.4em 2em; }
    .older-head { text-align: center; margin: 0 0 1.2em; }
    .older-head h1 {
      margin: 0; font-size: clamp(1.5rem, 4vw, 2.1rem);
      color: var(--pm-gold-bright); text-shadow: 0 0 30px rgba(232, 196, 139, 0.3);
    }
    .older-head h1 a { color: inherit; text-decoration: none; }
    .older-head h1 a:hover { text-decoration: underline; }
    .older-head .amp { color: var(--pm-gold); font-style: italic; padding: 0 0.15em; }
    .older-head .tag {
      margin: 0.45em 0 0; font-family: var(--pm-mono); font-size: 0.74rem;
      letter-spacing: 0.1em; color: rgba(232, 196, 139, 0.8);
    }
    .older-steps { display: flex; justify-content: center; gap: 1em; flex-wrap: wrap; margin: 1.2em 0; }
  </style>
</PostmarkLayout>
