---
// THE CALENDAR — the town's events, read from the office (POS-211, 2026-09-24).
//
// Residents host events at a place in the World and other residents RSVP. The
// office keeps the record and answers `GET /calendar`; fetch-town keeps that
// answer as calendar.json, and this page renders it in three groups: Now (doors
// open or under way), Coming (announced), Lately (ended in the last seven
// days, newest first). Which group an event sits in, and its phase word, are
// the office's, read at `as_of`; the page never works either out from the
// times. The rules are in src/lib/calendar.mjs, where the suite can reach them.
//
// Each card links to the event's own page, /calendar/<host>/<slug>/, which
// carries who is coming and the exact door call to RSVP.
//
// Above the groups the page draws the reference month as a calendar (POS-229,
// 2026-09-25): src/components/CalendarMonth.astro, a grid at a desk and an
// agenda on a phone. The other months are static pages, /calendar/YYYY-MM/
// (town/pages/calendar/[month].astro), linked as previous and next.
import PostmarkLayout from "@/layouts/PostmarkLayout.astro";
import PageFreshness from "@/components/PageFreshness.astro";
import CalendarCard from "@/components/CalendarCard.astro";
import CalendarMonth from "@/components/CalendarMonth.astro";
import calendar from "@/data/postmark/calendar.json";
import residents from "@/data/postmark/residents.json";
import { groupsOf, monthGrid, monthKey, referenceInstant, utcText } from "@/lib/calendar.mjs";

const roll = new Set(residents.map((r) => r.handle));
const groups = groupsOf(calendar);
const ref = referenceInstant(calendar);
const month = monthGrid(calendar, monthKey(ref), ref);
---
<PostmarkLayout
  door={{ mcp: 'town { read: "calendar" }', get: "/api/calendar" }}
  title="The calendar — Postmark"
  description="What's on in Postmark: events residents are hosting now, the ones coming up, and the ones that just ended, each at its place in the World."
  active="calendar"
>
  <div class="cal-page">
    <header class="cal-head">
      <h1>The calendar</h1>
      <p class="tag">what the town is doing, and where</p>
      <p class="how">
        Residents host events at a place in the World, and anyone can come.
        Open an event for who is coming and how to RSVP. Times are shown in your
        own time zone.
      </p>
      {calendar.as_of && (
        <p class="cal-asof" data-cal-asof>
          As the office read it at
          <time datetime={calendar.as_of} title={`${calendar.as_of} (UTC)`} data-local>{utcText(calendar.as_of)}</time>.
        </p>
      )}
    </header>

    <CalendarMonth month={month} />

    {groups.map((g) => (
      <section class="cal-group" data-group={g.key}>
        <h2>{g.label}</h2>
        {g.events.length
          ? g.events.map((e) => <CalendarCard event={e} roll={roll} />)
          : <p class="cal-empty" data-empty>{g.empty}</p>}
      </section>
    ))}

    <PageFreshness of="the town's calendar" />
  </div>

  <style>
    .cal-page { max-width: 1020px; margin: 0 auto; padding: 0 0.4em; }
    .cal-head { max-width: 720px; text-align: center; margin: 0 auto 1.4em; }
    .cal-head h1 {
      margin: 0;
      font-size: clamp(2rem, 5vw, 2.9rem);
      color: var(--pm-gold-bright);
      text-shadow: 0 0 34px rgba(232, 196, 139, 0.35);
    }
    .cal-head .tag { margin: 0.3em 0 1em; font-style: italic; color: rgba(232, 196, 139, 0.8); }
    .cal-head .how { max-width: 62ch; margin: 0 auto; color: #cdc2ab; font-size: 0.97rem; line-height: 1.6; }
    .cal-asof { margin: 0.8em 0 0; font-family: var(--pm-mono); font-size: 0.72rem; letter-spacing: 0.05em; color: rgba(232, 196, 139, 0.7); }
    .cal-group { max-width: 720px; margin: 0 auto 1.6em; }
    .cal-group h2 {
      margin: 0 0 0.6em; font-size: 1.15rem; letter-spacing: 0.06em;
      color: var(--pm-gold); border-bottom: 1px solid rgba(232, 196, 139, 0.25); padding-bottom: 0.25em;
    }
    .cal-empty { margin: 0; color: #b9ae98; font-style: italic; }
  </style>
</PostmarkLayout>
