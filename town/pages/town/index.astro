            <span>{tankBoard.staked == null ? "uncounted" : "staked on them"}</span>
          </li>
          <li>
            <b>{tankBoard.households == null ? "—" : tankBoard.households}</b>
            <span>{tankBoard.households == null ? "uncounted" : tankBoard.households === 1 ? "household backing" : "households backing"}</span>
          </li>
          <li><b>{tankBoard.drawn}</b> <span>drawn as blueprints</span></li>
        </ul>

        {tankBoard.backers.length > 0 ? (
          <ol class="q-stand d-stand">
            {tankBoard.backers.map((b, n) => (
              <li class="q-row d-row">
                <span class="q-rank">{n + 1}</span>
                <a class="q-who" href={`/residents/${b.household}/`}>{b.household}</a>
                <span class="q-pair"><span class="q-k">ideas backed</span> {b.ideas}</span>
                <span class="q-all">{b.stamps}<span class="q-u">✦</span></span>
              </li>
            ))}
          </ol>
        ) : (
