            {tankStages.map((g) => (
              <div class="m-stage">
                <p class="m-lab" title={`${g.ideas.length} ${g.ideas.length === 1 ? "idea" : "ideas"} · most-backed first`}>{g.stage}</p>
                <div class="m-grid">
                  {g.ideas.map((i) => (
                <article class="m-card is-idea">
                  <p class="m-kind">{i.by ?? "the town"}</p>
                  <h3 class="m-title">{i.title}</h3>
                  {i.body && <p class="m-body">{i.body}</p>}
