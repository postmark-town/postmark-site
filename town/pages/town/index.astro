      {asOfText && <p class="c-asof">as of {asOfText}</p>}
      </div>
      <LaneTutorial lane={LANE_BY.quests} slides={tutorialFor("quests")} />
    </section>

    {/* ── THE THINK TANK ──────────────────────────────────────────────── */}
    <section class="c-lane" id="ideas" data-panel="ideas" style={tintVars("ideas")}>
