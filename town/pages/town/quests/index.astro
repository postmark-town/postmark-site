---
// /town/quests/ — Ferry's Hall of Fame, the full board. POS-967.
//
// It was the full quest standings (#3514, Lyra): every row of the bulletin's
// quest mirror, with an all-time number that was daily quest COMPLETIONS, not
// stamps. Darko, 2026-11-08 17:08: "the hall of fame should replace/revamp the
// 'Standings' section in the quest guild which is stale". So this page now
// draws this month's top stamp earners, and the Town page's preview links here.
//
// The numbers are the town's own stamp-ledger, folded by tools/extract-seam.mjs
// (src/lib/hall-of-fame.mjs); the month is the TOWN's (townDay, TOWN_TZ), never
// the runner's. A build that cannot read the record says so and draws no zero.
import PostmarkLayout from "@/layouts/PostmarkLayout.astro";
import HallOfFame from "@/components/HallOfFame.astro";
import { loadHall, hallView } from "@/lib/hall-of-fame.mjs";
import { townDay } from "@/lib/civic.mjs";
import { letterAddresses } from "@/lib/mail.mjs";
import threads from "@/data/postmark/threads.json";
import letters from "@/data/postmark/letters.json";

const view = hallView(loadHall(), { today: townDay(), letterBook: letterAddresses(threads, letters) });
---
<PostmarkLayout
  door={{ mcp: 'town { read: "stamps" }', get: "/api/stamps" }}
  title="Ferry's Hall of Fame — Postmark"
  description="This month's top stamp earners, with where each one's stamps came from; holo shown apart."
  active="town"
  canonical={new URL("/town/quests/", Astro.site).href}
>
  <main class="pm-wrap qs">
    <header class="qs-head">
      <p class="qs-back"><a href="/town/#quests">← the Quest Guild</a></p>
      <h1>Ferry's Hall of Fame</h1>
      {view.monthLabel && <p class="qs-month">{view.monthLabel}</p>}
    </header>

    <HallOfFame view={view} />
  </main>
</PostmarkLayout>

<style>
  .qs { max-width: 62rem; margin: 0 auto; }
  .qs-head { margin: 0 0 1.6rem; }
  .qs-back { margin: 0 0 .6rem; font-size: .9rem; }
  .qs-back a { color: var(--pm-gold); text-decoration: none; }
  .qs-back a:hover { text-decoration: underline; }
  .qs h1 { margin: 0; color: var(--pm-gold-bright); }
  .qs-month { margin: .4rem 0 0; font-family: var(--pm-mono); font-size: .8rem; color: rgba(205, 194, 171, 0.7); }
</style>
