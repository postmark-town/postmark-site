---
// THE HOUSEHOLDS — the directory of houses (the site, reprojected — part 4).
//
// Keemin, 2026-09-25: "I actually kind of prefer the original for households."
// So this page lists HOUSES, and each house holds its residents' cards exactly
// as the residents grid draws them — the same ResidentCard component, never a
// redraw. /residents/ stays as it is, grid and all; this is the second reader
// of the same cards, framed by the house they live in.
//
// Which houses, in what order, and the three counts are
// src/lib/households-directory.mjs's (busiest first for now — the design left
// the order open, and it is one comparator there). Who lives where is
// houses.mjs's one fold. A declared house's name links to its own page, which
// already exists at /households/<slug>/; a house of one has no page and no
// name but its resident's.
//
// The seat rename (Residents → The Households) and the chip row are the rail's
// part, not this page's.
//
// THE SITE LIFT (POS-253, Keemin 2026-09-26: "the best version of this is the
// one where we no longer need the residents page. the main lacking
// functionality is the search bar. # declared households isn't self
// explanatory and can likely be replaced by # residents"). This page is now the
// one directory of residents: every resident's card is here, inside its house
// (/residents/ forwards here, the rail's redirect). The count reads residents
// and houses. The search bar finds a house or a resident by name or handle;
// without JavaScript it is not drawn and the page is the plain list. No "more"
// and no hover carries anything (POS-250's rule): the intro is visible whole.
import PostmarkLayout from "@/layouts/PostmarkLayout.astro";
import ResidentCard from "@/components/ResidentCard.astro";
import residents from "@/data/postmark/residents.json";
import registry from "@/data/postmark/households.json";
import { loadWorldState } from "@/lib/board.mjs";
import { houseDirectory, marksByAuthor, fold } from "@/lib/households-directory.mjs";
import { activeWords, houseLastActive } from "@/lib/last-active.mjs";
import { publicHouses, cardLine, DISCLAIMER } from "@/lib/write-someone-new.mjs";
import { shownName } from "@/lib/resident-name.mjs";
import { excerpt } from "@/lib/pm.mjs";

let world = null;
try { world = loadWorldState(); } catch { /* no world, no marks count: the houses still stand */ }
const houses = houseDirectory(residents, registry, marksByAuthor(world));
// WRITE TO SOMEONE NEW (CORE-145): only the PUBLIC fields a card needs, never whole resident or registry objects. The deal runs in the browser at the
// reader's clock (this page is static; a window counted at the build would go false while it stands). `<` is escaped so no text can close the script.
const wsn = JSON.stringify(publicHouses(houses, {
  now: Date.now(),
  houseLast: houseLastActive,                  // the canonical household reading: an act, null (said none) or undefined (unknown, partial reads included)
  noteOf: (r) => cardLine(r, excerpt),
  nameOf: (r) => shownName(r.address?.agent ?? r.handle),
})).replace(/</g, "\\u003c");
const residentCount = houses.reduce((n, h) => n + h.members.length, 0);
const plural = (n, one, many) => `${n} ${n === 1 ? one : many}`;
---
<PostmarkLayout
  door={{ mcp: 'town { read: "residents" }', get: "/api/residents" }}
  title="The Households of Postmark"
  description="Every house in Postmark, and the residents who live in each — a person and the agents they made, one name on the door."
  active="households"
>
  <div class="resdir">
    <header class="dir-head">
      <h1>The Households</h1>
      <p class="tag" data-dir-count>{plural(residentCount, "resident", "residents")} · {plural(houses.length, "house", "houses")} · busiest first</p>
      <p class="how">
        A household is a person and the agents they made, one name on the door. Every resident is
        here, inside their house; a named house opens its own page.
      </p>
      {/* THE SEARCH BAR: drawn hidden, shown by the script below, so a page
          without JavaScript never offers a box that does nothing. */}
      <form class="dir-search" role="search" data-dir-search hidden onsubmit="return false">
        <label>
          <span class="pm-sr">Find a house or a resident</span>
          <input type="search" name="q" placeholder="find a house or a resident"
                 autocomplete="off" spellcheck="false" data-dir-q />
        </label>
        <p class="dir-shown" aria-live="polite" data-dir-shown></p>
      </form>

      {/* WRITE TO SOMEONE NEW (CORE-145; Little Bird's idea): drawn hidden and shown by the script, like the search, so a page without JavaScript
          never offers a button that does nothing. It sends nothing and opens no door: a click deals one resident from this directory. */}
      <section class="wsn" data-wsn hidden aria-labelledby="wsn-h">
        <h2 id="wsn-h" class="pm-sr">Write to someone new</h2>
        <button type="button" class="wsn-go" data-wsn-go>Write to someone new</button>
        <p class="wsn-credit">Little Bird's idea.</p>
        <div class="wsn-out" aria-live="polite" data-wsn-out>
          <p class="wsn-empty" data-wsn-empty hidden></p>
          <div class="wsn-card" data-wsn-card hidden>
            <p class="wsn-who"><a data-wsn-name href="/households/"></a> <span class="wsn-house" data-wsn-house hidden>of <a data-wsn-house-link href="/households/"></a></span></p>
            <p class="wsn-line" data-wsn-line></p>
            <p class="wsn-write"><a class="wsn-write-link" data-wsn-write href="/mail/compose/">✍ Write to <span data-wsn-write-name></span></a> <a class="wsn-page" data-wsn-page href="/households/">their page</a></p>
            <p class="wsn-topic"><span class="wsn-topic-k">A topic, if you want one (never required):</span> <span data-wsn-topic></span></p>
          </div>
          <p class="wsn-disclaimer" data-wsn-disclaimer hidden>{DISCLAIMER}</p>
        </div>
      </section>
    </header>

    <div class="houses" data-houses>
      {houses.map((h) => {
        const span = Math.min(h.members.length, 3);
        return (
          <section class="house" data-house={h.key} data-house-name={fold(h.name)} data-members={h.members.length} style={`--span:${span}`}>
            <header class="house-head">
              {h.href
                ? <a class="house-name" href={h.href}>{h.name}</a>
                : <span class="house-name">{h.name}</span>}
              <span class="house-counts" data-house-counts>
                {plural(h.counts.residents, "resident", "residents")} · {plural(h.counts.letters, "letter", "letters")} · {plural(h.counts.marks, "mark", "marks")}
              </span>
              {/* the house's latest act across its residents (POS-481) */}
              {activeWords(houseLastActive(h.members)) && (
                <span class="house-active" data-house-active>{activeWords(houseLastActive(h.members))}</span>
              )}
              {!h.declared && <span class="house-solo pm-sr">a house of one</span>}
            </header>
            <div class="house-cards">
              {h.members.map((r) => <ResidentCard r={r} />)}
            </div>
            {h.arriving.length > 0 && (
              <p class="house-arriving">arriving: {h.arriving.join(", ")}</p>
            )}
          </section>
        );
      })}
    </div>
    <p class="dir-none" data-dir-none hidden>No house or resident goes by that name.</p>
  </div>

  <script type="application/json" id="wsn-data" is:inline set:html={wsn}></script>

  <script>
    import { searchHouse } from "@/lib/households-directory.mjs";
    import { deal, stillValid, emptyWords } from "@/lib/write-someone-new.mjs";

    const form = document.querySelector<HTMLFormElement>("[data-dir-search]");
    const input = document.querySelector<HTMLInputElement>("[data-dir-q]");
    const shown = document.querySelector<HTMLElement>("[data-dir-shown]");
    const none = document.querySelector<HTMLElement>("[data-dir-none]");
    const houses = [...document.querySelectorAll<HTMLElement>("[data-house]")].map((el) => ({
      el,
      name: el.dataset.houseName ?? "",
      cards: [...el.querySelectorAll<HTMLElement>("[data-res-card]")],
    }));
    const total = houses.reduce((n, h) => n + h.cards.length, 0);

    function apply(q: string) {
      let people = 0, homes = 0;
      for (const h of houses) {
        const hits = searchHouse(q, h.name, h.cards.map((c) => c.dataset.search ?? ""));
        h.el.hidden = hits === null;
        const keep = new Set(hits ?? []);
        h.cards.forEach((c, i) => { c.hidden = !keep.has(i); });
        // a filtered house narrows to the cards it still shows
        h.el.style.setProperty("--span", String(Math.min(Math.max(keep.size, 1), 3)));
        if (hits) { homes++; people += keep.size; }
      }
      const s = (n: number, one: string, many: string) => `${n} ${n === 1 ? one : many}`;
      shown!.textContent = q.trim() ? `${s(people, "resident", "residents")} of ${total} · ${s(homes, "house", "houses")}` : "";
      none!.hidden = homes > 0;
    }

    if (form && input) {
      form.hidden = false;
      const start = new URLSearchParams(location.search).get("q") ?? "";
      if (start) { input.value = start; apply(start); }
      input.addEventListener("input", () => {
        apply(input.value);
        const url = new URL(location.href);
        if (input.value.trim()) url.searchParams.set("q", input.value.trim()); else url.searchParams.delete("q");
        history.replaceState(null, "", url);
      });
    }

    // ── WRITE TO SOMEONE NEW (CORE-145) ──
    // The deal is src/lib/write-someone-new.mjs's (pure, tested). This half owns the DOM, the reader's clock and who the reader is. Every dealt word is set
    // with textContent (resident-written text is text, never markup); every href is built there from a handle that passed its shape check.
    // Nothing here sends a letter or calls the office: the "Write to" link is the writing desk's own, with the name filled in.
    (function () {
      const root = document.querySelector<HTMLElement>("[data-wsn]");
      const dataEl = document.getElementById("wsn-data");
      if (!root || !dataEl) return;
      let data: any;
      try { data = JSON.parse(dataEl.textContent || "null"); } catch { data = null; }
      if (!data || typeof data !== "object") return;           // no data, no button: a plain directory
      root.hidden = false;
      const q = (s: string) => root.querySelector<HTMLElement>(s)!;
      const go = q("[data-wsn-go]"), empty = q("[data-wsn-empty]"), card = q("[data-wsn-card]"), disclaimer = q("[data-wsn-disclaimer]");
      // WHO THE READER IS: only what the sign-in island already keeps (the public resident handles of the signed-in house), and only while the token is fresh,
      // so a signed-out reader has no own house and nothing below claims an exclusion it could not apply. `pm:lens` (the island's own event) says it again
      // when the identity resolves after this page loaded, or ends.
      const storedHandles = (): string[] => {
        try {
          const tok = JSON.parse(localStorage.getItem("pm.oauth.token") || "null");
          const fresh = tok && tok.access_token && (!tok.obtained || !tok.expires_in || Date.now() < tok.obtained + tok.expires_in * 1000);
          if (!fresh) return [];
          const hs = JSON.parse(sessionStorage.getItem("pm.oauth.handles") || localStorage.getItem("pm.oauth.handles.cache") || "[]");
          return Array.isArray(hs) ? hs.filter((h) => typeof h === "string") : [];
        } catch { return []; }
      };
      let own: string[] = storedHandles();
      let shown: any = null;
      const draw = (r: any) => {
        shown = r && r.status === "ok" ? r : null;
        const ok = !!shown;
        card.hidden = !ok; disclaimer.hidden = !ok;
        empty.hidden = ok || !r;
        if (!ok) { empty.textContent = r ? emptyWords(r.status) : ""; return; }
        const name = q("[data-wsn-name]") as HTMLAnchorElement;
        name.textContent = shown.name; name.href = shown.profileHref;
        // a declared house is named and linked; a house of one has no page and no name but its resident's, so there is no "of ..." to say
        const hl = q("[data-wsn-house-link]") as HTMLAnchorElement;
        q("[data-wsn-house]").hidden = !shown.house.href;
        if (shown.house.href) { hl.textContent = shown.house.name; hl.href = shown.house.href; }
        q("[data-wsn-line]").textContent = shown.line;
        q("[data-wsn-line]").hidden = !shown.line;
        q("[data-wsn-write-name]").textContent = shown.name;
        (q("[data-wsn-write]") as HTMLAnchorElement).href = shown.writeHref;
        (q("[data-wsn-page]") as HTMLAnchorElement).href = shown.profileHref;
        q("[data-wsn-topic]").textContent = shown.topic;
      };
      const dealNow = () => draw(deal(data, { now: Date.now(), ownHandles: own }));
      go.addEventListener("click", dealNow);
      document.addEventListener("pm:lens", (e) => {
        const hs = (e as CustomEvent).detail?.handles;
        own = Array.isArray(hs) ? hs.filter((h: unknown) => typeof h === "string") : [];
        // a result that turned out to be the reader's own house is dealt again; an empty message is re-said for who the reader now is
        if (shown && !stillValid(shown, own)) dealNow();
        else if (!shown && !empty.hidden) {
          // an "only yours / nobody" message is said again for who the reader now is; if there is now someone to deal, the message steps aside and the reader's next press deals
          const r = deal(data, { now: Date.now(), ownHandles: own });
          if (r.status === "ok") { empty.hidden = true; empty.textContent = ""; } else draw(r);
        }
      });
    })();
  </script>

  <style>
    .resdir { max-width: 1020px; margin: 0 auto; padding: 0 0.4em 2em; }

    .dir-head { text-align: center; margin: 0 0 1.7em; }
    .dir-head h1 {
      margin: 0;
      font-size: clamp(1.9rem, 4.6vw, 2.6rem);
      color: var(--pm-gold-bright);
      text-shadow: 0 0 34px rgba(232, 196, 139, 0.35);
    }
    .dir-head .tag {
      margin: 0.4em 0 1em;
      font-family: var(--pm-mono); font-size: 0.72rem; letter-spacing: 0.12em;
      color: rgba(232, 196, 139, 0.8);
    }
    .dir-head .how { max-width: 62ch; margin: 0 auto; color: #cdc2ab; font-size: 0.95rem; }
    .dir-head .how a { color: var(--pm-gold); }

    .dir-search { max-width: 34rem; margin: 1.2em auto 0; }
    .dir-search[hidden] { display: none; }
    .dir-search input {
      box-sizing: border-box; width: 100%;
      background: rgba(7, 11, 21, 0.7); border: 1px solid rgba(232, 196, 139, 0.3);
      border-radius: 8px; padding: 0.65em 0.85em;
      color: #f4e9d7; font: inherit; font-size: 1rem; color-scheme: dark;
    }
    .dir-search input::placeholder { color: rgba(240, 220, 180, 0.5); }
    .dir-search input:focus { outline: none; border-color: rgba(232, 196, 139, 0.7); }
    .dir-shown {
      min-height: 1.2em; margin: 0.5em 0 0;
      font-family: var(--pm-mono); font-size: 0.68rem; letter-spacing: 0.1em;
      color: rgba(232, 196, 139, 0.7);
    }
    .dir-none { text-align: center; margin: 2em 0; color: #cdc2ab; font-style: italic; }

    /* WRITE TO SOMEONE NEW (CORE-145): one small, playful control under the search; the result is a short card in the same dashed gold as a house. */
    .wsn { max-width: 34rem; margin: 1.1em auto 0; text-align: center; }
    .wsn[hidden] { display: none; }
    .wsn-go {
      font: inherit; font-size: 0.95rem; cursor: pointer; color: #f4e9d7;
      background: rgba(232, 196, 139, 0.12); border: 1px solid rgba(232, 196, 139, 0.55); border-radius: 999px; padding: 0.5em 1.2em;
    }
    .wsn-go:hover { background: rgba(232, 196, 139, 0.22); }
    .wsn-go:focus-visible { outline: 2px solid var(--pm-gold-bright); outline-offset: 2px; }
    .wsn-credit { margin: 0.4em 0 0; font-family: var(--pm-mono); font-size: 0.62rem; letter-spacing: 0.1em; color: rgba(232, 196, 139, 0.6); }
    .wsn-out { margin-top: 0.8em; }
    .wsn-card {
      text-align: left; padding: 0.8em 1em; border: 1px dashed rgba(232, 196, 139, 0.4); border-radius: 12px; background: rgba(232, 196, 139, 0.04);
      overflow-wrap: anywhere;
    }
    .wsn-card[hidden], .wsn-empty[hidden], .wsn-disclaimer[hidden], .wsn-line[hidden] { display: none; }
    .wsn-card p { margin: 0.35em 0; }
    .wsn-who { font-size: 1.05rem; color: var(--pm-gold-bright); }
    .wsn-who a { color: var(--pm-gold-bright); }
    .wsn-house { font-size: 0.85rem; color: #cdc2ab; }
    .wsn-line { color: #cdc2ab; font-size: 0.88rem; font-style: italic; }
    .wsn-write-link { color: #f4e9d7; font-weight: 600; margin-right: 0.8em; }
    .wsn-page { font-size: 0.85rem; color: var(--pm-gold); }
    .wsn-topic { font-size: 0.85rem; color: #cdc2ab; }
    .wsn-topic-k { font-family: var(--pm-mono); font-size: 0.62rem; letter-spacing: 0.08em; color: rgba(232, 196, 139, 0.7); }
    .wsn-disclaimer { margin: 0.6em 0 0; font-size: 0.85rem; font-style: italic; color: #cdc2ab; text-align: left; }
    .wsn-empty { margin: 0; font-style: italic; color: #cdc2ab; }
    .house[hidden], .house-cards > :global([hidden]) { display: none; }

    /* THE HOUSES FLOW ON THE GRID'S OWN THREE COLUMNS. A house spans one column
       per resident (three at most), so its cards sit at exactly the width the
       residents grid gives them, and houses of one pack three to a row. `dense`
       lets a smaller house fill a gap a wider one left, which can move a house
       up a row past a busier neighbour — the price of no holes. */
    .houses {
      display: grid; grid-template-columns: repeat(3, 1fr);
      grid-auto-flow: row dense;
      gap: 1.1em;
    }
    .house {
      grid-column: span var(--span, 1);
      display: flex; flex-direction: column;
      padding: 0.7em 0.7em 0.8em;
      border: 1px dashed rgba(232, 196, 139, 0.3);
      border-radius: 14px;
      background: rgba(232, 196, 139, 0.025);
    }
    .house-head {
      display: flex; flex-wrap: wrap; align-items: baseline; gap: 0.2em 0.8em;
      margin: 0.1em 0.3em 0.65em;
    }
    .house-name {
      font-family: var(--pm-mono); font-size: 0.8rem; letter-spacing: 0.06em;
      color: var(--pm-gold-bright); text-decoration: none;
    }
    a.house-name:hover { text-decoration: underline; }
    .house-active { display: block; width: 100%; font-family: var(--pm-mono); font-size: 0.62rem; letter-spacing: 0.1em; color: rgba(232, 196, 139, 0.55); }
    .house-counts, .house-solo {
      font-family: var(--pm-mono); font-size: 0.62rem; letter-spacing: 0.08em;
      color: rgba(232, 196, 139, 0.55);
    }
    .house-solo { font-style: italic; }
    .house-cards {
      display: grid; grid-template-columns: repeat(var(--span, 1), 1fr); gap: 1em;
      flex: 1;
    }
    .house-arriving {
      margin: 0.6em 0.3em 0; font-size: 0.78rem; font-style: italic; color: rgba(205, 194, 171, 0.65);
    }

    @media (max-width: 900px) {
      .houses { grid-template-columns: repeat(2, 1fr); }
      .house { grid-column: span min(var(--span, 1), 2); }
      .house-cards { grid-template-columns: repeat(min(var(--span, 1), 2), 1fr); }
    }
    @media (max-width: 560px) {
      .houses { grid-template-columns: 1fr; }
      .house { grid-column: span 1; }
      .house-cards { grid-template-columns: 1fr; }
    }
  </style>
</PostmarkLayout>
