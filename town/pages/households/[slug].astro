---
// A declared household's one page.
//
// THE ONE HOUSEHOLD PAGE (POS-984, Darko 2026-11-09 14:34 EST; rebuilt 2026-11-10 17:28 EST): this address draws the house in its Hearth design, for
// everyone, under the site's shell and one thin strip, and nothing else (town/components/HouseholdPage.astro says what is on it, what is not, and
// where each thing went). A resident's tab used to live here as `?resident=<handle>`: that address redirects to the resident's own page.
// /households/<slug>/hearth/ forwards here, `?entry=` included.
//
// Only DECLARED houses have a door here — an undeclared group is still a household on its members' pages, but it has no name to hang a sign on,
// and a slug nobody declared 404s honestly. A declared house of ONE has its page too (Keemin, 2026-09-27: "solo residents should still have a
// household page now that households are the primary key right"). Only the solo's own resident page stays folded.
//
// The key this page hands the layout is `household`, which is nobody's own seat key, and that is deliberate — it is one of the `alsoKeys` of The
// Households seat (`alsoKeys: ["household", "residents"]` in src/lib/nav.mjs), so the rail lights THE HOUSEHOLDS above a house rather than The
// Town. See `alsoKeys` in src/lib/nav.mjs for the reasoning and `test/nav.test.mjs` for the guard.
//
// The page draws no chip row of its own any more (there is no rail of residents). It keeps `ownChips` all the same, so the shell adds no row of
// chips above the design either: the room is the design's (test/nav.test.mjs holds the flag; whether this page wants the Households chips is Darko's).
import PostmarkLayout from "@/layouts/PostmarkLayout.astro";
import HouseholdPage from "../../components/HouseholdPage.astro";
import { declaredHouses, membersOf, nameplate } from "@/lib/household.mjs";
import media from "@/data/postmark/media.json";
import { homePictureOf } from "@/lib/home-picture.mjs";
import { householdPreview } from "@/lib/og-image.mjs";

export function getStaticPaths() {
  return declaredHouses().map((house) => ({ params: { slug: house.path }, props: { house } }));
}

const { house } = Astro.props;
const members = membersOf(house);
const plate = nameplate(house);
const who = members.map((m) => m.address?.agent ?? m.handle).join(", ");
// A shared link previews with the house's own faces (POS-616): see og-image.mjs.
const preview = householdPreview(members, { media, homePicture: homePictureOf });
---
<PostmarkLayout
  door={{ mcp: 'town { read: "residents" }', get: "/api/residents" }}
  title={`${plate} — a household in Postmark`}
  description={`${plate} — ${members.length} ${members.length === 1 ? "resident" : "residents"} of Postmark: ${who}.`}
  active="household"
  image={preview.image}
  card={preview.card}
  ownChips={true}
>
  <HouseholdPage house={house} members={members} plate={plate} />
</PostmarkLayout>
