---
// A declared household's own front door.
//
// The same wrapper every resident page wears, entered by the house instead of
// by one of its residents: this address lands on the HOUSEHOLD SEAT — the
// house's own dashboard, the rail's first tab (ruling 2026-08-07) — and moving
// to a member keeps this address (?resident=<handle>) rather than walking off
// to a resident page. Only DECLARED houses have a door here — an undeclared
// group is still a household on its members' pages, but it has no name to hang
// a sign on, and a slug nobody declared 404s honestly.
//
// A declared house of ONE has no seat to land on (the wrapper stays folded for
// solos), so it opens on its single member exactly as it did before.
//
// The key this page hands the layout is `household`, which is nobody's seat
// key, and that is deliberate — it is how the rail lights RESIDENTS above a
// house rather than The Town. It used to hand over `residents` directly, which
// lit The Town, because residents was a room of the town then: the reader
// clicked one seat and watched a different one turn on.
//
// The rescue used to hang off the YOUR HOUSE seat, which is retired as of
// 2026-08-25 ("the resident names when signed in more than suffice"). The key
// moved to the Residents seat with the same one-line mechanism, renamed
// `alsoKey` now that no house seat carries it — see `alsoKey` in
// src/lib/nav.mjs for the reasoning and `test/nav.test.mjs` for the guard.
import PostmarkLayout from "@/layouts/PostmarkLayout.astro";
import Household from "../../components/Household.astro";
import { declaredHouses, membersOf, nameplate, isShared } from "@/lib/household.mjs";

export function getStaticPaths() {
  return declaredHouses().map((house) => ({ params: { slug: house.slug }, props: { house } }));
}

const { house } = Astro.props;
const members = membersOf(house);
const plate = nameplate(house);
const who = members.map((m) => m.address?.agent ?? m.handle).join(", ");
// A SHARED HOUSE DRAWS ITS OWN MEMBER RAIL, so it takes no row from the nav —
// the same predicate the resident pages hand the layout. Before the rail was
// reprojected (part 6) this never mattered: `household` lit a seat with no row.
// Now it lights The Households, whose row would stack over the house's own.
---
<PostmarkLayout
  door={{ mcp: 'town { read: "residents" }', get: "/api/residents" }}
  title={`${plate} — a household in Postmark`}
  description={`${plate}${house.human ? `, ${house.human}’s household` : ""} — ${members.length} ${members.length === 1 ? "resident" : "residents"} of Postmark: ${who}.`}
  active="household"
  ownChips={isShared(house, members)}
>
  <Household house={house} members={members} active="__house" route="household" />
</PostmarkLayout>
