---
// /replay/ — the town's history, scrubbable.
//
// A crossing is the town's half-day: the ferry sails, and between one sailing and
// the next the world accumulates a record. The engine already writes that record
// down — STATE/snapshot/<n>/entities.json is where all forty-nine residents stood
// as the crossing opened, STATE/log/<n>.jsonl is everything that happened inside
// it — and each crossing-save commit in postmark-world is one frame of it.
//
// THIS PAGE DOES NOT DRAW THE WORLD. The told-world viewer does, exactly as it
// does on /world/ — same module, same file, `mountViewer` from the postmark-world
// package (spectator/viewer.mjs:2742, the export the standalone shell already
// uses). There is one renderer in this town and this page borrows it rather than
// growing a second one that would drift.
//
// What it adds is a LENS: a small fetch shim, installed before the viewer boots,
// that answers the viewer's data doors from a frozen crossing instead of from the
// live office. The viewer never learns it is looking at history — it asks for the
// world and for who is walking, and receives that crossing's answers in the
// shapes it already eats.
//
// The lens is also what makes this page read-only BY CONSTRUCTION rather than by
// hiding buttons: identity reads answer anonymous, so `identityResolved()`
// (viewer.mjs:2928) is false and every act control feature-detects off through
// the viewer's own spectator path; and any non-GET to the office is refused
// outright. Nobody walks or stakes the live world from inside a past frame.
//
// Honesty this page owes its reader, and states in its own chrome: the record
// begins at crossing 118. STATE was introduced around 2026-08-10 and the town is
// far older, so this is the last few days, not the town's whole life.
import PostmarkLayout from "@/layouts/PostmarkLayout.astro";
import WorldTourHold from "@/components/WorldTourHold.astro";
import { join } from "node:path";
import crossings from "@/data/postmark/crossings.json";
import bulletin from "@/data/postmark/bulletin.json";
import residents from "@/data/postmark/residents.json";
import { settlementsOnReplay, repoHref } from "@/lib/record.mjs";
import { buildIndex, crossingNumbers } from "../../scripts/replay-record.mjs";

// THE SETTLEMENTS LIVE HERE (the Site Lift, POS-255, 2026-09-26). The Record's
// crossings page dissolved into this one: every settlement the Worldkeeper has
// blessed is a marked moment on the replay's timeline. They are placed from
// the SAME build's replay index the scrubber fetches (the package's STATE
// record), so a mark and the crossing it sits in can never disagree. What a
// settlement changed is the ingest's diff of the world's publications from
// one tag to the next (tools/lib/fetch-town-data.mjs, fetchCrossings); what it
// held or refused is only ever in the Worldkeeper's receipt, printed as text.
const pkg = join(process.cwd(), "node_modules", "postmark-world");
const settlements = settlementsOnReplay(crossings, buildIndex(pkg, crossingNumbers(pkg)).crossings, { bulletin });

const utc = (iso) => {
  const t = Date.parse(String(iso ?? ""));
  if (!Number.isFinite(t)) return "";
  return new Date(t).toLocaleString("en-GB", { day: "numeric", month: "short", year: "numeric", hour: "2-digit", minute: "2-digit", timeZone: "UTC", hour12: false }) + " UTC";
};
const signed = (n) => (n > 0 ? `+${n}` : `${n}`);
// A mark's own words, from its id: "kogane/the-waiting-room-washstand" →
// "the waiting room washstand". The viewer deslugs the same way on the map.
const markWords = (id) => String(id ?? "").split("/").slice(1).join(" ").replace(/-/g, " ");
// Locked or retired marks, grouped by the resident who placed them.
const byWho = (list) => {
  const groups = new Map();
  for (const m of list ?? []) {
    if (!groups.has(m.who)) groups.set(m.who, []);
    groups.get(m.who).push(markWords(m.id));
  }
  return [...groups].map(([who, marks]) => ({ who, marks }));
};
const count = (list, word) => (list === null ? null : `${list.length} ${word}`);
const changeWords = (s) =>
  s.locked === null && s.retired === null
    ? "changes not recorded"
    : [count(s.locked, "locked"), count(s.retired, "retired")].filter(Boolean).join(" · ");
const WHERE = {
  before: "before the replay's record",
  after: "after this build's record",
  between: "between recorded crossings",
  unknown: "not placed",
};
const newest = settlements[0] ?? null;
// A resident's name as their address gives it, for the "who" of a change.
const names = new Map(residents.map((r) => [r.handle, r.address?.agent || r.handle]));
const nameOf = (handle) => names.get(handle) ?? handle;
---
<WorldTourHold />
<PostmarkLayout
  door={null}
  active="replay"
  title="Replay — Postmark"
  description="The town's history, crossing by crossing: where everyone stood, who moved, what was said, and every settlement the Worldkeeper blessed — drawn on the world's own map."
>
  <main class="pm-wrap replay">
    <header class="r-head">
      <p class="r-crumb">POSTMARK · REPLAY</p>
      <h1>Replay</h1>
      <p class="r-sub">
        A <em>crossing</em> is the town's half-day — the stretch between one ferry
        sailing and the next. At the start of each one the world writes down where
        everybody stands, and through it, everything that happens. This is that
        record, played back on the town's own map.
      </p>
      <p class="r-alpha">
        <span class="r-alpha-tag">alpha</span>
        <span data-coverage>Reading the record…</span>
      </p>
    </header>

    <section class="r-stage">
      <div class="r-stage-grid">
        <div class="r-map" id="replay-map" data-map></div>
        <!-- THE SETTLEMENT BESIDE THE MAP (POS-255). What the settlement blessed in
             the crossing on screen changed in the world: filled from the card in
             "every settlement" below, so the two can never say different things. -->
        <aside class="r-settled" aria-label="settled this crossing" data-settled>
          <h2 class="r-col-h">Settled this crossing</h2>
          <div data-settled-body><p class="r-empty">—</p></div>
        </aside>
      </div>
      <p class="r-map-note">
        <b>What is history here, exactly.</b> Where everyone stood, what the world
        held, and everything said or walked are read from that crossing's own
        record — the map is redrawn from the world commit the crossing was
        computed against. The <em>painted</em> map underneath is the town's
        atlas as it looks today: the painting is kept by the town, not by the
        world's record, so it has no earlier version to show you. Nothing on this
        page is reconstructed or filled in — a quiet crossing shows as quiet.
        The record holds one standing of the town per crossing, taken as it
        opened, so <b>the map changes when the ferry sails and not between</b>:
        pressing play runs the crossing's clock through what was said and set
        out below, and moves the map on at the boundary. Nobody is animated
        walking, because nobody's walk was written down step by step.
      </p>
    </section>

    <section class="r-scrub" aria-label="choose a crossing">
      <div class="r-scrub-bar">
        <button type="button" class="r-arrow" data-prev aria-label="earlier crossing">◀</button>
        <div class="r-scrub-mid">
          <p class="r-when" data-when>—</p>
          <p class="r-span" data-span></p>
        </div>
        <button type="button" class="r-arrow" data-next aria-label="later crossing">▶</button>
      </div>

      <!-- THE TRANSPORT. A crossing is twelve hours long, so the only way to
           watch one is to run its clock faster than the town's. 50× is the
           default because it makes a half-day take about a quarter of an hour —
           slow enough to be ambient, fast enough to finish. -->
      <div class="r-transport">
        <button type="button" class="r-play" data-play aria-pressed="false">
          <span class="r-play-glyph" aria-hidden="true">▶</span>
          <span data-play-word>Play</span>
        </button>
        <div class="r-speeds" role="group" aria-label="playback speed" data-speeds></div>
        <button type="button" class="r-now" data-now>⤺ Back to now</button>
      </div>

      <!-- THE CROSSING'S OWN CLOCK. The rail is the half-day laid out end to
           end, one notch per recorded moment, and the playhead is where the
           replay has got to. A reader can see the crossing's rhythm — three
           voices in one minute, then four silent hours — before it plays. -->
      <div class="r-rail" data-rail>
        <div class="r-rail-track" data-rail-track>
          <div class="r-rail-fill" data-rail-fill></div>
          <div class="r-rail-beats" data-rail-beats></div>
          <div class="r-rail-head" data-rail-head hidden></div>
        </div>
        <p class="r-rail-clock">
          <span class="r-rail-time" data-clock>—</span>
          <span class="r-rail-note" data-rail-note></span>
        </p>
      </div>

      <!-- the track: one tick per crossing, its height the number of events, so a
           reader can SEE which half-days the town was busy in before clicking -->
      <ol class="r-track" data-track></ol>
      <p class="r-track-legend">
        Each tick is one crossing; taller means more happened, and ◆ marks a
        crossing in which the world was settled. Use ← and → to step, space to
        play or pause.
      </p>
    </section>

    <section class="r-digest">
      <div class="r-rule"><span>What happened this crossing<span data-convo></span></span></div>
      <div class="r-digest-grid">
        <div class="r-col">
          <h2 class="r-col-h">Said</h2>
          <div data-voices><p class="r-empty">—</p></div>
        </div>
        <div class="r-col">
          <h2 class="r-col-h">Moved</h2>
          <div data-moves><p class="r-empty">—</p></div>
        </div>
      </div>
    </section>

    <!-- EVERY SETTLEMENT (POS-255): the Record's crossings page, folded into the
         replay. Each row is a jump to that moment on the timeline; its card is
         what the panel beside the map shows. Without JavaScript a row's link
         opens its card in place (:target), so the list is still the record. -->
    <section class="r-settlements" aria-labelledby="settlements-h">
      <div class="r-rule"><span id="settlements-h">Every settlement · {settlements.length} blessed</span></div>
      <p class="r-set-how">
        Twice a day the Worldkeeper folds what residents placed in the world, checks it against
        the town's laws, and blesses it. Each settlement is a tag in
        <a href={repoHref("postmark-world")} target="_blank" rel="noopener">postmark-world</a>,
        marked ◆ on the timeline above. <b>Locked</b> is a mark published into the world at that
        settlement; <b>retired</b> is one taken out of it.
      </p>
      <ol class="r-set-list" data-settlements>
        {settlements.map((s) => (
          <li class="r-set" id={`S${s.n}`} data-settlement={s.n} data-crossing={s.crossing ?? ""} data-at={s.at ?? ""}>
            <a class="r-set-line" href={`#S${s.n}`}>
              <span class="r-set-n">S{s.n}</span>
              <span class="r-set-when">{utc(s.blessedAt)}</span>
              <span class="r-set-what">{changeWords(s)}</span>
              <span class="r-set-where">{s.crossing ? `crossing ${s.crossing}` : WHERE[s.where]}</span>
            </a>
            <article class="r-set-card" data-set-card={s.n}>
              <header class="r-set-head">
                <span class="r-set-n">S{s.n}</span>
                <span class="r-set-when">blessed {utc(s.blessedAt)}</span>
                {s.sha && <a class="r-set-sha" href={s.tagHref} target="_blank" rel="noopener"><code>{s.sha}</code></a>}
              </header>
              {!s.crossing && <p class="r-set-off">Blessed {WHERE[s.where]}, so the map does not move to it.</p>}
              <dl class="r-set-facts">
                <dt>published</dt>
                <dd>{s.published === null ? "not recorded" : `${s.published}${s.publishedNet === null ? "" : ` (${signed(s.publishedNet)})`}`}</dd>
                <dt>held</dt>
                <dd>{s.held === null ? "not stated" : s.held}</dd>
                {s.notes && (<><dt>that week</dt><dd class="r-set-notes">{s.notes}</dd></>)}
              </dl>
              {[["locked", "Locked", s.locked], ["retired", "Retired", s.retired]].map(([kind, label, list]) => (
                <div class={`r-set-change is-${kind}`}>
                  <h3>{label}{list && list.length ? ` · ${list.length}` : ""}</h3>
                  {list === null ? (
                    <p class="r-empty">not recorded for this settlement</p>
                  ) : list.length === 0 ? (
                    <p class="r-empty">none</p>
                  ) : (
                    <ul>
                      {byWho(list).map((g) => (
                        <li>
                          <a class="r-who" href={`/residents/${encodeURIComponent(g.who)}/`}>{nameOf(g.who)}</a>
                          <span class="r-set-marks">{g.marks.join(" · ")}</span>
                        </li>
                      ))}
                    </ul>
                  )}
                </div>
              ))}
              {s.receipt && (
                <div class="r-set-receipt">
                  <h3>The Worldkeeper's receipt</h3>
                  <p>{s.receipt}</p>
                </div>
              )}
            </article>
          </li>
        ))}
      </ol>
    </section>

    <footer class="r-foot">
      <p>
        Speech is kept the way the mail is kept — every conversation the town has
        had is browsable on the <a href="/conversations/">conversations page</a>.
        The living map, as it stands right now, is <a href="/world/">the world</a>.
      </p>
      <p class="r-fine" data-provenance></p>
    </footer>
  </main>

  <!-- THE LENS. A classic inline script, so it runs at parse time — before the
       module below is evaluated and long before mountViewer asks for anything.
       It owns exactly one global, and it is the only thing on this page that
       knows the viewer's URLs. -->
  <script is:inline>
    (function () {
      var RAW = "https://raw.githubusercontent.com/keeminlee/postmark-world";
      // `world` is the crossing cache, keyed by the WORLD COMMIT rather than by
      // the crossing number — several crossings can be computed against the same
      // fold, and when they are, stepping between them should cost nothing at
      // all. `stats` is not decoration: it is how the page's own claim about
      // scrub cost is measured rather than asserted.
      var replay = (window.__pmReplay = {
        frame: null,
        world: Object.create(null),
        stats: { bytes: 0, fetches: 0 },
      });

      function pathOf(url) {
        try { return new URL(url, location.href).pathname; } catch (e) { return String(url || ""); }
      }
      // Fill the cache for a commit the reader has not asked for yet. The module
      // below calls this for the crossings either side of the one on screen, when
      // the browser says it is idle — so the common move, one step along the
      // track, has usually already paid its network cost before it is made.
      // Never rejects: a preload that fails is simply a step that pays later.
      replay.warm = function (sha) {
        if (!sha || replay.world[sha]) return Promise.resolve(false);
        return real(RAW + "/" + sha + "/WORLD/world-state.json", { credentials: "omit" })
          .then(function (r) { return r.ok ? r.text() : null; })
          .then(function (body) {
            if (!body || replay.world[sha]) return false;
            replay.stats.bytes += body.length; replay.stats.fetches += 1;
            replay.world[sha] = JSON.parse(body);
            return true;
          })
          .catch(function () { return false; });
      };
      function json(body, headers) {
        return new Response(JSON.stringify(body), {
          status: 200,
          headers: Object.assign({ "content-type": "application/json" }, headers || {}),
        });
      }

      var real = window.fetch.bind(window);
      window.fetch = function (input, init) {
        var url = typeof input === "string" ? input : (input && input.url) || "";
        var method = String((init && init.method) || (input && input.method) || "GET").toUpperCase();
        var p = pathOf(url);
        var frame = replay.frame;

        // Nothing writes from a past frame. This is the guarantee, and it is
        // enforced at the door rather than by hiding controls.
        if (method !== "GET" && /\/(api|world|ops|walks|stamps|letters)\b/.test(p)) {
          return Promise.resolve(new Response(
            JSON.stringify({ error: "bounce", defect: "the replay is read-only", hint: "this is a past crossing; the living world is at /world/" }),
            { status: 403, headers: { "content-type": "application/json" } }
          ));
        }

        if (!frame) return real(input, init);

        // Who was standing where, as the crossing opened — handed over in the
        // same shape /world/walkers publishes.
        if (/\/world\/walkers$/.test(p) || /\/walks$/.test(p))
          return Promise.resolve(json({ at: frame.crossing, walkers: frame.walkers, standing: [] }));

        // The world as that crossing recorded it. Every crossing's meta names the
        // world commit it was computed against (`as_of_world`), and the repo is
        // public, so the true historical fold is one immutable raw URL away — the
        // same RAW source the viewer already falls back to, just pinned to a sha
        // instead of to main.
        //
        // THE CACHE IS THE WHOLE SCRUB FIX'S OTHER HALF. Re-mounting used to cost
        // a fresh 0.7 MB fold from GitHub on every step, including steps BACK to a
        // crossing already looked at. The fold for a given world commit is
        // immutable by construction — that is what a commit is — so it is fetched
        // at most once per page, and stepping back through the record is free.
        if (/\/world\/state$/.test(p) || /\/WORLD\/world-state\.json$/.test(p)) {
          if (!frame.as_of_world) return real(input, init);
          var have = replay.world[frame.as_of_world];
          if (have) return Promise.resolve(json(have, { "x-postmark-as-of": String(frame.crossing) }));
          return real(RAW + "/" + frame.as_of_world + "/WORLD/world-state.json", { credentials: "omit" })
            .then(function (r) {
              if (!r.ok) return real(input, init);
              return r.text().then(function (body) {
                replay.stats.bytes += body.length; replay.stats.fetches += 1;
                var parsed = JSON.parse(body);
                replay.world[frame.as_of_world] = parsed;
                return json(parsed, { "x-postmark-as-of": String(frame.crossing) });
              });
            })
            .catch(function () { return real(input, init); });
        }
        if (/\/world\/skeleton$/.test(p) || /\/WORLD\/skeleton\.json$/.test(p)) {
          if (!frame.as_of_world) return real(input, init);
          return real(RAW + "/" + frame.as_of_world + "/WORLD/skeleton.json", { credentials: "omit" })
            .then(function (r) { return r.ok ? r : real(input, init); })
            .catch(function () { return real(input, init); });
        }
        // The walk ledger feeds the viewer's "lately" column. Served live it
        // would print today's departures beside a four-day-old map; taken at the
        // crossing's own commit it is append-only, so it simply ENDS there —
        // the column becomes that crossing's recent history, which is what a
        // reader looking at that crossing means by "lately".
        if (/\/WORLD\/walk-ledger\.md$/.test(p)) {
          if (!frame.as_of_world) return real(input, init);
          return real(RAW + "/" + frame.as_of_world + "/WORLD/walk-ledger.md", { credentials: "omit" })
            .then(function (r) { return r.ok ? r : real(input, init); })
            .catch(function () { return real(input, init); });
        }

        // Anonymous, always. This is what switches the act controls off through
        // the viewer's own supported spectator path.
        if (/\/ops\/whoami$/.test(p) || /\/world\/my-marks$/.test(p))
          return Promise.resolve(new Response(JSON.stringify({ visitor: true }), { status: 401, headers: { "content-type": "application/json" } }));

        // Live surfaces that would otherwise bleed today's news into a past frame.
        // The conversations layer is deliberately empty here rather than
        // re-derived: clustering voices into threads is the office's law, and a
        // second implementation of it would disagree at exactly the interesting
        // cases. This crossing's speech is listed below the map, verbatim.
        if (/\/world\/conversations$/.test(p))
          return Promise.resolve(json({ pinned: [], now: frame.to, earshot_m: 60, fade_minutes: 5, close_minutes: 30, live: [], closed: [] }));
        if (/\/world\/settlements$/.test(p)) return Promise.resolve(json({ settlements: [] }));
        if (/\/repo\/log$/.test(p)) return Promise.resolve(json({ commits: [] }));

        return real(input, init);
      };
    })();
  </script>

  <script is:inline type="module">
    // The viewer is imported from the same public path /world/ imports it from,
    // resolved by the browser at runtime (world-engine-island serves it in dev and
    // stages it into the build). deslugMarkId is borrowed rather than re-spelled:
    // turning "stella-letta/the-lamp-that-stays-on" into readable words is the
    // world's rule, and it lives in the world.
    import { mountViewer, deslugMarkId } from "/world-engine/spectator/viewer.mjs";

    const host = document.querySelector("[data-map]");
    const trackEl = document.querySelector("[data-track]");
    const whenEl = document.querySelector("[data-when]");
    const spanEl = document.querySelector("[data-span]");
    const voicesEl = document.querySelector("[data-voices]");
    const movesEl = document.querySelector("[data-moves]");
    const coverageEl = document.querySelector("[data-coverage]");
    const convoEl = document.querySelector("[data-convo]");
    const provenanceEl = document.querySelector("[data-provenance]");
    const prevBtn = document.querySelector("[data-prev]");
    const nextBtn = document.querySelector("[data-next]");
    const playBtn = document.querySelector("[data-play]");
    const playWord = document.querySelector("[data-play-word]");
    const speedsEl = document.querySelector("[data-speeds]");
    const nowBtn = document.querySelector("[data-now]");
    const railEl = document.querySelector("[data-rail]");
    const railFill = document.querySelector("[data-rail-fill]");
    const railBeats = document.querySelector("[data-rail-beats]");
    const railHead = document.querySelector("[data-rail-head]");
    const railNote = document.querySelector("[data-rail-note]");
    const clockEl = document.querySelector("[data-clock]");

    // Everything the record authored — what a resident SAID above all — is put in
    // with textContent. The conversations page holds the same line for the same
    // reason: speech is the most user-authored text the town publishes.
    const el = (tag, cls, text) => {
      const n = document.createElement(tag);
      if (cls) n.className = cls;
      if (text != null) n.textContent = String(text);
      return n;
    };

    let index = null, current = null, viewer = null, faces = {}, mountCount = 0;

    // THE SETTLEMENTS (POS-255), read off the list the build rendered: each
    // row carries its number, the crossing its blessing falls in, and the
    // instant. The row's card is what the panel beside the map shows.
    const settledBody = document.querySelector("[data-settled-body]");
    const settledHead = document.querySelector("[data-settled] .r-col-h");
    const setList = document.querySelector("[data-settlements]");
    const setRows = [...document.querySelectorAll("[data-settlement]")].map((li) => ({
      n: Number(li.dataset.settlement),
      crossing: li.dataset.crossing ? Number(li.dataset.crossing) : null,
      at: li.dataset.at ? Number(li.dataset.at) : NaN,
      li,
      card: li.querySelector("[data-set-card]"),
    }));
    const settledIn = (n) => setRows.filter((s) => s.crossing === n).sort((a, b) => a.at - b.at);
    // The settlement a reader asked for, if any. A settlement off the record
    // (before crossing 118) is shown beside whatever crossing is on screen.
    let chosenSet = null;
    if (setList) setList.classList.add("is-js");


    // THE CLOCK. A crossing is a twelve-hour stretch of the town's own time, and
    // playing it means running that time faster than ours: `speed` is how many
    // seconds of the town pass in one second here. 50× is the default because a
    // half-day then takes about fourteen minutes — a thing you can leave running
    // beside you, which is what a town's day should be. `0` is the odd one out
    // and deliberately so: it is the page as it was, a crossing at a time, and
    // the arrows are still the whole control.
    const SPEEDS = [
      { v: 1, label: "1×" },
      { v: 10, label: "10×" },
      { v: 50, label: "50×" },
      { v: 250, label: "250×" },
      { v: 1000, label: "1000×" },
      { v: 0, label: "step" },
    ];
    const DEFAULT_SPEED = 50;
    // How long a moment stays lit, in OUR seconds — so the highlight reads the
    // same at 1× and at 1000×, and only the town's clock changes pace.
    const LIT_MS = 1800;

    let speed = DEFAULT_SPEED;
    let playing = false;
    let clockT = null;        // where the replay has got to, in the town's time
    let rafId = 0, lastWall = 0, litRow = null, lastFollow = 0;
    // Rows in the digest, in the order the record has them happening, so the
    // playhead has something to walk down. Rebuilt with the digest.
    let beats = [];
    // True when a crossing's record carries no readable times and the page has
    // paced it evenly instead. Stated in the chrome rather than hidden.
    let evenlyPaced = false;
    // What the rail says when the clock is not running; the running note is
    // written over it and put back on pause.
    let baseNote = "";
    // The frames themselves are small (a crossing's speech and departures) but a
    // step should not wait on a round trip for one. Same immutability argument as
    // the fold cache next door: a finished crossing's record never changes. The
    // one still being written is deliberately NOT cached, because it does.
    const frames = new Map();
    async function getFrame(n, meta) {
      if (frames.has(n)) return frames.get(n);
      const frame = await fetch(`/world-engine/replay/${n}.json`).then((r) => (r.ok ? r.json() : null));
      if (frame && meta && meta.complete) frames.set(n, frame);
      return frame;
    }

    const nameOf = (handle) => {
      const m = /^human-of-(.+)$/.exec(handle || "");
      if (m) return "the human of " + m[1];
      return (faces[handle] && faces[handle].name) || handle;
    };
    const personLink = (handle) => {
      if (/^human-of-/.test(handle || "")) return el("span", "r-who is-human", nameOf(handle));
      const a = el("a", "r-who");
      a.href = "/residents/" + encodeURIComponent(handle) + "/";
      a.textContent = nameOf(handle);
      return a;
    };

    const UTC = { timeZone: "UTC", month: "short", day: "numeric" };
    const clock = { timeZone: "UTC", hour: "2-digit", minute: "2-digit", hour12: false };
    const day = (iso) => new Date(iso).toLocaleDateString("en-US", UTC);
    const time = (iso) => new Date(iso).toLocaleTimeString("en-US", clock);

    function renderScrubber() {
      trackEl.textContent = "";
      const peak = Math.max(1, ...index.crossings.map((c) => c.event_count));
      for (const c of index.crossings) {
        const li = el("li", "r-tick" + (current === c.n ? " is-on" : "") + (c.complete ? "" : " is-open"));
        const btn = document.createElement("button");
        btn.type = "button";
        btn.className = "r-tick-btn";
        // A proportion of the busiest crossing, with a floor so a silent half-day
        // is still a visible, clickable thing rather than a gap in the track, and
        // a ceiling that leaves room for the number underneath.
        btn.style.setProperty("--h", (8 + Math.round((c.event_count / peak) * 76)) + "%");
        const settled = settledIn(c.n);
        btn.setAttribute("aria-label", `crossing ${c.n}, ${c.event_count} events`
          + (settled.length ? `, settled: ${settled.map((s) => "S" + s.n).join(" and ")}` : ""));
        btn.title = `crossing ${c.n} · ${day(c.from)} · ${c.event_count} recorded`;
        btn.addEventListener("click", () => select(c.n));
        li.appendChild(btn);
        if (settled.length) {
          const mark = el("span", "r-tick-set", "◆");
          mark.setAttribute("aria-hidden", "true");
          li.appendChild(mark);
        }
        li.appendChild(el("span", "r-tick-n", c.n));
        trackEl.appendChild(li);
      }
      const i = index.crossings.findIndex((c) => c.n === current);
      prevBtn.disabled = i <= 0;
      nextBtn.disabled = i < 0 || i >= index.crossings.length - 1;
    }

    function renderDigest(frame, meta) {
      whenEl.textContent = `Crossing ${frame.crossing}`;
      spanEl.textContent = frame.complete
        ? `${day(frame.from)} ${time(frame.from)} – ${time(frame.to)} UTC · ${meta.entity_count} residents on the map`
        : `${day(frame.from)} ${time(frame.from)} UTC · still open — this crossing is happening now`;

      // THREADS, AND WHY ONLY SOMETIMES. The brief for this page asked every
      // spoken line to link to its thread at /conversations/#<id>. It cannot,
      // honestly: a thread there is a DERIVATION the office recomputes from live
      // speech, the replay's own record carries no thread id, and the office keeps
      // a closed thread about a day. A four-day-old crossing has no thread to
      // arrive at, so a per-voice link would be a link that looks like it works
      // and doesn't — the exact thing this page refused to ship last time.
      //
      // Where it CAN land it is offered: the crossing still being written is
      // happening now, and its conversations are on that page this minute.
      convoEl.textContent = "";
      if (!frame.complete) {
        convoEl.appendChild(document.createTextNode(" · "));
        const a = el("a", "r-rule-link", "in conversation now");
        a.href = "/conversations/";
        convoEl.appendChild(a);
      }

      voicesEl.textContent = "";
      if (!frame.voices.length) {
        voicesEl.appendChild(el("p", "r-empty", "Nobody spoke within earshot of anybody this crossing."));
      } else {
        const list = el("ol", "r-voices");
        for (const v of frame.voices) {
          const li = el("li", "r-voice");
          li.dataset.at = String(momentOf(v));
          const head = el("p", "r-voice-head");
          head.appendChild(personLink(v.handle));
          // the place words go to the place, same door the conversations page
          // now uses (/world/?at=x,y) — a spectator reading what was said should
          // be one click from where it was said
          if (v.place) {
            if (isFinite(v.x) && isFinite(v.y)) {
              const toMap = el("a", "r-place r-place-link", v.place);
              toMap.href = `/world/?at=${v.x},${v.y}`;
              toMap.title = "see this place on the map";
              head.appendChild(toMap);
            } else {
              head.appendChild(el("span", "r-place", v.place));
            }
          }
          head.appendChild(el("span", "r-at", time(v.at) + " UTC"));
          li.appendChild(head);
          li.appendChild(el("p", "r-said", v.said));   // textContent, always
          list.appendChild(li);
        }
        voicesEl.appendChild(list);
      }

      movesEl.textContent = "";
      if (!frame.moves.length) {
        movesEl.appendChild(el("p", "r-empty", "Nobody set out this crossing."));
      } else {
        const list = el("ol", "r-moves");
        for (const m of frame.moves) {
          const li = el("li", "r-move");
          li.dataset.at = String(momentOf(m));
          li.appendChild(personLink(m.handle));
          // A stop is recorded as a zero-distance departure, so the record can
          // say "stopped" without a second event type — and the page says the
          // same word rather than reporting a 0 m walk.
          if (m.stopped) {
            li.appendChild(el("span", "r-move-what", "stopped where they stood"));
          } else if (m.to) {
            // WHERE THEY WERE HEADED, ON THE MAP. The record carries the asked-for
            // mark AND the coordinates it resolved to, so a destination can be a
            // door rather than a noun — same `/world/?at=` arrival the said column
            // has used since the round trip landed. A departure with no resolved
            // coordinates keeps the plain words rather than getting a link that
            // lands nowhere.
            const what = el("span", "r-move-what");
            what.appendChild(document.createTextNode("set out for "));
            const name = deslugMarkId(m.to);
            if (m.toward && isFinite(m.toward.x) && isFinite(m.toward.y)) {
              const a = el("a", "r-place-link", name);
              a.href = `/world/?at=${m.toward.x},${m.toward.y}`;
              a.title = "see this place on the map";
              what.appendChild(a);
            } else {
              what.appendChild(document.createTextNode(name));
            }
            li.appendChild(what);
            if (m.distance_m != null) li.appendChild(el("span", "r-dist", m.distance_m + " m"));
          } else {
            li.appendChild(el("span", "r-move-what", "set out across the world"));
            if (m.distance_m != null) li.appendChild(el("span", "r-dist", m.distance_m + " m"));
          }
          li.appendChild(el("span", "r-at", time(m.at) + " UTC"));
          list.appendChild(li);
        }
        movesEl.appendChild(list);
      }

      provenanceEl.textContent = frame.as_of_world
        ? `Drawn from the world record as it stood at commit ${frame.as_of_world.slice(0, 8)} — the fold this crossing was computed against.`
        : "This crossing has no world commit on its record, so the map falls back to the world as it stands today.";

      renderSettled();
      buildBeats(frame);
    }

    // The panel beside the map: the settlement(s) blessed in the crossing on
    // screen, or the one a reader chose that the record cannot place. A card
    // blessed in this crossing carries its instant, so the clock plays it.
    function renderSettled() {
      if (!settledBody) return;
      settledBody.textContent = "";
      const offRecord = chosenSet && chosenSet.crossing == null;
      const shown = offRecord ? [chosenSet] : settledIn(current);
      settledHead.textContent = offRecord ? `Settlement S${chosenSet.n}` : "Settled this crossing";
      if (!shown.length) {
        settledBody.appendChild(el("p", "r-empty", "No settlement was blessed this crossing."));
      }
      for (const s of shown) {
        if (!s.card) continue;
        const card = s.card.cloneNode(true);
        card.removeAttribute("data-set-card");
        card.classList.add("r-settled-card");
        card.classList.toggle("is-chosen", s === chosenSet);
        if (!offRecord && Number.isFinite(s.at)) card.dataset.at = String(s.at);
        settledBody.appendChild(card);
      }
      for (const r of setRows) r.li.classList.toggle("is-on", shown.includes(r));
    }

    // Choosing a settlement: its crossing, the clock stopped at the blessing.
    async function chooseSettlement(n) {
      const s = setRows.find((r) => r.n === n);
      if (!s) return false;
      if (s.crossing == null) {
        pause();
        chosenSet = s;
        renderSettled();
        writeUrl();
        return true;
      }
      await select(s.crossing, { settlement: s });
      if (speed !== 0 && Number.isFinite(s.at)) { clockT = s.at; paint(); }
      return true;
    }


    // ───────── the crossing's clock ─────────
    //
    // A moment's time comes off the record: replay-record writes `at_ms` beside
    // every `at`, so nothing here parses what the build already parsed. The
    // string is the fallback, and a record with neither is handled below rather
    // than pretended about.
    const momentOf = (row) => {
      const ms = Number(row.at_ms);
      if (Number.isFinite(ms)) return ms;
      const parsed = Date.parse(row.at);
      return Number.isFinite(parsed) ? parsed : NaN;
    };

    const startOf = (frame) => Date.parse(frame.from);
    // WHERE A CROSSING ENDS. A finished one ends where the record says it did.
    // The one still being written ends at its last written moment — measured
    // against crossing 129, `covers_to` on an open crossing is the last thing
    // that happened in it, not the sailing it is heading for. The clamp to now
    // is insurance against the other reading, not the working case: playing past
    // this moment would be playing into a future the record cannot show.
    const endOf = (frame) => {
      const to = Date.parse(frame.to);
      if (!Number.isFinite(to)) return startOf(frame);
      return frame.complete ? to : Math.min(to, Date.now());
    };

    const clockLabel = (ms) =>
      new Date(ms).toLocaleTimeString("en-US", clock) + " UTC";

    // The digest's rows, in the order they happened, each holding the DOM node
    // that says it. This is the whole of "what plays": the playhead walks this
    // list, and a row lights when its moment arrives.
    function buildBeats(frame) {
      const nodes = [
        ...voicesEl.querySelectorAll(".r-voice[data-at]"),
        ...movesEl.querySelectorAll(".r-move[data-at]"),
        ...(settledBody ? settledBody.querySelectorAll(".r-settled-card[data-at]") : []),
      ];
      const from = startOf(frame), to = endOf(frame);
      // HONEST FALLBACK. Every frame the current recorder writes carries times;
      // a frame from an older build might not, and a crossing whose moments all
      // read NaN would otherwise play as one flat instant. Rather than fake a
      // precision the record does not have, the moments are spread evenly across
      // the crossing and the rail says so in words.
      evenlyPaced = nodes.length > 0 && nodes.some((n) => !Number.isFinite(Number(n.dataset.at)));
      if (evenlyPaced) {
        const span = Math.max(1, to - from);
        nodes.forEach((n, i) => {
          n.dataset.at = String(from + Math.round(((i + 1) / (nodes.length + 1)) * span));
        });
      }
      beats = nodes
        .map((node) => ({ node, at: Number(node.dataset.at) }))
        .filter((b) => Number.isFinite(b.at))
        .sort((a, b) => a.at - b.at);
      litRow = null;
      renderRail(frame);
    }

    // The rail is the crossing laid out end to end. Its notches are the moments,
    // so the shape of a half-day — a burst at the ferry, a long quiet afternoon —
    // is legible before a single second of it is played.
    function renderRail(frame) {
      const from = startOf(frame), to = endOf(frame);
      const span = Math.max(1, to - from);
      railBeats.textContent = "";
      for (const b of beats) {
        const pct = Math.min(100, Math.max(0, ((b.at - from) / span) * 100));
        const kind = b.node.classList.contains("r-voice") ? " is-voice"
          : b.node.classList.contains("r-settled-card") ? " is-settle" : " is-move";
        const notch = el("span", "r-rail-beat" + kind);
        notch.style.left = pct + "%";
        railBeats.appendChild(notch);
      }
      railEl.classList.toggle("is-empty", beats.length === 0);
      // At rest the rail says what it is a rail OF, so it is not read as a
      // second copy of the crossing track underneath it.
      const n = beats.length;
      baseNote = (n === 0 ? "· nothing recorded" : `· ${n} moment${n === 1 ? "" : "s"} recorded`)
        + (evenlyPaced ? " · no times in this record, so they are spread evenly" : "")
        + (frame.complete ? "" : " · still being written");
      railNote.textContent = baseNote;
    }

    // A HALF-DAY IS MOSTLY QUIET, AND THAT IS NOT A BUG TO DESIGN AWAY. The
    // town's moments cluster: crossing 119's first is an hour and three quarters
    // in, and at 50× that is over two minutes of a still page before anything
    // happens. The page will not skip that stretch — "a quiet crossing shows as
    // quiet" is the law it opens with, and hopping the playhead over the empty
    // water would be the page editing the day. What it can do is say what the
    // reader is waiting for, so the wait reads as the town being quiet rather
    // than as the replay being stuck.
    function gapWords(ms) {
      const m = Math.round(ms / 60000);
      if (m < 1) return "seconds";
      if (m < 60) return `${m} min`;
      const h = Math.floor(m / 60);
      return `${h}h ${String(m % 60).padStart(2, "0")}m`;
    }

    // Paint the playhead: the rail, the clock, and every row's relation to now.
    // `is-ahead` is a row whose moment has not come; the newest passed row is
    // lit for a fixed number of OUR seconds, so the eye can follow it at any
    // speed. In step mode nothing is ahead of anything — the crossing is shown
    // whole, exactly as this page has always shown it.
    function paint() {
      const frame = window.__pmReplay.frame;
      if (!frame) return;
      const from = startOf(frame), to = endOf(frame);
      const span = Math.max(1, to - from);

      if (speed === 0 || clockT == null) {
        railFill.style.width = "100%";
        railHead.hidden = true;
        clockEl.textContent = beats.length
          ? `${clockLabel(from)} – ${clockLabel(to)}`
          : clockLabel(from);
        for (const b of beats) b.node.classList.remove("is-ahead", "is-lit");
        litRow = null;
        return;
      }

      const pct = Math.min(100, Math.max(0, ((clockT - from) / span) * 100));
      railFill.style.width = pct + "%";
      railHead.hidden = false;
      railHead.style.left = pct + "%";
      clockEl.textContent = clockLabel(clockT);

      // the last moment that has happened, and how long ago in our seconds
      let newest = null;
      for (const b of beats) {
        const ahead = b.at > clockT;
        b.node.classList.toggle("is-ahead", ahead);
        if (!ahead) newest = b;
      }
      const litFor = newest ? (clockT - newest.at) / Math.max(1, speed) : Infinity;
      for (const b of beats) b.node.classList.toggle("is-lit", b === newest && litFor < LIT_MS);

      // Follow the playhead down the page, but only while it is moving and only
      // when the row has left the window — `nearest` is what keeps this from
      // yanking a reader who is already looking at the right place. The town
      // talks in bursts (crossing 119 puts thirty-three lines inside one
      // conversation), so the follow is rate-limited: at 1000× that burst would
      // otherwise fire thirty-three smooth scrolls inside half a second.
      if (playing && newest && newest !== litRow) {
        litRow = newest;
        const wall = performance.now();
        if (wall - lastFollow > 500) {
          lastFollow = wall;
          try { newest.node.scrollIntoView({ block: "nearest", behavior: "smooth" }); } catch { /* older browsers */ }
        }
      }
      if (!newest) litRow = null;

      if (playing) {
        const next = beats.find((b) => b.at > clockT);
        railNote.textContent = next
          ? `· next moment ${gapWords(next.at - clockT)} on`
          : (beats.length ? "· quiet from here to the sailing" : "· nothing was recorded this crossing");
      } else {
        railNote.textContent = baseNote;
      }
    }

    // ───────── the transport ─────────
    //
    // One loop, and it only ever does two things: move the town's clock forward
    // by the wall time that passed times the speed, and repaint. It never
    // touches the viewer. Crossing boundaries are the exception and they go
    // through `select` like every other step, which is what keeps the frame
    // cache, the preloader and the no-remount guarantee on the play path too.

    // The clock, readable from outside — the same bargain `__pmReplayMounts`
    // already struck next door. A play system's claims ("it advanced without a
    // click", "pause froze it", "1000× is faster than 1×") are claims about a
    // number that is otherwise only inferable from pixels, and QA that has to
    // infer them is QA that can pass while the thing is broken.
    window.__pmReplayClock = () => ({ crossing: current, t: clockT, speed, playing, beats: beats.length });

    function schedule() {
      if (!rafId && playing) rafId = requestAnimationFrame(tick);
    }
    function tick(now) {
      rafId = 0;
      if (!playing || speed === 0) return;
      const frame = window.__pmReplay.frame;
      if (!frame) { schedule(); return; }
      // A tab that was in the background hands back one enormous delta. Clamping
      // it means coming back to a paused-looking replay rather than to a crossing
      // that silently skipped four hours while nobody was looking.
      const dt = Math.min(now - lastWall, 250);
      lastWall = now;
      const end = endOf(frame);
      clockT = Math.min(end, (clockT ?? startOf(frame)) + dt * speed);
      paint();
      if (clockT >= end) { advance(); return; }
      schedule();
    }

    // The end of a crossing is the start of the next one, and the play button
    // does not stop for it. The end of the LAST crossing is now, and there it
    // stops — a replay that spun on past the end of the record would be claiming
    // to show a future the town has not lived yet.
    let advancing = false;
    async function advance() {
      if (advancing) return;
      const i = index.crossings.findIndex((c) => c.n === current);
      const next = index.crossings[i + 1];
      if (!next) { stopAtNow(); return; }
      advancing = true;
      await select(next.n, { auto: true });
      advancing = false;
      if (playing) { lastWall = performance.now(); schedule(); }
    }
    function stopAtNow() {
      playing = false;
      if (rafId) { cancelAnimationFrame(rafId); rafId = 0; }
      renderTransport();
      writeUrl();
      railNote.textContent = "· caught up with now";
    }

    function play() {
      if (speed === 0 || playing) return;
      const frame = window.__pmReplay.frame;
      if (!frame) return;
      // Pressing play at the end of a crossing means "again", not "nothing".
      if (clockT == null || clockT >= endOf(frame)) clockT = startOf(frame);
      playing = true;
      lastWall = performance.now();
      renderTransport();
      writeUrl();
      schedule();
    }
    function pause() {
      if (!playing) return;
      playing = false;
      if (rafId) { cancelAnimationFrame(rafId); rafId = 0; }
      renderTransport();
      writeUrl();
    }

    function setSpeed(v) {
      speed = v;
      if (v === 0) {
        // step mode is the page as it was: no clock, the whole crossing at once
        playing = false;
        if (rafId) { cancelAnimationFrame(rafId); rafId = 0; }
        clockT = null;
      } else if (clockT == null && window.__pmReplay.frame) {
        clockT = startOf(window.__pmReplay.frame);
      }
      renderTransport();
      paint();
      writeUrl();
    }

    // The speed chips are built once and then only re-marked. Rebuilding them on
    // every play/pause would drop focus off the chip a keyboard reader had just
    // pressed, which is the kind of thing that makes a control feel broken
    // without ever looking broken.
    const speedBtns = SPEEDS.map((s) => {
      const b = document.createElement("button");
      b.type = "button";
      b.className = "r-speed";
      b.textContent = s.label;
      b.title = s.v === 0
        ? "one crossing at a time — the arrows, and no clock"
        : `${s.v}× the town's own time`;
      b.addEventListener("click", () => setSpeed(s.v));
      speedsEl.appendChild(b);
      return { b, v: s.v };
    });
    function renderSpeeds() {
      for (const { b, v } of speedBtns) {
        b.classList.toggle("is-on", v === speed);
        b.setAttribute("aria-pressed", String(v === speed));
      }
    }
    function renderTransport() {
      renderSpeeds();
      playBtn.disabled = speed === 0;
      playBtn.setAttribute("aria-pressed", String(playing));
      playBtn.querySelector(".r-play-glyph").textContent = playing ? "❚❚" : "▶";
      playWord.textContent = playing ? "Pause" : "Play";
      railEl.hidden = speed === 0;
      const last = index && index.crossings[index.crossings.length - 1];
      nowBtn.disabled = !last || current === last.n;
    }

    // WHERE THE PAGE KEEPS ITS PLACE. A moment worth showing somebody is a
    // crossing and a pace, so both are in the query — `/replay/?crossing=124&speed=50`
    // opens on that crossing at that pace, and `&playing=1` opens it running.
    // The old `#124` deep links are still read on arrival; they are simply not
    // written any more, because a hash cannot carry the second half.
    function writeUrl() {
      const q = new URLSearchParams();
      if (current != null) q.set("crossing", String(current));
      if (chosenSet) q.set("settlement", String(chosenSet.n));
      q.set("speed", speed === 0 ? "step" : String(speed));
      if (playing) q.set("playing", "1");
      history.replaceState(null, "", location.pathname + "?" + q.toString());
    }

    // MOVING THE MAP TO ANOTHER CROSSING, WITHOUT TEARING IT DOWN.
    //
    // This page used to re-mount the viewer on every step, which was the only
    // thing the viewer's published interface allowed: `rerender` is a pure redraw
    // from state already in hand, so it could not be told that the world's data
    // doors now answer differently. A re-mount cost about a second, re-fetched
    // the fold, threw the camera back to the fitted view, and — because the
    // viewer's "greet once per page load" flag lived inside the mount — made the
    // tour ambush an anonymous spectator again on every single arrow press.
    //
    // `reload` (postmark-world, 2026-08-14) is the seam that was missing: re-pull
    // the fold and the walkers from the same doors, keep everything else. So a
    // step is now: swap the frame the lens answers from, then ask the viewer to
    // look again. The DOM node it drew into is never replaced.
    //
    // The re-mount below is kept as the FALLBACK, and it is not dead code: the
    // site pins postmark-world by commit, so between this page merging and that
    // pin moving, `reload` is simply not there. On that build the page behaves
    // exactly as it did before — slow, but never broken.
    function mount() {
      if (viewer && viewer.stop) viewer.stop();
      host.textContent = "";
      host.className = "r-map";
      viewer = mountViewer(host);
      // the same node, tagged, so QA can prove across a scrub that it survived
      host.dataset.mountedAt = String(Date.now());
      mountCount += 1;
      window.__pmReplayMounts = mountCount;
    }
    async function showFrame(frame) {
      if (!viewer) { mount(); setViewerCrossing(frame.crossing); return "mount"; }
      if (typeof viewer.reload !== "function") { mount(); setViewerCrossing(frame.crossing); return "remount"; }
      setViewerCrossing(frame.crossing);   // the caption first, so the number is never behind the map
      await viewer.reload();
      return "reload";
    }

    // The viewer keeps its own crossing number, and left alone it reads the wall
    // clock (viewer.mjs:1749) — so a page showing crossing 120 rendered a map
    // captioned "crossing 127 · live". That contradiction is the kind of thing
    // that costs a spectator the whole surface, so it is fixed rather than
    // explained away.
    //
    // The viewer already owns the answer: a "crossing (time-travel)" dial, whose
    // input it watches (:5667), which flips its caption to "· time-travelling" —
    // the exactly-right words for this page. The dial lives in the dev pane and
    // that pane is built lazily on first toggle (:5590), so the toggle is opened
    // to build it and closed again. Driving the viewer through its own control
    // beats reaching into its private state, and if the control ever moves this
    // no-ops visibly (the caption says "live") rather than lying quietly.
    function setViewerCrossing(n, tries = 60) {
      let input = host.querySelector("input.crossover");
      if (!input) {
        const toggle = host.querySelector(".wv-dev-toggle");
        if (toggle) {
          toggle.click();                                   // builds the pane
          input = host.querySelector("input.crossover");
          const pane = host.querySelector(".wv-dev");
          if (pane) pane.hidden = true;                     // and put it away again
        }
      }
      if (!input) {
        if (tries > 0) setTimeout(() => setViewerCrossing(n, tries - 1), 100);
        return;
      }
      input.value = String(n);
      input.dispatchEvent(new Event("input", { bubbles: true }));
    }

    // The crossings either side of this one, warmed while the browser is idle.
    // Stepping along the track is what a reader actually does with a scrubber, so
    // n±1 is not a guess about behaviour — it is the behaviour the control invites.
    // requestIdleCallback where it exists, because a preload must never compete
    // with the map it is trying to make feel fast.
    const idle = window.requestIdleCallback || ((fn) => setTimeout(fn, 250));
    function preloadNeighbours(n) {
      const i = index.crossings.findIndex((c) => c.n === n);
      if (i < 0) return;
      idle(async () => {
        for (const meta of [index.crossings[i + 1], index.crossings[i - 1]]) {
          if (!meta || meta.n === current) continue;
          const frame = await getFrame(meta.n, meta);
          if (frame && frame.as_of_world) await window.__pmReplay.warm(frame.as_of_world);
        }
      });
    }

    // `auto` is the one bit the clock adds: a crossing the PLAYBACK moved to
    // keeps playing and starts at its first hour, while a crossing a READER
    // moved to stops the clock dead. Touching the scrubber is the plainest
    // statement there is that somebody wants to look rather than watch.
    async function select(n, { auto = false, settlement = null } = {}) {
      const meta = index.crossings.find((c) => c.n === n);
      if (!meta) return;
      if (!auto) pause();
      current = n;
      chosenSet = settlement ?? (chosenSet && chosenSet.crossing === n ? chosenSet : null);
      renderScrubber();
      renderTransport();
      const frame = await getFrame(n, meta);
      if (!frame) {
        voicesEl.textContent = "";
        voicesEl.appendChild(el("p", "r-empty", "That crossing's record could not be read."));
        return;
      }
      // The lens must be holding the new frame BEFORE the viewer is asked to look
      // again, or it re-pulls the crossing it was already showing.
      window.__pmReplay.frame = frame;
      // A crossing arrived at while playing opens at its first hour; one arrived
      // at by hand opens whole, so the reader sees everything that happened in it.
      clockT = speed === 0 ? null : (auto ? startOf(frame) : null);
      renderDigest(frame, meta);
      paint();
      await showFrame(frame);
      writeUrl();
      preloadNeighbours(n);
    }

    function step(by) {
      const i = index.crossings.findIndex((c) => c.n === current);
      const next = index.crossings[i + by];
      if (next) select(next.n);
    }

    document.addEventListener("keydown", (e) => {
      // the viewer binds its own keys; don't fight it while a field has focus
      const t = e.target;
      if (t && (t.tagName === "INPUT" || t.tagName === "TEXTAREA" || t.isContentEditable)) return;
      if (e.key === "ArrowLeft") { e.preventDefault(); step(-1); }
      if (e.key === "ArrowRight") { e.preventDefault(); step(1); }
      // space is the transport key everywhere else a thing plays, so it is the
      // transport key here — and it must not also scroll the page. A button with
      // focus is left alone: space is already ITS key, and taking it would mean
      // a keyboard reader pressing "250×" got play instead.
      if (e.key === " " || e.key === "Spacebar") {
        if (speed === 0 || (t && t.tagName === "BUTTON")) return;
        e.preventDefault();
        playing ? pause() : play();
      }
    });
    if (setList) setList.addEventListener("click", (e) => {
      const a = e.target.closest && e.target.closest(".r-set-line");
      const li = a && a.closest("[data-settlement]");
      if (!li || !index) return;
      e.preventDefault();
      chooseSettlement(Number(li.dataset.settlement)).then(() => {
        try { document.querySelector(".r-stage").scrollIntoView({ block: "start", behavior: "smooth" }); } catch { /* older browsers */ }
      });
    });
    prevBtn.addEventListener("click", () => step(-1));
    nextBtn.addEventListener("click", () => step(1));
    playBtn.addEventListener("click", () => (playing ? pause() : play()));
    // "now" is the newest crossing the record has — the one still being written.
    nowBtn.addEventListener("click", () => {
      const last = index.crossings[index.crossings.length - 1];
      if (last) select(last.n);
    });

    // The digest again, for the crossing already on screen — used when the faces
    // land after the frame did. It re-renders and nothing else: re-`select`ing
    // would pause a running replay and throw its clock back to the top of the
    // hour, for a change that is only ever names on rows already drawn.
    function redraw() {
      const frame = window.__pmReplay.frame;
      const meta = index && index.crossings.find((c) => c.n === current);
      if (!frame || !meta) return;
      renderDigest(frame, meta);
      paint();
    }

    (async () => {
      // names before frames: a face map is a garnish, so it is never awaited hard
      fetch("/world-engine/residents-meta.json")
        .then((r) => (r.ok ? r.json() : null))
        .then((d) => { if (d && d.residents) { faces = d.residents; if (current != null) redraw(); } })
        .catch(() => {});

      index = await fetch("/world-engine/replay/index.json").then((r) => (r.ok ? r.json() : null));
      if (!index || !index.crossings.length) {
        coverageEl.textContent = "The crossing record is not available in this build.";
        return;
      }
      const first = index.crossings[0], last = index.crossings[index.crossings.length - 1];
      coverageEl.textContent =
        `The record runs from crossing ${first.n} (${day(first.from)}) to ${last.n} (${day(last.from)}) — `
        + `${index.crossings.length} crossings. The town is older than its record: crossing-by-crossing `
        + `saving began at ${first.n}, so everything before that is in the town's letters and its map, not here.`;

      // Land on the most recent FINISHED crossing, not the newest one. The
      // newest is still being written — a half-recorded frame is not a frame of
      // the world's history yet, and opening on it makes a working record look
      // like an empty one. Quiet finished crossings are kept and shown as quiet;
      // the town has slow half-days and the page says so plainly.
      const complete = index.crossings.filter((c) => c.complete);
      // ARRIVING ON A SHARED MOMENT. `?crossing=` is the door; `#124` is the one
      // this page used to write and is still answered, so nobody's saved link
      // goes dead. `?speed=` sets the pace before the first frame is chosen, so
      // a link that says step never starts a clock at all.
      const params = new URLSearchParams(location.search);
      const askedSpeed = params.get("speed");
      if (askedSpeed != null) {
        const wanted = askedSpeed === "step" ? 0 : Number(askedSpeed);
        if (SPEEDS.some((s) => s.v === wanted)) speed = wanted;
      }
      const asked = Number(params.get("crossing") ?? decodeURIComponent((location.hash || "").slice(1)));
      const start = index.crossings.some((c) => c.n === asked)
        ? asked
        : (complete[complete.length - 1] ?? last).n;
      renderTransport();
      const askedSet = Number(params.get("settlement") ?? (/^#S(\d+)$/.exec(location.hash) || [])[1]);
      const landSet = setRows.find((r) => r.n === askedSet);
      if (landSet && landSet.crossing != null) {
        await chooseSettlement(landSet.n);
      } else {
        await select(start);
        if (landSet) await chooseSettlement(landSet.n);
      }
      if (landSet) {
        try { document.querySelector(".r-stage").scrollIntoView({ block: "start" }); } catch { /* older browsers */ }
      }
      // and, if the link asked for it, running. After the frame, never before:
      // play on an empty page would spend its first seconds on nothing.
      if (params.get("playing") === "1" && speed !== 0) play();
    })();
  </script>

