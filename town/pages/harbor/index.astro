---
// The Sky Harbor — 1f4ee.town. A chart of the web of towns, not a page about it.
// Option B, "Night Mail by Lantern-Light" (POS-769, Darko 2026-10-22): the
// harbor at night, Postmark's postbox at the top, the chartered towns moored on
// clouds along drawn flight paths, the listed ones as lanterns on the far water.
//
// Two clocks run this page, and keeping them apart is the whole design:
//
//   BUILD TIME — the chart's shape, every town card, the lanterns and their
//     dated counts, the travelers' register and Postmark's quay. The registry
//     is read from the town marks in the PINNED postmark-world package
//     (src/lib/harbor.mjs), so it is exactly as fresh as the pin and never lies
//     about a town that has not been chartered. These render with no network.
//
//   READ TIME — the live figure on each chartered town, whether a flight path
//     has carried anything, the live half of each card, the two ledgers on the
//     departures ticket and the cargo. These are foreign records, read at a
//     distance by a box timer every 15 minutes and served as a snapshot. They
//     are fetched client-side, stamped with the hour they were read, and marked
//     stale when that hour gets old.
//
// A reader with no JS, a dead snapshot, or a shore that did not answer still
// gets the chart, every card, the lanterns, the register and the quay. That is
// the point of the split: the parts Postmark can vouch for do not depend on the
// parts it cannot.
import HarborLayout from "@/layouts/HarborLayout.astro";
import stats from "@/data/postmark/stats.json";
import { loadCharters } from "@/lib/harbor.mjs";
import { FRAMES, layoutTowns, shipPath, towerInks, epithetOf } from "@/lib/harbor-sky.mjs";
import { sectionCard } from "@/lib/og-image.mjs";

// The instruments' own address. Root-relative in a build, because both vhosts
// serve the snapshot at exactly this path — so one URL is same-origin at
// whichever door the reader came through. Pinning it absolute to postmark.town
// would make the harbor's own domain fetch its instruments from a town it
// merely lists, which is the dependency the domain move exists to undo.
//
// DEV keeps the absolute URL: the snapshot is written by the box timer into the
// served tree, not by this build, so a dev server has no copy of it locally. It
// is CORS-open, which is what lets `npm run dev` read the real water.
const SNAPSHOT = import.meta.env.DEV
  ? "https://postmark.town/harbor/data/harbor-snapshot.json"
  : "/harbor/data/harbor-snapshot.json";

// The harbor's own address. It is built into the town's tree at /harbor/, but it
// LIVES at 1f4ee.town — the codepoint of 📮 U+1F4EE POSTBOX. postmark.town/harbor/
// 301s here, so this is the only address the page is ever read at.
const CANONICAL = "https://1f4ee.town/";

// Every door OUT of this page is absolute. The 1f4ee.town vhost mirrors the
// whole site webroot so nothing 404s — but that mirror is a safety net, not a
// destination: a root-relative /join/ here would hand the reader a noindexed
// copy of the town flying the harbor's flag.
const TOWN = "https://postmark.town";

const charters = loadCharters();
// A listed town is not on the chart (POS-763, POS-769): it is a lantern on the
// far water, with no flight path, no instrument read, and nothing calling it
// chartered.
const chartered = charters.filter((t) => !t.listed);
const listed = charters.filter((t) => t.listed);
const host = chartered.find((t) => t.hub);
const moored = chartered.filter((t) => !t.hub);

// A town's name is its own, as its mark gives it (src/lib/harbor.mjs § nameFor).
const nameOf = (slug) => charters.find((t) => t.slug === slug)?.name ?? slug;
// A town with no glyph shows its initial, in its own case, never a borrowed emoji.
const initialOf = (slug) => nameOf(slug).replace(/^the /i, "")[0];
const isUrl = (v) => /^https?:\/\//.test(v);
const hostOf = (url) => String(url || "").replace(/^https?:\/\//, "").replace(/\/$/, "");
const predicate = (t, slot) => t.predicates.find((p) => p.slot === slot)?.value ?? "";

// ── the two drawings of the chart ────────────────────────────────────────────
// The same chart, wide and tall; CSS shows one. Geometry is src/lib/harbor-sky.mjs.
const drawings = ["wide", "tall"].map((k) => {
  const frame = FRAMES[k];
  const towns = layoutTowns(frame, moored).map((t, i) => ({
    ...t,
    name: nameOf(t.slug),
    epithet: epithetOf(t.body),
    inks: towerInks(t.slug, i),
  }));
  return { key: k, frame, towns, ship: shipPath(frame, towns) };
});

// The island renders card halves, ledger rows and cargo crates that must name
// towns exactly as the page names them — so it is handed THIS registry rather
// than re-deriving one. `<` is escaped so no value can close the script early.
const registryJson = JSON.stringify(
  charters.map((t) => ({ slug: t.slug, name: nameOf(t.slug), glyph: t.glyph, door: t.door, listed: t.listed })),
).replace(/</g, "\\u003c");

// The footer's doors are "the chartered towns", so a listed town is not among them.
const doors = chartered.map((t) => ({ glyph: t.glyph, name: nameOf(t.slug), door: t.door }));

// The host's count is the TOWN's record, not an instrument read — the snapshot
// carries the foreign shores and says so in its own note. It renders at build
// time and never wears the staleness lamp.
const hubFigure = { n: stats.residents, label: "residents" };

// The card shown first. Without JS every card stands open, one after another.
const firstCard = moored[0]?.slug ?? host?.slug ?? "";

// The far water's read dates, said once when they agree.
const farReads = [...new Set(listed.map((t) => t.count?.read).filter(Boolean))].sort();

// The postmark cancel carries a day. The build's day stands until the island
// stamps the snapshot's own.
const BUILT = new Date();
const MONTHS = ["JAN", "FEB", "MAR", "APR", "MAY", "JUN", "JUL", "AUG", "SEP", "OCT", "NOV", "DEC"];
const cancelDay = `${BUILT.getUTCDate()} ${MONTHS[BUILT.getUTCMonth()]}`;
const cancelYear = String(BUILT.getUTCFullYear());

const sections = [
  { href: "#chart", label: "The chart" },
  ...(listed.length ? [{ href: "#far", label: "The far water" }] : []),
  { href: "#departures", label: "Departures" },
  { href: "#quay", label: "The quay" },
];
