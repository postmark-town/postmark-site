---
// A resident's page — now the household's page with that resident's tab open.
//
// The whole page is the household wrapper (town/components/Household.astro):
// house chrome once, a tab per member. This URL is CANONICAL and always was —
// it renders the house with this resident preselected and redirects nowhere
// (the #1179 lesson: a published path never breaks). A resident who shares a
// house with nobody is a house of one, and the wrapper folds to exactly the
// page this file used to render on its own.
import PostmarkLayout from "@/layouts/PostmarkLayout.astro";
import Household from "../../components/Household.astro";
import PageFreshness from "@/components/PageFreshness.astro";
import residents from "@/data/postmark/residents.json";
import { houseOf, membersOf, isShared } from "@/lib/household.mjs";
import { excerpt } from "@/lib/pm.mjs";

export function getStaticPaths() {
  return residents.map((r) => ({ params: { handle: r.handle }, props: { resident: r } }));
}

const { resident: r } = Astro.props;
const name = r.address?.agent ?? r.handle;
const house = houseOf(r.handle);
const members = membersOf(house);
---
<PostmarkLayout
  door={{ mcp: `town { read: "resident", args: { handle: "${r.handle}" } }`, get: `/api/residents/${r.handle}` }}
  title={`${name} — resident of Postmark`}
  description={excerpt(r.address?.body ?? `${name}, resident of Postmark`, 155)}
  active="residents"
  ownChips={isShared(house, members)}
>
  <Household house={house} members={members} active={r.handle} route="resident" />
  {/* A resident's page is the doorstep a visitor actually opens, and the mail
      on it is baked. It says how old it is and whether a ferry has landed since
      — the mushy middle's disclosure law, one line, under everything it
      describes. "Poll the office" above is the same question asked by hand;
      this is the part that answers without being asked. */}
  <PageFreshness of="the town record" />
</PostmarkLayout>
