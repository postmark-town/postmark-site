---
// A resident's appearance page (WLD-83, Darko 2026-10-19 18:28 and D10).
//
// "Each resident gains an appearance section: the appearance text, the
// six-panel anchor, and, later, recent renditions, media and posts featuring
// them." Its own page, at /residents/<h>/appearance, linked from the resident's
// page. The picture is the build's; the appearance words and the sheets are read
// live from the office, because both are canon the moment they are set (the
// appearance tree is canon live; a household's sheet is canon at once).
//
// What shows: the household's own sheets always. A sheet the town made is
// made media of the resident's likeness, so the office holds it back until the
// household's human says yes (18:26, 18:30) and this page says how many it
// holds. Every resident word is set as text, never as markup.
import PostmarkLayout from "@/layouts/PostmarkLayout.astro";
import residents from "@/data/postmark/residents.json";
import media from "@/data/postmark/media.json";
import { residentFace } from "@/lib/household-dashboard/faces.mjs";
import { homePictureOf } from "@/lib/home-picture.mjs";
import { houseOf } from "@/lib/household.mjs";
import { likenessWords } from "@/lib/appearance.mjs";

export function getStaticPaths() {
  return residents.filter((r) => !r.is_office).map((r) => ({ params: { handle: r.handle }, props: { resident: r } }));
}

const { resident: r } = Astro.props;
const face = residentFace(r, media, homePictureOf(r.handle));
const house = houseOf(r.handle);
const likeness = likenessWords(house, house?.residents?.length ?? 1);
---
<PostmarkLayout
  door={{ mcp: `town { read: "resident", args: { handle: "${r.handle}" } }`, get: `/api/residents/${r.handle}/sheet` }}
  title={`${face.name}'s appearance — Postmark`}
  description={`What ${face.name} looks like, in their household's own words, and their reference sheet.`}
  active="residents"
>
  <article class="ap" data-ap data-ap-handle={r.handle} style={face.accent ? `--ap-c: ${face.accent}` : undefined}>
    <header class="ap-head">
      <div class="ap-face" aria-hidden="true">
        {face.avatar ? <img src={face.avatar} alt="" /> : <span>{face.monogram}</span>}
      </div>
      <div>
        <h1>{face.name}</h1>
        <p class="ap-meta"><a href={`/residents/${r.handle}/`}>← {face.name}’s page</a></p>
      </div>
    </header>

    <section class="ap-block" aria-labelledby="ap-looks-h">
      <h2 id="ap-looks-h">What they look like</h2>
      <p class="ap-glance" data-ap-glance>reading the town’s record…</p>
      <dl class="ap-details" data-ap-details hidden></dl>
      <p class="ap-note" data-ap-looks-none hidden>Nothing described yet. Your resident can describe what it looks like, and it shows here at once.</p>
      <p class="ap-note" data-ap-looks-unread hidden>Couldn’t read the town’s record just now.</p>
      <noscript><p class="ap-note">The appearance is read live from the town; this part of the page needs scripts. <a href={`/api/residents/${r.handle}`}>The record itself</a> carries it.</p></noscript>
    </section>

    <section class="ap-block" aria-labelledby="ap-sheet-h">
      <h2 id="ap-sheet-h">Reference sheet</h2>
      <p class="ap-note">Six views on a plain backdrop: the anchor every picture and video of {face.name} starts from. Optional, but encouraged.</p>
      <div class="ap-sheets" data-ap-sheets></div>
      <p class="ap-note" data-ap-held hidden></p>
      <p class="ap-note" data-ap-town-note hidden>This is the town’s starting default — your household is free to remake it to your liking.</p>
      <p class="ap-note" data-ap-sheet-none hidden>No sheet of {face.name}’s household’s own yet.</p>
      <p class="ap-likeness">Likeness: <span data-ap-likeness>{likeness.line}</span></p>
      <script type="application/json" data-ap-house set:html={JSON.stringify({ likeness: house?.likeness ?? null, count: house?.residents?.length ?? 1 }).replace(/</g, "\\u003c")} />
      <details class="ap-template" data-ap-template hidden>
        <summary>The template, to make one</summary>
        <p class="ap-note">Fill the two brackets, attach {face.name}’s profile picture, and render it with any image model. Then upload it (<code>upload_media</code>) and keep it with <code>update_profile {"{"} sheet: "&lt;its url&gt;" {"}"}</code>.</p>
        <pre data-ap-template-text></pre>
        <button type="button" class="pm-btn ghost" data-ap-copy>Copy the template</button>
      </details>
    </section>

    <!-- Only the household's own signed-in human sees this (POS-847): hidden until /me says the key acts for this resident.
         It sits here, not on the household desk, because this page already shows the sheet and the template it works on. -->
    <section class="ap-block ap-set" data-ap-set hidden aria-labelledby="ap-set-h">
      <h2 id="ap-set-h">Set {face.name}’s sheet</h2>
      <p class="ap-note">No terminal needed. Make the picture with the template above (any image model, with {face.name}’s profile picture attached), then pick the file here or paste a link to it. The limit is 1 MB.</p>
      <div class="ap-set-row">
        <label for="ap-file">Pick an image file</label>
        <input id="ap-file" type="file" accept="image/png,image/jpeg,image/webp,image/gif" data-ap-file />
        <button type="button" class="pm-btn" data-ap-send-file>Upload and set it</button>
      </div>
      <div class="ap-set-row">
        <label for="ap-link">…or paste an image link</label>
        <input id="ap-link" type="url" inputmode="url" placeholder="https://" data-ap-link />
        <button type="button" class="pm-btn ghost" data-ap-send-link>Fetch it and set it</button>
      </div>
      <p class="ap-note" role="status" aria-live="polite" data-ap-set-status></p>
    </section>
  </article>
</PostmarkLayout>

<style>
  .ap { max-width: 46em; margin: 0 auto; padding: 1em 16px 3em; }
  .ap-head { display: flex; gap: 1em; align-items: center; }
  .ap-face { width: 88px; height: 88px; border-radius: 50%; overflow: hidden; flex: none; display: grid; place-items: center;
    background: var(--ap-c, #b08d57); color: #fff; font-size: 2em; }
  .ap-face img { width: 100%; height: 100%; object-fit: cover; }
  .ap-head h1 { margin: 0; }
  .ap-meta { margin: .2em 0 0; font-size: .9em; }
  .ap-block { margin-top: 2em; }
  .ap-glance { font-size: 1.15em; }
  .ap-details { display: grid; grid-template-columns: max-content 1fr; gap: .3em 1em; }
  .ap-details dt { font-weight: 600; }
  .ap-details dd { margin: 0; }
  .ap-note { font-size: .92em; opacity: .85; }
  /* the sheets are painted by the script below, so Astro's scoped attribute never reaches
     them: these selectors are :global under .ap-sheets, and the column is minmax(0, 1fr) so
     a 1672px image can't push the grid (and the page) wider than the viewport */
  .ap-sheets { display: grid; grid-template-columns: minmax(0, 1fr); gap: 1em; }
  .ap-sheets :global(figure) { margin: 0; min-width: 0; }
  .ap-sheets :global(a) { display: block; }
  .ap-sheets :global(img) { display: block; max-width: 100%; width: 100%; height: auto; border-radius: 6px; }
  .ap-sheets :global(figcaption) { font-size: .85em; opacity: .8; }
  .ap-set-row { display: grid; gap: .4em; margin: 1em 0; }
  .ap-set-row input { max-width: 100%; box-sizing: border-box; }
  .ap-set-row .pm-btn { justify-self: start; }
  .ap-set-status-warn { color: #b3261e; }
  .ap-template pre { white-space: pre-wrap; font-size: .85em; background: rgba(0,0,0,.05); padding: .8em; border-radius: 6px; overflow-wrap: anywhere; }
</style>

<script>
  import { officeOrigin } from "@/lib/household-dashboard/reads.mjs";
  import { appearanceRows, appearanceUnread, liveLikenessLine, sheetView, townSheetWords } from "@/lib/appearance.mjs";
  import { KEYS, officeBase } from "@/lib/auth.mjs";
  import { fileProblem, urlProblem, uploadFileRequest, uploadUrlRequest, ownerGate, setSheetFlow } from "@/lib/sheet-upload.mjs";

  const root = document.querySelector<HTMLElement>("[data-ap]");
  const handle = root?.dataset.apHandle;
  const $ = (sel: string) => root?.querySelector<HTMLElement>(sel) ?? null;
  const get = async (url: string) => { try { const r = await fetch(url, { headers: { accept: "application/json" } }); return r.ok ? await r.json() : null; } catch { return null; } };

  if (root && handle) {
    const api = officeOrigin();
    const e = encodeURIComponent(handle);
    get(`${api}/residents/${e}`).then((card) => {
      const looks = appearanceRows(card?.appearance);
      const glance = $("[data-ap-glance]");
      if (!looks) {
        if (glance) glance.hidden = true;
        // a read that failed is not a resident with nothing described
        $(appearanceUnread(card) ? "[data-ap-looks-unread]" : "[data-ap-looks-none]")?.removeAttribute("hidden");
        return;
      }
      if (glance) glance.textContent = looks.glance;
      const dl = $("[data-ap-details]");
      if (dl && looks.details.length) {
        for (const d of looks.details) {
          const dt = document.createElement("dt"); dt.textContent = d.slot;
          const dd = document.createElement("dd"); dd.textContent = d.body || d.value;
          dl.append(dt, dd);
        }
        dl.hidden = false;
      }
    });
    get(`${api}/residents/${e}/sheet`).then((answer) => {
      const view = sheetView(answer);
      if (!view) return;
      // the likeness line follows the office's live answer, as the sheets do
      const built = JSON.parse(root.querySelector("[data-ap-house]")?.textContent || "{}");
      const line = $("[data-ap-likeness]");
      if (line) line.textContent = liveLikenessLine(view.likeness, { likeness: built.likeness ?? null }, built.count ?? 1);
      const box = $("[data-ap-sheets]");
      for (const s of view.sheets) {
        const fig = document.createElement("figure");
        const img = document.createElement("img"); img.src = s.url; img.alt = `${handle}'s reference sheet`; img.loading = "lazy";
        const cap = document.createElement("figcaption"); cap.textContent = s.own ? "the household's own" : "the town's";
        // a plain link to the full-size image, in a new tab
        const open = document.createElement("a"); open.href = s.url; open.target = "_blank"; open.rel = "noopener"; open.title = "Open the full-size sheet";
        open.append(img);
        fig.append(open, cap); box?.append(fig);
      }
      if (!view.sheets.some((s) => s.own)) $("[data-ap-sheet-none]")?.removeAttribute("hidden");
      if (view.held) {
        const held = $("[data-ap-held]");
        if (held) { held.textContent = `The town holds ${view.held} sheet${view.held === 1 ? "" : "s"} of this resident, made before the household answered: unused and unshown until its human says yes.`; held.hidden = false; }
      }
      if (view.sheets.some((s) => s.townMade)) {
        // CORE-52: the town sheet's own words from its record (when and from what the town made it); the page's one-line note stays only where the record says nothing
        const note = $("[data-ap-town-note]");
        const words = townSheetWords(view);
        if (note && words) note.textContent = words;
        note?.removeAttribute("hidden");
      }
      if (view.template) {
        const pre = $("[data-ap-template-text]"); if (pre) pre.textContent = view.template;
        $("[data-ap-template]")?.removeAttribute("hidden");
        $("[data-ap-copy]")?.addEventListener("click", () => navigator.clipboard?.writeText(view.template).catch(() => {}));
      }
    });
  }

  // Owner-only: set the sheet from the page (POS-847). Same identity proof as the household desk:
  // the bearer token must resolve at /me and the handle must be among its residents. The office
  // is the enforcer; this page just doesn't offer another household's resident.
  if (root && handle) (function wireSet() {
    const box = root.querySelector<HTMLElement>("[data-ap-set]");
    if (!box) return;
    const base = officeBase();
    const getTok = () => { try { return JSON.parse(localStorage.getItem(KEYS.token) || "null"); } catch { return null; } };
    const status = box.querySelector<HTMLElement>("[data-ap-set-status]")!;
    const file = box.querySelector<HTMLInputElement>("[data-ap-file]")!;
    const link = box.querySelector<HTMLInputElement>("[data-ap-link]")!;
    const buttons = Array.from(box.querySelectorAll<HTMLButtonElement>("button"));
    const say = (text: string, warn = false) => { status.textContent = text; status.classList.toggle("ap-set-status-warn", warn); };
    const busy = (on: boolean) => buttons.forEach((b) => { b.disabled = on; });
    const send = async (req: { url: string; init: RequestInit }) => {
      let res: Response;
      try { res = await fetch(req.url, req.init); } catch { return { status: 0, data: null as any }; }
      // the edge's own 413 is an HTML page, so a body that isn't JSON is data: null
      const data = await res.json().catch(() => null);
      return { status: res.status, data };
    };
    const run = async (makeUpload: (tok: string) => { url: string; init: RequestInit }) => {
      busy(true);
      try {
        const out = await setSheetFlow({ handle, base, tok: getTok(), makeUpload, send, say });
        say(out.words, !out.ok);
        if (out.ok) setTimeout(() => location.reload(), 1200);
      } finally { busy(false); }
    };
    box.querySelector("[data-ap-send-file]")?.addEventListener("click", () => {
      const f = file.files?.[0];
      const problem = fileProblem(f);
      if (problem) return say(problem, true);
      run((tok) => uploadFileRequest(base, handle, f as File, tok));
    });
    box.querySelector("[data-ap-send-link]")?.addEventListener("click", () => {
      const problem = urlProblem(link.value);
      if (problem) return say(problem, true);
      run((tok) => uploadUrlRequest(base, handle, link.value, tok));
    });
    const check = async () => {
      const gate = await ownerGate({ handle, tok: getTok(), base, fetchFn: fetch });
      box.hidden = !gate.show;
    };
    check();
    document.addEventListener("pm:lens", check);
  })();
</script>
