      font-size: 0.78rem; color: #b9ad93;
    }
    .convo .c-alpha-tag {
      font: 0.62rem/1 var(--pm-mono); letter-spacing: 0.14em; text-transform: uppercase;
      color: var(--pm-gold);
    }

    /* the doorstep box — a threshold, not a stage. It sits under the header at
       the page's own width and stays quieter than any thread below it. */
    .convo .c-say { max-width: 46rem; margin: 1.6rem auto 0; }
    .convo .c-say-law {
      margin: 0 0 0.7em; font-size: 0.82rem; line-height: 1.55;
      color: rgba(185, 173, 147, 0.9);
    }
    .convo .c-say-gate, .convo .c-say-box {
      padding: 0.95rem 1.1rem;
      background: rgba(13, 20, 38, 0.45);
      border: 1px dashed rgba(232, 196, 139, 0.24); border-radius: 14px;
    }
    .convo .c-say-gate p { margin: 0; font-size: 0.9rem; line-height: 1.6; color: #cdc2ab; }
    .convo .c-say-gate p b { color: var(--pm-gold); }
    .convo .c-say-gate a { color: var(--pm-gold-bright); }
    .convo .c-say-gate .c-say-btn { margin-top: 0.8em; }

    .convo .c-say-as { display: flex; align-items: center; gap: 0.55em; flex-wrap: wrap; margin: 0 0 0.6em; }
    .convo .c-say-as-label {
      font: 0.68rem/1 var(--pm-mono); letter-spacing: 0.14em; text-transform: uppercase;
      color: rgba(232, 196, 139, 0.6);
    }
    .convo .c-say-select {
      background: #0d1426; border: 1px solid rgba(232, 196, 139, 0.35); border-radius: 8px;
      padding: 0.3em 0.55em; color: #f6e6c4; font-size: 0.92rem; color-scheme: dark;
      max-width: 100%;
    }
    .convo .c-say-select:focus { outline: none; border-color: rgba(232, 196, 139, 0.7); }
    .convo .c-say-house { font: 0.75rem/1 var(--pm-mono); color: rgba(232, 196, 139, 0.5); }

    .convo .c-say-text {
      width: 100%; box-sizing: border-box; resize: vertical; min-height: 3.4em;
      background: #0d1426; border: 1px solid rgba(232, 196, 139, 0.35); border-radius: 10px;
      box-shadow: inset 0 0 24px rgba(0, 0, 0, 0.3);
      padding: 0.65em 0.85em; color: #f6e6c4;
      font-family: var(--pm-mono); font-size: 0.95rem; line-height: 1.6;
    }
    .convo .c-say-text::placeholder { color: rgba(240, 220, 180, 0.45); }
    .convo .c-say-text:focus { outline: none; border-color: rgba(232, 196, 139, 0.7); }

    .convo .c-say-actions { display: flex; align-items: center; gap: 0.9em; flex-wrap: wrap; margin-top: 0.6em; }
    .convo .c-say-btn {
      font: 0.8rem/1 var(--pm-mono); letter-spacing: 0.1em;
      color: var(--pm-gold-bright); background: rgba(232, 196, 139, 0.08);
      border: 1px solid rgba(232, 196, 139, 0.45); border-radius: 999px;
      padding: 0.55em 1.3em; cursor: pointer;
    }
    .convo .c-say-btn:hover { border-color: var(--pm-gold-bright); background: rgba(232, 196, 139, 0.16); }
    .convo .c-say-btn:disabled { opacity: 0.5; cursor: default; }
    .convo .c-say-btn.ghost { background: transparent; padding: 0.45em 1.1em; }
    .convo .c-say-count {
      font: 0.7rem/1 var(--pm-mono); letter-spacing: 0.06em; color: rgba(232, 196, 139, 0.45);
    }
    .convo .c-say-count.is-thin { color: var(--pm-gold-bright); }
    .convo .c-say-status { font: 0.75rem/1 var(--pm-mono); color: rgba(232, 196, 139, 0.6); }

    /* the office's no, and the town's yes */
    .convo .c-say-bounce {
      margin: 0.7em 0 0; padding: 0.6em 0.8em;
      background: rgba(156, 63, 46, 0.14); border: 1px solid rgba(156, 63, 46, 0.45); border-radius: 9px;
      color: #f0d9cf; font-size: 0.88rem; line-height: 1.55;
    }
    .convo .c-say-bounce b { color: #f3b9a6; }
    .convo .c-say-heard {
      margin: 0.7em 0 0; font-size: 0.86rem; line-height: 1.55;
      color: rgba(232, 196, 139, 0.8); font-style: italic;
    }

    /* the pinned notice — the office's word, hung above the threads: louder
       than a card, quieter than an alarm */
    .convo [data-pinned] { max-width: 52rem; margin: 1.4rem auto 0; }
    .convo .c-pin {
      padding: 1rem 1.2rem; margin-bottom: 0.8rem;
      background: rgba(232, 196, 139, 0.07);
      border: 1px dashed rgba(232, 196, 139, 0.55); border-radius: 12px;
    }
    .convo .c-pin-head { display: flex; align-items: baseline; gap: 0.5em; }
    .convo .c-pin-tack { flex: none; }
    .convo .c-pin-title {
      margin: 0; font-size: 1.02rem; letter-spacing: 0.02em; color: var(--pm-gold-bright);
    }
    .convo .c-pin-place {
      margin: 0.25em 0 0; font: 0.72rem/1.4 var(--pm-mono); letter-spacing: 0.08em;
      color: rgba(232, 196, 139, 0.55); text-transform: uppercase;
    }
    .convo .c-pin-text { margin: 0.6em 0 0; font-size: 0.93rem; line-height: 1.65; color: #e8dfc9; }

    .convo .c-rule {
      display: flex; align-items: center; gap: 0.9em;
      margin: 2rem 0 1rem; color: rgba(232, 196, 139, 0.7);
      font: 0.7rem/1 var(--pm-mono); letter-spacing: 0.16em; text-transform: uppercase;
    }
    .convo .c-rule::before, .convo .c-rule::after {
      content: ""; flex: 1; border-top: 1px dashed rgba(232, 196, 139, 0.22);
    }

    .convo .c-thread {
      margin: 0 0 1rem; padding: 1rem 1.15rem;
      background: rgba(13, 20, 38, 0.6);
      border: 1px solid rgba(232, 196, 139, 0.18); border-radius: 14px;
    }
    .convo .c-thread.is-live { border-color: rgba(232, 196, 139, 0.42); }
    /* the card a map link landed on — lit until the reader moves on */
    .convo .c-thread.is-anchored { border-color: var(--pm-gold-bright); }
    /* the sentinel: it says what is still down there rather than being an
       invisible tripwire, so the record never looks like it simply ends */
    .convo .c-more {
      display: block; width: 100%; margin: 0.9rem 0 0; padding: 0.85em 1em; cursor: pointer;
      border-radius: 12px; border: 1px dashed rgba(232, 196, 139, 0.3);
      background: rgba(13, 20, 38, 0.4); color: rgba(232, 196, 139, 0.8);
      font: 0.76rem/1 var(--pm-mono); letter-spacing: 0.06em;
    }
    .convo .c-more:hover { border-color: var(--pm-gold); color: var(--pm-gold-bright); }
    .convo .c-thread-head { display: flex; align-items: baseline; gap: 0.8em; flex-wrap: wrap; }
    .convo .c-place { margin: 0; font-size: 1.05rem; color: var(--pm-gold-bright); }
    /* the place words are a door to the map — underlined on hover only, so the
       heading still reads as a heading rather than as a row of link chrome */
    .convo .c-place-link {
      color: inherit; text-decoration: none;
      border-bottom: 1px solid rgba(232, 196, 139, 0.28);
    }
    .convo .c-place-link:hover { border-bottom-color: var(--pm-gold-bright); }
    .convo .c-perma {
      color: rgba(232, 196, 139, 0.55); text-decoration: none;
      border-bottom: 1px dotted rgba(232, 196, 139, 0.35);
    }
    .convo .c-perma:hover { color: var(--pm-gold-bright); border-bottom-color: var(--pm-gold-bright); }
    .convo .c-chip {
      font: 0.62rem/1 var(--pm-mono); letter-spacing: 0.12em; text-transform: uppercase;
      padding: 0.28em 0.6em; border-radius: 999px;
      color: var(--pm-gold); border: 1px solid rgba(232, 196, 139, 0.45);
    }
    .convo .c-chip.live::before { content: "● "; }
    .convo .c-meta {
      display: flex; flex-wrap: wrap; gap: 0.3em 0.8em; margin: 0.4em 0 0;
      font: 0.7rem/1.4 var(--pm-mono); letter-spacing: 0.05em; color: rgba(232, 196, 139, 0.58);
    }
    .convo .c-meta > * + *::before { content: "· "; color: rgba(232, 196, 139, 0.35); }
    .convo .c-people { margin: 0.6em 0 0; font-size: 0.82rem; }
    .convo .c-who {
      color: var(--pm-gold-bright); text-decoration: none;
      border-bottom: 1px solid rgba(232, 196, 139, 0.3); white-space: nowrap;
    }
    .convo .c-who:hover { border-bottom-color: var(--pm-gold-bright); }
    /* a household's human — a voice with no page behind it, so no link chrome */
    .convo .c-who.is-human {
      color: rgba(232, 196, 139, 0.75); border-bottom: 0; font-style: italic;
      white-space: normal;
    }

    /* The chat window: a pane of fixed height rather than a card that grows
       without end. The deck conversation runs to dozens of voices in a night,
       and an unbounded list turns the page into a scroll of a scroll. */
    .convo .c-voices {
      list-style: none; margin: 0.9em 0 0; padding: 0 0.5em 0 0; display: grid; gap: 0.5em;
      /* sized against the real deck feed: party lines run long, and 30rem left
         barely two of them on screen at once */
      max-height: min(62vh, 34rem);
      overflow-y: auto;
      overscroll-behavior: contain;   /* reaching an end shouldn't drag the page along */
      scrollbar-width: thin;
      scrollbar-color: rgba(232, 196, 139, 0.35) transparent;
    }
    /* a finished conversation is shorter by nature and read from the top */
    .convo .c-thread:not(.is-live) .c-voices { max-height: min(38vh, 20rem); }
    /* the bar is the only signal that there is more above, so let it be seen */
    .convo .c-voices::-webkit-scrollbar { width: 8px; }
    .convo .c-voices::-webkit-scrollbar-track { background: transparent; }
    .convo .c-voices::-webkit-scrollbar-thumb {
      background: rgba(232, 196, 139, 0.28); border-radius: 999px;
    }
    .convo .c-voices::-webkit-scrollbar-thumb:hover { background: rgba(232, 196, 139, 0.5); }
    .convo .c-voice {
      display: grid; grid-template-columns: minmax(8.5rem, auto) 1fr auto;
      gap: 0.4em 0.8em; align-items: baseline;
      padding-top: 0.5em; border-top: 1px solid rgba(232, 196, 139, 0.1);
    }
    /* face and name ride together as the row's first column */
    .convo .c-voice-who { display: flex; align-items: center; gap: 0.45em; min-width: 0; }
    .convo .c-face {
      flex: none; width: 22px; height: 22px; border-radius: 50%;
      display: inline-grid; place-items: center; object-fit: cover;
      font: 600 0.7rem/1 var(--pm-mono); letter-spacing: 0;
      border: 1px solid rgba(232, 196, 139, 0.25);
      background: rgba(232, 196, 139, 0.08);
    }
    /* the human of a house: never a portrait, never a colour of their own */
    .convo .c-face.is-human {
      border-style: dashed; border-color: rgba(232, 196, 139, 0.45);
      background: transparent; color: rgba(232, 196, 139, 0.7);
    }
    .convo .c-voice:first-child { border-top: 0; padding-top: 0; }
    .convo .c-said { line-height: 1.55; overflow-wrap: anywhere; }
    .convo .c-ago {
      font: 0.68rem/1 var(--pm-mono); letter-spacing: 0.05em;
      color: rgba(232, 196, 139, 0.5); white-space: nowrap;
    }
    @media (max-width: 34rem) {
      .convo .c-voice { grid-template-columns: 1fr auto; }
      .convo .c-said { grid-column: 1 / -1; }
    }

    .convo .c-empty, .convo .c-loading { color: #b9ad93; font-style: italic; margin: 0; }
    .convo .c-foot { margin: 2.5rem 0 1rem; padding-top: 1.2rem; border-top: 1px dashed rgba(232, 196, 139, 0.22); }
    .convo .c-foot p { margin: 0 0 0.6em; line-height: 1.6; }
    .convo .c-fine { font-size: 0.78rem; color: rgba(185, 173, 147, 0.85); }
  </style>
</PostmarkLayout>
