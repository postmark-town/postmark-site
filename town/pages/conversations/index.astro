          if (at !== card) box.insertBefore(card, at);      // only a card out of place moves
        });
        restoreScroll(box, was, followsNew);
      }

      // ── THE WORLD'S CIRCLE READER IN A CARD: only the long room's fallback (the module script below supplies window.__pmCircleReaders) ──
      // Until CORE-156 every card mounted the reader (one `?room=` read each: live rooms at once, finished ones as they came near the screen)
      // and the reader drew the room. A card now reads from its own thread's lines and asks nothing. The reader is mounted in a card ONLY by
      // showEarlierOf above: a reader pressed for the earlier part of a room that holds more than its read carries. One mount per card, ever.
      function hook() { return window.__pmCircleReaders || null; }

      function ensureReader(card) {
        if (card.__cr) return card.__cr.ready;
        if (selected) return null;                  // the lists are hidden behind a selected conversation: no reads for rooms nobody can see
        var h = hook();
        var t = card.__t;
        var box = card.querySelector("[data-room-earlier]");
        if (!h || !t || !t.id || !box) return null; // no reader on this page, or a room with no id to read
        var host = el("div", "c-circles");
        host.setAttribute("data-circles-host", "");
        box.appendChild(host);
        var rec = { host: host, reader: null, ready: null };
        card.__cr = rec;
        rec.ready = h.mount(host, String(t.id), {
          // "Open" on a statement goes to that conversation on its own (the #circle- link), and the card goes back to its room view
          onNavigate: function (n) {
            if (!n || n.view !== "circle" || n.circleId === undefined || n.circleId === null) return;
            var id = String(n.circleId);
            setTimeout(function () { if (card.__cr && card.__cr.reader) card.__cr.reader.showRoom(); location.hash = "circle-" + encodeURIComponent(id); }, 0);
          },
          faceForSpeaker: faceForSpeaker,
          hostOwnsHeader: true,
