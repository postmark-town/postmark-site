      var sayHome = null;                      // where the speaking area lives on the ordinary page
      var selected = null;                     // { cid, rid, card, host, room, reader, mine }: cid a circle, else rid the room asked for
      var selSeq = 0;
      // what the address selects: a #circle-<id> fragment, else a ?room=<id> query (CORE-177: outside the fragment, so every bare #<id> stays the lists'
      // card anchor, whatever the id spells, `room-abc` included); a circle the reader opens inside a room's view is its fragment over that query
      function selectedHash() {
