        var primed = sel.answer;
        sel.answer = null;
        h.mount(sel.host, String(sel.room), {
          circle: sel.cid, faceForSpeaker: faceForSpeaker,
          onState: function (st) { if (selected === sel) { sel.step = st; sel.card.classList.toggle("is-room-step", st === "room"); offerSelected(sel); } },
          onNavigate: function (n) { followSelected(sel, n); },
          primed: primed,
          onCircleRead: function (id, first, body) { selectedWasRead(sel, id, first, body); },
        }).then(function (m) {
          sel.mounting = false;
          if (selected !== sel) { if (m && m.reader) { try { m.reader.destroy(); } catch (e) { /* gone */ } } return; }
          if (!m || !m.ok) { selNote(sel, "The circle reader isn't available on this page, so this conversation can't be shown here.", false); return; }
          sel.reader = m.reader;
          offerSelected(sel);
        }, function () {
          sel.mounting = false;
          selNote(sel, "This conversation couldn't be read just now, so it can't be shown. That is not the same as it being empty.", true);
        });
      }
      function loadSelected(sel) {
        if (selected !== sel) return;
        selNote(sel, "", false);
        // a circle: the circle read says its room; a room: the named room read (the requested id, as written) answers with the room's own header
        var ask = sel.cid ? "?circle=" + encodeURIComponent(sel.cid) : "?room=" + encodeURIComponent(sel.rid);
