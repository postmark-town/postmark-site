              return;
            }
            sel.answer = res.d;                 // the one answer: the reader is given it, not sent to ask again (mountSelected)
            paintSelectedPlace(sel, room);
            mountSelected(sel);
          })
          .catch(function () {
            selNote(sel, "This conversation couldn't be read just now, so it can't be shown. That is not the same as it being empty.", true);
          });
      }
      // the page's own line above the reader: the place the OFFICE says this circle is in, and the live chip (never worked out here)
      function paintSelectedPlace(sel, room) {
        sel.room = room.id;
        var title = sel.card.querySelector("[data-selected-place]");
        if (!title) { title = el("h2", "c-place"); title.setAttribute("data-selected-place", ""); sel.card.insertBefore(title, sel.host); }
        title.textContent = room.place || "somewhere in the world";
        var chip = sel.card.querySelector(".c-chip");
        if (room.live && !chip) title.after(el("span", "c-chip live", "live"));
        else if (!room.live && chip) chip.remove();
      }
      // THE READER MOVED INSIDE THE VIEW (its Back to the room, a room opener's Open, a stub's link). The page follows what is on screen: whatever moved, a reply
      // target chosen before it is dropped (a target belongs to the conversation it was chosen in); a different circle becomes the selected one (the card, the
      // address: pushState, so the browser's Back returns to the one before, with no remount). The place line is the office's own word for THAT circle: it is
      // painted from the answer the reader's press was just given (selectedWasRead), where until CORE-156 the page asked the office a second time for it.
      // The room step keeps the address: the selected conversation is still the one the visitor chose.
      function followSelected(sel, n) {
        if (selected !== sel || !n) return;
        document.dispatchEvent(new CustomEvent("pm:selected-change"));
        if (n.view !== "circle" || n.circleId === undefined || n.circleId === null) return;
        var id = String(n.circleId);
        if (!/^\d{1,18}$/.test(id) || id === sel.cid) return;
        sel.cid = id;
        sel.says = null;                        // the count the view holds is the earlier circle's until this one's answer lands
        sel.card.setAttribute("data-selected-card", id);
        try { history.pushState(null, "", "#circle-" + encodeURIComponent(id)); } catch (e) { /* the address stays; the view on screen is right */ }
        offerSelected(sel);
      }

      // ── THE ONE CONVERSATION ASKS ONLY WHEN ITS READER DOES (CORE-156) ──
      // SELECTED-ASKS:BEGIN
      // Until now this view asked `?circle=` twice on arrival and once more on EVERY answered poll, moved or not, with nothing keeping two asks from
      // overlapping. It now asks once on arrival and never on the timer. What the poll does instead costs nothing: the list answer it already holds says
      // how many lines that conversation has, and when that is more than the view was last given the view offers them ("2 new in this conversation. Show").
      // Otherwise it says plainly that it does not update by itself, with a Refresh press. A press is ONE ask, never a second while it is in flight, and
      // none while the page is waiting out a failed read. On the reader's own room step there is nothing to refresh, and the line stands down.
      function selectedWasRead(sel, id, first, body) {
        if (selected !== sel || !first || String(id) !== sel.cid) return;
        var find = body && body.find && typeof body.find === "object" ? body.find : null;
        var read = find && find.circle_read && typeof find.circle_read === "object" ? find.circle_read : null;
        sel.says = read && isFinite(read.says) ? Number(read.says) : null;        // how many lines the office says this conversation holds, as of this read
        if (find && find.room && find.room.id !== undefined && find.room.id !== null) paintSelectedPlace(sel, find.room);
        offerSelected(sel);
      }
      // how many lines the LIST the page already holds shows in this conversation (the say and everything under it), or null when no room on the page holds it
      function selectedInList(sel) {
        var found = null;
        [liveBox, closedBox].forEach(function (box) {
          Array.prototype.forEach.call(box.querySelectorAll(".c-thread"), function (card) {
            if (found !== null || !card.__t) return;
            var shape = card.__room && card.__room.shape;      // the shape the card was last drawn from: nothing is worked out again
            var node = shape ? shape.byId[sel.cid] : null;
            if (node) found = 1 + node.total;
          });
        });
        return found;
      }
      function offerSelected(sel) {
        if (selected !== sel) return;
        var row = sel.card.querySelector("[data-selected-fresh]");
        if (!row) return;
        row.hidden = !sel.reader || sel.step !== "circle";
        if (row.hidden) return;
        var words = row.querySelector("[data-selected-fresh-words]"), b = row.querySelector("[data-selected-refresh]");
        var held = selectedInList(sel);
        var fresh = held !== null && sel.says !== null && held > sel.says ? held - sel.says : 0;
        var text = sel.waiting ? "The office isn't answering just now, so this page is not asking it for more. Try again once the conversations refresh."
          : fresh ? fresh + " new in this conversation." : "This view does not update by itself.";
        if (words.textContent !== text) words.textContent = text;
        var label = sel.asking ? "Reading…" : fresh ? "Show" : "Refresh";
        if (b.textContent !== label) b.textContent = label;
        b.disabled = !!sel.asking;
      }
      function askSelected(sel) {
        if (selected !== sel || !sel.reader || sel.asking || sel.step !== "circle") return;
        sel.waiting = !!poller.state().fails;
        if (sel.waiting) { offerSelected(sel); return; }
        sel.asking = true;
        offerSelected(sel);
        var done = function () { sel.asking = false; offerSelected(sel); };
        try { Promise.resolve(sel.reader.refresh({ quiet: false })).then(done, done); } catch (e) { done(); }
      }
      // the poll's call (no argument) asks the office NOTHING; the visitor's own say (`own`) is their act, and is one ask
      function refreshSelected(own) {
        if (!selected) return;
        if (own) askSelected(selected);
        else { selected.waiting = false; offerSelected(selected); }
      }
      // SELECTED-ASKS:END
      function enterSelected(want) {
        var cid = want.cid, rid = want.rid;
        var card = el("article", "c-thread c-selected");
        if (cid) card.setAttribute("data-selected-card", cid);
        else card.setAttribute("data-selected-room", rid);
        var back = el("a", "c-selected-back", "← All conversations");
        back.href = "/conversations/";
        // an ordinary primary press leaves IN PLACE (the page, its one speaking area, an unsent draft and the chosen actor all stay); the link keeps its ordinary
        // href, so a modified press (new tab, new window, download, middle button) and a browser with no script behave as any link does
        back.addEventListener("click", function (ev) {
          if (ev.defaultPrevented || ev.button !== 0 || ev.metaKey || ev.ctrlKey || ev.shiftKey || ev.altKey) return;
          ev.preventDefault();
          try { history.pushState(null, "", "/conversations/"); } catch (e) { location.href = "/conversations/"; return; }
          syncSelected(); anchored = false; tick();
        });
        card.appendChild(back);
        var host = el("div", "c-circles");
        host.setAttribute("data-circles-host", "");
        card.appendChild(host);
        // under the reader: whether there is anything new, and the one press that asks for it (SELECTED-ASKS above); hidden until the conversation is on screen
        var freshRow = el("p", "c-fine c-selected-fresh");
        freshRow.setAttribute("data-selected-fresh", "");
        freshRow.setAttribute("role", "status");
        freshRow.hidden = true;
        freshRow.appendChild(el("span", null, "")).setAttribute("data-selected-fresh-words", "");
        var freshBtn = el("button", "c-act", "Refresh");
        freshBtn.type = "button";
        freshBtn.setAttribute("data-selected-refresh", "");
        freshBtn.addEventListener("click", function () { if (selected && selected.card === card) askSelected(selected); });
        freshRow.appendChild(document.createTextNode(" "));
        freshRow.appendChild(freshBtn);
        card.appendChild(freshRow);
        selBox.textContent = "";
        selBox.appendChild(card);
        selBox.hidden = false;
        document.documentElement.classList.add("c-selecting");
        if (h1El) h1El.textContent = "One conversation";
        // the speaking area is the page's own (one form, one auth, one submit): it moves in under the reader and goes home afterwards
        if (sayEl && !sayHome) { sayHome = document.createComment("c-say-home"); sayEl.parentNode.insertBefore(sayHome, sayEl); }
        if (sayEl) card.appendChild(sayEl);
        selected = { cid: cid, rid: rid, card: card, host: host, room: null, reader: null, mounting: false, mine: ++selSeq, answer: null, says: null, step: null, asking: false, waiting: false };
        document.dispatchEvent(new CustomEvent("pm:selected-change"));      // a reply target belongs to the conversation it was chosen in
        loadSelected(selected);
      }
      function leaveSelected() {
        var sel = selected;
        selected = null;                        // first: late answers for it are dropped
        if (sel && sel.reader) { try { sel.reader.destroy(); } catch (e) { /* gone */ } }
        if (sayEl && sayHome && sayHome.parentNode) sayHome.parentNode.insertBefore(sayEl, sayHome.nextSibling);
        if (selBox) { selBox.textContent = ""; selBox.hidden = true; }
        document.documentElement.classList.remove("c-selecting");
        if (h1El) h1El.textContent = h1Home;
        document.dispatchEvent(new CustomEvent("pm:selected-change"));
      }
      function syncSelected() {
        var want = selectedHash();
        if (!want) { if (selected) leaveSelected(); return; }
        if (selected && selectedKey(selected) === selectedKey(want)) return;
        if (selected) leaveSelected();
        enterSelected(want);
      }

      function anchorFromHash() {
        var id = decodeURIComponent((location.hash || "").slice(1));
        if (!id) return;
        var circle = /^circle-(\d{1,18})$/.exec(id);
        if (circle) return;       // a circle link is the selected view (syncSelected), not a card to scroll to
        var card = document.getElementById(id);
        if (!card) return; // a thread past the closed cap, or a stale link — the page stands
        card.scrollIntoView({ block: "start" });
        card.classList.add("is-anchored");
      }
      // SELECTED-VIEW:END
      window.addEventListener("hashchange", function () { syncSelected(); anchored = false; tick(); });
      // CORE-177: Back and Forward between "All conversations" and a ?room= view change the query, not the fragment, so no hashchange fires; the view
      // follows the address the same way (syncSelected keeps a view that already matches, so a fragment move that fires both is one sync)
      window.addEventListener("popstate", function () { syncSelected(); });

      // POLL-SCHEDULER:BEGIN
      // ONE ASK AT A TIME, AND A WAIT THAT GROWS WHILE THE OFFICE DOES NOT ANSWER (CORE-158; Wright 2026-11-22: "one ask at a time per tab; back off after a
      // failure and say so on the page"). The pace itself (POLL_MS) is not changed here. Every way into the main list's ask (the timer, a hash change, a say, the
      // faces landing, the tab coming back) goes through `tick`, which does nothing while the last ask has not settled; the next ask is armed from the SETTLEMENT,
      // after the pace on a success and after a longer, capped wait on a failure, and a success is back at the pace. A hidden tab arms nothing (a failure that
      // settles while hidden does not start the poll again), and a tab that comes back waits out what is left of a back-off rather than asking at once.
      var POLL_BACKOFF_MS = [15000, 30000, 60000];
      function makePoller(o) {
        var inFlight = false, fails = 0, timer = null, due = 0;
        function wait() { return fails ? o.steps[Math.min(fails, o.steps.length) - 1] : o.pace; }
        function clear() { if (timer !== null) { o.clearT(timer); timer = null; } }
        function arm(ms) {
          clear();
          due = o.now() + ms;             // kept even when hidden, so a tab that comes back owes only what is left of the wait
          if (o.hidden()) return;
          timer = o.setT(function () { timer = null; tick(); }, ms);
        }
        function tick() {
          if (inFlight) return false;
          inFlight = true; clear();
          var settled = false;
          function settle(ok) {
            if (settled) return;
            settled = true; inFlight = false;
            fails = ok ? 0 : fails + 1;
            arm(wait());
          }
          var p;
          try { p = o.run(); } catch (e) { settle(false); return true; }
          Promise.resolve(p).then(function (ok) { settle(ok === true); }, function () { settle(false); });
          return true;
        }
        return {
          tick: tick,
          pause: clear,
          resume: function () {
            if (timer !== null || inFlight) return;
            var left = fails ? due - o.now() : 0;
            if (left > 0) arm(left); else tick();
          },
          // the wait a failing ask now would be followed by, for the words the page says while it backs off
          retryMs: function () { return o.steps[Math.min(fails + 1, o.steps.length) - 1]; },
          state: function () { return { inFlight: inFlight, fails: fails, wait: wait(), armed: timer !== null }; },
        };
      }
      // POLL-SCHEDULER:END

      // POLL-ASK:BEGIN
      // One ask of the main list. It answers true when the office answered and false when it did not (not OK, not JSON, or the request itself failed: a rejection,
      // an abort, a timeout), which is what the scheduler above backs off on. A failure says so on the page, and says the page is waiting to retry.
      function officeSilent() {
        var s = Math.round(poller.retryMs() / 1000);
        paint(liveBox, null, "The office isn't answering, so this page is waiting " + s + " seconds to retry. The live door is /api/world/conversations.");
        return false;
      }
      function ask() {
        return fetch(pageUrl(null), { headers: { accept: "application/json" } })
          .then(function (r) { return r.ok ? r.json() : null; })
          .then(function (d) {
            if (!d) return officeSilent();
            paintPinned(d.pinned);
            // live threads follow the newest voice; a finished one is a record,
            // so it opens at the first thing said rather than the last
            paint(liveBox, d.live, "The town is quiet. Nobody is within earshot of anybody, or nobody has anything to say.", true);
            // the newest page of finished conversations: held only while the reader is on it
            holdNewest(d);
            redraw();
            // each mounted reader whose room moved takes the new talk IN PLACE (it offers "new — show"; it never pulls a reader along)
            refreshReaders(liveBox, false); refreshReaders(closedBox, false);
            refreshSelected();
            if (!anchored) { anchored = true; anchorFromHash(); }
            pinNext = false;
            if (dials && d.earshot_m) {
              dials.textContent = "Earshot is " + d.earshot_m + " metres; words stay hearable there until the next settlement."
                + " This page refreshes every " + (POLL_MS / 1000) + " seconds.";
            }
            return true;
          })
          .catch(function () { return officeSilent(); });
      }
      // POLL-ASK:END
      var poller = makePoller({
        run: ask, pace: POLL_MS, steps: POLL_BACKOFF_MS,
        hidden: function () { return document.hidden; },
        now: function () { return Date.now(); },
        setT: function (fn, ms) { return window.setTimeout(fn, ms); },
        clearT: function (t) { window.clearTimeout(t); },
      });
      function tick() { return poller.tick(); }

      // The faces arrive on their own schedule and are never waited for: the
      // first paint is names-only, and if this fetch never lands the page stays
      // names-only rather than empty. When it does land, repaint so the faces
      // appear under the names already on screen.
      // POLL-FACES:BEGIN
      // The faces landing is an AUTOMATIC ask, not a visitor's act (CORE-158): it repaints the cards with their pictures by asking the list again, but never while the
      // page is waiting out a failed read: the owed retry stands, and the pictures arrive with it. The readers are still asked to redraw at once.
      function facesReady(d) {
        if (d && d.residents) {
          faces = d.residents;
          if (!poller.state().fails) tick();
          // the readers drew (or are drawing) their bylines before the pictures landed: ask them to redraw so the faces appear under the names
          refreshReaders(liveBox, true); refreshReaders(closedBox, true);
        }
      }
      // POLL-FACES:END
      fetch("/world-engine/residents-meta.json", { headers: { accept: "application/json" } })
        .then(function (r) { return r.ok ? r.json() : null; })
        .then(facesReady)
        .catch(function () { /* names only — a face is a garnish, never the meal */ });

      tick();
      // a backgrounded tab should not keep polling the office all night; it comes back with one ask (or the rest of a back-off), never a burst
      document.addEventListener("visibilitychange", function () {
        if (document.hidden) poller.pause();
        else poller.resume();
      });
      // the doorstep box (module script below) speaks, then asks for a repaint
      // right away — waiting out the poll to see your own voice land feels broken.
      // Their own voice also beats wherever they were reading: pin to newest.
      document.addEventListener("pm:spoke", function () { pinNext = true; tick(); refreshReaders(liveBox, true); refreshReaders(closedBox, true); refreshSelected(true); });
      syncSelected();       // a #circle- or ?room= link on arrival shows its conversation at once, before the first poll answers (and whatever that page holds)
    })();
  </script>

  <script>
    // THE DOORSTEP BOX — the same identity the writing desk uses (KEYS.token in
    // localStorage, tokenIsFresh, Bearer against the same-origin office) and the
    // same sign-in: the header pill's OAuth dance, clicked, never a second flow.
    // This module only relays. The office decides who may speak, how often, and
    // what bounces; when it says no, its words go on the page verbatim.
    import { KEYS, officeBase, tokenIsFresh } from "@/lib/auth.mjs";
    import { siteWriteHeaders } from "@/lib/office-write.mjs";
    import { mountRoom, officeSource } from "@/lib/circle-reader-mount.mjs";

    const OFFICE_BASE = officeBase();

    // ── THE CIRCLE READER'S HOOK (CORE-82) ─────────────────────────────────────
    // The poller above is an inline script and cannot import, so this module hands it ONE small door: window.__pmCircleReaders.mount(host,
    // roomId, { onState }) -> Promise<{ ok, reader } | { ok: false, why }>. It loads the World's reader through the site's adapter (a pinned
    // World that does not carry it, or a failed import, is { ok: false }: the cards keep their flat transcript and say so), adds its CSS
    // once, and mounts it with the keyless office reads. Reply buttons exist only for a signed-in reader (the office still judges the say),
    // and a Reply press is announced as a `pm:reply-target` event for the speak box below. Nothing here derives a link, a parent or a circle.
    const __getTok = () => { try { return JSON.parse(localStorage.getItem(KEYS.token) || "null"); } catch { return null; } };
    // CORE-177: the door mounts through the site's ONE reader setup (circle-reader-mount.mjs mountRoom), the same one the event page's rooms use:
    // the staged World reader, its CSS added once, the keyless office reads; this page adds what is its own (Reply for a signed-in reader, the
    // #circle- link, and, CORE-128 / WLD-215, its face provider and its own card header, so the reader leaves its header out)
    window.__pmCircleReaders = {
      // CORE-156: the page draws each room's messages itself, and gives a message its Reply button only for a reader this says is signed in
      // (read at each drawing, never frozen; the office still judges the say)
      canReply: () => tokenIsFresh(__getTok()),
      async mount(host, roomId, { onState = null, onNavigate = null, circle = null, faceForSpeaker = null, hostOwnsHeader = false, primed = null, onCircleRead = null } = {}) {
        // CORE-156: the reader's reads go through here so that (1) a circle the page has ALREADY asked the office for is not asked for twice: `primed` is
        // that answer, handed to the reader for its first read of that circle and spent once; and (2) the page is told every circle answer the reader is
        // given (`onCircleRead(id, first, body)`), so it never asks again to learn what the reader just learned. Nothing here asks by itself.
        // CORE-177: a ?room= view is primed the same way: the page's named room read already answered under this room's canonical header, so the reader's
        // first read of exactly that room is that answer, spent once (one ask on arrival, as for a circle)
        const office = officeSource({ base: OFFICE_BASE });
        let unspent = circle !== null && circle !== undefined && primed && typeof primed === "object" && primed.find && typeof primed.find === "object" ? primed : null;
        let unspentRoom = (circle === null || circle === undefined) && primed && typeof primed === "object" && primed.find && typeof primed.find === "object"
          && primed.find.room && String(primed.find.room.id) === String(roomId) ? primed : null;
        const source = {
          room: (id) => {
            if (unspentRoom && String(id) === String(roomId)) { const body = unspentRoom; unspentRoom = null; return Promise.resolve(body); }
            return office.room(id);
          },
          circle: async (id, after) => {
            const first = after === undefined || after === null || after === "";
            let body;
            if (unspent && first && String(id) === String(circle)) { body = unspent; unspent = null; }
            else body = await office.circle(id, after);
            if (typeof onCircleRead === "function") { try { onCircleRead(id, first, body); } catch { /* the page's own note never fails a read */ } }
            return body;
          },
        };
        // CORE-177: mounted through the site's ONE reader setup (mountRoom: the staged World reader, its CSS once), with this source
        const m = await mountRoom({
          doc: document, host, roomId, source,
          canReply: tokenIsFresh(__getTok()),
          onReply: (target) => document.dispatchEvent(new CustomEvent("pm:reply-target", { detail: target })),
          onState, onNavigate, circle,
          hrefForCircle: (c) => `#circle-${encodeURIComponent(c)}`,
          faceForSpeaker, hostOwnsHeader,
        });
        return m.ok ? { ok: true, reader: m.reader } : m;
      },
    };
    document.dispatchEvent(new CustomEvent("pm:circles-ready"));
    const HUMAN = "__human__";     // a select value no handle can collide with
    const MAX = 500;

    const $ = (sel) => document.querySelector(sel);
    const getTok = () => { try { return JSON.parse(localStorage.getItem(KEYS.token) || "null"); } catch { return null; } };

    const gateOut = $("[data-say-signedout]");
    const gateVisitor = $("[data-say-visitor]");
    const form = $("[data-say-form]");
    const asEl = $("[data-say-as]");
    const houseEl = $("[data-say-house]");
    const textEl = $("[data-say-text]");
    const sendBtn = $("[data-say-send]");
    const countEl = $("[data-say-count]");
    const statusEl = $("[data-say-status]");
    const bounceEl = $("[data-say-bounce]");
    const heardEl = $("[data-say-heard]");
    const linkedEl = $("[data-say-linked]");
    const replyEl = $("[data-say-reply]");
    const replyTextEl = $("[data-say-reply-text]");

    // ── the reply target ─────────────────────────────────────────────────────
    // A Reply pressed in a circle hands over { id, handle, said }: the id is the one the OFFICE served on that line, the words are
    // theirs (text, cut for the row). `reply_to` rides the say only while a target is chosen, and is cleared once the say lands.
    let replyTarget = null;
    const SAID_CUT = 80;
    function renderReply() {
      if (!replyEl) return;
      replyEl.hidden = !replyTarget;
      if (!replyTarget) { replyTextEl.textContent = ""; return; }
      const said = [...replyTarget.said];
      replyTextEl.textContent = "replying to " + replyTarget.handle + ": " + (said.length > SAID_CUT ? said.slice(0, SAID_CUT).join("") + "…" : replyTarget.said);
    }
    document.addEventListener("pm:reply-target", (ev) => {
      const t = ev.detail;
      if (!t || t.id === undefined || t.id === null || !form || form.hidden) return;
      replyTarget = { id: t.id, handle: String(t.handle ?? ""), said: String(t.said ?? "") };
      renderReply();
      form.scrollIntoView?.({ block: "nearest" });
      textEl?.focus();
    });
    // CORE-117: a chosen reply target belongs to the conversation it was chosen in; choosing or leaving a selected conversation clears it
    document.addEventListener("pm:selected-change", () => { replyTarget = null; renderReply(); });
    $("[data-say-reply-clear]")?.addEventListener("click", () => { replyTarget = null; renderReply(); textEl?.focus(); });

    function only(el) {
      for (const s of [gateOut, gateVisitor, form]) if (s) s.hidden = s !== el;
    }

    $("[data-say-signin]")?.addEventListener("click", () => {
      document.querySelector("[data-auth-signin]")?.click();
    });

    // ── the box ──────────────────────────────────────────────────────────────
    function syncCount() {
      const left = MAX - textEl.value.length;
      countEl.textContent = left + " left";
      countEl.classList.toggle("is-thin", left <= 40);
    }
    textEl?.addEventListener("input", syncCount);

    function setStatus(msg) {
      statusEl.textContent = msg || "";
      statusEl.hidden = !msg;
    }

    // Bounces are sentences, not alerts — and every character of them comes from
    // the office, so both halves go in as text nodes.
    function showBounce(defect, hint) {
      bounceEl.textContent = "";
      const b = document.createElement("b");
      b.textContent = defect;
      bounceEl.appendChild(b);
      if (hint) bounceEl.appendChild(document.createTextNode(" — " + hint));
      bounceEl.hidden = false;
      heardEl.hidden = true;
    }

    function clearBounce() { bounceEl.hidden = true; bounceEl.textContent = ""; }

    // What the town says back when a word lands: where it was heard, and by how
    // many. Nobody near is not a failure — the record still keeps it.
    function showHeard(data) {
      const where = data.where || {};
      const n = Array.isArray(data.listeners) ? data.listeners.length : 0;
      // `aboard` is a flag, not a name — and when it's set the place words
      // already open with "aboard …", so they stand alone. Prefixing "at" (or
      // concatenating the flag) is how you get "aboard true" on a deck.
      const at = where.aboard
        ? (where.place || "aboard the vessel")
        : "at " + (where.place || "where you stand");
      let words = n
        ? "Heard " + at + " — " + (n === 1 ? "one" : String(n)) + " within earshot."
        : "Said " + at + ". Nobody was near enough to hear it; the town's record keeps it anyway.";
      if (data.note) words += " " + data.note;
      heardEl.textContent = words;
      heardEl.hidden = false;
      clearBounce();
    }

    let speaking = false;
    async function speak(ev) {
      ev.preventDefault();
      if (speaking) return;
      const text = (textEl.value || "").trim();
      if (!text) {
        showBounce("nothing to say yet", "write a line first — earshot carries words, not silence.");
        return;
      }
      const tok = getTok();
      if (!tokenIsFresh(tok)) { boot(); return; }
      const as = asEl.value;
      // reply_to is ADDITIVE: absent unless a Reply was chosen, and exactly the id the office served on that line
      const payload = { ...(as === HUMAN ? { human: true, text } : { handle: as, text }), ...(replyTarget ? { reply_to: replyTarget.id } : {}) };

      clearBounce();
      heardEl.hidden = true;
      linkedEl.hidden = true; linkedEl.textContent = "";
      speaking = true; sendBtn.disabled = true; setStatus("saying it…");
      let res, data;
      try {
        res = await fetch(OFFICE_BASE + "/world/say", {
          method: "POST",
          headers: siteWriteHeaders(tok.access_token),
          body: JSON.stringify(payload),
        });
        data = await res.json().catch(() => ({}));
      } catch {
        speaking = false; sendBtn.disabled = false; setStatus("");
        showBounce("the office didn't answer", "couldn't reach the town — check your connection and try again. Nothing was said.");
        return;
      }
      speaking = false; sendBtn.disabled = false; setStatus("");
      if (res.status === 401) { boot(); return; }
      if (!res.ok || data.spoke === false) {
        showBounce(data.defect || ("the office said no (" + res.status + ")"), data.hint || "");
        return;
      }
      textEl.value = "";
      syncCount();
      showHeard(data);
      // the office's own sentence about the link (`said.note`: "linked by name"; `said.id_note`: why a say has no act number), as served
      const notes = [data.said?.note, data.said?.id_note].filter((n) => typeof n === "string" && n.trim()).map((n) => n.trim());
      if (notes.length) { linkedEl.textContent = notes.join(" "); linkedEl.hidden = false; }
      replyTarget = null; renderReply();      // a reply is answered once; the next say starts clean
      // the threads are painted by the inline poller; ask it for an immediate
      // repaint so the speaker watches their own voice arrive
      document.dispatchEvent(new CustomEvent("pm:spoke"));
    }
    form?.addEventListener("submit", speak);

    // ⌘/Ctrl-Enter speaks — the box is two rows, so Enter has to stay a newline
    textEl?.addEventListener("keydown", (e) => {
      if (e.key === "Enter" && (e.metaKey || e.ctrlKey)) { e.preventDefault(); form.requestSubmit(); }
    });

    // ── boot: who is signed in, and what voices do they own ──────────────────
    function seedVoices(handles, household) {
      asEl.textContent = "";
      for (const h of handles) {
        const o = document.createElement("option");
        o.value = h; o.textContent = h;                  // handles are town data — text, never markup
        asEl.appendChild(o);
      }
      const mine = document.createElement("option");
      mine.value = HUMAN;
      mine.textContent = "yourself (the human of the house)";
      asEl.appendChild(mine);
      houseEl.textContent = household ? "· " + household : "";
    }

    async function boot() {
      const tok = getTok();
      if (!tokenIsFresh(tok)) return only(gateOut);
      let me;
      try {
        const r = await fetch(OFFICE_BASE + "/me", {
          headers: { accept: "application/json", authorization: "Bearer " + tok.access_token },
        });
        if (!r.ok) return only(gateOut);
        me = await r.json();
      } catch { return only(gateOut); }
      if (me.visitor || !(me.handles && me.handles.length)) return only(gateVisitor);
      // `me.household` is the GitHub login, not the town's word for the house.
      // The per-handle registry block carries the slug the world actually
      // records — a human's voice lands as human-of-<slug> — so the nameplate
      // and the voice say the same word. An undeclared house has a null slug
      // and the block is absent entirely without the registry view; both fall
      // back to the login rather than to nothing.
      seedVoices(me.handles, me.households?.[me.handles[0]]?.slug ?? me.household);
      syncCount();
      only(form);
    }

    boot();
  </script>

  <style is:global>
    .convo .c-head { text-align: center; padding: 2.2rem 0 1.2rem; max-width: 46rem; margin: 0 auto; }
    .convo .c-crumb {
      font: 0.68rem/1 var(--pm-mono); letter-spacing: 0.22em;
      color: var(--pm-gold); margin: 0 0 0.9em;
    }
    .convo .c-head h1 { margin: 0 0 0.5em; }
    .convo .c-sub { margin: 0 0 0.7em; line-height: 1.65; }
    .convo .c-sub-quiet { color: #b9ad93; font-size: 0.95rem; }
    .convo .c-alpha {
      display: inline-flex; align-items: center; gap: 0.6em;
      margin: 0.5em 0 0; padding: 0.35em 0.8em;
      border: 1px dashed rgba(232, 196, 139, 0.35); border-radius: 999px;
      font-size: 0.78rem; color: #b9ad93;
    }
    .convo .c-alpha-tag {
      font: 0.62rem/1 var(--pm-mono); letter-spacing: 0.14em; text-transform: uppercase;
      color: var(--pm-gold);
    }

    /* the doorstep box — a threshold, not a stage. It sits under the header at
       the page's own width and stays quieter than any thread below it. */
    .convo .c-say { max-width: 46rem; margin: 1.6rem auto 0; }
    .convo .c-say-law {
      margin: 0 0 0.7em; font-size: 0.82rem; line-height: 1.55;
      color: rgba(185, 173, 147, 0.9);
    }
    .convo .c-say-gate, .convo .c-say-box {
      padding: 0.95rem 1.1rem;
      background: rgba(13, 20, 38, 0.45);
      border: 1px dashed rgba(232, 196, 139, 0.24); border-radius: 14px;
    }
    .convo .c-say-gate p { margin: 0; font-size: 0.9rem; line-height: 1.6; color: #cdc2ab; }
    .convo .c-say-gate p b { color: var(--pm-gold); }
    .convo .c-say-gate a { color: var(--pm-gold-bright); }
    .convo .c-say-gate .c-say-btn { margin-top: 0.8em; }

    .convo .c-say-as { display: flex; align-items: center; gap: 0.55em; flex-wrap: wrap; margin: 0 0 0.6em; }
    .convo .c-say-as-label {
      font: 0.68rem/1 var(--pm-mono); letter-spacing: 0.14em; text-transform: uppercase;
      color: rgba(232, 196, 139, 0.6);
    }
    .convo .c-say-select {
      background: #0d1426; border: 1px solid rgba(232, 196, 139, 0.35); border-radius: 8px;
      padding: 0.3em 0.55em; color: #f6e6c4; font-size: 0.92rem; color-scheme: dark;
      max-width: 100%;
    }
    .convo .c-say-select:focus { outline: none; border-color: rgba(232, 196, 139, 0.7); }
    .convo .c-say-house { font: 0.75rem/1 var(--pm-mono); color: rgba(232, 196, 139, 0.5); }

    .convo .c-say-text {
      width: 100%; box-sizing: border-box; resize: vertical; min-height: 3.4em;
      background: #0d1426; border: 1px solid rgba(232, 196, 139, 0.35); border-radius: 10px;
      box-shadow: inset 0 0 24px rgba(0, 0, 0, 0.3);
      padding: 0.65em 0.85em; color: #f6e6c4;
      font-family: var(--pm-mono); font-size: 0.95rem; line-height: 1.6;
    }
    .convo .c-say-text::placeholder { color: rgba(240, 220, 180, 0.45); }
    .convo .c-say-text:focus { outline: none; border-color: rgba(232, 196, 139, 0.7); }

    .convo .c-say-actions { display: flex; align-items: center; gap: 0.9em; flex-wrap: wrap; margin-top: 0.6em; }
    .convo .c-say-btn {
      font: 0.8rem/1 var(--pm-mono); letter-spacing: 0.1em;
      color: var(--pm-gold-bright); background: rgba(232, 196, 139, 0.08);
      border: 1px solid rgba(232, 196, 139, 0.45); border-radius: 999px;
      padding: 0.55em 1.3em; cursor: pointer;
    }
    .convo .c-say-btn:hover { border-color: var(--pm-gold-bright); background: rgba(232, 196, 139, 0.16); }
    .convo .c-say-btn:disabled { opacity: 0.5; cursor: default; }
    .convo .c-say-btn.ghost { background: transparent; padding: 0.45em 1.1em; }
    .convo .c-say-count {
      font: 0.7rem/1 var(--pm-mono); letter-spacing: 0.06em; color: rgba(232, 196, 139, 0.45);
    }
    .convo .c-say-count.is-thin { color: var(--pm-gold-bright); }
    .convo .c-say-status { font: 0.75rem/1 var(--pm-mono); color: rgba(232, 196, 139, 0.6); }

    /* the office's no, and the town's yes */
    .convo .c-say-bounce {
      margin: 0.7em 0 0; padding: 0.6em 0.8em;
      background: rgba(156, 63, 46, 0.14); border: 1px solid rgba(156, 63, 46, 0.45); border-radius: 9px;
      color: #f0d9cf; font-size: 0.88rem; line-height: 1.55;
    }
    .convo .c-say-bounce b { color: #f3b9a6; }
    .convo .c-say-heard {
      margin: 0.7em 0 0; font-size: 0.86rem; line-height: 1.55;
      color: rgba(232, 196, 139, 0.8); font-style: italic;
    }

    /* the pinned notice — the office's word, hung above the threads: louder
       than a card, quieter than an alarm */
    .convo [data-pinned] { max-width: 52rem; margin: 1.4rem auto 0; }
    .convo .c-pin {
      padding: 1rem 1.2rem; margin-bottom: 0.8rem;
      background: rgba(232, 196, 139, 0.07);
      border: 1px dashed rgba(232, 196, 139, 0.55); border-radius: 12px;
    }
    .convo .c-pin-head { display: flex; align-items: baseline; gap: 0.5em; }
    .convo .c-pin-tack { flex: none; }
    .convo .c-pin-title {
      margin: 0; font-size: 1.02rem; letter-spacing: 0.02em; color: var(--pm-gold-bright);
    }
    .convo .c-pin-place {
      margin: 0.25em 0 0; font: 0.72rem/1.4 var(--pm-mono); letter-spacing: 0.08em;
      color: rgba(232, 196, 139, 0.55); text-transform: uppercase;
    }
    .convo .c-pin-text { margin: 0.6em 0 0; font-size: 0.93rem; line-height: 1.65; color: #e8dfc9; }
    .convo .c-pin-ann { list-style: none; margin: 0.6em 0 0; padding: 0; font-size: 0.9rem; line-height: 1.55; color: #e8dfc9; }
    .convo .c-pin-ann-item { padding: 0.25em 0; overflow-wrap: anywhere; white-space: pre-line; }
    .convo .c-pin-ann-at { font-family: var(--pm-mono); font-size: 0.76rem; color: rgba(232, 196, 139, 0.8); }

    .convo .c-rule {
      display: flex; align-items: center; gap: 0.9em;
      margin: 2rem 0 1rem; color: rgba(232, 196, 139, 0.7);
      font: 0.7rem/1 var(--pm-mono); letter-spacing: 0.16em; text-transform: uppercase;
    }
    .convo .c-rule::before, .convo .c-rule::after {
      content: ""; flex: 1; border-top: 1px dashed rgba(232, 196, 139, 0.22);
    }

    /* THE CARD, ITS HEAD, THE FACES AND THE READER'S HOST are src/styles/conversation-host.css (CORE-177: moved there word for word, so the
       event page's rooms wear literally this theme); what follows is the chrome only this page draws */
    /* the pager's buttons ("Show earlier", "Newer conversations"): they say what is
       still down there rather than letting the record look like it simply ends */
    .convo .c-more {
      display: block; width: 100%; margin: 0.9rem 0 0; padding: 0.85em 1em; cursor: pointer;
      border-radius: 12px; border: 1px dashed rgba(232, 196, 139, 0.3);
      background: rgba(13, 20, 38, 0.4); color: rgba(232, 196, 139, 0.8);
      font: 0.76rem/1 var(--pm-mono); letter-spacing: 0.06em;
    }
    .convo .c-more:hover { border-color: var(--pm-gold); color: var(--pm-gold-bright); }
    .convo .c-more:disabled { cursor: progress; opacity: 0.6; }
    .convo .c-people { margin: 0.6em 0 0; font-size: 0.82rem; display: flex; flex-wrap: wrap; align-items: center; gap: 0.35em 0.5em; }
    /* CORE-128: a speaker is their small face and their name, side by side (the same face the lines wear: about 20px) */
    .convo .c-person { display: inline-flex; align-items: center; gap: 0.35em; min-width: 0; }
    .convo .c-person > .c-face { width: 20px; height: 20px; font-size: 0.62rem; box-sizing: border-box; }
    /* CORE-156: a crowded room's speakers are capped; "and N more" opens the rest in place, "show fewer" folds them */
    .convo .c-people-more {
      font: 0.72rem/1.4 var(--pm-mono); letter-spacing: 0.04em; color: rgba(232, 196, 139, 0.8); background: none; border: 0; margin: 0 0 0 0.3em; padding: 0.35em 0; cursor: pointer;
      text-decoration: underline; text-decoration-color: rgba(232, 196, 139, 0.4); text-underline-offset: 2px;
    }
    .convo .c-people-more:hover { color: var(--pm-gold-bright); }
    .convo .c-people-more:focus-visible { outline: 2px solid var(--pm-gold-bright); outline-offset: 2px; border-radius: 4px; }
    /* CORE-156: under the one conversation, whether there is anything new and the one press that asks for it */
    .convo .c-selected-fresh { margin: 0.8em 0 0; }
    .convo .c-selected-fresh[hidden] { display: none; }
    .convo .c-selected-fresh .c-act { font: 0.72rem/1.4 var(--pm-mono); letter-spacing: 0.04em; margin-left: 0.4em; }
    .convo .c-selected-fresh .c-act:disabled { opacity: 0.6; cursor: progress; }
    .convo .c-who {
      color: var(--pm-gold-bright); text-decoration: none;
      border-bottom: 1px solid rgba(232, 196, 139, 0.3); white-space: nowrap;
    }
    .convo .c-who:hover { border-bottom-color: var(--pm-gold-bright); }
    /* a household's human — a voice with no page behind it, so no link chrome */
    .convo .c-who.is-human {
      color: rgba(232, 196, 139, 0.75); border-bottom: 0; font-style: italic;
      white-space: normal;
    }

    /* The chat window: a pane of fixed height rather than a card that grows
       without end. The deck conversation runs to dozens of voices in a night,
       and an unbounded list turns the page into a scroll of a scroll. */
    .convo .c-voices {
      list-style: none; margin: 0.9em 0 0; padding: 0 0.5em 0 0; display: grid; gap: 0.5em;
      /* sized against the real deck feed: party lines run long, and 30rem left
         barely two of them on screen at once */
      max-height: min(62vh, 34rem);
      overflow-y: auto;
      overscroll-behavior: contain;   /* reaching an end shouldn't drag the page along */
      scrollbar-width: thin;
      scrollbar-color: rgba(232, 196, 139, 0.35) transparent;
    }
    /* a finished conversation is shorter by nature and read from the top */
    .convo .c-thread:not(.is-live) .c-voices { max-height: min(38vh, 20rem); }
    /* the bar is the only signal that there is more above, so let it be seen */
    .convo .c-voices::-webkit-scrollbar { width: 8px; }
    .convo .c-voices::-webkit-scrollbar-track { background: transparent; }
    .convo .c-voices::-webkit-scrollbar-thumb {
      background: rgba(232, 196, 139, 0.28); border-radius: 999px;
    }
    .convo .c-voices::-webkit-scrollbar-thumb:hover { background: rgba(232, 196, 139, 0.5); }
    .convo .c-voice {
      display: grid; grid-template-columns: minmax(8.5rem, auto) 1fr auto;
      gap: 0.4em 0.8em; align-items: baseline;
      padding-top: 0.5em; border-top: 1px solid rgba(232, 196, 139, 0.1);
    }
    /* face and name ride together as the row's first column */
    .convo .c-voice-who { display: flex; align-items: center; gap: 0.45em; min-width: 0; }
    .convo .c-voices > .c-voice:first-child { border-top: 0; padding-top: 0; }
    /* the WHOLE message, as it was written (its own line breaks kept): never clamped, never cut (CORE-156) */
    .convo .c-said { line-height: 1.55; overflow-wrap: anywhere; white-space: pre-wrap; min-width: 0; }
    .convo .c-ago {
      font: 0.68rem/1 var(--pm-mono); letter-spacing: 0.05em;
      color: rgba(232, 196, 139, 0.5); white-space: nowrap;
    }

    /* CORE-156: READING A ROOM. Under a message's words, what a reader can do with it: Reply (signed in) and Open (the circle on its own, a link to share) */
    .convo .c-acts {
      grid-column: 2 / -1; display: flex; flex-wrap: wrap; align-items: center; gap: 0.1em 1.1em;
      font: 0.7rem/1.4 var(--pm-mono); letter-spacing: 0.04em;
    }
    .convo .c-act {
      font: inherit; letter-spacing: inherit; color: rgba(232, 196, 139, 0.72); background: none; border: 0; margin: 0; padding: 0.25em 0; cursor: pointer;
      text-decoration: underline; text-decoration-color: rgba(232, 196, 139, 0.35); text-underline-offset: 2px;
    }
    .convo .c-act:hover { color: var(--pm-gold-bright); text-decoration-color: var(--pm-gold-bright); }
    .convo .c-act:focus-visible, .convo .c-fold:focus-visible { outline: 2px solid var(--pm-gold-bright); outline-offset: 2px; border-radius: 4px; }
    .convo .c-loose { grid-column: 2 / -1; font-style: italic; }
    /* the ONE button under a message that has replies ("3 replies": the whole circle, every level): it opens the circle in place and folds it again */
    .convo .c-fold-wrap, .convo .c-kids-wrap { list-style: none; min-width: 0; }
    .convo .c-fold {
      display: inline-flex; align-items: center; margin: 0 0.5em 0.1em 0; padding: 0.5em 0.95em; min-height: 2.25rem; cursor: pointer;
      font: 500 0.74rem/1 var(--pm-mono); letter-spacing: 0.04em; color: var(--pm-gold);
      background: rgba(232, 196, 139, 0.08); border: 1px solid rgba(232, 196, 139, 0.3); border-radius: 999px;
    }
    .convo .c-fold:hover { border-color: var(--pm-gold); color: var(--pm-gold-bright); }
    .convo .c-fold[aria-expanded="true"] { background: rgba(232, 196, 139, 0.16); border-color: rgba(232, 196, 139, 0.5); }
    /* "N new": replies that arrived while the circle was folded; pressing it opens the circle with them on screen */
    .convo .c-fold-new, .convo .c-fold-new:hover { color: #1b2233; background: var(--pm-gold); border-color: var(--pm-gold); font-weight: 600; }
    .convo .c-fold-new:hover { background: var(--pm-gold-bright); border-color: var(--pm-gold-bright); }
    /* an open circle: each reply whole, set in from the left under the message it answers, beside a thin line; every level at once */
    .convo .c-kids {
      list-style: none; margin: 0.4em 0 0.2em 0.9rem; padding: 0 0 0 0.9rem; display: grid; gap: 0.5em;
      border-left: 2px solid rgba(232, 196, 139, 0.3);
    }
    .convo .c-kids .c-kids { margin-top: 0; margin-bottom: 0; }
    .convo .c-kids > .c-voice { border-top: 1px dashed rgba(232, 196, 139, 0.14); }
    /* a very long back-and-forth stops stepping in (its words must keep their width on a phone); each reply still sits under what it answers */
    .convo .c-kids[data-deep] { margin-left: 0; padding-left: 0; border-left: 0; }
    /* THE CIRCLE (Darko, 2026-11-22: "the circle design of the expandable replies"): the replies button wears a small circle, and an OPEN circle's own
       line carries one at its midpoint, as the World's reader draws it (WLD-178). The line is drawn in two pieces so the circle needs no fill behind it.
       Line and circle fold the whole circle, like the button; the levels inside keep their plain thin lines (they open and fold with it). */
    .convo .c-fold:not(.c-fold-new)::before {
      content: ""; flex: none; box-sizing: border-box; width: 0.85rem; height: 0.85rem; margin-right: 0.6em;
      border: 2px solid currentColor; border-radius: 50%; background: rgba(232, 196, 139, 0.22);
    }
    .convo .c-fold[aria-expanded="true"]::before { background: transparent; }
    .convo .c-kids[data-circle] { position: relative; margin-left: 0.1rem; padding-left: 1.75rem; border-left: 0; }
    .convo .c-ring-row { position: absolute; left: 0; top: 0; bottom: 0; width: 1.5rem; list-style: none; }
    .convo .c-ring-line, .convo .c-ring { position: absolute; margin: 0; padding: 0; cursor: pointer; color: var(--pm-gold); background: transparent; }
    .convo .c-ring-line { inset: 0; width: 100%; border: 0; border-radius: 0; }
    .convo .c-ring-line::before {
      content: ""; position: absolute; left: 50%; top: 0; bottom: 0; width: 2px; transform: translateX(-50%); border-radius: 1px; opacity: 0.45;
      background: linear-gradient(to bottom, currentColor 0, currentColor calc(50% - 0.85rem), transparent calc(50% - 0.85rem), transparent calc(50% + 0.85rem), currentColor calc(50% + 0.85rem), currentColor 100%);
    }
    .convo .c-ring { left: 50%; top: 50%; width: 1.05rem; height: 1.05rem; box-sizing: border-box; border: 2px solid currentColor; border-radius: 50%; transform: translate(-50%, -50%); opacity: 0.85; }
    .convo .c-ring-line:hover::before { opacity: 0.85; }
    .convo .c-ring:hover, .convo .c-ring-line:hover + .c-ring { opacity: 1; background: rgba(232, 196, 139, 0.2); }
    /* a reply the reader has not seen before: marked, and said in words beside its time (colour is never the only sign) */
    .convo .c-voice.is-new { background: rgba(232, 196, 139, 0.09); box-shadow: inset 3px 0 0 var(--pm-gold); border-radius: 4px; padding: 0.5em 0.5em 0.45em 0.75em; }
    .convo .c-voice.is-new > .c-ago::before { content: "new · "; color: var(--pm-gold-bright); }
    /* a room that holds more statements than its read carries says so above its pane, with the way to its earlier conversations */
    .convo .c-room-earlier { margin: 0.8em 0 0; }
    .convo .c-room-earlier > p { margin: 0; }
    .convo .c-room-earlier > .c-more { display: inline-block; width: auto; margin: 0.5rem 0 0.3rem; }
    @media (max-width: 34rem) {
      .convo .c-voice { grid-template-columns: 1fr auto; }
      .convo .c-said, .convo .c-acts, .convo .c-loose { grid-column: 1 / -1; }
      /* the time sits beside the name, on the message's first line (until CORE-156 it fell under the words) */
      .convo .c-voice > .c-ago { grid-column: 2; grid-row: 1; }
      .convo .c-kids { margin-left: 0.25rem; padding-left: 0.6rem; }
      .convo .c-kids[data-circle] { margin-left: 0; padding-left: 1.55rem; }
      .convo .c-ring-row { width: 1.4rem; }
      /* a finger's target: the links under a message stand taller, the replies button taller still */
      .convo .c-act { padding: 0.55em 0; }
      .convo .c-fold { min-height: 2.6rem; padding: 0.5em 1.05em; }
    }

    .convo .c-empty, .convo .c-loading { color: #b9ad93; font-style: italic; margin: 0; }
    .convo .c-foot { margin: 2.5rem 0 1rem; padding-top: 1.2rem; border-top: 1px dashed rgba(232, 196, 139, 0.22); }
    .convo .c-foot p { margin: 0 0 0.6em; line-height: 1.6; }

    /* CORE-82: the reply target and the #circle- note (the circle reader's host, for the one-conversation view and a long room's earlier conversations, is
       conversation-host.css; the reader brings its own stylesheet, READER_CSS, added once by the module script) */
    .convo .c-say-reply[hidden], .convo .c-say-linked[hidden], .convo [data-selected][hidden], .convo .c-selected-note[hidden] { display: none; }
    /* CORE-117: ONE conversation. The lists, the pins and the page's intro step aside; the card is the page's one thread, the speaking area sits under it */
    html.c-selecting .convo > *:not(.c-head):not([data-selected]) { display: none; }
    html.c-selecting .convo .c-head > *:not(h1):not(.c-crumb) { display: none; }
    .convo .c-selected { margin: 0 0 1.2rem; }
    .convo .c-selected-back {
      display: block; width: fit-content; margin: 0 0 0.7rem; font: 0.78rem/1.4 var(--pm-mono); letter-spacing: 0.04em;
      color: var(--pm-gold-bright); text-decoration: none; border-bottom: 1px solid rgba(232, 196, 139, 0.4);
    }
    .convo .c-selected-note { margin: 0.5em 0; }
    .convo .c-selected [data-selected-place] { display: inline-block; margin-right: 0.6rem; }
    /* the room one step back (the reader's own Back to the room) draws the room's whole header itself: the page's partial place + live line stands down there, so one metadata group is on screen */
    .convo .c-selected.is-room-step [data-selected-place], .convo .c-selected.is-room-step > .c-chip { display: none; }
    .convo .c-selected > .c-say { margin: 1.2rem 0 0; }
    .convo .c-say-reply {
      display: flex; align-items: center; gap: 0.7em; flex-wrap: wrap; margin: 0 0 0.5em;
      padding: 0.5em 0.8em; border-radius: 8px; border: 1px dashed rgba(232, 196, 139, 0.4);
      color: rgba(246, 230, 196, 0.95); font-size: 0.86rem; line-height: 1.5;
    }
    .convo .c-say-reply-text { min-width: 0; overflow-wrap: anywhere; }
    .convo .c-say-linked { font-style: normal; }
  </style>
</PostmarkLayout>
