      }

      // NO ASK, EVER, FROM HERE (CORE-156). The poll, the pictures landing and a say all call this, and until now it re-read `?room=` for every mounted
      // reader whose room had moved (and `?circle=` for each circle opened in it), on the timer. A reader mounted in a card (the long room's list) is read
      // ONCE, on the press that mounted it, and never again by the page: it is a list of where the room's conversations start, and the room's own pane
      // beside it is what stays current. `all` (the pictures landed, a say was spoken) redraws each room's own pane from the lines it already holds.
      function refreshReaders(box, all) {
        if (!all) return;
        Array.prototype.forEach.call(box.querySelectorAll(".c-thread"), redrawRoom);
      }

      function dropCard(card) {
        var rec = card.__cr;
        if (rec && rec.reader) { try { rec.reader.destroy(); } catch (e) { /* gone */ } }
        if (card.parentNode) card.parentNode.removeChild(card);
      }

      // the module script says the hook is there (it may land after the first paint): the rooms are redrawn from the lines they hold (a signed-in
      // reader's Reply buttons, a long room's "earlier" button), with no ask of the office; and the selected conversation is mounted if one is waiting
      document.addEventListener("pm:circles-ready", function () {
        redrawRooms();
        if (selected) mountSelected(selected);
      });

      // Pinned notices: the office's durable word over an area. Every string
      // is a text node — a notice is authored upstream, but the law here is
      // the same law as for voices: nothing resident-adjacent touches innerHTML.
      var pinnedBox = document.querySelector("[data-pinned]");
      function paintPinned(list) {
        if (!pinnedBox) return;
        if (!Array.isArray(list) || list.length === 0) { pinnedBox.hidden = true; pinnedBox.textContent = ""; return; }
        pinnedBox.textContent = "";
        list.forEach(function (n) {
          var card = el("article", "c-pin");
          var head = el("div", "c-pin-head");
          head.appendChild(el("span", "c-pin-tack", "📌"));
          head.appendChild(el("h3", "c-pin-title", String(n.title || "notice")));
