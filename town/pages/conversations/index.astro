      }
      // what the view on screen is: its circle once it has one (a room's reader can open one of its circles), else the room it was asked for
      function selectedKey(s) { return !s ? null : s.cid ? "circle:" + s.cid : "room:" + s.rid; }
      function selNote(sel, words, retry) {
        if (selected !== sel) return;
        var n = sel.card.querySelector("[data-selected-note]");
        if (!n && !words) return;
        if (!n) { n = el("p", "c-fine c-selected-note"); n.setAttribute("data-selected-note", ""); n.setAttribute("role", "status"); sel.card.insertBefore(n, sel.host); }
        n.textContent = words || "";
        n.hidden = !words;
