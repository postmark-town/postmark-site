---
// /ops/graph/ — the window (world-graph plan, Stage E).
//
// The founder's own view of world.db: every node the store holds and every edge
// between them, with the six standing invariants' findings PAINTED ONTO the
// picture rather than listed beside it. The plan's line for why that matters:
// "the feature that makes it debugging rather than decoration — lint violations
// painted as red edges: the stale wheelhouse as a dangling red edge you see,
// hanging off the vessel."
//
// Everything here is drawn client-side from the office's `GET /world/graph`,
// which is keyless like the rest of the world's read tier. Nothing about the
// graph is baked at build: the store is rehydrated on its own clock and a page
// that shipped a snapshot would be showing yesterday's world with today's date
// on it. The As-Of bar at the top says which world you are looking at, every
// time, and asks `GET /world/store` whether that is still the sha main points
// at — the store's own freshness question, answered by the store's own door
// rather than guessed from a clock here.
//
// ON CYTOSCAPE. Imported as an npm dependency and bundled by Astro, the same
// lane every other library on this site takes (marked, js-yaml): no CDN, no
// vendored copy in the tracked tree, nothing to drift. §2.6 chose it for the
// standing page because layouts, pan, zoom and click-to-expand come free; Sigma
// remains the drop-in swap if a whole-world WebGL view is ever wanted.
//
// ON THE Y AXIS. The world's y runs SOUTH and Cytoscape's runs DOWN the screen,
// so the map view passes coordinates through unchanged and north comes out up.
// The office says so in the payload (`coordinates`) rather than leaving it to a
// comment only one side can read — the GEXF exporter has to flip the same
// numbers for Gephi, and one of the two viewers was always going to get it
// backwards without the contract written down.
//
// Internal surface: noindex, like every page under /ops/.
import PostmarkLayout from "@/layouts/PostmarkLayout.astro";
import OpsNav from "@/components/OpsNav.astro";

// The seven decided edge types (§2.6 / dial 5), in the order the chips show
// them: the two structural ones first (they are 70% of the graph), then the
// convergence hops, then the one that carries a live finding.
const EDGE_TYPES = [
  { type: "contains", line: "spatial containment" },
  { type: "describes", line: "a predicate and what it predicates" },
  { type: "instance-of", line: "a token and its type" },
  { type: "implements", line: "a mark and the machinery that keeps it true" },
  { type: "reads", line: "code and a world surface it reads" },
  { type: "imports", line: "one module and another" },
  { type: "stop-of", line: "a stop and the vessel whose timetable names it" },
];

// THE STANDING COLOURS (Stage 0's lattice, re-grounded 2026-08-14): constitution
// → blue, sovereignty → green, market → yellow, gray for a standing the office
// did not send. The colour is DERIVED — the office runs the world's own
// mark-standing walk at hydration and ships the verdict per mark — because
// tier-B made the `tier:` field unlawful and the loader's default said "market"
// for every silent record, which painted every sovereign mark yellow. The
// legend's member counts are filled in by the island from the store in hand,
// never written here.
const TIERS = [
  { tier: "constitution", label: "constitution", swatch: "tier-constitution" },
  { tier: "sovereignty", label: "sovereignty", swatch: "tier-sovereignty" },
  { tier: "market", label: "market", swatch: "tier-market" },
  { tier: "draft", label: "standing not sent", swatch: "tier-draft" },
];

// ONE SPECIES OF DOT (v2, stage 1). The page used to draw four shapes — a
// circle, a diamond, a rounded box, a hexagon — which said in the only language
// a graph has that the world holds four kinds of thing. It holds one. What
// differs is what a node WEARS, and each of these is a derived fact rather than
// a species: the standing lattice as colour, a badge where the registry lives,
// a predicate drawn small and tight against the parent it continues, and the
// machinery standing off the world's edge entirely.
//
// Lifetime rings are stage 2 and deliberately absent — the payload carries no
// entities and no emissions, and a ring drawn for a lifetime nobody sent would
// be the one thing this page must never do.
const WEARINGS = [
  { cls: "dot", label: "a node of the world", line: "one species; the colour is its derived standing" },
  { cls: "badge", label: "declares a class", line: "the registry lives here — a derived fact, not a kind of thing" },
  { cls: "cont", label: "a continuation", line: "a predicate is its parent continued: drawn small, tight against it" },
  { cls: "shelf", label: "the machinery shelf", line: "binding-channel ends — code and doctrine, not nodes of the world" },
  { cls: "ghost", label: "unresolved", line: "the far end of a dangling edge; nothing in the store claims it" },
];

// THE LENSES (founder ruling, 2026-08-13). The graph-views hub's readings pour
// into this page as ways of LOOKING at the one graph, and its six-tab frame
// retires: a second page rendering a second picture of the same store was the
// thing the ruling refused. A lens repaints — it never filters, never rebuilds,
// and never adds a node the store does not hold.
//
// One at a time, like `layout`, because two paints cannot share a node.
const PAINTS = [
  { paint: "tier", label: "standing", line: "the one walk's verdict, derived at hydration — how this page has always drawn" },
  { paint: "ideal", label: "what LOGOS derives", line: "every datum on disk, sorted by where the law says it belongs" },
  { paint: "registry", label: "the class registry", line: "which nodes name a class-node — closure is a property of addressing" },
  { paint: "law", label: "the record's law", line: "the constitution as written marks — the piecewise LOGOS, lighting up as clauses land" },
  { paint: "works", label: "the keeping works", line: "the law's class marks and their open asks — a red action is the town asking for a room" },
];

// THE IDEAL VIEW'S POPULATIONS. Every key a record carries is put through the
// serialization map, and a node is coloured by the worst thing it turns up:
// residue is a violation of the law by the record, debt is the map's own
// unfinished business, and the two are never summed into one "problem".
const IDEAL = [
  { cls: "lawful", label: "lawful", line: "every key this record carries has a place the law recognises" },
  { cls: "residue", label: "residue", line: "carries a derivable the law places NOWHERE — standing, the grain; written down anyway" },
  { cls: "debt", label: "debt", line: "carries a key the serialization map has not placed yet — this table's own unfinished business" },
  { cls: "unread", label: "outside the reading", line: "code, doctrine and classes — and any mark whose key list this office did not send" },
];

// THE REGISTRY'S TWO POPULATIONS. A class-node DECLARES a class; every other
// node NAMES one, today through `kind:`. Counted apart, because conflating them
// would report the registry as its own membership.
const REGISTRY = [
  { cls: "declares", label: "declares a class", line: "carries `class:` — these ARE the registry, not citations of it" },
  { cls: "names", label: "names one", line: "addressable: the law has a class-node to reach this node through" },
  { cls: "unaddressable", label: "names none", line: "speaks the older four-word vocabulary; a class not in the graph cannot be addressed" },
  { cls: "spine", label: "the convergence spine", line: "classes, code and doctrine — the layer the traversal runs over" },
];
---
<PostmarkLayout
  door={{ get: "/api/world/store" }}
  title="The world graph — Postmark ops"
  description="The window on world.db: every node and edge in the world store, with the standing invariants' findings painted onto the graph."
  active=""
  noindex={true}
>
  <div class="opsgraph" data-graph>
    <p class="pm-kicker"><a href="/">Postmark</a> · <a href="/ops/">Ops</a> · The graph</p>
    <OpsNav here="/ops/graph/" />

    <header class="og-head">
      <h1>The world graph</h1>
      <p class="tag">world.db as it stands · the standing invariants painted on</p>
    </header>

    <!-- THE AS-OF BAR. Which world this is, when it was folded, and whether it
         is still the one main points at. Filled by the island; the shell says
         "reading" so a slow office never looks like an empty world. -->
    <section class="og-asof" data-asof>
      <span class="og-asof-dot" data-asof-dot></span>
      <span class="og-asof-text" data-asof-text>reading the store…</span>
      <span class="og-counts" data-counts></span>
      <button type="button" class="og-reload" data-reload hidden>re-read</button>
    </section>

    <!-- THE CHIPS. Views first (the whole reason to come here), then the two
         taxonomies. Every chip is a filter over what is already loaded — no
         chip costs a round trip, because the whole store came in one. -->
    <div class="og-chips">
      <div class="og-chiprow">
        <span class="og-chiplabel">view</span>
        <button type="button" class="og-chip og-chip-view is-on" data-view="all">everything</button>
        <button type="button" class="og-chip og-chip-view" data-view="convergence">convergence</button>
        <button type="button" class="og-chip og-chip-view" data-view="findings">findings only</button>
        <button type="button" class="og-chip og-chip-view" data-view="works">the works</button>
        <span class="og-chipsep"></span>
        <span class="og-chiplabel">layout</span>
        <button type="button" class="og-chip og-chip-layout is-on" data-layout="web">web</button>
        <button type="button" class="og-chip og-chip-layout" data-layout="map">map</button>
        <span class="og-chipsep"></span>
        <span class="og-chiplabel">find</span>
        <input type="search" class="og-search" data-search placeholder="id, body, household…" spellcheck="false" autocomplete="off" />
      </div>

      <div class="og-chiprow">
        <span class="og-chiplabel">paint</span>
        {PAINTS.map((p) => (
          <button type="button" class={`og-chip og-chip-paint${p.paint === "tier" ? " is-on" : ""}`} data-paint={p.paint} title={p.line}>{p.label}</button>
        ))}
      </div>

      <!-- THE STANDING ROW. The lattice as a FILTER, not just a legend: each
           chip hides or shows the marks the one walk gave that standing.
           Marks only — code, doctrine and classes have no standing to filter
           by, and they keep their own chips below. -->
      <div class="og-chiprow">
        <span class="og-chiplabel">standing</span>
        {TIERS.map((t) => (
          <button type="button" class="og-chip og-chip-tier is-on" data-tier-chip={t.tier} title="show or hide the marks the one walk gave this standing">
            <i class={`og-swatch og-${t.swatch}`} aria-hidden="true"></i>{t.label}
          </button>
        ))}
      </div>

      <!-- THE CLASS ROW, built by the island from the registry itself. Nothing
           here is written down in advance: a class-node added tomorrow gets a
           chip with no code change, and this row shrinks toward the classes as
           the older vocabulary empties. A row of constants would have to be
           edited to notice the cutover, which is a row that stops noticing. -->
      <div class="og-chiprow" data-classrow>
        <span class="og-chiplabel">classes</span>
        <span class="og-quiet" data-classrow-empty>reading the registry…</span>
      </div>

      <div class="og-chiprow">
        <span class="og-chiplabel">edges</span>
        {EDGE_TYPES.map((e) => (
          <button type="button" class="og-chip og-chip-edge is-on" data-edge={e.type} title={e.line}>{e.type}</button>
        ))}
      </div>
    </div>

    <div class="og-stage">
      <div class="og-canvas">
        <div class="og-cy" data-cy></div>

        <!-- THE ZOOM RAIL. The wheel still zooms (harder than it used to — see
             wheelSensitivity at mount); these are for the reader without a
             wheel, and for the two jumps a wheel is bad at: a decisive step
             in or out, and "put everything visible back in front of me". -->
        <div class="og-zoom">
          <button type="button" data-zoom-in title="zoom in">+</button>
          <button type="button" data-zoom-out title="zoom out">−</button>
          <button type="button" data-zoom-fit title="fit everything visible">⤢</button>
        </div>

        <!-- the legend, over the canvas' bottom-left; the standing colours are
             the half people actually need, so they go first. The colour row is
             swapped by the paint lens — a legend still naming standing while
             the canvas is painted by another reading would be worse than none. -->
        <div class="og-legend">
          <div class="og-legend-row" data-legend="tier">
            {TIERS.map((t) => (
              <span class="og-legend-item" data-tier-item={t.tier}>
                <i class={`og-swatch og-${t.swatch}`} aria-hidden="true"></i>{t.label}<b data-tier-count></b>
              </span>
            ))}
          </div>
          <div class="og-legend-row" data-legend="ideal" hidden>
            {IDEAL.map((c) => (
              <span class="og-legend-item" title={c.line}><i class={`og-swatch og-ideal-${c.cls}`} aria-hidden="true"></i>{c.label}</span>
            ))}
          </div>
          <div class="og-legend-row" data-legend="registry" hidden>
            {REGISTRY.map((c) => (
              <span class="og-legend-item" title={c.line}><i class={`og-swatch og-reg-${c.cls}`} aria-hidden="true"></i>{c.label}</span>
            ))}
          </div>
          <div class="og-legend-row" data-legend="law" hidden>
            <span class="og-legend-item"><i class="og-swatch og-rec-law" aria-hidden="true"></i>a clause of the law</span>
            <span class="og-legend-item"><i class="og-swatch og-rec-mech" aria-hidden="true"></i>a clause naming machinery</span>
            <span class="og-legend-item"><i class="og-swatch og-rec-off" aria-hidden="true"></i>not the record</span>
          </div>
          <div class="og-legend-row" data-legend="works" hidden>
            <span class="og-legend-item"><i class="og-swatch og-works-mark" aria-hidden="true"></i>a class mark of the law</span>
            <span class="og-legend-item"><i class="og-swatch og-works-ask" aria-hidden="true"></i>an open ask — the town asking</span>
            <span class="og-legend-item"><i class="og-swatch og-works-off" aria-hidden="true"></i>the rest, receded</span>
          </div>
          <div class="og-legend-row">
            {WEARINGS.map((w) => (
              <span class="og-legend-item" title={w.line}><i class={`og-wear og-wear-${w.cls}`} aria-hidden="true"></i>{w.label}</span>
            ))}
            <span class="og-legend-item og-legend-red"><i class="og-swatch og-lint" aria-hidden="true"></i>a finding</span>
          </div>
        </div>

        <!-- THE SHELF'S OWN LABEL. The band at the east edge is not a corner of
             the world the layout happened to use; it is a statement that code
             and doctrine are not IN the world. A band with no caption would read
             as the former. -->
        <p class="og-shelf-label" data-shelf-label hidden>the machinery shelf ·<br />binding-channel ends —<br />not nodes of the world</p>

        <!-- THE CLAIM, on hover. A mark's body is the sentence its author wrote
             about the thing, and until the office shipped it this window could
             say a node's degree, its tier and its path but not what it SAYS.
             Positioned over the canvas from the node's rendered position; never
             a real tooltip, because a `title` cannot be read off a canvas. -->
        <div class="og-claim" data-claim hidden aria-hidden="true"></div>

        <p class="og-hint" data-hint>tap a node to light its neighbourhood — neighbours hidden by a filter come back with it. Tap the background to let go.</p>
      </div>

      <!-- THE FINDINGS PANEL. The six standing invariants, each with its verdict,
           its headline, and its own evidence heads. "Show" selects exactly the
           nodes and edges the finding is about — the panel and the paint are one
           list, so a finding can never highlight something it does not name. -->
      <aside class="og-panel">
        <div class="og-panel-head">
          <h2 data-panel-title>Findings</h2>
          <button type="button" class="og-panel-back" data-panel-back hidden>← findings</button>
        </div>

        <div data-findings class="og-findings">
          <p class="og-quiet">reading…</p>
        </div>

        <!-- THE LENS PANEL. The chosen lens' own reading, in the findings'
             place: the law's own measures, the registry's reach, or the record's
             clauses. It is the same
             contract the findings panel holds itself to — the panel and the
             paint read one list, so a lens can never count something it does
             not light. -->
        <div data-lens class="og-lens" hidden></div>

        <!-- the inspector: what one node is, when you tap it -->
        <div data-inspector class="og-inspector" hidden></div>
      </aside>
    </div>
  </div>

  <script>
    import cytoscape from "cytoscape";
    import { officeBase } from "@/lib/auth.mjs";
    import {
      SERIALIZATION_MAP, STORE_BOUNDARY, serializationOf, idealClassOf, fieldCensus,
      classRegistry, lawMeasures, standingLattice, standingTierOf, isRecordNode, recordTree,
      isMachinery, wearsRegistryBadge, isContinuation, classFilters, filterBucketOf,
      keepingWorks, isDeclaringClassMark,
    } from "@/lib/world-lenses.mjs";

    const root = document.querySelector("[data-graph]");
    if (root) (function () {
      const OFFICE = officeBase();
      const $ = (s) => root.querySelector(s);
      const all = (s) => Array.prototype.slice.call(root.querySelectorAll(s));

      // ── the palette ───────────────────────────────────────────────────────
      // Read off the town's own tokens where one exists, hard-coded where the
      // graph needs a hue the town has never had to name (the tier lattice's
      // green and blue). Cytoscape draws to a canvas and cannot read a CSS
      // custom property, so these are the one place on the page where a colour
      // is written twice — kept together so the pair is obvious.
      const TIER = {
        constitution: "#5b86ff",   // blue — the town's own law
        sovereignty: "#3fbf87",    // green — a household's own ground
        market: "#e0b04a",         // yellow — what is traded
        draft: "#7b8494",          // gray — the sketchbooks
      };
      const KIND = {
        class: "#aa8fd8",          // --pm-stamp: law wears the stamp's violet
        code: "#4ec3d9",
        doctrine: "#f2e6cd",       // near --pm-paper: doctrine is the paper the law is written on. Deliberately NOT the town gold, which sat a few degrees off the market tier's yellow and made 8 doctrine sections indistinguishable from 400 market marks.
        unknown: "#5b6377",
      };
      const RED = "#ff5c52";       // a finding. The one colour that overrides every other.
      const SPAN_MODEL = 4000;     // the map's scale denominator (see layoutMap)

      // THE IDEAL VIEW'S PALETTE. Deliberately the lattice's own hues put to a
      // second reading, rather than four new ones: green for a record whose every
      // key the law can place, amber for one storing a derivable the law places
      // nowhere, violet — the stamp's colour, which on this page already means
      // "law" — for a key the serialization map itself has not placed, and the
      // ground colour for everything the reading does not cover. One page
      // teaching two colour languages would be worse than one hue reused.
      const IDEAL_PAINT = {
        lawful: "#3fbf87",
        residue: "#e0b04a",
        debt: "#aa8fd8",
        unread: "#3d4557",
      };

      // THE REGISTRY'S PALETTE. Addressability is a two-state question with one
      // declaring population above it: the class-nodes themselves wear the gold
      // this town keeps for its own furniture, the nodes that can name one wear
      // blue, and the nodes that cannot are the ones worth seeing — amber, in a
      // graph where most of them are.
      const REG_PAINT = {
        declares: "#e8c48b",
        names: "#5b86ff",
        unaddressable: "#e0b04a",
        spine: "#4ec3d9",
        off: "#3d4557",
      };

      // THE RECORD'S PALETTE. A clause that asserts constitution wears the
      // town's own blue; a clause that asserts nothing — every one of which
      // turns out to name MACHINERY rather than law — wears the stamp's violet,
      // which is what a class already wears on this page. Everything outside
      // the record goes to the ground colour: still there, still tappable, no
      // longer competing with the thing being read.
      const RECORD_PAINT = { law: "#5b86ff", mechanic: "#aa8fd8", off: "#252d3f" };

      // The registry badge, as a data URI so the page carries no asset request.
      //
      // PERCENT-ENCODED WHOLE, not by hand. A `background-image` value is a
      // SPACE-SEPARATED LIST, so a raw SVG's spaces split one URI into a dozen
      // relative paths and the browser goes looking for `/ops/graph/viewBox='0`
      // — sixteen 404s and no badge. encodeURIComponent takes the spaces and the
      // `#` in one pass, which hand-escaping the `#` alone did not.
      const BADGE_SVG = "data:image/svg+xml;utf8," + encodeURIComponent(
        "<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 12 12'>"
        + "<path d='M6 0.5 L11.5 6 L6 11.5 L0.5 6 Z' fill='#e8c48b' stroke='#070b15' stroke-width='1.4'/></svg>");

      const HINT_DEFAULT = "tap a node to light its neighbourhood — neighbours hidden by a filter come back with it. Tap the background to let go.";
      const hint = (text) => { $("[data-hint]").textContent = text || HINT_DEFAULT; };

      // Every lens class a chip can put on a node, in one string for
      // removeClass — DERIVED from the row the template built. The works lens
      // arrived and the hand-kept list in setPaint missed it, which left the
      // works colours stuck under every other lens; a derived list cannot miss
      // the next lens either.
      const PAINT_CLASSES = all("[data-paint]").map((b) => "paint-" + b.dataset.paint).join(" ");

      // A mark's colour is its DERIVED standing (the one walk, run office-side
      // at hydration) — never the `tier` field, which tier-B retired and the
      // loader used to default. No standing sent → the gray row, stated.
      const colourOf = (d) => (d.kind === "mark" ? (TIER[standingTierOf(d)] ?? TIER.draft) : (KIND[d.kind] ?? KIND.unknown));

      // ── state ─────────────────────────────────────────────────────────────
      let cy = null;
      let payload = null;
      let focused = null;            // the node whose neighbourhood is lit
      const WORLD_POS = new Map();   // id -> where the world says it is (see mount)
      const on = {
        // Filled at mount from the registry, not written down here — see the
        // class row. Until the payload arrives there is nothing to filter by.
        classes: new Set(),
        edges: new Set(["contains", "describes", "instance-of", "implements", "reads", "imports", "stop-of"]),
        // The standing chips, read off the row the template built from TIERS —
        // a second hand-kept list here would be the drift the paint list had.
        tiers: new Set(all("[data-tier-chip]").map((b) => b.dataset.tierChip)),
        view: "all",
        layout: "web",
        paint: "tier",
        q: "",
      };
      // Which of the two panel homes the back button returns to. The inspector
      // is a detour from whichever was showing, never a third place to be lost
      // in.
      let panelHome = "findings";
      // The lenses' readings, computed once at mount off the one payload.
      let fields = null, record = null, registry = null, measures = null, lattice = null, filters = null, works = null;

      // ── boot ──────────────────────────────────────────────────────────────
      async function boot() {
        let health = null;
        const [graphRes, healthRes] = await Promise.allSettled([
          fetch(OFFICE + "/world/graph", { headers: { accept: "application/json" } }),
          fetch(OFFICE + "/world/store", { headers: { accept: "application/json" } }),
        ]);
        if (graphRes.status !== "fulfilled") return dead("the office isn't answering", "the window reads GET /world/graph — the door is keyless, so this is the office being down rather than a permission.");
        if (!graphRes.value.ok) {
          const b = await graphRes.value.json().catch(() => ({}));
          return dead(b.defect || `the office said ${graphRes.value.status}`, b.hint || "");
        }
        payload = await graphRes.value.json();
        if (healthRes.status === "fulfilled" && healthRes.value.ok) health = await healthRes.value.json().catch(() => null);

        paintAsOf(health);
        mount();
        paintFindings();
        $("[data-reload]").hidden = false;
      }

      function dead(defect, hint) {
        $("[data-asof-dot]").className = "og-asof-dot is-bad";
        $("[data-asof-text]").textContent = defect;
        $("[data-findings]").textContent = "";
        const p = document.createElement("p");
        p.className = "og-quiet";
        p.textContent = hint;
        $("[data-findings]").appendChild(p);
      }

      // ── the As-Of bar ─────────────────────────────────────────────────────
      // Three separate facts, never blended: WHICH sha the store was folded
      // from, WHEN it was folded, and whether that sha is still the one main
      // points at. The third is the store's own answer (GET /world/store), not
      // an inference from the second — a store folded a minute ago can already
      // be behind, and a store folded last week can still be current.
      function paintAsOf(health) {
        const a = payload.as_of || {};
        const sha = (a.world || "").slice(0, 12);
        const ago = sinceWords(a.hydrated_at);
        const mainSha = health && health.main && health.main.sha ? health.main.sha : null;
        const fresh = mainSha ? mainSha === a.world : null;

        const dot = $("[data-asof-dot]");
        const bits = [`world ${sha || "?"}`, `hydrated ${ago}`];
        if (a.hydration_status && a.hydration_status !== "OK") bits.push(`status ${a.hydration_status}`);
        if (fresh === true) { dot.className = "og-asof-dot is-fresh"; bits.push("this IS the sha main points at"); }
        else if (fresh === false) { dot.className = "og-asof-dot is-stale"; bits.push(`BEHIND main (${mainSha.slice(0, 12)}) — rehydrate to see the current world`); }
        else { dot.className = "og-asof-dot"; bits.push("freshness unknown — the office could not read main"); }
        $("[data-asof-text]").textContent = bits.join(" · ");
      }

      function sinceWords(iso) {
        const t = Date.parse(iso || "");
        if (!Number.isFinite(t)) return "at an unknown time";
        const mins = Math.round((Date.now() - t) / 60000);
        if (mins < 1) return "just now";
        if (mins < 60) return `${mins} min ago`;
        const hrs = Math.round(mins / 60);
        if (hrs < 48) return `${hrs} h ago`;
        return `${Math.round(hrs / 24)} days ago`;
      }

      function paintCounts() {
        // `.off`, NOT `:visible` — the runLayout lesson, learned here a second
        // time: `:visible` is recalculated lazily after a `cy.batch()`, and a
        // count taken straight after applyFilters read the world as it was
        // BEFORE the filter ("513 of 819" over a 29-node view). `.off` is set
        // synchronously and is the only thing that hides an element. An edge
        // draws only when both its ends do, so it is counted that way.
        const hidden = (el) => el.hasClass("off");
        const nodes = cy.nodes().filter((n) => !hidden(n));
        const edges = cy.edges().filter((e) => !hidden(e) && !hidden(e.source()) && !hidden(e.target()));
        const total = payload.counts.nodes;
        const lit = nodes.filter(".lint").length + edges.filter(".lint").length;
        const of = nodes.length === total ? "" : ` of ${total}`;
        $("[data-counts]").textContent = `${nodes.length}${of} nodes · ${edges.length} edges · ${lit} carrying a finding`;
      }

      // ── the graph ─────────────────────────────────────────────────────────
      function mount() {
        const els = payload.elements;
        // THE WORLD'S OWN COORDINATES, COPIED OUT FIRST. Cytoscape takes the
        // position objects it is handed and writes layout results back through
        // them, so after one `cose` run the payload no longer holds where the
        // marks ARE — it holds where the force layout put them. Read back for
        // the map view that is a town drawn at made-up coordinates, and read
        // back in the inspector it is a lie about a record. Copied by value,
        // once, before cytoscape ever sees them.
        for (const n of els.nodes) if (n.position) WORLD_POS.set(n.data.id, { x: n.position.x, y: n.position.y });
        // A label short enough to read beside the dot it belongs to. Code ids
        // carry their whole path (`code:world/tools/vessel.test.mjs`) and are
        // twice the length of anything else on the canvas; the file name is what
        // a reader is looking for and the full path is one row away in the
        // inspector. Marks keep household/slug, because on this graph the
        // household is half the identity.
        for (const n of els.nodes) {
          const id = n.data.id;
          n.data.short = n.data.kind === "code" ? id.replace(/^code:/, "").split("/").pop() : id;
        }
        // The lint class is put on at mount rather than restyled later: it is a
        // property of the element (the store said so), not a mode the page is in.
        //
        // The lens classes ride along for the same reason: where the law puts a
        // record's data, whether the registry can address it, and whether it is a
        // clause of the written law are all facts ABOUT the node, not modes the
        // page is in. What the paint chips switch is which of them cytoscape is
        // looking at — a `paint-*` class added to every node, so the mode lives
        // in one place and a node never has to be re-classified when the lens
        // changes.
        const data = els.nodes.map((n) => n.data);
        registry = classRegistry(data);
        const reg = new Set(registry.registered);
        // The keeping-works reading is taken here, before the class loop, so
        // an open ask is a mount-time fact about its minting mark — same
        // footing as the lint class itself (the store said so).
        works = keepingWorks(data, payload.lints);
        const askIds = new Set(works.ask_mark_ids);
        for (const n of els.nodes) {
          const d = n.data;
          const cls = [];
          if (d.lints && d.lints.length) cls.push("lint");
          if (d.unresolved) cls.push("ghost");
          if (isDeclaringClassMark(d)) cls.push("works-mark");
          if (askIds.has(d.id)) cls.push("works-ask");
          cls.push("ideal-" + idealClassOf(d));
          // declares = the store's own fact (step-1, 2026-08-18); an instance
          // carrying `class:` NAMES its class — it does not declare it
          cls.push("reg-" + (d.kind !== "mark"
            ? (payload.convergence_kinds.includes(d.kind) ? "spine" : "off")
            : d.declares === true ? "declares"
            : d.class != null || reg.has(String(d.subkind ?? "")) ? "names" : "unaddressable"));
          if (isRecordNode(d)) cls.push("rec", d.tier === "constitution" ? "rec-law" : "rec-mechanic");
          // THE THREE WEARINGS. Facts about the node, put on once — the shape
          // rules that used to say "this is a different kind of thing" are gone.
          if (wearsRegistryBadge(d)) cls.push("badge");
          if (isContinuation(d)) cls.push("cont");
          if (isMachinery(d)) cls.push("shelf");
          n.classes = cls.join(" ");
        }
        for (const e of els.edges) e.classes = e.data.lints && e.data.lints.length ? "lint" : "";

        // The readings, taken once off the payload the page already has. Nothing
        // here asks the office a second question.
        fields = fieldCensus(data);
        record = recordTree(data);
        measures = lawMeasures(data);
        lattice = standingLattice(data);
        filters = classFilters(data);
        // Every chip starts on: the page opens on the whole world, and a filter
        // row that arrived with something already hidden would be lying about
        // what the store holds.
        for (const c of filters.chips) on.classes.add(c.key);

        cy = cytoscape({
          container: $("[data-cy]"),
          elements: els,
          // 0.2 made the wheel a formality: the map view is 95 km across, and
          // reaching a house from the fitted view took a minute of scrolling.
          wheelSensitivity: 0.6,
          // 700 nodes is small enough to keep labels honest at zoom rather than
          // paying for a texture cache that blurs them.
          textureOnViewport: false,
          motionBlur: false,
          style: [
            {
              selector: "node",
              style: {
                "background-color": (n) => colourOf(n.data()),
                "border-width": 0,
                // sqrt-scaled by degree, for the reason world-gexf.mjs gives:
                // the spread is two orders of magnitude and linear sizing turns
                // the hubs into discs that cover the town.
                width: (n) => 8 + Math.sqrt(n.data("deg") || 0) * 4,
                height: (n) => 8 + Math.sqrt(n.data("deg") || 0) * 4,
                label: "",
                "font-size": 9,
                "font-family": "ui-monospace, Consolas, monospace",
                color: "#cfd8ea",
                "text-background-color": "#070b15",
                "text-background-opacity": 0.78,
                "text-background-padding": 2,
                "text-margin-y": -4,
                "text-valign": "top",
                "min-zoomed-font-size": 7,
                "transition-property": "opacity",
                "transition-duration": "120ms",
              },
            },
            // ── one species of dot ────────────────────────────────────────
            // The four shapes are gone. There is one node type, so there is one
            // shape; what a node wears says the rest.
            //
            // A CONTINUATION IS DRAWN SMALL. A predicate is its parent continued
            // — it inherits the parent's extent whole rather than sitting inside
            // it — and drawing it at a sited mark's weight said the opposite.
            // The layout pulls it tight against its parent (see runLayout).
            {
              selector: "node.cont",
              style: {
                width: (n) => 5 + Math.sqrt(n.data("deg") || 0) * 2.4,
                height: (n) => 5 + Math.sqrt(n.data("deg") || 0) * 2.4,
              },
            },
            // THE REGISTRY BADGE. A small diamond riding the dot's shoulder,
            // drawn as an image rather than as a shape or a border: the shape is
            // spoken for (one species) and the border is spoken for (a finding,
            // and the focus pick). `background-clip: none` lets it overhang, so
            // it reads as worn rather than as part of the dot.
            {
              selector: "node.badge",
              style: {
                "background-image": BADGE_SVG,
                "background-image-containment": "over",
                "background-clip": "none",
                "background-fit": "none",
                "background-width": 9,
                "background-height": 9,
                "background-position-x": "104%",
                "background-position-y": "-14%",
                "background-image-opacity": 1,
              },
            },
            // THE MACHINERY SHELF. Code and doctrine are not nodes of the world;
            // they are the far ends of binding channels. Square, hollow, and
            // parked off the world's edge by the layout — still tappable, still
            // reachable along their `implements`/`reads` edges, and still able
            // to go red, which is why this rule touches neither border colour
            // nor the lint rules that follow it.
            {
              selector: "node.shelf",
              style: {
                shape: "round-rectangle",
                "background-opacity": 0.22,
                "border-width": 1,
                "border-color": "#4c5f8a",
                "border-opacity": 0.7,
                width: 9,
                height: 9,
              },
            },
            {
              // the far end of a dangling edge: hollow, so it reads as an
              // absence rather than as a thing
              selector: "node.ghost",
              style: { "background-opacity": 0.08, "border-width": 1.5, "border-color": KIND.unknown, "border-style": "dashed" },
            },
            {
              selector: "edge",
              style: {
                width: (e) => (e.data("type") === "contains" ? 1.4 : 0.8),
                "line-color": "#33415e",
                "curve-style": "haystack",
                "haystack-radius": 0,
                opacity: 0.55,
              },
            },
            { selector: 'edge[type = "implements"], edge[type = "instance-of"], edge[type = "stop-of"]', style: { "line-color": "#4c5f8a", opacity: 0.8 } },
            // ── the lenses ────────────────────────────────────────────────
            // Cytoscape resolves a property to the LAST matching rule, so a
            // lens' rules sit here: after the kinds and the tier lattice they
            // override, and before the lint and focus rules, which must keep
            // winning over any lens. A node only matches these while it wears
            // the mode class, so switching the lens off restores the lattice
            // without touching a single element's own classes.
            { selector: "node.paint-ideal", style: { "background-color": IDEAL_PAINT.unread } },
            { selector: "node.paint-ideal.ideal-lawful", style: { "background-color": IDEAL_PAINT.lawful } },
            { selector: "node.paint-ideal.ideal-residue", style: { "background-color": IDEAL_PAINT.residue } },
            { selector: "node.paint-ideal.ideal-debt", style: { "background-color": IDEAL_PAINT.debt } },
            { selector: "node.paint-registry", style: { "background-color": REG_PAINT.off } },
            { selector: "node.paint-registry.reg-spine", style: { "background-color": REG_PAINT.spine } },
            { selector: "node.paint-registry.reg-names", style: { "background-color": REG_PAINT.names } },
            { selector: "node.paint-registry.reg-unaddressable", style: { "background-color": REG_PAINT.unaddressable } },
            // The class-nodes are eleven in a graph of hundreds and they are the
            // thing the whole reading turns on, so under this paint they are
            // drawn up rather than left to their degree.
            {
              selector: "node.paint-registry.reg-declares",
              style: {
                "background-color": REG_PAINT.declares,
                width: (n) => 14 + Math.sqrt(n.data("deg") || 0) * 4,
                height: (n) => 14 + Math.sqrt(n.data("deg") || 0) * 4,
              },
            },
            { selector: "node.paint-law", style: { "background-color": RECORD_PAINT.off, opacity: 0.3 } },
            // The record is 64 nodes in a graph of 767, and most of them are
            // leaves — degree-sizing hides exactly the clauses this lens is
            // for, so under it a clause is drawn at a readable floor.
            {
              selector: "node.paint-law.rec",
              style: {
                "background-color": RECORD_PAINT.mechanic, opacity: 1,
                width: (n) => 13 + Math.sqrt(n.data("deg") || 0) * 4,
                height: (n) => 13 + Math.sqrt(n.data("deg") || 0) * 4,
              },
            },
            { selector: "node.paint-law.rec.rec-law", style: { "background-color": RECORD_PAINT.law } },
            // The keeping works: the class marks are the subject, everything
            // else recedes; an open ask is drawn red AS FILL — the border red
            // stays the lint's own, and here the two agree on purpose.
            { selector: "node.paint-works", style: { "background-color": "#3a4256", opacity: 0.22 } },
            {
              selector: "node.paint-works.works-mark",
              style: {
                "background-color": "#d9a95a", opacity: 1, label: "data(short)", "font-size": 10,
                width: (n) => 14 + Math.sqrt(n.data("deg") || 0) * 4,
                height: (n) => 14 + Math.sqrt(n.data("deg") || 0) * 4,
              },
            },
            { selector: "node.paint-works.works-ask", style: { "background-color": RED, opacity: 1 } },
            // ── the whole point of the page ───────────────────────────────
            { selector: "node.lint", style: { "border-width": 3, "border-color": RED, "border-opacity": 1 } },
            { selector: "edge.lint", style: { "line-color": RED, width: 3, opacity: 1, "z-index": 20 } },
            // ── focus: a lit neighbourhood, everything else pushed back ────
            { selector: ".dim", style: { opacity: 0.07 } },
            { selector: ".lit", style: { opacity: 1, "z-index": 30 } },
            { selector: "node.lit", style: { label: "data(short)", "z-index": 40 } },
            { selector: "node.pick", style: { "border-width": 3, "border-color": "#f6dcae", label: "data(short)", "font-size": 11, "z-index": 50 } },
            { selector: "edge.lit", style: { width: 2, "line-color": "#8aa0cc", opacity: 0.95 } },
            // Red wins, always, and it has to be said LAST: cytoscape resolves a
            // property to the last matching rule, so the focus styles above were
            // repainting a finding's own edge in the neutral highlight colour —
            // the one element on the page that must never lose its colour.
            { selector: "edge.lint.lit", style: { "line-color": RED, width: 3.5, opacity: 1, "z-index": 45 } },
            { selector: ".off", style: { display: "none" } },
          ],
          layout: { name: "preset" },   // laid out properly by applyFilters below
        });

        cy.on("tap", "node", (ev) => focus(ev.target));
        cy.on("tap", (ev) => { if (ev.target === cy) blur(); });
        cy.on("mouseover", "node", (ev) => showClaim(ev.target));
        cy.on("mouseout", "node", hideClaim);
        // A pan or a zoom leaves the card floating over whatever is now under
        // it, which would attach a claim to the wrong node — the one failure
        // this feature must not have.
        cy.on("pan zoom", hideClaim);

        paintLatticeLegend();
        paintClassRow();
        setPaint(fromQuery("paint") ?? on.paint);
        setView(fromQuery("view") ?? on.view);
        applyFilters({ relayout: true });
      }

      // ?paint= / ?view= — a way of looking you can link to. Validated against
      // the chips the page actually built, so a key that no longer exists (or
      // never did) lands on the default rather than on a blank panel. Silent by
      // design: a stale link in somebody's notes should open the graph, not an
      // error.
      function fromQuery(key) {
        let want = null;
        try { want = new URLSearchParams(location.search).get(key); } catch { return null; }
        if (!want) return null;
        return all(`[data-${key}]`).some((b) => b.dataset[key] === want) ? want : null;
      }

      // ── filters ───────────────────────────────────────────────────────────
      // Everything stays MOUNTED and is hidden with display:none rather than
      // removed: a filter is a way of looking, not a different graph, and
      // click-to-expand has to be able to bring a hidden neighbour back without
      // asking the office for it again.
      function applyFilters({ relayout = false } = {}) {
        cy.batch(() => {
          cy.elements().removeClass("off");
          if (on.view === "findings") {
            cy.elements().not(".lint").addClass("off");
            // a red edge needs both its ends, or it is a red line into nothing
            cy.edges(".lint").connectedNodes().removeClass("off");
          } else if (on.view === "works") {
            // The board as a graph: the law's class marks and the open asks,
            // nothing else. The works PAINT recedes the rest of the world in
            // place; this view removes it, for the reader who came only for
            // the asks. The two compose — ?paint=works&view=works is the
            // board, clean.
            cy.nodes().forEach((n) => { if (!n.hasClass("works-mark") && !n.hasClass("works-ask")) n.addClass("off"); });
            cy.edges().forEach((e) => { if (!on.edges.has(e.data("type"))) e.addClass("off"); });
          } else if (on.view === "convergence") {
            const kinds = new Set(payload.convergence_kinds);
            cy.nodes().forEach((n) => { if (!kinds.has(n.data("kind"))) n.addClass("off"); });
            cy.edges().forEach((e) => { if (!on.edges.has(e.data("type"))) e.addClass("off"); });
          } else {
            // The class row filters by the REGISTRY's own buckets now, not by a
            // hardcoded kind. Same rule the row is built from, so a chip can
            // never hide a node it did not count.
            const reg = new Set(filters.registered);
            cy.nodes().forEach((n) => {
              const d = n.data();
              if (!on.classes.has(filterBucketOf(d, reg))) { n.addClass("off"); return; }
              // The standing chips: marks only. Everything else has no
              // standing to filter by and keeps its own chips. Unknown or
              // unsent standings live on the "standing not sent" chip, the
              // same bucket the palette gives them.
              if (d.kind === "mark") {
                const t = standingTierOf(d);
                if (!on.tiers.has(TIER[t] ? t : "draft")) n.addClass("off");
              }
            });
            cy.edges().forEach((e) => { if (!on.edges.has(e.data("type"))) e.addClass("off"); });
          }
          // THE FIND BOX, last: it narrows whatever the view produced, in
          // every view — typed intent outranks the chips.
          const q = on.q.trim().toLowerCase();
          if (q) cy.nodes().forEach((n) => {
            if (n.hasClass("off")) return;
            const d = n.data();
            const hay = `${d.id} ${d.body || ""} ${d.by || ""} ${d.class || ""} ${d.subkind || ""}`.toLowerCase();
            if (!hay.includes(q)) n.addClass("off");
          });
        });
        if (focused) focus(focused, { keep: true });
        if (relayout) runLayout();
        // A find whose matches sit off-screen looks like a find that found
        // nothing — bring them in front of the reader. `.off`, not `:visible`,
        // for the timing reason runLayout gives.
        if (on.q.trim()) {
          const vis = cy.elements().not(".off");
          if (vis.length) cy.fit(vis, 60);
        }
        paintCounts();
      }

      function runLayout() {
        // NOT `:visible`. Cytoscape recalculates style — and therefore the
        // `display: none` that `.off` carries — lazily after a `cy.batch()`, so
        // a `:visible` read taken straight after `applyFilters` still sees the
        // world as it was BEFORE the filter. That was invisible while this
        // function only fed the result to a force layout (laying out a few
        // hidden nodes changes nothing anyone sees) and became a bug the moment
        // it started BRANCHING on the answer: the machinery shelf's caption
        // stayed up over an empty shelf. `.off` is a class, set synchronously,
        // and it is the only thing on this page that hides an element.
        const eles = cy.elements().not(".off");
        if (!eles.length) return;
        if (on.layout === "map") return layoutMap(eles);
        hint(null);
        // `cose` is the built-in force layout — no plugin, which matters for a
        // page that must build with nothing but the npm dependency. Capped at a
        // few hundred iterations: this is a debugging window, not a poster, and
        // the extra settling buys nothing a human reads.
        // THE WORLD IS LAID OUT; THE MACHINERY IS SHELVED. Running cose over
        // both would let 130 binding-channel ends push the town around, which is
        // the force layout being asked to arrange things that are not in the
        // world. So the force runs on the world's own nodes, and the shelf is
        // placed against the result.
        const world = eles.nodes().not(".shelf");
        const shelf = eles.nodes(".shelf");
        if (world.length) {
          world.union(world.edgesWith(world)).layout({
            name: "cose",
            animate: false,
            numIter: 350,
            nodeRepulsion: 9000,
            // A CONTINUATION SITS TIGHT AGAINST WHAT IT CONTINUES. `describes`
            // is the predicate-to-parent edge, and giving it a short ideal
            // length is how "a predicate is its parent continued" is said in
            // the only language a force layout speaks. No edge is invented: this
            // shortens the ones the store already sent.
            idealEdgeLength: (e) => (e.data("type") === "describes" ? 16 : 60),
            gravity: 0.4,
            randomize: true,
            fit: false,
            padding: 30,
          }).run();
        }
        placeShelf(world, shelf);
        cy.fit(eles, 30);
      }

      // The band at the east edge. Placed against the world's own bounding box
      // rather than at fixed coordinates, so it stands beside whatever the force
      // layout produced instead of landing on top of it.
      function placeShelf(world, shelf) {
        paintShelfLabel(shelf.length > 0);
        if (!shelf.length) return;
        const bb = world.length ? world.boundingBox() : { x1: 0, x2: 0, y1: 0, y2: 400 };
        const span = Math.max(bb.y2 - bb.y1, 200);
        const rows = Math.max(10, Math.ceil(Math.sqrt(shelf.length * 3)));
        const step = span / rows;
        const gap = Math.max(90, (bb.x2 - bb.x1) * 0.09);
        let i = 0;
        cy.batch(() => shelf.forEach((n) => {
          const col = Math.floor(i / rows), row = i % rows;
          i++;
          n.position({ x: bb.x2 + gap + col * step, y: bb.y1 + row * step });
        }));
      }

      const paintShelfLabel = (show) => { $("[data-shelf-label]").hidden = !show; };

      // THE MAP. Sited marks go where the world says they are — y unflipped, so
      // south is down and north is up. Everything else has no place in the world
      // (code, doctrine, classes, and the predicates that inherit their parent's
      // extent rather than sitting anywhere), and rather than pretend, they are
      // parked in a labelled column off to the west. Hiding them would be the
      // lie; scattering them across the town would be worse.
      function layoutMap(eles) {
        let minX = Infinity, maxX = -Infinity, minY = Infinity, maxY = -Infinity;
        eles.nodes().forEach((n) => {
          const p = positionOf(n);
          if (!p) return;
          minX = Math.min(minX, p.x); maxX = Math.max(maxX, p.x);
          minY = Math.min(minY, p.y); maxY = Math.max(maxY, p.y);
        });
        if (!Number.isFinite(minX)) return;   // nothing in view is anywhere; leave the web layout alone

        // A MAP HAS A SCALE. The world is 95 km across — Pando Peak is that far
        // from the quay — and a node is drawn in model units, so laying the
        // marks out at their metre coordinates and fitting the result renders
        // every one of them at a fraction of a pixel: an empty black rectangle
        // that is arithmetically correct and shows nothing. One uniform factor
        // takes metres into the model space, which is what the word "scale"
        // means on any map; every distance and every bearing survives it,
        // because it is the same number for both axes.
        const metres = Math.max(maxX - minX, maxY - minY, 1);
        const k = SPAN_MODEL / metres;
        const at = (p) => ({ x: (p.x - minX) * k, y: (p.y - minY) * k });

        let i = 0, s = 0;
        const perCol = 40;
        const rowGap = SPAN_MODEL / perCol;
        const shelfCount = eles.nodes(".shelf").length;
        paintShelfLabel(shelfCount > 0);
        cy.batch(() => {
          eles.nodes().forEach((n) => {
            const p = positionOf(n);
            if (p) { n.position(at(p)); return; }
            // THE SHELF, east of the world, exactly as in the web layout: code
            // and doctrine are not merely unplaced, they are not OF the world,
            // and the map keeps that distinction rather than pooling them with
            // the marks that simply inherit a parent's extent.
            if (n.hasClass("shelf")) {
              const col = Math.floor(s / perCol), row = s % perCol;
              s++;
              n.position({ x: SPAN_MODEL * 1.16 + col * (SPAN_MODEL * 0.035), y: row * rowGap });
              return;
            }
            // THE NOWHERE COLUMN, west of the world's own bounding box. Classes
            // and the predicates that inherit a parent's extent are not
            // ANYWHERE, and the map says so by putting them outside it rather
            // than scattering them through a town they have no address in.
            // Hiding them would be the tidier lie.
            const col = Math.floor(i / perCol);
            const row = i % perCol;
            i++;
            n.position({ x: -SPAN_MODEL * 0.22 - col * (SPAN_MODEL * 0.035), y: row * rowGap });
          });
        });
        cy.fit(eles, 40);
        hint(`the map, at ${Math.round(metres / 1000)} km across — the world's own coordinates, x east, y south. `
          + `The town is a speck beside Pando Peak; scroll to zoom in. West: everything that is not anywhere. `
          + `East: the machinery, which is not of the world at all.`);
      }

      const positionOf = (n) => WORLD_POS.get(n.id()) ?? null;

      // ── the lenses ────────────────────────────────────────────────────────
      //
      // A LENS REPAINTS; IT NEVER FILTERS. Every node stays exactly where it is
      // and exactly as visible as the chips left it — what changes is which fact
      // about it the colour is carrying. That is the whole difference between
      // this and the six-tab hub it replaces: the hub drew a second picture of
      // the same store beside the first, and two pictures of one world drift.
      function setPaint(paint) {
        on.paint = paint;
        // A lens' own hint belongs to that lens. The map's belongs to the
        // layout and survives, because it is still true.
        if (on.layout !== "map") hint(null);
        all("[data-paint]").forEach((b) => b.classList.toggle("is-on", b.dataset.paint === paint));
        cy.batch(() => {
          // PAINT_CLASSES, not a hand-kept list — the works lens shipped while
          // the list here still named three lenses, and its colours stayed
          // stuck under every chip clicked after it.
          cy.nodes().removeClass(PAINT_CLASSES);
          if (paint !== "tier") cy.nodes().addClass("paint-" + paint);
        });
        all("[data-legend]").forEach((row) => { row.hidden = row.dataset.legend !== paint; });
        panelHome = paint === "tier" ? "findings" : "lens";
        if (paint !== "tier") paintLens();
        showHome();
      }

      // THE CLAIM. What the mark SAYS, on hover — the sentence its author wrote,
      // capped at 150 characters by the world's own schema. Drawn as a card over
      // the canvas rather than as a `title`, because the graph is one canvas
      // element and a canvas has no children to hang a tooltip on.
      function showClaim(node) {
        const d = node.data();
        const card = $("[data-claim]");
        card.textContent = "";

        const id = document.createElement("b");
        id.textContent = d.id;
        card.appendChild(id);

        const line = document.createElement("span");
        if (d.body) line.textContent = d.body;                  // the author's own words: textContent, never innerHTML
        else if (d.kind === "mark") { line.textContent = "this store carries no body for this mark"; line.className = "is-quiet"; }
        else { line.textContent = d.kind + (d.subkind ? " · " + d.subkind : ""); line.className = "is-quiet"; }
        card.appendChild(line);

        // Placed from the node's RENDERED position (screen space, pan and zoom
        // already applied), flipped to the left of the node when it would run
        // off the right edge of the canvas.
        const p = node.renderedPosition();
        const box = $("[data-cy]").getBoundingClientRect();
        card.hidden = false;
        const w = card.offsetWidth;
        const left = p.x + 14 + w > box.width ? Math.max(4, p.x - 14 - w) : p.x + 14;
        card.style.left = left + "px";
        card.style.top = Math.max(4, Math.min(p.y - 10, box.height - card.offsetHeight - 4)) + "px";
      }
      const hideClaim = () => { $("[data-claim]").hidden = true; };

      // The lens' own reading, in the findings' place. Every number here is
      // computed from the payload the graph is drawn from, so the panel and the
      // paint cannot disagree.
      function paintLens() {
        const box = $("[data-lens]");
        box.textContent = "";
        if (on.paint === "ideal") paintIdealLens(box);
        if (on.paint === "registry") paintRegistryLens(box);
        if (on.paint === "law") paintLawLens(box);
        if (on.paint === "works") paintWorksLens(box);
      }

      // THE CLASS ROW, built from the registry the store actually holds.
      //
      // A REGISTERED CLASS NOTHING NAMES KEEPS ITS CHIP. Eleven classes are
      // declared and most are addressed by nothing; a row showing only the
      // populated ones would hide exactly that. The empty chips are drawn dim
      // and are not clickable, because a filter that hides nothing is a legend,
      // not a control, and dressing it as a control would be the lie.
      function paintClassRow() {
        const row = $("[data-classrow]");
        $("[data-classrow-empty]").hidden = filters.chips.length > 0;
        for (const c of filters.chips) {
          const btn = document.createElement("button");
          btn.type = "button";
          btn.className = "og-chip og-chip-class is-on"
            + (c.group === "class" ? " og-chip-registered" : "")
            + (c.group === "shelf" ? " og-chip-shelf" : "")
            + (c.count ? "" : " is-empty");
          btn.dataset.classKey = c.key;
          btn.title = c.group === "class"
            ? (c.count ? `a registered class, and what names it` : "declared, and addressed by nothing yet")
            : c.key === "older-vocabulary" ? "marks naming no class-node — the law cannot address these yet"
            : c.key === "registry-own" ? "the class-nodes themselves, which the law addresses through"
            : c.key === "unresolved" ? "the far end of a dangling edge; nothing in the store claims it"
            : "code and doctrine — binding-channel ends, shelved off the world's edge";
          btn.appendChild(document.createTextNode(c.label));
          const n = document.createElement("b");
          n.textContent = String(c.count);
          btn.appendChild(n);
          if (!c.count) { btn.disabled = true; btn.classList.remove("is-on"); }
          else btn.addEventListener("click", () => toggleClass(btn, c.key));
          row.appendChild(btn);
        }
      }

      function toggleClass(btn, key) {
        if (on.classes.has(key)) on.classes.delete(key); else on.classes.add(key);
        btn.classList.toggle("is-on", on.classes.has(key));
        setView("all");
        applyFilters({ relayout: true });
      }

      // THE STANDING LEGEND, counted. Every count is the one walk's verdict as
      // the office derived it at hydration — the authored/defaulted split the
      // old lattice drew is gone with the field it split: `tier:` is not a
      // field, and there is nothing left to have defaulted.
      function paintLatticeLegend() {
        for (const item of all("[data-tier-item]")) {
          const row = lattice.rows.find((r) => r.tier === item.dataset.tierItem);
          const slot = item.querySelector("[data-tier-count]");
          if (!row) { slot.textContent = ""; continue; }
          if (!row.total) { slot.textContent = "none"; item.classList.add("is-empty"); continue; }
          item.classList.remove("is-empty");
          slot.textContent = String(row.total);
        }
      }

      // ── what LOGOS derives ────────────────────────────────────────────────
      // The hub's ideal view. It drew a second tree of the same world with every
      // datum re-read as the law reads it; here the same reading paints the one
      // graph and opens in the inspector, which is the version of it that cannot
      // drift against the picture beside it.
      function paintIdealLens(box) {
        box.appendChild(lede(
          "The same world through the law's glasses: identity is slug plus class and nothing else, authorship and containment are EDGES, "
          + "genuine properties are PREDICATE CHILDREN, and standing is derived and stored by nobody. Every key on disk is put through the "
          + "serialization map, and the three outcomes are kept apart."));

        if (!fields.read) {
          box.appendChild(warn(
            "this office sends no key list, so not one record can be re-read. The lens paints every node OUTSIDE THE READING rather "
            + "than reporting a world with nothing out of place — which is the picture a finished cutover would produce, and the opposite finding."));
          return;
        }

        box.appendChild(sectionHead("The law's own measures"));
        box.appendChild(numbers(measures.map((m) => [m.label, m.now, m.of, m.note])));

        // A count is a place to GO. Each of these lights exactly the records it
        // counted — the same contract the findings panel holds itself to.
        const residueIds = idsWhere((d) => idealClassOf(d) === "residue");
        const debtIds = idsWhere((d) => idealClassOf(d) === "debt");
        if (residueIds.length) box.appendChild(showButton("show the records carrying residue", () => showIds(residueIds, "grid")));
        if (debtIds.length) box.appendChild(showButton("show the records carrying debt", () => showIds(debtIds, "grid")));

        box.appendChild(sectionHead("The serialization map — where every key on disk belongs"));
        box.appendChild(lede(
          `v${SERIALIZATION_MAP.version}, authored ${SERIALIZATION_MAP.authored}. A way station: the destination is ${SERIALIZATION_MAP.destination}, `
          + "at which point the table is deleted and read from the graph like everything else. RESIDUE and DEBT are different failures — the map "
          + "places residue nowhere on purpose, and debt is the map's own unfinished business."));
        box.appendChild(numbers([
          ["identity", fields.rows.identity, fields.total, "an identity atom — the class the tree speaks today"],
          ["an edge", fields.rows.edge, fields.total, "NOT a property: `by:` is the create-edge, `at:` is containment plus an offset"],
          ["a predicate's own payload", fields.rows.predicate, fields.total, "slot and value — the only keys on disk already in lawful shape"],
          ["a property → a predicate child", fields.rows.property, fields.total, "a genuine authored property, whose lawful form is a child node"],
          ["the action's log record", fields.rows.log, fields.total, "a fact about the act, not about the node"],
          ["TRUE RESIDUE — belongs nowhere", fields.rows.derived, fields.total,
            fields.residueKeys.map(([k, n]) => `${k} ×${n}`).join(", ") || "none — no record stores a derivable"],
          ["MAPPING DEBT — the map places it nowhere YET", fields.rows.unmapped, fields.total,
            fields.unmappedKeys.length ? fields.unmappedKeys.map(([k, n]) => `${k} ×${n}`).join(", ") : "none — every key on disk has a stated destination"],
        ]));
        box.appendChild(quiet(`${fields.total} key instances read off ${fields.read} records; ${fields.placed} of them placed.`));

        paintBoundary(box);
      }

      // ── the class registry ────────────────────────────────────────────────
      // The hub's convergence question, and the sharpest number it produced.
      function paintRegistryLens(box) {
        box.appendChild(lede(
          "Closure is a property of ADDRESSING: a class not in the graph cannot be addressed, and a node naming no class-node cannot be "
          + "reached by the law at all. A class-node DECLARES a class; every other node NAMES one, today through `kind:`. The two are counted apart."));

        box.appendChild(numbers([
          ["class-nodes in the registry", registry.classNodes, null,
            registry.registered.length ? registry.registered.join(", ") : "none in this store"],
          ["nodes naming a registered class", registry.citing, registry.marks, "addressable — the law has a way to reach these"],
          ["nodes naming none", registry.unaddressable, registry.marks,
            registry.unregisteredKinds.length
              ? registry.unregisteredKinds.map(([k, n]) => `kind: ${k} (${n})`).join(", ") + " — the older four-word vocabulary"
              : "every node names a class-node"],
        ]));
        if (registry.unaddressable) {
          box.appendChild(showButton("show what the law cannot address",
            () => showIds(idsWhere((d) => d.kind === "mark" && !registry.citing_ids.includes(d.id)), "grid")));
        }

        box.appendChild(sectionHead("The convergence spine"));
        box.appendChild(lede(
          `The layer the traversal runs over — ${payload.convergence_kinds.join(", ")} — must be walkable from a class through its affordances `
          + "to the code that honours them. The `view` chips above narrow the graph to exactly this set; this paints it in place instead."));
        const spine = {};
        for (const k of payload.convergence_kinds) spine[k] = payload.counts.by_kind[k] ?? 0;
        box.appendChild(numbers(Object.entries(spine).map(([k, n]) => [k, n, payload.counts.nodes, ""])));

        paintBoundary(box);
      }

      // ── the keeping works · the town's asks ───────────────────────────────
      // The focused view of the law's class marks and the open asks (the
      // TDD-board sitting, 2026-08-17). Red here is not a failure by design:
      // a red action is the town ASKING — the ask's representation IS the gap,
      // and closing asks is what the economy is for.
      function paintWorksLens(box) {
        box.appendChild(lede(
          "The keeping works: every constitutional class mark, and every action the law advertises. A room BUILT means the office "
          + "dispatches it; an OPEN ASK is law declared with no room behind it — the town asking, on purpose. The asks are L6's own rows, "
          + "never recomputed here."));

        if (!works.available) {
          box.appendChild(warn(
            "this office sends no L6 finding, so the action side cannot be read — the class marks below are the payload's, "
            + "but which of their actions have rooms is stated by nobody. Not green: unread."));
        } else {
          box.appendChild(numbers([
            ["class marks in the works", works.classMarks.length, null, works.classMarks.map((m) => m.class).sort().join(", ") || "none in this store"],
            ["actions the law advertises", works.actions.length, null, works.actions.map((a) => a.action).sort().join(", ") || "none"],
            ["rooms built", works.rooms, works.actions.length, "the office dispatches these"],
            ["OPEN ASKS", works.asks.length, works.actions.length,
              works.asks.length ? works.asks.map((a) => `${a.for === "resident" ? a.action : `${a.action} for ${a.for}`} (${a.from.join(", ")})`).join("; ") : "none — every advertised action has its room"],
          ]));
          if (works.ask_mark_ids.length) box.appendChild(showButton("show the marks doing the asking", () => showIds(works.ask_mark_ids, "grid")));
        }

        box.appendChild(sectionHead("Three registers of red — what a red means depends on where it lives"));
        box.appendChild(lede(
          "ASKS (this lens): a constitutional mark declares an action with no room built — intentional, bounty-shaped, the build queue. "
          + "DEBT (the LOGOS measures — the ideal and registry lenses): the strangler cutovers' ledger, program-sized asks priced by "
          + "sittings, not single rooms. VIOLATIONS (the fidelity suite, world-side): a rendering saying OTHER than the law — never "
          + "intentional, never an ask; they gate settlements and are fixed, not funded. Unrendered LOGOS clauses are deliberately NOT "
          + "red anywhere: the piecewise ruling lands a clause when a build leans on it, so absence is the design."));

        paintBoundary(box);
      }

      // ── the boundary ──────────────────────────────────────────────────────
      // The hub read a whole world clone; this page reads one payload, and the
      // honest port of every reading that needs the rest of the clone is the
      // hub's own holes idiom — each absence NAMED and tied to the registry row
      // it belongs to, never filled with invented data. That a reading is
      // missing here because its substrate is not in the graph is not an excuse;
      // it is the cutover's own finding, restated.
      function paintBoundary(box, only = null) {
        const holes = only ? STORE_BOUNDARY.filter((h) => only.includes(h.title)) : STORE_BOUNDARY;
        if (!holes.length) return;
        box.appendChild(sectionHead(only ? "The hole beside this one" : "The holes — named, not filled"));
        if (!only) box.appendChild(lede(
          "This window reads the store: nodes and edges, and nothing else. What the hub read from a whole world clone and this page cannot:"));
        for (const h of holes) {
          const card = document.createElement("article");
          card.className = "og-hole";
          const t = document.createElement("b");
          t.textContent = h.title;
          const r = document.createElement("span");
          r.className = "og-hole-row";
          r.textContent = h.row;
          const p = document.createElement("p");
          p.textContent = h.text;
          card.appendChild(t); card.appendChild(r); card.appendChild(p);
          box.appendChild(card);
        }
      }

      const idsWhere = (fn) => payload.elements.nodes.filter((n) => fn(n.data)).map((n) => n.data.id);

      // ── the record's law ──────────────────────────────────────────────────
      // The piecewise LOGOS: the constitution written as real marks, each one a
      // clause whose body IS the sentence. NOTHING IS INVENTED — the subtree is
      // found by the path the store already carries, and a world where the
      // record has not been written yields an empty list that says so.
      function paintLawLens(box) {
        box.appendChild(lede(
          "The constitution as the world actually holds it: predicated marks under `let-there-be-light/logos`, "
          + "each one a clause. This is the store's own record — clauses appear here as they land, and nothing on this page writes law."));

        if (!record.total) {
          box.appendChild(warn("this store holds no marks under logos (the record) — either the clauses have not been written yet, or this office sends no `path` to find them by."));
          return;
        }

        box.appendChild(numbers([
          ["clauses in the record", record.total, payload.counts.by_kind.mark ?? null, ""],
          ["· asserting constitution", record.by_tier.constitution ?? 0, record.total, "a clause of the law itself"],
          ["· asserting nothing", record.total - (record.by_tier.constitution ?? 0), record.total, "every one of these names MACHINERY rather than law"],
          ["carrying their sentence", record.with_body, record.total, "a clause with no body is a heading, or an office that sends no bodies"],
        ]));
        box.appendChild(showButton("show the record as a tree", showRecord));

        const ul = document.createElement("ul");
        ul.className = "og-clauses";
        for (const c of record.clauses) {
          const li = document.createElement("li");
          li.className = "og-clause is-walkable" + (c.tier === "constitution" ? " is-law" : "");
          li.style.paddingLeft = (c.depth * 0.85) + "em";
          const b = document.createElement("b");
          b.textContent = c.id.replace(/^the-town\//, "");
          li.appendChild(b);
          if (c.body) {
            const s = document.createElement("span");
            s.textContent = c.body;                    // the clause's own words, never re-worded here
            li.appendChild(s);
          }
          li.addEventListener("click", () => walkTo(c.id));
          ul.appendChild(li);
        }
        box.appendChild(ul);
        // The law has a second written form the store does not hold, and this
        // is the one lens where a reader will wonder where it went.
        paintBoundary(box, ["the second crystallization — the law as a graph"]);
      }

      // The record laid out as what it is: ONE TREE, rooted at the logos seed. The
      // findings panel rejected `breadthfirst` for its own sets and was right
      // to — a finding is usually disconnected pairs, and breadthfirst strings
      // those into a strip four screens wide. The record is the opposite shape,
      // and a tree layout is the only one that shows a clause's depth.
      //
      // UNDIRECTED, and that is not a detail. A `describes` edge runs from the
      // predicate to the mark it predicates — child to PARENT — so a directed
      // breadthfirst walking out of the root reaches nothing and lays all 64
      // clauses in one flat row, which is the exact failure the findings panel
      // avoided by not using this layout at all. Undirected, the same edges give
      // the nesting depth back.
      function showRecord() {
        const ids = record.clauses.map((c) => c.id);
        const eles = showIds(ids, "none");
        if (!eles || !eles.length) return;
        const root = eles.nodes().filter((n) => n.id().endsWith("/logos"));
        // RUN OVER THE EDGES TOO. `eles.nodes().layout(...)` hands breadthfirst a
        // collection with no edges in it, and a tree layout with no edges has no
        // tree: all 64 clauses come out in one flat row with the root stranded
        // below them. The edges are what make this layout the right one.
        eles.layout({
          name: "breadthfirst", animate: false, directed: false, spacingFactor: 1.35,
          roots: root.length ? root : undefined, fit: false,
        }).run();
        cy.fit(eles, 50);
        hint(`the record: ${record.total} clauses, deepest at ${Math.max(...record.clauses.map((c) => c.depth))} below the root. Hover a clause to read it.`);
      }

      // Light exactly a named set of ids and push everything else back — the
      // same contract `showFinding` holds, factored out so a lens cannot invent
      // a second, laxer version of it.
      function showIds(ids, layout = "grid") {
        const eles = cy.collection();
        for (const id of ids) {
          const el = cy.getElementById(id);
          if (el && el.length) eles.merge(el);
        }
        if (!eles.length) return null;
        // the edges among them, so a subtree reads as a tree rather than as dust
        eles.merge(eles.nodes().edgesWith(eles.nodes()));
        focused = null;
        cy.batch(() => {
          cy.elements().removeClass("lit dim pick");
          eles.removeClass("off");
          cy.elements().not(eles).addClass("dim");
          eles.addClass("lit");
        });
        if (layout === "grid") {
          const box = $("[data-cy]").getBoundingClientRect();
          const n = eles.nodes().length;
          const cols = Math.max(1, Math.ceil(Math.sqrt(n * Math.max(box.width / Math.max(box.height, 1), 0.2))));
          eles.nodes().layout({ name: "grid", animate: false, cols, avoidOverlap: true, condense: false, fit: false }).run();
          cy.fit(eles, 60);
          // SAY HOW TO GET BACK. Laying a set out in a grid moves those nodes for
          // good — tapping the background lets go of the highlight but leaves
          // them where the grid put them, because a lens must never silently
          // re-run a layout the reader did not ask for. That is defensible and it
          // is not discoverable, so the hint bar says the second step out loud.
          hint(`${eles.nodes().length} of ${payload.counts.nodes} nodes, laid out on their own. `
            + `Tap the background to let go of the highlight; the "web" layout chip puts the whole graph back.`);
        }
        paintCounts();
        return eles;
      }

      function walkTo(id) {
        const n = cy.getElementById(id);
        if (!n || !n.length) return;
        n.removeClass("off");
        focus(n);
        cy.animate({ center: { eles: n }, zoom: Math.max(cy.zoom(), 1.1) }, { duration: 200 });
      }

      // ── the lens panel's small parts ──────────────────────────────────────
      const sectionHead = (text) => { const h = document.createElement("h3"); h.className = "og-lens-head"; h.textContent = text; return h; };
      const lede = (text) => { const p = document.createElement("p"); p.className = "og-lens-lede"; p.textContent = text; return p; };
      const quiet = (text) => { const p = document.createElement("p"); p.className = "og-quiet"; p.textContent = text; return p; };
      const warn = (text) => { const p = document.createElement("p"); p.className = "og-lens-warn"; p.textContent = text; return p; };

      function showButton(label, fn) {
        const b = document.createElement("button");
        b.type = "button";
        b.className = "og-show";
        b.textContent = label;
        b.addEventListener("click", fn);
        return b;
      }

      // One row per number, with its denominator and its reason. The share bar
      // is drawn from the same two numbers the text states — never a third
      // figure a reader would have to trust separately.
      function numbers(rows) {
        const ul = document.createElement("ul");
        ul.className = "og-numbers";
        for (const [label, now, of, note] of rows) {
          const li = document.createElement("li");
          const l = document.createElement("b");
          l.textContent = label;
          const v = document.createElement("i");
          v.textContent = of ? `${now} / ${of}` : String(now);
          li.appendChild(l); li.appendChild(v);
          if (of) {
            const bar = document.createElement("div");
            bar.className = "og-bar";
            const fill = document.createElement("span");
            fill.style.width = Math.min(100, Math.round((now / of) * 100)) + "%";
            bar.appendChild(fill);
            li.appendChild(bar);
          }
          if (note) {
            const s = document.createElement("small");
            s.textContent = note;
            li.appendChild(s);
          }
          ul.appendChild(li);
        }
        return ul;
      }

      // ── focus: the neighbourhood, expanded ────────────────────────────────
      // Tapping a node reveals its closed neighbourhood EVEN WHERE A FILTER HAS
      // HIDDEN IT, and says how many it had to bring back. That is the honest
      // version of click-to-expand: the filter is still on, and the page tells
      // you it stepped outside it rather than silently widening what you asked
      // for.
      function focus(node, { keep = false } = {}) {
        focused = node;
        const hood = node.closedNeighborhood();
        const revealed = hood.filter(".off");
        cy.batch(() => {
          cy.elements().removeClass("lit dim pick");
          revealed.removeClass("off");
          cy.elements().not(hood).addClass("dim");
          hood.addClass("lit");
          node.addClass("pick");
        });
        if (!keep) inspect(node, revealed.nodes().length);
        paintCounts();
      }

      function blur() {
        focused = null;
        cy.batch(() => cy.elements().removeClass("lit dim pick"));
        applyFilters();
        hideClaim();
        showHome();
      }

      // ── the panel ─────────────────────────────────────────────────────────
      function paintFindings() {
        const box = $("[data-findings]");
        box.textContent = "";
        const lints = payload.lints || [];
        if (!lints.length) {
          const p = document.createElement("p");
          p.className = "og-quiet";
          p.textContent = "this store carries no lint findings — the hydration that wrote it ran without them.";
          box.appendChild(p);
          return;
        }
        for (const l of lints) {
          const card = document.createElement("article");
          card.className = "og-finding" + (l.verdict === "RED" ? " is-red" : "");

          const head = document.createElement("header");
          const pill = document.createElement("span");
          pill.className = "og-verdict v-" + String(l.verdict || "").toLowerCase().replace(/[^a-z]/g, "");
          pill.textContent = l.verdict;
          const id = document.createElement("b");
          id.textContent = l.lint;
          head.appendChild(pill);
          head.appendChild(id);
          card.appendChild(head);

          const h = document.createElement("p");
          h.className = "og-finding-head";
          h.textContent = l.headline;               // the lint's own words, never re-worded here
          card.appendChild(h);

          const im = l.implicates || { nodes: [], edges: [] };
          const meta = document.createElement("p");
          meta.className = "og-finding-meta";
          meta.textContent = im.paints === false
            ? (im.note || "nothing on the graph to point at")
            : `${im.nodes.length} node${im.nodes.length === 1 ? "" : "s"} · ${im.edges.length} edge${im.edges.length === 1 ? "" : "s"}`
              + (im.unmatched && im.unmatched.length ? ` · ${im.unmatched.length} named but NOT IN THE STORE` : "");
          card.appendChild(meta);

          if (im.note && im.paints !== false) {
            const note = document.createElement("p");
            note.className = "og-finding-note";
            note.textContent = im.note;
            card.appendChild(note);
          }

          if ((l.evidence || []).length) {
            const ul = document.createElement("ul");
            ul.className = "og-evidence";
            for (const line of l.evidence) {
              const li = document.createElement("li");
              li.textContent = line;                // resident/derived text: textContent, never innerHTML
              ul.appendChild(li);
            }
            card.appendChild(ul);
            if (l.evidence_total > l.evidence.length) {
              const more = document.createElement("p");
              more.className = "og-quiet";
              more.textContent = `+${l.evidence_total - l.evidence.length} more, and ${l.rows_total} rows behind them — npm run world:lints prints the lot`;
              card.appendChild(more);
            }
          }

          if (im.paints !== false && (im.nodes.length || im.edges.length)) {
            const btn = document.createElement("button");
            btn.type = "button";
            btn.className = "og-show";
            btn.textContent = "show on the graph";
            btn.addEventListener("click", () => showFinding(l));
            card.appendChild(btn);
          }
          box.appendChild(card);
        }
      }

      // Selecting a finding lights EXACTLY the elements it named — the panel and
      // the paint read the same list, so a finding can never highlight something
      // it does not claim.
      function showFinding(l) {
        const im = l.implicates || { nodes: [], edges: [] };
        const ids = im.nodes.map((n) => n.id).concat(im.edges.map((e) => e.id));
        const eles = cy.collection();
        for (const id of ids) {
          const el = cy.getElementById(id);
          if (el && el.length) eles.merge(el);
        }
        if (!eles.length) return;
        focused = null;
        cy.batch(() => {
          cy.elements().removeClass("lit dim pick");
          eles.removeClass("off");
          // a red edge with a hidden end is a red line into nothing — bring the
          // ends back with it, whatever the current filter says
          eles.edges().connectedNodes().removeClass("off");
          cy.elements().not(eles).addClass("dim");
          eles.addClass("lit");
        });
        // Lay the lit set out on its own, in a grid shaped like the canvas.
        // Left where the whole-graph layout put them, a finding's nodes land
        // wherever they happened to fall and their labels overprint; a force
        // layout packs them into a column and does the same; `breadthfirst`
        // strings them into a strip four screens wide, because a finding is
        // usually a set of DISCONNECTED PAIRS (a mark and its mechanic, a parcel
        // and its class) rather than one tree — and a strip fits to a zoom where
        // every label disappears. A grid gives each node its own cell, which is
        // the property that matters when the point is to read the names. The
        // pairing stays visible: the red edges draw across it.
        const box = $("[data-cy]").getBoundingClientRect();
        const n = eles.nodes().length;
        const cols = Math.max(1, Math.ceil(Math.sqrt(n * Math.max(box.width / Math.max(box.height, 1), 0.2))));
        eles.nodes().layout({ name: "grid", animate: false, cols, avoidOverlap: true, condense: false, fit: false }).run();
        cy.fit(eles, 60);
        inspectFinding(l, im);
        paintCounts();
      }

      function inspectFinding(l, im) {
        const box = $("[data-inspector]");
        box.textContent = "";
        openDetour(`${l.lint} — what is lit`);

        const ul = document.createElement("ul");
        ul.className = "og-whylist";
        for (const n of im.nodes) ul.appendChild(whyRow(n.id, n.why, "node"));
        for (const e of im.edges) ul.appendChild(whyRow(e.id, e.why, "edge"));
        for (const u of im.unmatched || []) ul.appendChild(whyRow(u.id, "named by the lint, but the store has no node for it — the finding cannot be drawn", "missing"));
        box.appendChild(ul);
      }

      // A named node in a finding is a place to GO: L3 names 38 files, and the
      // question that follows reading that is always "which one, and what is it
      // attached to". Clicking the row walks there.
      function whyRow(id, why, kind) {
        const li = document.createElement("li");
        li.className = "og-why og-why-" + kind;
        const b = document.createElement("b");
        b.textContent = id;
        li.appendChild(b);
        if (why) {
          const s = document.createElement("span");
          s.textContent = why;
          li.appendChild(s);
        }
        if (kind === "node") {
          li.classList.add("is-walkable");
          li.addEventListener("click", () => {
            const n = cy.getElementById(id);
            if (!n || !n.length) return;
            n.removeClass("off");
            focus(n);
            cy.animate({ center: { eles: n }, zoom: Math.max(cy.zoom(), 1.1) }, { duration: 200 });
          });
        }
        return li;
      }

      // The inspector for one node: what the store holds about it, and every
      // edge it stands at either end of.
      function inspect(node, revealedCount) {
        const box = $("[data-inspector]");
        box.textContent = "";
        openDetour("This node");

        const d = node.data();
        const h = document.createElement("p");
        h.className = "og-inspect-id";
        h.textContent = d.id;
        box.appendChild(h);

        // WHAT IT SAYS, before what it is. A mark's body is the one finite
        // assertion the record is made of (logos § the one claim), and a
        // reader who has to leave this page to find out what a node claims is
        // not reading the world through this window.
        if (d.body) {
          const claim = document.createElement("blockquote");
          claim.className = "og-inspect-claim";
          claim.textContent = d.body;              // the author's own words: textContent, never innerHTML
          box.appendChild(claim);
        }

        const facts = [
          ["kind", d.subkind ? `${d.kind} · ${d.subkind}` : d.kind],
          // The one walk's verdict, derived office-side; a mark the office sent
          // no standing for says so rather than wearing the loader's default.
          ["standing", d.kind === "mark" ? (d.standing ? `${d.standing} (derived)` : "not sent by this office") : "—"],
          ["by", d.by || "—"],
          ["degree", `${d.deg} (${d.indeg} in · ${d.outdeg} out)`],
        ];
        const p = node.position();
        const orig = positionOf(node);
        if (orig) facts.push(["at", `${orig.x}, ${orig.y} m — x east, y south`]);
        else facts.push(["at", "nowhere in the world — this kind is not anywhere"]);
        if (d.path) facts.push(["path", d.path]);
        if (d.mechanic) facts.push(["mechanic", d.mechanic]);
        if (d.class) facts.push(["class", d.class]);
        if (d.affordances) facts.push(["affordances", String(d.affordances)]);
        // WHAT THE AUTHOR WROTE, beside what the loader composed. Every other
        // row here is the composed record; this is the file.
        if (Array.isArray(d.keys)) facts.push(["keys on disk", d.keys.join(", ")]);
        if (d.unresolved) facts.push(["unresolved", "nothing in the store claims this id — it is the far end of a dangling edge, kept because the dangle IS the finding"]);

        const dl = document.createElement("dl");
        dl.className = "og-facts";
        for (const [k, v] of facts) {
          const dt = document.createElement("dt"); dt.textContent = k;
          const dd = document.createElement("dd"); dd.textContent = v;
          dl.appendChild(dt); dl.appendChild(dd);
        }
        box.appendChild(dl);

        if ((d.lints || []).length) {
          const red = document.createElement("p");
          red.className = "og-inspect-lint";
          red.textContent = `carries a finding: ${d.lints.join(", ")}`;
          box.appendChild(red);
        }

        // THIS RECORD THROUGH THE LAW'S GLASSES. The hub drew a whole second
        // tree to say this; here it is one block on the node you asked about,
        // and it says the same four things: which of its keys are edges, which
        // are predicates it keeps or owes, which are derivables it should not be
        // storing at all, and which the map has yet to place.
        const s = serializationOf(d);
        if (s.read) {
          const groups = [
            ["edges", s.edges.map((e) => `${e.key} → ${e.edge}`), "og-ser-edge"],
            ["predicates", s.predicates.map((p) => p.key + (p.lawful ? "" : " → a predicate child")), "og-ser-pred"],
            ["residue", s.residue.map((r) => r.key), "og-ser-residue"],
            ["debt", s.debt.map((r) => r.key), "og-ser-debt"],
          ].filter(([, items]) => items.length);
          const wrap = document.createElement("div");
          wrap.className = "og-ser";
          for (const [name, items, cls] of groups) {
            const row = document.createElement("div");
            row.className = "og-ser-row";
            const h = document.createElement("i");
            h.textContent = name;
            row.appendChild(h);
            for (const it of items) {
              const chip = document.createElement("span");
              chip.className = "og-ser-chip " + cls;
              chip.textContent = it;
              row.appendChild(chip);
            }
            wrap.appendChild(row);
          }
          box.appendChild(wrap);
        }

        const edges = node.connectedEdges();
        const head = document.createElement("p");
        head.className = "og-quiet";
        head.textContent = `${edges.length} edge${edges.length === 1 ? "" : "s"}`
          + (revealedCount ? ` · ${revealedCount} neighbour${revealedCount === 1 ? "" : "s"} brought back from behind the current filter` : "");
        box.appendChild(head);

        const ul = document.createElement("ul");
        ul.className = "og-edgelist";
        edges.forEach((e) => {
          const li = document.createElement("li");
          if (e.hasClass("lint")) li.className = "is-red";
          const dir = e.source().id() === node.id() ? "→" : "←";
          const other = e.source().id() === node.id() ? e.target().id() : e.source().id();
          const t = document.createElement("i"); t.textContent = e.data("type");
          li.appendChild(t);
          li.appendChild(document.createTextNode(` ${dir} ${other}`));
          li.addEventListener("click", () => {
            const n = e.source().id() === node.id() ? e.target() : e.source();
            n.removeClass("off");
            focus(n);
          });
          ul.appendChild(li);
        });
        box.appendChild(ul);
      }

      // THE PANEL HAS TWO HOMES AND ONE DETOUR. Which home depends on the lens:
      // under the tier lattice the panel is the findings, under a lens it is
      // that lens' reading. The inspector is the detour, and the back button
      // returns to whichever home you left — never to a third place.
      // The lens titles, read off the chips themselves. The works lens shipped
      // while a hand-kept map here named three lenses, and its panel titled
      // itself "undefined"; read from the row, the map cannot be missing one.
      const HOME_TITLE = { findings: "Findings" };
      for (const b of all("[data-paint]")) HOME_TITLE[b.dataset.paint] = b.textContent.trim();

      function showHome() {
        $("[data-inspector]").hidden = true;
        $("[data-findings]").hidden = panelHome !== "findings";
        $("[data-lens]").hidden = panelHome !== "lens";
        $("[data-panel-back]").hidden = true;
        $("[data-panel-title]").textContent = panelHome === "findings" ? HOME_TITLE.findings : HOME_TITLE[on.paint];
      }

      // The detour: hide both homes, show the inspector, and offer the way back.
      function openDetour(title) {
        $("[data-findings]").hidden = true;
        $("[data-lens]").hidden = true;
        $("[data-inspector]").hidden = false;
        $("[data-panel-back]").hidden = false;
        $("[data-panel-back]").textContent = "← " + (panelHome === "findings" ? "findings" : HOME_TITLE[on.paint].toLowerCase());
        $("[data-panel-title]").textContent = title;
      }

      // ── wiring ────────────────────────────────────────────────────────────
      all("[data-edge]").forEach((btn) => btn.addEventListener("click", () => {
        const t = btn.dataset.edge;
        if (on.edges.has(t)) on.edges.delete(t); else on.edges.add(t);
        btn.classList.toggle("is-on", on.edges.has(t));
        applyFilters({ relayout: true });
      }));

      all("[data-view]").forEach((btn) => btn.addEventListener("click", () => {
        setView(btn.dataset.view);
        applyFilters({ relayout: true });
      }));

      function setView(v) {
        on.view = v;
        all("[data-view]").forEach((b) => b.classList.toggle("is-on", b.dataset.view === v));
      }

      all("[data-layout]").forEach((btn) => btn.addEventListener("click", () => {
        on.layout = btn.dataset.layout;
        all("[data-layout]").forEach((b) => b.classList.toggle("is-on", b === btn));
        runLayout();
      }));

      // A lens repaints and re-panels; it never relayouts and never filters, so
      // choosing one leaves the graph you were reading exactly where it was.
      all("[data-paint]").forEach((btn) => btn.addEventListener("click", () => setPaint(btn.dataset.paint)));

      // The standing chips: the class row's own contract — toggling one
      // returns to the whole-world view, because a standing filter under
      // "findings only" would silently hide reds.
      all("[data-tier-chip]").forEach((btn) => btn.addEventListener("click", () => {
        if (!cy) return;
        const t = btn.dataset.tierChip;
        if (on.tiers.has(t)) on.tiers.delete(t); else on.tiers.add(t);
        btn.classList.toggle("is-on", on.tiers.has(t));
        setView("all");
        applyFilters({ relayout: true });
      }));

      // The find box narrows in place — no relayout, so the world does not
      // reshuffle under the reader's hands while they type.
      let findTimer = null;
      $("[data-search]").addEventListener("input", (ev) => {
        clearTimeout(findTimer);
        findTimer = setTimeout(() => { if (!cy) return; on.q = ev.target.value; applyFilters(); }, 180);
      });

      // The zoom rail: a decisive step about the canvas' own centre, and a
      // fit that honours whatever the filters currently show.
      const zoomBy = (f) => {
        if (!cy) return;
        const box = $("[data-cy]").getBoundingClientRect();
        cy.zoom({ level: cy.zoom() * f, renderedPosition: { x: box.width / 2, y: box.height / 2 } });
      };
      $("[data-zoom-in]").addEventListener("click", () => zoomBy(1.6));
      $("[data-zoom-out]").addEventListener("click", () => zoomBy(1 / 1.6));
      $("[data-zoom-fit]").addEventListener("click", () => {
        if (!cy) return;
        const vis = cy.elements().not(".off");
        if (vis.length) cy.fit(vis, 30);
      });

      $("[data-panel-back]").addEventListener("click", () => { blur(); });
      $("[data-reload]").addEventListener("click", () => { location.reload(); });

      boot();
    })();
  </script>

  <style is:global>
    /* The ops graph. `is:global` because the island builds most of the panel's
       markup in JS, and scoped styles never reach nodes Astro did not see at
       build — the same reason the ops desk went global. Every selector is
       under .opsgraph, so nothing here can reach another page. */

    .opsgraph { max-width: 1400px; margin: 0 auto; padding: 0 0.4em 2.4em; }

    .opsgraph .og-head { text-align: center; margin: 0 0 1.2em; }
    .opsgraph .og-head h1 {
      margin: 0; font-size: clamp(1.7rem, 4vw, 2.3rem);
      color: var(--pm-gold-bright); text-shadow: 0 0 34px rgba(232, 196, 139, 0.35);
    }
    .opsgraph .og-head .tag {
      margin: 0.35em 0 0; font-family: var(--pm-mono); font-size: 0.7rem;
      letter-spacing: 0.11em; color: rgba(232, 196, 139, 0.78);
    }

    /* ── the As-Of bar ──────────────────────────────────────────────────── */
    .opsgraph .og-asof {
      display: flex; align-items: center; gap: 0.7em; flex-wrap: wrap;
      font-family: var(--pm-mono); font-size: 0.7rem; letter-spacing: 0.03em;
      color: #9fb0cd; background: rgba(13, 20, 38, 0.72);
      border: 1px solid rgba(232, 196, 139, 0.16); border-radius: 9px;
      padding: 0.55em 0.9em; margin-bottom: 0.7em;
    }
    .opsgraph .og-asof-dot {
      width: 8px; height: 8px; border-radius: 50%; flex: none;
      background: #7b8494; box-shadow: 0 0 8px currentColor;
    }
    .opsgraph .og-asof-dot.is-fresh { background: #3fbf87; }
    .opsgraph .og-asof-dot.is-stale { background: #e0b04a; }
    .opsgraph .og-asof-dot.is-bad { background: #ff5c52; }
    .opsgraph .og-counts { margin-left: auto; color: #6f7f9c; }
    .opsgraph .og-reload {
      font: inherit; color: #9fb0cd; background: transparent; cursor: pointer;
      border: 1px solid rgba(232, 196, 139, 0.24); border-radius: 6px; padding: 0.15em 0.6em;
    }
    .opsgraph .og-reload:hover { border-color: rgba(232, 196, 139, 0.6); color: var(--pm-gold-bright); }

    /* ── chips ──────────────────────────────────────────────────────────── */
    .opsgraph .og-chips { display: flex; flex-direction: column; gap: 0.35em; margin-bottom: 0.7em; }
    .opsgraph .og-chiprow { display: flex; align-items: center; gap: 0.35em; flex-wrap: wrap; }
    .opsgraph .og-chiplabel {
      font-family: var(--pm-mono); font-size: 0.62rem; letter-spacing: 0.14em;
      text-transform: uppercase; color: #5d6b86; width: 5.4em; flex: none;
    }
    .opsgraph .og-chipsep { width: 1px; height: 1.2em; background: rgba(232, 196, 139, 0.18); margin: 0 0.5em; }
    .opsgraph .og-chip {
      display: inline-flex; align-items: center; gap: 0.4em;
      font-family: var(--pm-mono); font-size: 0.68rem; cursor: pointer;
      color: #7b8ba7; background: rgba(13, 20, 38, 0.6);
      border: 1px solid rgba(123, 139, 167, 0.24); border-radius: 999px;
      padding: 0.22em 0.75em; transition: all 0.12s ease;
    }
    .opsgraph .og-chip:hover { border-color: rgba(232, 196, 139, 0.5); color: var(--pm-gold-bright); }
    .opsgraph .og-chip.is-on { color: #e8eefb; border-color: rgba(232, 196, 139, 0.45); background: rgba(28, 44, 79, 0.75); }
    .opsgraph .og-chip:not(.is-on) { opacity: 0.55; }

    /* the little kind glyphs — the same shapes cytoscape draws */
    /* THE WEARINGS. Not four kinds of thing — one dot, and what it wears. Each
       of these draws in HTML exactly what cytoscape draws on the canvas. */
    .opsgraph .og-wear { width: 10px; height: 10px; flex: none; display: inline-block; position: relative; }
    .opsgraph .og-wear-dot { border-radius: 50%; background: #5b86ff; }
    .opsgraph .og-wear-badge { border-radius: 50%; background: #5b86ff; }
    .opsgraph .og-wear-badge::after {
      content: ""; position: absolute; right: -3px; top: -3px; width: 6px; height: 6px;
      background: #e8c48b; transform: rotate(45deg); border: 0.5px solid #070b15;
    }
    .opsgraph .og-wear-cont { border-radius: 50%; background: #5b86ff; width: 6px; height: 6px; margin: 2px; }
    .opsgraph .og-wear-shelf {
      border-radius: 2px; background: rgba(91, 134, 255, 0.22); border: 1px solid #4c5f8a;
      width: 9px; height: 9px;
    }
    .opsgraph .og-wear-ghost { border-radius: 50%; background: transparent; border: 1.5px dashed #5b6377; }

    /* the standing chips carry their colour — the filter and the legend speak
       the same hue */
    .opsgraph .og-chip-tier .og-swatch { width: 8px; height: 8px; }

    /* the find box, dressed as the chips it stands with */
    .opsgraph .og-search {
      font-family: var(--pm-mono); font-size: 0.68rem; color: #e8eefb;
      background: rgba(13, 20, 38, 0.6); border: 1px solid rgba(123, 139, 167, 0.24);
      border-radius: 999px; padding: 0.22em 0.75em; width: 13em; outline: none;
    }
    .opsgraph .og-search:focus { border-color: rgba(232, 196, 139, 0.6); }
    .opsgraph .og-search::placeholder { color: #5d6b86; }

    /* the zoom rail, over the canvas' top-left corner */
    .opsgraph .og-zoom {
      position: absolute; left: 0.7em; top: 0.7em; z-index: 3;
      display: flex; flex-direction: column; gap: 0.3em;
    }
    .opsgraph .og-zoom button {
      width: 1.9em; height: 1.9em; font-size: 0.85rem; line-height: 1; cursor: pointer;
      color: #cfd8ea; background: rgba(7, 11, 21, 0.86);
      border: 1px solid rgba(232, 196, 139, 0.24); border-radius: 7px;
    }
    .opsgraph .og-zoom button:hover { border-color: var(--pm-gold); color: var(--pm-gold-bright); }

    /* the class row's own counts, and the chips that are legend rather than
       control — a registered class nothing names cannot filter anything */
    .opsgraph .og-chip-class b { font-weight: 400; color: #6b7a95; margin-left: 0.15em; font-size: 0.95em; }
    .opsgraph .og-chip-registered { border-style: solid; }
    .opsgraph .og-chip-class.is-empty { opacity: 0.32; cursor: default; }
    .opsgraph .og-chip-class.is-empty:hover { border-color: rgba(123, 139, 167, 0.24); color: #7b8ba7; }
    .opsgraph .og-chip-shelf.is-on { border-color: rgba(76, 95, 138, 0.8); }

    /* the shelf's own caption, against the canvas' east edge */
    .opsgraph .og-shelf-label {
      position: absolute; right: 0.7em; bottom: 0.7em; z-index: 3; margin: 0; max-width: 11em;
      font-family: var(--pm-mono); font-size: 0.55rem; line-height: 1.6; text-align: right;
      color: #8595b0; pointer-events: none; letter-spacing: 0.04em;
      background: rgba(7, 11, 21, 0.86); border: 1px solid rgba(76, 95, 138, 0.45);
      border-radius: 8px; padding: 0.45em 0.7em;
    }
    .opsgraph .og-shelf-label[hidden] { display: none; }

    /* ── the stage ──────────────────────────────────────────────────────── */
    .opsgraph .og-stage { display: grid; grid-template-columns: minmax(0, 1fr) 24em; gap: 0.7em; align-items: stretch; }
    @media (max-width: 900px) { .opsgraph .og-stage { grid-template-columns: minmax(0, 1fr); } }

    .opsgraph .og-canvas {
      position: relative; min-height: 640px; height: 68vh;
      background: var(--pm-night);
      border: 1px solid rgba(232, 196, 139, 0.18); border-radius: 12px; overflow: hidden;
    }
    .opsgraph .og-cy { position: absolute; inset: 0; }

    .opsgraph .og-legend {
      position: absolute; left: 0.7em; bottom: 0.7em; z-index: 2;
      display: flex; flex-direction: column; gap: 0.25em;
      background: rgba(7, 11, 21, 0.82); border: 1px solid rgba(232, 196, 139, 0.14);
      border-radius: 8px; padding: 0.45em 0.7em; pointer-events: none;
    }
    .opsgraph .og-legend-row { display: flex; gap: 0.85em; flex-wrap: wrap; }
    /* An author `display` beats the UA's `[hidden] { display: none }`, so every
       element on this page that is both flexed AND hidden by the island has to
       say so itself. Learned from the legend showing all three of its colour
       rows at once, which is three legends and therefore none. */
    .opsgraph .og-legend-row[hidden], .opsgraph .og-claim[hidden] { display: none; }
    .opsgraph .og-legend-item {
      display: inline-flex; align-items: center; gap: 0.35em;
      font-family: var(--pm-mono); font-size: 0.6rem; color: #8595b0;
