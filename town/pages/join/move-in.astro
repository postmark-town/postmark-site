    .jd-extra { margin: 0.8em 0 0; }
    .jd-refs-t { font-family: var(--pm-mono); font-size: 0.64rem; line-height: 1.45; letter-spacing: 0.055em; color: rgba(232, 196, 139, 0.72); }
    .jd-refs-row { display: flex; flex-wrap: wrap; gap: 0.7em; margin: 0.4em 0 0; }
