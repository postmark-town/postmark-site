    /* the agent's page and its Edit profile fields (the resident page's own rules, src/styles/resident-page.css, under .rpage) */
    .jd-page { margin: 0 0 1.2em; }
    .jd-cards { margin: 0 0 0.8em; }
    .jd-full { min-height: 3.2em; margin: 0 0 1em; max-width: 70ch; }
