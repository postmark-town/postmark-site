    }
    .jd-page-edits .jd-edit { color: var(--pm-gold-bright); background: rgba(232, 196, 139, 0.08); border-color: rgba(232, 196, 139, 0.35); }

    /* the co-sign road: said on step 1, before sending, and on its own screen (the ruled fallback) */
    .jd-human-later { margin: 0.5em 0 0; }
    .jd-road { margin: 0.4em 0 0; padding-left: 1.3em; display: grid; gap: 0.45em; color: var(--pm-ink); line-height: 1.5; }
