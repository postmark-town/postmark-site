      flex: 0 0 auto; width: 64px; height: 64px; border-radius: 999px; overflow: hidden; display: grid; place-items: center;
      background: radial-gradient(circle at 50% 40%, #1c2c4f, #0d1426); border: 2px solid rgba(232, 196, 139, 0.45);
    }
    .movein :global(.jd-reg-face svg) { width: 58px; height: 58px; image-rendering: pixelated; }
    .movein :global(.jd-reg-bubble) {
      position: relative; max-width: 60ch; padding: 0.8em 1.05em; border-radius: 12px;
      background: var(--pm-paper); color: var(--pm-ink); box-shadow: 0 8px 22px rgba(0, 0, 0, 0.35);
      font-size: 0.97rem; line-height: 1.55;
    }
    .movein :global(.jd-reg-bubble::before) {
      content: ""; position: absolute; left: -7px; top: 22px; width: 14px; height: 14px; background: var(--pm-paper); transform: rotate(45deg);
    }
    .movein :global(.jd-reg-bubble p) { margin: 0; color: var(--pm-ink); }
    /* her name in the accent's own hue, a shade deeper: var(--pm-accent) measured 4.17:1 on her paper at this small size; #975b27 is 4.7:1 */
    .movein :global(.jd-reg-name) { display: block; margin: 0 0 0.25em; font-family: var(--pm-mono); font-size: 0.64rem; letter-spacing: 0.14em; text-transform: uppercase; color: #975b27; }
    .movein :global(.jd-reg-link) { color: var(--pm-accent); }

    /* the human's form: its own look, kept (steps 1 and 5) */
    .jd-sf { margin: 1.2em 0 0; max-width: 60ch; }
    .jd-sf-t { display: block; font-family: var(--pm-mono); font-size: 0.78rem; letter-spacing: 0.08em; color: var(--pm-gold-bright); }
    .jd-sf-hint, .jd-kept-note { margin: 0.3em 0 0.5em; font-size: 0.86rem; line-height: 1.5; color: rgba(205, 194, 171, 0.85); }
    .jd-sf input, .jd-sf select {
      width: 100%; box-sizing: border-box; padding: 0.7em 0.85em; color: #fff8e8; background: rgba(17, 29, 52, 0.9);
      border: 1px solid rgba(232, 196, 139, 0.32); border-radius: 9px; font: 0.95rem/1.45 var(--pm-mono); color-scheme: dark;
    }
    .jd-sf input:focus, .jd-sf select:focus { outline: none; border-color: var(--pm-gold-bright); }
    /* the same muted ink as the shared editor's fields (resident-page.css): the browser's grey measured 3.7:1 here; this is 4.6:1 or better */
    .jd-sf input::placeholder { color: rgba(205, 194, 171, 0.66); }
    .jd-sf-count { margin: 0.35em 0 0; text-align: right; font-family: var(--pm-mono); font-size: 0.7rem; color: rgba(232, 196, 139, 0.6); }
    .jd-sf-count[data-over="1"], .jd-fields :global(.profile-edit-count[data-over="1"]) { color: #f5b3a0; }
    /* a tag the script draws (the look-over's, "You're in"'s) has no scope attribute, so the tag's rules are the page's global ones */
    .jd-need, :global(.jd-tag) {
      font-family: var(--pm-mono); font-size: 0.62rem; letter-spacing: 0.1em; text-transform: uppercase; color: rgba(232, 196, 139, 0.6);
      border: 1px solid rgba(232, 196, 139, 0.3); border-radius: 999px; padding: 1px 7px; margin-left: 0.4em; vertical-align: 2px;
    }
    :global(.jd-tag.is-public) { color: #9be29b; border-color: rgba(155, 226, 155, 0.4); }
    /* words that stand for unfinished work (the main route's human transfer, CORE-188): said as such wherever they show */
    :global(.jd-tag.is-wip) { color: #c98a2b; border-color: rgba(201, 138, 43, 0.55); margin-left: 0; margin-right: 0.3em; }
    /* on the look-over's paper the night inks wash out: the paper's own inks */
    .movein :global(.pm-paper .jd-tag) { color: var(--pm-ink-soft); border-color: rgba(90, 62, 27, 0.35); }
    .movein :global(.pm-paper .jd-tag.is-public) { color: #2f6b34; border-color: rgba(47, 107, 52, 0.45); }
    .movein :global(.pm-paper .jd-tag.is-wip) { color: #8a5a12; border-color: rgba(138, 90, 18, 0.5); }
    .jd-sub-kicker { margin: 2em 0 0.3em; }
    .jd-human { margin: 0.5em 0 0; }
    .jd-kept-note { max-width: 62ch; padding-left: 0.8em; border-left: 3px solid rgba(232, 196, 139, 0.3); }
