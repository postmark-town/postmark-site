    .jd-ref-thumb {
      display: grid; place-items: center; width: 92px; height: 92px; border-radius: 10px; background-size: cover; background-position: center;
      border: 1.5px dashed rgba(232, 196, 139, 0.4); color: rgba(232, 196, 139, 0.65); font-family: var(--pm-mono); font-size: 0.72rem;
    }
    .jd-ref-thumb.has-pic { border-style: solid; }
