    /* look it over */
    .jd-review { padding: 1.2em 1.4em; margin: 0 0 1.2em; }
    .jd-review-sec + .jd-review-sec { margin-top: 1.1em; padding-top: 1em; border-top: 1px dashed rgba(90, 62, 27, 0.25); }
    .jd-review-sec h3 { display: flex; align-items: center; gap: 0.7em; margin: 0 0 0.5em; font-size: 1.02rem; color: var(--pm-ink); }
    .jd-review-sec :global(dl) { margin: 0; display: grid; gap: 0.35em; }
