      display: inline-flex; align-items: center; gap: 0.5em; padding: 0.65em 1.2em; border-radius: 10px; cursor: pointer;
      border: 1px solid rgba(232, 196, 139, 0.35); color: var(--pm-gold-bright); font-family: var(--pm-mono);
    }
    .jd-pick:has(input:checked) { background: rgba(232, 196, 139, 0.14); border-color: var(--pm-gold-bright); }

    /* look it over */
    .jd-review { padding: 1.2em 1.4em; margin: 0 0 1.2em; }
