    /* THE ACT, on night */
    .jf-act { padding: 1.5em 0 3em; box-sizing: border-box; }
    .jf-act:focus { outline: none; }
    .jf-act[hidden] { display: none; }
    .jf-act [hidden] { display: none !important; }

    /* THE REGISTRAR (built from a template by the script: :global) */
    .movein :global(.jd-reg) { display: flex; align-items: flex-start; gap: 0.9em; margin: 0 0 1.4em; }
    .movein :global(.jd-reg-face) {
      flex: 0 0 auto; width: 64px; height: 64px; border-radius: 999px; overflow: hidden; display: grid; place-items: center;
      background: radial-gradient(circle at 50% 40%, #1c2c4f, #0d1426); border: 2px solid rgba(232, 196, 139, 0.45);
    }
    .movein :global(.jd-reg-face svg) { width: 58px; height: 58px; image-rendering: pixelated; }
    .movein :global(.jd-reg-bubble) {
