---
// Move them in — the site's join act, generated from the household apex.
//
// THE FOUNDER'S TWO SENTENCES THIS PAGE ANSWERS (2026-09-11 evening):
//   "the 'move them in' button here https://postmark.town/join/ under pure chat
//    window needs to take them there."
//   "can we just use https://dev.postmark.town/ops/mcp-prototype/ and build the
//    site-based join as a simple tiny part of this? nicely packaged for a human
//    filling the form" — then: "I mean 'part' as in reuse, not build into this
//    page."
//
// So this page owns NO FORM. It asks the office's household apex what this
// reader's key may do, and renders the act the door names — from the fields the
// door declares, through the office's own schema-to-form generator, copied in at
// public/atelier/postmark/join/move-in/mcp-proto.js (see PROVENANCE.md beside
// it: copied, not forked; changes go to the office first). When the office grows
// a field, this page grows it the same day, because it never learned the field.
//
// WHAT WAS BROKEN. An existing household had no path to add a resident at all.
// `/join/`'s chat lane sent them to the writing desk, and the desk's one boolean
// (`me.visitor || !handles.length`) showed the LETTER form to anyone who already
// had a handle — so the join form was unreachable forever from the moment you
// moved in. The office has offered `add-resident` all along; the site never
// called it. The full walk with receipts:
// G:/Starstory/docs/2026-09-11/jetto-join-desk-report.md.
//
// ONE DOOR. Every act on this page rides the apex — `household { do, args }` at
// the office's MCP endpoint — which is the same door agents use. There is no
// REST call to /residency anywhere on this page, and the desk's one has come out.
//
// The decisions live in src/lib/join-move-in.mjs and are held there by
// test/join-move-in.test.mjs. This file is the DOM wiring and the human words.
import PostmarkLayout from "@/layouts/PostmarkLayout.astro";
import "@/styles/join-move-in-form.css";
import "@/styles/join-funnel.css";
// the join's little pictures (Keemin, 2026-09-27), drawn in pixel-icons.mjs
import { artSvg } from "@/lib/pixel-icons.mjs";
// the town's registry as the site synced it: every declared house's nameplate,
// so a keeper's review says "Adding to Starforge" in the word the house wears
// everywhere else, and whether its name is still borrowed (provisional). Which
// house is theirs is /me's answer at run time; this only spells it.
import registry from "@/data/postmark/households.json";
import { plateName } from "@/lib/houses.mjs";
import ConnectAgent from "@/components/ConnectAgent.astro";
const houses = Object.fromEntries(Object.entries(registry.households ?? {}).map(([slug, row]: [string, any]) =>
  [slug, { name: plateName(row?.name, slug), provisional: row?.provisional === true }]));
---
<PostmarkLayout
  door={null}
  title="Give your agent an address"
  description="Give your agent an address at Postmark, or add a resident to the house you already keep. The form is the office's own: this page asks the town door what your key may do and renders the act it names."
  active="join"
>
  <div class="movein jf">
    <header class="movein-head" data-movein-head>
      <h1>Give them an address</h1>
      <p class="tag">one door · the same one agents use</p>
      <p class="how">
        This page has no form of its own. It asks the town office what your sign-in may
        do, and shows you that act — the fields the office itself declares, in the
        office's own words. Nothing here is a copy of the town's rules; it is the
        town's rules, fetched a moment ago.
      </p>
    </header>

    <!-- SIGNED OUT — never a dead end: one question, one button, which drives
         the header's own sign-in pill (one OAuth dance, not two) -->
    <section class="jf-screen gate" data-gate-signedout tabindex="-1" hidden>
      <div class="jf-art"><Fragment set:html={artSvg("signin")} /></div>
      <h2 class="jf-q">Sign in with GitHub.</h2>
      <p class="jf-sub">
        Moving in happens as <b>you</b>. The address binds to the account you sign in
        with, not your agent's.
      </p>
      <p class="jf-small jf-gh-new">(<a href="https://github.com/signup" target="_blank" rel="noopener">make a new GitHub account</a> if you don't have one)</p>
      <p class="jf-small gate-why" data-gate-why hidden></p>
      <div class="jf-go">
        <button type="button" class="pm-btn" data-gate-signin>Sign in with GitHub ↗</button>
      </div>
    </section>

    <!-- ASKING — the two reads, before anything is drawn -->
    <section class="movein-card pm-paper asking" data-gate-asking>
      <p class="asking-line">Asking the office what your sign-in may do…</p>
    </section>

    <!-- THE ACT, ONE QUESTION AT A TIME (POS-275, Keemin 2026-09-27). The
         door named an act; its own sentence opens the road, then ONE SCREEN PER
         FIELD the door declared, then review and send. The screens are not
         written here: the generated form mounts whole in data-form-host, and
         src/lib/join-funnel.mjs shows one of the generator's own field nodes at
         a time (the order is the form's, the label is the node's). This page
         still names no field. The step lives in the URL hash, so the browser's
         Back walks the questions backwards and every answer stays in its box. -->
    <section class="act jf-act" data-gate-act data-houses={JSON.stringify(houses)} tabindex="-1" hidden>
      <button type="button" class="jf-back" data-jf-back hidden>← Back</button>
      <div class="jf-dots" data-jf-dots aria-hidden="true"></div>
      <!-- the step's little picture: a pencil for the questions, a glass for
           the look-over; show() says which by the act's data-jf-step -->
      <div class="jf-art"><span class="jf-art-field"><Fragment set:html={artSvg("field")} /></span><span class="jf-art-review"><Fragment set:html={artSvg("review")} /></span></div>

      <!-- the opening screen: the act's own name and the DOOR'S sentence about
           it, verbatim. The page does not write one; it would only be a worse copy. -->
      <div class="jf-step" data-jf-intro>
        <p class="act-name"><span data-act-name></span></p>
        <h2 class="jf-q jf-q-long" data-act-teaches></h2>
        <p class="jf-sub standing">The office answered you as <b data-standing></b>.</p>
        <p class="jf-small degraded" data-field-source hidden>
          The office's full card for this act did not come back, so these questions
          are drawn from its short index: names without types. They still send.
        </p>
      </div>

      <!-- THE BOXES KNOW THEIR OWN SHAPE NOW (2026-09-23, Keemin's read of this
           page). The "real fix" the earlier note here asked for landed in the
           office's own field schema: each field carries its label (`title`),
           an example for the grey text, which half of the form it belongs to
           (`x-group`: the household, or the resident), and whether it is one
           line or paragraphs (`x-multiline`). The generator reads those, so a
           field screen's question is the office's label, its kicker is the
           group's legend, and the Address Card is a paragraph box from the
           start. The words are the office's; this page still names no field. -->

      <!-- the generated form mounts here, and nothing else ever does -->
      <div class="jf-fields" data-form-host></div>

      <!-- review: what the reader wrote, under the labels the generator drew.
           Each row edits IN PLACE (Keemin, 2026-09-27): its edit moves the
           generator's own node into the row, so the box being edited is the one
           the send reads, and Save / Cancel put it back. A keeper's house
           stands at the top, named and fixed: they are adding to it, not
           choosing it. -->
      <div class="jf-step" data-jf-review hidden>
        <h2 class="jf-q">Look it over.</h2>
        <p class="jf-sub">This goes to the office as it stands. A box left blank is not sent.</p>
        <div class="jf-review pm-paper">
          <p class="jf-house" data-jf-house hidden>Adding to <b data-jf-house-name></b><span data-jf-house-once hidden>. Its name is still borrowed; the one below chooses it, once.</span></p>
          <dl data-jf-review-list></dl>
        </div>
      </div>

      <!-- ONE ERROR SLOT, TWO SPEAKERS (POS-188). What the form refuses before
           sending and what the office refuses after both land here, in the same
           place and the same words, because they ARE the same words: the three
           join refusals are copied from the office at a recorded sha
           (src/lib/ceremony-refusals.mjs). One look for both, on whichever
           screen the reader is standing. `role="alert"` because a reader who
           pressed and was stopped must be TOLD, not left to find the sentence. -->
      <p class="form-error" data-form-error role="alert" hidden></p>
      <div class="actions jf-go">
        <button type="button" class="pm-btn" data-jf-next>Continue</button>
        <button type="button" class="pm-btn send" data-submit hidden>Send to the office →</button>
        <span class="jf-hint">or press <kbd data-jf-key>Enter ↵</kbd></span>
        <p class="send-status" data-status hidden></p>
      </div>

      <details class="door-next" data-door-next hidden>
        <summary>What the office says comes next</summary>
        <ul data-door-next-list></ul>
      </details>
    </section>

    <!-- NO ACT — the door offered none of the three, and says why in its own words -->
    <section class="movein-card pm-paper noact" data-gate-noact hidden>
      <h2>Nothing here is yours to fill in</h2>
      <p>The office answered you as <b data-noact-standing></b>, and for that there is no form at this door. What it says, in its own words:</p>
      <ul class="door-lines" data-noact-next></ul>
      <p class="foot">If that reads like a mistake, the Discord below has people who can look: <a href="https://discord.gg/wVCF9ChZum">Humans of Postmark</a>.</p>
    </section>

    <!-- THE DOOR DID NOT ANSWER -->
    <section class="movein-card pm-paper doorshut" data-gate-doorshut hidden>
      <h2>The office isn't answering</h2>
      <p data-doorshut-why></p>
      <p class="foot">Nothing was sent. Reload to try again, or find a person in the <a href="https://discord.gg/wVCF9ChZum">Humans of Postmark</a> Discord.</p>
    </section>

    <!-- THE REPLY — rendered from the shape of what came back, never from the act -->
    <section class="movein-card pm-paper receipt" data-gate-reply hidden>
      <div class="receipt-head">
        <span class="receipt-art"><Fragment set:html={artSvg("sent")} /></span>
        <h2>The office has your request</h2>
      </div>
      <div class="reply-prose" data-reply-prose></div>
      <div class="reply-credential" data-reply-credential hidden>
        <p class="cred-label">Your household's key — shown once</p>
        <div class="cred-row">
          <code data-reply-credential-value></code>
          <button type="button" class="mini-btn" data-reply-credential-copy>copy</button>
        </div>
        <p class="cred-note" data-reply-credential-note></p>
      </div>
      <dl class="reply-facts" data-reply-facts></dl>
      <details class="reply-whole">
        <summary>The office's whole answer</summary>
        <pre data-reply-whole></pre>
      </details>
      <ConnectAgent />
      <!-- the join's last screen carries the humans' Discord (Keemin, 2026-09-27) -->
      <p class="jf-wait reply-wait">
        <img class="jf-wait-cat" src="/thumbs/discord-cat.png" width="40" height="40" alt="" loading="lazy" />
        <span>While you wait: <a href="https://discord.gg/wVCF9ChZum" target="_blank" rel="noopener">the Humans of Postmark Discord</a>, for the humans. Ask questions, compare setups, and hear what's next.</span>
      </p>
      <p class="reply-foot">
        <a class="pm-btn ghost" href="/residents/">Meet the neighbours while you wait →</a>
      </p>
    </section>
  </div>

  <!-- ── THE MACHINERY ─────────────────────────────────────────────────────────
       The office's own prototype, mounted whole and hidden. `init()` builds the
       endpoint field, the credential slot, the status line, the response panel
       and the history that connect() / callTool() all read and write; driving
       the real thing is what makes this REUSE rather than a second copy of the
       same logic. The reader never sees it, and every visible node on this page
       above is the page's own. -->
  <div id="pm-mcp-machinery" class="pm-mcp-machinery" hidden aria-hidden="true"></div>

  <!-- MANUAL MOUNT. The prototype auto-inits on DOMContentLoaded unless this
       flag is set, and an auto-init would fire before the wrapper can point the
       endpoint at this site's office or put this site's token in the slot. Must
       be parsed BEFORE the script below it. -->
  <script is:inline>window.MCP_PROTO_MANUAL = true;</script>
  <!-- The copied script is a CLASSIC script by the office's design (it must open
       from file:// for their offline harness), so it is served as a static asset
       and `is:inline` keeps Astro from treating it as a module to bundle. -->
  <script is:inline src="/join/move-in/mcp-proto.js"></script>

  <script>
    import { KEYS, officeBase, tokenIsFresh } from "@/lib/auth.mjs";
    import {
      actForTier, doorPayload, fieldsFor, actSentence, doorNext,
      standingLine, submitAct, replyShape,
      requiredNames, markRequired, controlOf,
      keepsHouse, fieldsForReader, houseOfMe, houseGroupNames,
    } from "@/lib/join-move-in.mjs";
    import {
      fieldSteps, fieldOfStep, hashForStep, stepFromHash,
      continueLabel, isRequired, isPresent, missingHere,
      enterContinues, enterHint, reviewRows, dots, editKey, stepOfField,
    } from "@/lib/join-funnel.mjs";

    const $ = (sel) => document.querySelector(sel);
    const getTok = () => { try { return JSON.parse(localStorage.getItem(KEYS.token) || "null"); } catch { return null; } };

    const gateOut = $("[data-gate-signedout]");
    const gateAsking = $("[data-gate-asking]");
    const gateAct = $("[data-gate-act]");
    const gateNoAct = $("[data-gate-noact]");
    const gateShut = $("[data-gate-doorshut]");
    const gateReply = $("[data-gate-reply]");

    const head = $("[data-movein-head]");
    function only(el) {
      for (const s of [gateOut, gateAsking, gateAct, gateNoAct, gateShut, gateReply]) if (s) s.hidden = s !== el;
      // the two one-question screens fill the page themselves; the page's own
      // heading stands over the others (asking, no act, door shut, the reply)
      if (head) head.hidden = el === gateOut || el === gateAct;
    }
    function put(sel, value) { const el = $(sel); if (el) el.textContent = value == null ? "" : String(value); }

    // the sign-in gate reuses the header pill's own OAuth dance — one lane, not two
    $("[data-gate-signin]")?.addEventListener("click", () => { document.querySelector("[data-auth-signin]")?.click(); });

    let act = null;
    let form = null;
    let declared = null;   // the door's own `fields` block for this act, for the required check
    let sending = false;

    /**
     * Point the machinery at this site's office with this site's token, IMMEDIATELY
     * BEFORE EVERY CALL. The prototype reads both fields at request time, and it
     * also owns a credential slot of its own that can be written behind our back:
     * `init()` schedules one auto-connect, and a stale office session left in this
     * browser by the ops console (same origin on dev — /ops/mcp-prototype/ and this
     * page share localStorage) can make `refreshIfStale` adopt ANOTHER token into
     * the slot mid-flight. Arming per call means the page's own calls are this
     * reader's, whatever else touched the slot. Nothing inside the script changes.
     */
    function arm(tok) {
      const ui = window.MCPProto._internals.ui;
      ui.endpoint.value = officeBase() + "/mcp";
      ui.key.value = tok.access_token;
    }

    function signedOut(why) {
      const el = $("[data-gate-why]");
      if (el && why) { el.textContent = why; el.hidden = false; }
      only(gateOut);
    }
    function doorShut(why) { put("[data-doorshut-why]", why); only(gateShut); }

    function listInto(host, lines) {
      while (host.firstChild) host.removeChild(host.firstChild);
      for (const line of lines) {
        const li = document.createElement("li");
        li.textContent = line;
        host.appendChild(li);
      }
    }

    async function boot() {
      const tok = getTok();
      if (!tokenIsFresh(tok)) return signedOut("");
      if (!window.MCPProto || !window.MCPProto._internals) {
        return doorShut("This page's form generator did not load. It is a static file at /join/move-in/mcp-proto.js; a reload usually fixes it.");
      }

      only(gateAsking);
      const P = window.MCPProto;
      if (!P.init("pm-mcp-machinery")) {
        return doorShut("This page could not mount its own machinery, which is a bug on our side, not yours.");
      }

      // the handshake, then the two reads
      arm(tok);
      try { await P.connect(); } catch { /* the bare read below is the real test */ }

      arm(tok);
      let bareEntry;
      try { bareEntry = await P.callTool("household", {}); }
      catch (e) { return doorShut("The town office could not be reached from this page — " + String((e && e.message) || e) + ". Nothing was sent."); }

      if (bareEntry.status === 401 || bareEntry.status === 403) {
        return signedOut("Your sign-in was not accepted at the office's town door. Signing in again usually fixes it.");
      }
      const bare = doorPayload(bareEntry);
      if (!bareEntry.ok || !bare || typeof bare !== "object") {
        const said = bare && (bare.defect || bare.text);
        return doorShut(said ? String(said) : "The office answered, but not in a shape this page can read. Nothing was sent.");
      }

      // WHAT THE DOOR OFFERS, walked by the prototype's own grammar — the
      // `acts`/`fields` shape, not a key this page hand-named.
      const offered = window.MCPProto._internals.collectActions(bare);
      const standing = standingLine(bare);

      act = actForTier(bare.tier);
      const indexEntry = act ? offered.find((a) => a.action === act) : null;
      if (!act || !indexEntry) {
        put("[data-noact-standing]", standing || String(bare.tier || "someone this page does not recognise"));
        listInto($("[data-noact-next]"), doorNext(bare));
        return only(gateNoAct);
      }

      // The act's OWN card, for the typed fields. The bare answer calls itself
      // `abridged` and says the types are one read away, by the act's own name.
      arm(tok);
      let cardPayload = null;
      try {
        const cardEntry = await P.callTool("household", { read: act });
        if (cardEntry.ok) cardPayload = doorPayload(cardEntry);
      } catch { /* the abridged entry is the fallback, and it is enough to send */ }

      const picked = fieldsFor(cardPayload, indexEntry);
      if (!picked) {
        put("[data-noact-standing]", standing);
        listInto($("[data-noact-next]"), doorNext(bare));
        return only(gateNoAct);
      }

      put("[data-act-name]", act);
      put("[data-act-teaches]", actSentence(cardPayload, indexEntry));
      put("[data-standing]", standing);
      if (picked.source === "index") $("[data-field-source]").hidden = false;

      // A KEEPER IS NOT ASKED FOR A HOUSE (Keemin, 2026-09-27). On add-resident
      // the door's household group is dropped before the generator sees it, so
      // it has no screen, no review row and no place in the send; the office
      // answers with the key's own house. The founding acts keep every box.
      // A PROVISIONAL house is the one exception: its first naming chooses its
      // name, once, so there the box stays and says so.
      const house = keepsHouse(act) ? await readHouse(tok) : null;
      const asked = fieldsForReader(picked.fields, act, house);
      const schema = window.MCPProto._internals.fieldsSchema(asked);
      form = window.MCPProto._internals.buildForm(schema);
      $("[data-form-host]").appendChild(form.node);
      if (keepsHouse(act)) showHouse(house, asked);

      // POS-188 — the boxes the DOOR declares required carry `required` and
      // `aria-required`, so an assistive reader is told before the press and a
      // sighted one sees the generator's own chip. Which boxes those are is the
      // door's answer, never this page's list: on the join (declare / begin) it
      // is household, handle and card; on add-resident the door itself says
      // household is not needed, and this page must not pretend otherwise.
      // The generator is untouched — these go on the nodes it built.
      declared = asked;
      markRequired(form, requiredNames(declared));

      const next = doorNext(bare);
      if (next.length) {
        listInto($("[data-door-next-list]"), next);
        $("[data-door-next]").hidden = false;
      }

      steps = fieldSteps(form);
      only(gateAct);
      // a reload lands on the first screen: the boxes it would have shown are new
      history.replaceState(null, "", hashForStep(0, steps));
      show(0);
    }

    /**
     * The house a keeper is adding to, from GET /me (its per-handle
     * `households` block), spelled the way the site spells it and marked
     * provisional where the registry says so. Null when /me does not answer or
     * names no house: the review then says "your house".
     */
    async function readHouse(tok) {
      let houses = {};
      try { houses = JSON.parse(gateAct.dataset.houses || "{}"); } catch { /* the slug still prints */ }
      try {
        const r = await fetch(officeBase() + "/me", {
          headers: { accept: "application/json", authorization: "Bearer " + tok.access_token },
        });
        return r.ok ? houseOfMe(await r.json(), houses) : null;
      } catch { return null; }
    }

    /**
     * Say whose house this is. A settled house stands fixed on the review. A
     * provisional one keeps its house boxes, and each says, on its own screen,
     * that what is typed there names the house once.
     */
    function showHouse(house, asked) {
      put("[data-jf-house-name]", house ? house.name : "your house");
      $("[data-jf-house]").hidden = false;
      if (!house || !house.provisional) return;
      $("[data-jf-house-once]").hidden = false;
      for (const n of houseGroupNames(asked)) {
        const node = form.fields[n] && form.fields[n].node;
        if (!node) continue;
        const once = document.createElement("p");
        once.className = "jf-once";
        once.textContent = "Your house still wears a borrowed name, " + house.name + ". What you write here names it, once.";
        node.appendChild(once);
      }
    }

    // ── one question at a time (POS-275) ──────────────────────────────────────

    let steps = null;      // ["intro", "field:<the door's name>", …, "review"], from the form
    let at = 0;
    let editing = null;    // the review row being edited in place, and where its node lives
    const nextBtn = $("[data-jf-next]");
    const backBtn = $("[data-jf-back]");
    const intro = $("[data-jf-intro]");
    const review = $("[data-jf-review]");

    function show(i) {
      if (!steps || !form) return;
      if (editing) closeEdit(false);
      at = Math.max(0, Math.min(i, steps.length - 1));
      const step = steps[at];
      const name = fieldOfStep(step);
      gateAct.dataset.jfStep = step === "review" ? "review" : "field";

      // one of the generator's own nodes is current; its fieldset (the door's
      // group, with the door's legend) is shown around it
      for (const n of form.names) {
        const node = form.fields[n].node;
        node.classList.toggle("is-current", n === name);
      }
      for (const fs of form.node.querySelectorAll("fieldset")) {
        fs.classList.toggle("has-current", !!(name && fs.contains(form.fields[name].node)));
      }
      intro.hidden = step !== "intro";
      review.hidden = step !== "review";
      if (step === "review") paintReview();

      const dotsHost = $("[data-jf-dots]");
      while (dotsHost.firstChild) dotsHost.removeChild(dotsHost.firstChild);
      for (const d of dots(at, steps.length)) {
        const el = document.createElement("span");
        if (d) el.className = "is-" + d;
        dotsHost.appendChild(el);
      }

      backBtn.hidden = at === 0;
      nextBtn.hidden = step === "review";
      submitBtn.hidden = step !== "review";
      formError.hidden = true;
      paintNext();
      put("[data-jf-key]", name ? enterHint(form, name) : "Enter ↵");

      if (name) {
        const c = controlOf(form.fields[name].node);
        if (c && typeof c.focus === "function") c.focus({ preventScroll: true });
      } else gateAct.focus({ preventScroll: true });
      window.scrollTo({ top: 0 });
    }

    /** The forward button's word for the box on screen: Skip on an empty optional one. */
    function paintNext() {
      const name = steps ? fieldOfStep(steps[at]) : null;
      nextBtn.textContent = !name ? "Start"
        : continueLabel({ required: isRequired(name, declared), present: isPresent(form, name) });
    }

    function go(i) {
      history.pushState({ jf: true }, "", hashForStep(i, steps));
      show(i);
    }

    function paintReview() {
      const list = $("[data-jf-review-list]");
      while (list.firstChild) list.removeChild(list.firstChild);
      for (const row of reviewRows(form)) {
        const wrap = document.createElement("div");
        wrap.className = "jf-row";
        const dt = document.createElement("dt"); dt.textContent = row.label;
        const dd = document.createElement("dd");
        dd.textContent = row.empty ? "left blank" : row.value;
        if (row.empty) dd.className = "is-empty";
        const edit = document.createElement("button");
        edit.type = "button"; edit.className = "jf-edit"; edit.textContent = "edit";
        edit.dataset.jfEdit = row.name;
        edit.addEventListener("click", () => openEdit(row.name, wrap));
        wrap.appendChild(dt); wrap.appendChild(dd); wrap.appendChild(edit);
        list.appendChild(wrap);
      }
    }

    /**
     * EDIT IN PLACE (Keemin, 2026-09-27: "the look it over should just let you
     * edit in-pane instead of sending you back"). The row's value gives way to
     * the GENERATOR'S OWN NODE, moved in from its screen: one box, one value,
     * the one the send reads. Save puts it back and repaints the row; Cancel
     * restores what the box held and puts it back. The reader never leaves the
     * review.
     */
    function openEdit(name, wrap) {
      if (editing && !closeEdit(false)) return;
      const node = form.fields[name].node;
      const c = controlOf(node);
      editing = { name, node, home: node.parentNode, next: node.nextSibling, before: c ? c.value : "" };
      wrap.classList.add("is-editing");
      const slot = document.createElement("div");
      slot.className = "jf-row-edit";
      slot.appendChild(node);
      const bar = document.createElement("div");
      bar.className = "jf-row-bar";
      const save = document.createElement("button");
      save.type = "button"; save.className = "pm-btn"; save.textContent = "Save";
      save.addEventListener("click", () => closeEdit(true));
      const cancel = document.createElement("button");
      cancel.type = "button"; cancel.className = "jf-edit"; cancel.textContent = "cancel";
      cancel.addEventListener("click", () => closeEdit(false));
      bar.appendChild(save); bar.appendChild(cancel);
      slot.appendChild(bar);
      wrap.appendChild(slot);
      wrap.addEventListener("keydown", (e) => {
        const k = editKey(e);
        if (!k || !editing) return;
        e.preventDefault(); e.stopPropagation();
        closeEdit(k === "save");
      });
      if (c && typeof c.focus === "function") c.focus();
    }

    /** Put the edited node back on its own screen. A save is refused, in the office's words, on an emptied required box. */
    function closeEdit(saving) {
      if (!editing) return true;
      const { name, node, home, next, before } = editing;
      if (saving) {
        const missing = missingHere(form, declared, name);
        if (missing.length) { showError(missing[0].defect, missing[0].hint); return false; }
      } else {
        const c = controlOf(node);
        if (c) c.value = before;
      }
      home.insertBefore(node, next);
      editing = null;
      formError.hidden = true;
      paintNext();
      if (steps && steps[at] === "review") {
        paintReview();
        $(`[data-jf-edit="${CSS.escape(name)}"]`)?.focus();
      }
      return true;
    }

    nextBtn?.addEventListener("click", () => {
      if (!steps) return;
      const name = fieldOfStep(steps[at]);
      if (name) {
        // the same check the send makes, asked of this one box, in the office's words
        const missing = missingHere(form, declared, name);
        if (missing.length) return showMissing(missing);
      }
      go(at + 1);
    });
    backBtn?.addEventListener("click", () => {
      if (history.state && history.state.jf) history.back();
      else { history.replaceState(null, "", hashForStep(at - 1, steps)); show(at - 1); }
    });
    // Enter continues (Ctrl/⌘+Enter in a paragraph box); on review it sends.
    gateAct?.addEventListener("keydown", (e) => {
      if (!steps || editing || !enterContinues(e)) return;
      e.preventDefault();
      (steps[at] === "review" ? submitBtn : nextBtn).click();
    });
    // typing re-words the forward button, and clears a refusal the box no longer earns
    $("[data-form-host]")?.addEventListener("input", (e) => {
      const t = e.target;
      if (t && typeof t.setCustomValidity === "function") t.setCustomValidity("");
      paintNext();
    });
    window.addEventListener("popstate", () => { if (steps && !gateAct.hidden) show(stepFromHash(location.hash, steps)); });

    // ── sending ───────────────────────────────────────────────────────────────

    const submitBtn = $("[data-submit]");
    const formError = $("[data-form-error]");
    const status = $("[data-status]");

    function setStatus(msg) {
      if (!msg) { status.hidden = true; status.textContent = ""; return; }
      status.hidden = false; status.textContent = msg;
    }

    /**
     * A required box left empty, shown in the OFFICE'S OWN WORDS and in the same
     * slot the office's own refusal uses (POS-188). Two doors, one sentence, one
     * place to look.
     *
     * Native validity as well as the slot: `setCustomValidity` puts the same
     * sentence on the control, and `reportValidity` opens the browser's own
     * bubble on the first empty one. The page has no <form> element to submit,
     * so nothing fires this for us; it is called by hand, on the press.
     */
    function showMissing(missing) {
      const first = missing[0];
      // take the reader to the box the refusal names, then say it there
      const there = steps ? stepOfField(first.name, steps) : null;
      if (there != null && there !== at) go(there);
      showError(first.defect, first.hint);
      for (const m of missing) {
        const c = controlOf(form.fields[m.name]?.node);
        if (c && typeof c.setCustomValidity === "function") { try { c.setCustomValidity(m.defect); } catch { /* not every control carries one */ } }
      }
      const firstControl = controlOf(form.fields[first.name]?.node);
      if (firstControl && typeof firstControl.reportValidity === "function") { try { firstControl.reportValidity(); } catch { /* as above */ } }
      else if (firstControl && typeof firstControl.focus === "function") firstControl.focus();
    }

    function showError(defect, hint) {
      // UNHIDDEN FIRST, THEN FILLED, and the order is the whole reason the slot
      // carries `role="alert"` at all. An assertive live region announces a
      // MUTATION INSIDE ITSELF, and an element that is `hidden` is out of the
      // accessibility tree entirely — so filling it while hidden and revealing it
      // afterwards can land as no announcement at all. Revealing the empty region
      // first makes the write the mutation. Both happen in one task, so nothing
      // paints in between and no reader sees an empty box.
      formError.hidden = false;
      while (formError.firstChild) formError.removeChild(formError.firstChild);
      const b = document.createElement("b"); b.textContent = defect; formError.appendChild(b);
      if (hint) { const s = document.createElement("span"); s.textContent = " — " + hint; formError.appendChild(s); }
      formError.hidden = false;
      // on a long review the slot can sit below the fold; bring it to the reader
      if (typeof formError.scrollIntoView === "function") formError.scrollIntoView({ block: "center" });
    }

    submitBtn?.addEventListener("click", async () => {
      if (sending || !form || !act) return;
      const tok = getTok();
      if (!tokenIsFresh(tok)) return signedOut("Your sign-in expired before this was sent. Nothing was sent.");

      formError.hidden = true;
      sending = true; submitBtn.disabled = true; setStatus("asking the office…");
      arm(tok);

      let res;
      try {
        res = await submitAct({ callTool: (name, args) => window.MCPProto.callTool(name, args), act, form, fields: declared });
      } catch (e) {
        sending = false; submitBtn.disabled = false; setStatus("");
        return showError("the office didn't answer", "couldn't reach the town door — check your connection and try again. Nothing was sent.");
      }
      sending = false; submitBtn.disabled = false; setStatus("");

      if (!res.sent && res.missing && res.missing.length) return showMissing(res.missing);
      if (!res.sent) return showError("this page could not read one of the boxes", res.errors.join("; "));

      const said = replyShape(res.entry);
      if (!said.ok) return showError(said.defect, said.hint);
      showReply(said);
    });

    function showReply(said) {
      const prose = $("[data-reply-prose]");
      while (prose.firstChild) prose.removeChild(prose.firstChild);
      for (const p of said.prose) {
        const el = document.createElement("p");
        el.textContent = p;
        prose.appendChild(el);
      }

      if (said.credential) {
        put("[data-reply-credential-value]", said.credential);
        put("[data-reply-credential-note]", said.credentialNote);
        $("[data-reply-credential]").hidden = false;
      }

      const facts = $("[data-reply-facts]");
      while (facts.firstChild) facts.removeChild(facts.firstChild);
      const rows = said.facts.concat(said.links.map((l) => [l.label, l.href]));
      for (const [k, v] of rows) {
        const wrap = document.createElement("div");
        const dt = document.createElement("dt"); dt.textContent = k.replace(/_/g, " ");
        const dd = document.createElement("dd");
        if (/^https?:\/\//.test(v)) {
          const a = document.createElement("a");
          a.href = v; a.textContent = v; a.rel = "noopener"; a.target = "_blank";
          dd.appendChild(a);
        } else dd.textContent = v;
        wrap.appendChild(dt); wrap.appendChild(dd);
        facts.appendChild(wrap);
      }

      put("[data-reply-whole]", JSON.stringify(said.whole, null, 2));
      only(gateReply);
      window.scrollTo({ top: 0, behavior: "smooth" });
    }

    $("[data-reply-credential-copy]")?.addEventListener("click", (e) => {
      const btn = e.currentTarget;
      const value = $("[data-reply-credential-value]").textContent;
      navigator.clipboard.writeText(value).then(() => {
        btn.textContent = "copied"; btn.classList.add("copied");
        setTimeout(() => { btn.textContent = "copy"; btn.classList.remove("copied"); }, 1600);
      }).catch(() => { btn.textContent = "press ⌘/Ctrl-C"; });
    });

    boot();
  </script>

  <style>
    /* the funnel's column (src/styles/join-funnel.css): centred, 720 wide, a
       16px gutter of its own on a phone */
    .movein { max-width: 720px; margin: 0 auto; padding: 0 16px 2em; box-sizing: border-box; }
    .movein-head { text-align: center; margin: 0 0 1.7em; }
    .movein-head h1 {
      margin: 0;
      font-size: clamp(1.9rem, 4.6vw, 2.6rem);
      color: var(--pm-gold-bright);
      text-shadow: 0 0 34px rgba(232, 196, 139, 0.35);
    }
    .movein-head .tag {
      margin: 0.4em 0 1em;
      font-family: var(--pm-mono); font-size: 0.72rem; letter-spacing: 0.12em;
      color: rgba(232, 196, 139, 0.8);
    }
    .movein-head .how { max-width: 56ch; margin: 0 auto; color: #cdc2ab; font-size: 0.97rem; line-height: 1.6; }
    .movein-head .how b { color: var(--pm-gold); }

    .movein-card { padding: 1.6em 1.7em; }
    .movein-card + .movein-card { margin-top: 1.2em; }
    .movein-card h2 { margin: 0 0 0.6em; font-size: 1.35rem; color: var(--pm-ink); line-height: 1.35; }
    .movein-card p { color: var(--pm-ink); line-height: 1.6; }
    .movein-card p b { color: var(--pm-wax); }
    .movein-card a { color: var(--pm-accent); }

    .gate .jf-sub b { color: var(--pm-gold); }
    .asking-line { margin: 0; font-family: var(--pm-mono); font-size: 0.85rem; color: var(--pm-ink-soft) !important; }

    /* the act's own name, in the door's spelling */
    .act-name { margin: 0 0 0.5em; }
    .act-name span {
      font-family: var(--pm-mono); font-size: 0.68rem; letter-spacing: 0.14em; text-transform: uppercase;
      color: var(--pm-accent); border: 1px solid rgba(164, 99, 42, 0.35);
      border-radius: 999px; padding: 3px 10px;
    }
    /* THE ACT, on night: one screen tall, like every funnel screen */
    .jf-act {
      min-height: calc(100svh - 150px);
      display: flex; flex-direction: column; justify-content: center;
      padding: 1.5em 0 3em; box-sizing: border-box;
    }
    .jf-act:focus { outline: none; }
    /* display:flex above outranks the `hidden` attribute, which left the whole
       act standing over the receipt after a send; hidden means gone */
    .jf-act[hidden] { display: none; }
    .jf-act [hidden] { display: none !important; }
    /* the door's sentence is a sentence, not a two-word question */
    .jf-q-long { font-size: clamp(1.6rem, 3.6vw, 2.3rem); }
    .act-name span { color: var(--pm-gold); border-color: rgba(232, 196, 139, 0.4); }
    .standing b { font-family: var(--pm-mono); font-size: 0.9em; color: var(--pm-gold); font-weight: 400; }
    .degraded { padding-left: 0.9em; border-left: 3px solid rgba(232, 196, 139, 0.4); }

    .form-error {
      margin: 1.2em 0 0; padding: 0.75em 0.95em; max-width: 60ch;
      border-radius: 8px; background: rgba(156, 63, 46, 0.22);
      border: 1px solid rgba(214, 120, 96, 0.45);
      color: #f0dcc4; font-size: 0.95rem; line-height: 1.5;
    }
    .form-error b { color: #f5b3a0; }

    .pm-btn.send:disabled { opacity: 0.55; cursor: default; }
    .send-status { margin: 0; font-family: var(--pm-mono); font-size: 0.85rem; color: #b9ad95; }
    .foot { margin: 1.1em 0 0; font-size: 0.85rem; color: var(--pm-ink-soft) !important; }

    /* the door's own lines, wherever they are shown */
    .door-next { margin: 2.2em 0 0; }
    .door-next summary {
      cursor: pointer; font-family: var(--pm-mono); font-size: 0.72rem;
      letter-spacing: 0.1em; text-transform: uppercase; color: rgba(232, 196, 139, 0.7);
    }
    .jf-act .door-next :global(li) { color: #cdc2ab; }
    .door-next ul, .door-lines { margin: 0.8em 0 0; padding-left: 1.2em; display: grid; gap: 0.55em; }
    /* :global from here down wherever the node is BUILT BY THE SCRIPT. Astro's
       scoping stamps a cid attribute on the elements in this template, and a
       node created at runtime has none — so a plain `.door-next li` compiles to
       `li[cid]` and matches nothing this page ever draws. Every list item,
       paragraph and row below arrives from the door, so every one of them is
       global. (The generated FORM's own nodes are styled by
       src/styles/join-move-in-form.css, which is a plain import and therefore
       global already.) */
    .door-next :global(li), .door-lines :global(li) {
      color: var(--pm-ink); font-size: 0.9rem; line-height: 1.55;
      overflow-wrap: anywhere;
    }

    /* the reply */
    .receipt-head { display: flex; align-items: center; gap: 0.7em; margin: 0 0 1em; }
    .receipt-art { flex: 0 0 auto; }
    .receipt-art :global(svg) { display: block; }
    .receipt-head h2 { margin: 0; }
    .reply-prose :global(p) { margin: 0 0 1em; color: var(--pm-ink); line-height: 1.6; }
    .reply-facts { margin: 1.2em 0 0; display: grid; gap: 0.5em; }
    .reply-facts :global(div) { display: flex; gap: 0.8em; flex-wrap: wrap; align-items: baseline; }
    .reply-facts :global(dt) {
      font-family: var(--pm-mono); font-size: 0.68rem; letter-spacing: 0.12em; text-transform: uppercase;
      color: var(--pm-ink-soft); min-width: 11em;
    }
    .reply-facts :global(dd) { margin: 0; color: var(--pm-ink); font-size: 0.92rem; overflow-wrap: anywhere; }
    .reply-facts :global(dd a) { color: var(--pm-accent); }

    .reply-credential {
      margin: 1.3em 0 0; padding: 0.9em 1em;
      border: 1px dashed rgba(156, 63, 46, 0.55); border-radius: 9px;
      background: rgba(156, 63, 46, 0.06);
    }
    .cred-label {
      margin: 0 0 0.6em !important;
      font-family: var(--pm-mono); font-size: 0.68rem; letter-spacing: 0.13em; text-transform: uppercase;
      color: var(--pm-wax) !important;
    }
    .cred-row { display: flex; gap: 0.6em; align-items: center; flex-wrap: wrap; }
    .cred-row code {
      font-family: var(--pm-mono); font-size: 0.85rem; color: var(--pm-ink);
      background: rgba(255, 252, 243, 0.9); border: 1px solid rgba(90, 62, 27, 0.35);
      border-radius: 6px; padding: 0.4em 0.6em; overflow-wrap: anywhere;
    }
    .cred-note { margin: 0.7em 0 0 !important; font-size: 0.88rem; color: var(--pm-ink-soft) !important; }
    .mini-btn {
      font-family: var(--pm-mono); font-size: 0.66rem; letter-spacing: 0.06em;
      color: var(--pm-accent); background: rgba(164, 99, 42, 0.08);
      border: 1px solid rgba(164, 99, 42, 0.35); border-radius: 999px;
      padding: 4px 11px; cursor: pointer;
    }
    .mini-btn.copied { color: #3a7d3a; border-color: rgba(58, 125, 58, 0.55); }

    .reply-whole { margin: 1.4em 0 0; }
    .reply-whole summary {
      cursor: pointer; font-family: var(--pm-mono); font-size: 0.72rem;
      letter-spacing: 0.1em; text-transform: uppercase; color: var(--pm-ink-soft);
    }
    .reply-whole pre {
      margin: 0.8em 0 0; padding: 0.8em; max-height: 22em; overflow: auto;
      font-family: var(--pm-mono); font-size: 0.78rem; line-height: 1.5;
      color: var(--pm-ink); background: rgba(255, 252, 243, 0.75);
      border: 1px solid rgba(90, 62, 27, 0.3); border-radius: 8px;
      white-space: pre-wrap; overflow-wrap: anywhere;
    }
    .reply-foot { margin: 1.6em 0 0; }

    /* the machinery is never seen and never measured */
    .pm-mcp-machinery { display: none !important; }

    @media (max-width: 560px) {
      .movein-card { padding: 1.3em 1.1em; }
      .reply-facts dt { min-width: 0; }
    }
  </style>
</PostmarkLayout>
