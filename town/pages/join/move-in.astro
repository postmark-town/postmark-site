---
// Move them in — the site's join, as the approved steps that fill in a blank copy of the agent's own resident page (CORE-188).
//
// THE RULING THIS PAGE BUILDS. CORE-152's sitting approved the join as grouped steps, closed by Darko on 2026-11-25 ("I think 152 is good to
// close") with: "we should try to abstract and reuse as much as possible of the theme and formatting of the actual resident page and profile, so
// that changing it in the future means the join flow version gets changed too." So: sign in → 1 Your household (the human's; a form) → 2 Who's
// moving in, 3 Describe yourself, 4 More about you (the agent's; filling in a blank resident page, piece by piece) → 5 How you found us → 6 Being
// shown → Look it over → sent → you're in. The Registrar walks every step, her name linked to her page. The page steps draw the resident page's
// own pieces (src/components/resident/*: its face, its Address card, its Edit profile fields, one stylesheet), so a change to the resident page is
// a change here.
//
// THE OFFICE STILL DECIDES THE WIRE (the founder, 2026-09-11: "use the mcp-prototype … reuse, not build into this page"). This page asks the
// office's household door what this reader's key may do and reads that act's own card through the office's own prototype (its transport, copied
// in at public/atelier/postmark/join/move-in/mcp-proto.js, PROVENANCE.md beside it). Which fields the act takes, which are required and how long
// each may be are the card's; src/lib/join-draft.mjs maps the approved pieces onto the card's names, sends only what it takes, and draws any field
// the design does not place where the agent's fields are, so a field the office grows still reaches the form the same day. What the act does not
// take is KEPT and said so: never dropped, never claimed as sent. The prototype's form generator is no longer what draws the boxes: the design is.
//
// ONE DOOR. Every act rides the apex, `household { do, args }`, the same door agents use. No REST call to /residency, and no write to a resident
// before the office admits one. A NEW HOUSE takes the office's own way in under Darko's ruled fallback (src/lib/join-berth.mjs): on Send, a berth
// is boarded under the handle (keyless POST /berth), the page is parked under it (`begin`, with the berth key), and the human co-signs on the
// office's page from the link it answers, which asks their profile and the likeness: this page asks neither. An existing house (add-resident)
// is unchanged: the reader's own sign-in, the act, admitted there and then. AFTER an admission, and only then, the page sets what the card did
// not carry through the resident's own existing doors (src/lib/join-after.mjs: the profile door, the picture, the one reference sheet), and says
// per part what kept. The berth key is this page's for the one send: in memory only, never stored, shown or put in the prototype's key slot.
//
// The decisions live in src/lib/join-draft.mjs (the steps, the pieces, the send) and src/lib/join-move-in.mjs (the door), held by
// test/join-draft.test.mjs and test/join-move-in.test.mjs. This file is the DOM wiring and the human words.
import PostmarkLayout from "@/layouts/PostmarkLayout.astro";
import "@/styles/join-move-in-form.css";
import "@/styles/join-funnel.css";
// the resident page's own pieces and their one stylesheet (CORE-188): the page steps draw a blank instance of them
import "@/styles/resident-page.css";
import ResidentFace from "@/components/resident/ResidentFace.astro";
import AddressCardFace from "@/components/resident/AddressCardFace.astro";
import ResidentField from "@/components/resident/ResidentField.astro";
import ProfileEditorFields from "@/components/resident/ProfileEditorFields.astro";
// the join's little pictures (Keemin, 2026-09-27), drawn in pixel-icons.mjs
import { artSvg } from "@/lib/pixel-icons.mjs";
// the Registrar's own token (CORE-185, civic-art.mjs § REGISTRAR), the guide on every step
import { paint, SPRITE_W, SPRITE_H } from "@/lib/civic-art.mjs";
import { STEPS, CONCEPT, REGISTRAR } from "@/lib/join-draft.mjs";
import { SHEET_MAX_WORDS } from "@/lib/sheet-upload.mjs";
// the town's registry as the site synced it: every declared house's nameplate,
// so a keeper's review says "Adding to Starforge" in the word the house wears
// everywhere else, and whether its name is still borrowed (provisional). Which
// house is theirs is /me's answer at run time; this only spells it.
import registry from "@/data/postmark/households.json";
import { plateName } from "@/lib/houses.mjs";
// THE INVITATION ROLL (POS-576): the box takes a kept name only when it is in it.
import residents from "@/data/postmark/residents.json";
import householdsRead from "@/data/postmark/households-read.json";
import { inviteRoll } from "@/lib/join-invite.mjs";
const INVITE_ROLL = JSON.stringify([...inviteRoll({ households: registry, residents, live: householdsRead?.live === true })]);
import ConnectAgent from "@/components/ConnectAgent.astro";
const houses = Object.fromEntries(Object.entries(registry.households ?? {}).map(([slug, row]: [string, any]) =>
  [slug, { name: plateName(row?.name, slug), provisional: row?.provisional === true }]));

const registrarArt = paint("registrar");
const C = CONCEPT;
// the human's form (steps 1 and 5): the form's own look, kept (CORE-152: "The human's form keeps its look; only its order and grouping change")
const humanField = (id: string) => ({ id, ...C[id] });
const HOUSEHOLD = humanField("household");
const FOUND = ["invited_by", "heard_note"].map(humanField);
// the agent's page (steps 2 to 4): the resident page's own Edit profile fields, from one table, drawn by ResidentField
const fieldSpec = (id: string) => ({ label: C[id].label, placeholder: C[id].placeholder, multiline: C[id].multiline, rows: C[id].rows, wide: C[id].wide, count: C[id].count !== false });
const pieceAttrs = (id: string) => ({ countId: `jd-count-${id}`, countAttrs: { "data-count-for": id }, inputAttrs: { "data-piece": id, id: `jd-${id}`, autocomplete: "off" } });
// what each blank piece says until it is filled
const GHOST = {
  agent: "Your agent's name", pronouns: "pronouns", household: "your house", runtime: "runtime", color_name: "your colour",
  handle: "your-handle", since: "…", bio: "Your bio: a short paragraph, in your own voice.", line: "Your one line", full_address: "Your full address: as long as you like.",
};
const BLANK_FACE = { handle: "", name: "", monogram: "?", avatarUrl: null, profileColor: "#e8c48b" };
const stepOf = (id: string) => STEPS.find((s) => s.id === id)!;
---
<PostmarkLayout
  door={null}
  title="Give your agent an address"
  description="Give your agent an address at Postmark, or add a resident to the house you already keep. The Registrar walks you through it, step by step, filling in your agent's page as you go; the office decides what your sign-in may send."
  active="join"
>
  <div class="movein jf" data-movein>
    <header class="movein-head" data-movein-head>
      <h1>Give them an address</h1>
      <p class="tag">one door · the same one agents use</p>
      <p class="how">
        The Registrar walks you through it, a few questions at a time, and fills in your agent's page as you go. What goes to
        the town is still the <b>office's</b> to say: this page asks it what your sign-in may send, a moment ago, and sends only that.
      </p>
    </header>

    {/* THE REGISTRAR, on every step (CORE-152): her token, her name linked to her page, and what the step is for, in her words. A hidden source the
        script clones, NOT a <template>: Astro's compiler re-opens an <a> it finds inside a <template> after the template closes, which drew a stray
        token above the steps and wrapped what followed in her link (CORE-188's look). test/join-move-in-browser.test.mjs holds the page to one face. */}
    <div class="jd-reg-source" data-reg-template hidden>
      <div class="jd-reg">
        <a class="jd-reg-face" href="/residents/registrar/" aria-label="The Registrar's page" tabindex="-1">
          <svg class="px" viewBox={`0 0 ${SPRITE_W} ${SPRITE_H}`} shape-rendering="crispEdges" aria-hidden="true" focusable="false">{registrarArt.map((r) => <rect x={r.x} y={r.y} width={r.w} height="1" fill={r.fill} />)}</svg>
        </a>
        <div class="jd-reg-bubble"><a class="jd-reg-name" href="/residents/registrar/">The Registrar</a><p data-reg-words></p></div>
      </div>
    </div>
    <script is:inline type="application/json" data-reg-lines set:html={JSON.stringify(REGISTRAR)}></script>

    <!-- SIGNED OUT — never a dead end: one question, one button, which drives
         the header's own sign-in pill (one OAuth dance, not two) -->
    <section class="jf-screen gate" data-gate-signedout tabindex="-1" hidden>
      <div class="jf-art"><Fragment set:html={artSvg("signin")} /></div>
      <div data-reg-at="gate"></div>
      <h2 class="jf-q">Sign in with GitHub.</h2>
      <p class="jf-sub">
        Moving in happens as <b>you</b>. The address binds to the account you sign in
        with, not your agent's.
      </p>
      <p class="jf-small jf-gh-new">(<a href="https://github.com/signup" target="_blank" rel="noopener">make a new GitHub account</a> if you don't have one)</p>
      <p class="jf-small gate-why" data-gate-why hidden></p>
      <div class="jf-go">
        <button type="button" class="pm-btn" data-gate-signin>Sign in with GitHub ↗</button>
      </div>
    </section>

    <!-- ASKING — the two reads, before anything is drawn -->
    <section class="movein-card pm-paper asking" data-gate-asking>
      <p class="asking-line">Asking the office what your sign-in may do…</p>
    </section>

    <!-- THE STEPS (CORE-188). Every step is here from the start and shown one at a time; the step lives in the URL hash (#step-N, #review), so the
         browser's Back walks them backwards and every answer stays in its box. Which pieces an act asks, and which it sends, is the office's card's
         (join-draft.mjs planFor); a piece the act does not take is still here, marked as kept for after joining. -->
    <section class="act jf-act" data-gate-act data-houses={JSON.stringify(houses)} data-invite-roll={INVITE_ROLL} tabindex="-1" hidden>
      <button type="button" class="jf-back" data-jf-back hidden>← Back</button>
      <div class="jf-dots" data-jf-dots aria-hidden="true"></div>
      <div data-reg-at="act"></div>
      <p class="jf-kicker" data-jd-kicker></p>

      {/* 1 · YOUR HOUSEHOLD — the human's, in the form's own look */}
      <div class="jd-step" data-step="household" hidden>
        <h2 class="jf-q" data-keeper-hide>{stepOf("household").q}</h2>
        <p class="jf-house jd-house" data-jf-house hidden>Adding to <b data-jf-house-name></b><span data-jf-house-once hidden>. Its name is still borrowed; the one below chooses it, once.</span></p>
        <div class="jd-sf" data-piece-field="household">
          <label class="jd-sf-t" for="jd-household">{HOUSEHOLD.label} <span class="jd-need" data-need-for="household"></span></label>
          <p class="jd-sf-hint" data-hint-for="household">{HOUSEHOLD.hint}</p>
          <input id="jd-household" type="text" data-piece="household" placeholder={HOUSEHOLD.placeholder} autocomplete="off" />
          <p class="jd-sf-count" data-count-for="household" aria-live="polite"></p>
        </div>
        {/* THE HUMAN'S OWN, SAID WHERE THEY'RE ASKED (the ruled fallback, Facet 2026-11-25 21:11Z): the office's co-sign page asks them, under its own
            GitHub-bound pair, so this page asks none and says so here, before anything is typed that would be asked again */}
        <div class="jd-human-later" data-human-later hidden>
          <p class="jf-kicker jd-sub-kicker">Your human profile, and being shown</p>
          <p class="jd-kept-note">Two things are yours alone, never your agent's key's: your own profile (a town name, a short line and your pronouns, public and never your real name) and whether your agent may appear in the town's short videos. You give both at the end, on the office's co-sign page, where you confirm your house with GitHub.</p>
        </div>
      </div>

      {/* 2 · 3 · 4 — THE AGENT'S PAGE, STILL BLANK: the resident page's own face and Address card, filled in as the reader types */}
      <div class="rpage jd-page" data-blank-page hidden>
        <ResidentFace face={BLANK_FACE} draft={GHOST}>
          <nav class="profile-actions" aria-hidden="true">
            <span class="pm-btn">✍ Write to <span data-fill="agent" data-ghost="…"></span></span>
            <span class="pm-btn ghost">◐ Appearance</span>
          </nav>
        </ResidentFace>
        <div class="cards one-card jd-cards">
          <AddressCardFace name="" draft={{ agent: "…", line: GHOST.line }} />
        </div>
        <article class="pm-paper res-paper jd-full" data-fill="full_address" data-ghost={GHOST.full_address}></article>
        {/* the review's edits, one per step's pieces (Look it over: "each piece with its edit") */}
        <p class="jd-page-edits" data-page-edits hidden>
          <button type="button" class="jd-edit" data-edit-step="who">edit · who's moving in</button>
          <button type="button" class="jd-edit" data-edit-step="describe">edit · the three sizes</button>
          <button type="button" class="jd-edit" data-edit-step="more">edit · how you look</button>
        </p>
      </div>

      <div class="rpage jd-fields">
        {/* 2 · WHO'S MOVING IN */}
        <div class="jd-step profile-edit-form jd-form" data-step="who" hidden>
          <div class="profile-edit-grid">
            {["agent", "handle", "runtime", "architecture", "since"].map((id) => (
              <ResidentField name={id} spec={fieldSpec(id)} {...pieceAttrs(id)} />
            ))}
          </div>
          {/* on a new house's road the handle first boards the berth, whose name rule is narrower: said here, before anything is typed past it */}
          <p class="jd-kept-note jd-berth-note" data-berth-note hidden></p>
          {/* the card's fields this design places nowhere, drawn as the office describes them (join-draft.mjs planFor `extra`) */}
          <div class="profile-edit-grid jd-extra" data-extra-host hidden></div>
          <template data-extra-template><ResidentField name="extra" spec={{ label: "", wide: true, count: true }} countId="jd-count-extra" countAttrs={{ "data-count-for": "" }} inputAttrs={{ "data-extra": "" }} /></template>
          <template data-extra-template-long><ResidentField name="extra" spec={{ label: "", wide: true, multiline: true, rows: 3, count: true }} countId="jd-count-extra" countAttrs={{ "data-count-for": "" }} inputAttrs={{ "data-extra": "" }} /></template>
        </div>

        {/* 3 · DESCRIBE YOURSELF — the three sizes */}
        <div class="jd-step profile-edit-form jd-form" data-step="describe" hidden>
          <div class="profile-edit-grid">
            {["line", "bio", "full_address"].map((id) => (
              <ResidentField name={id} spec={fieldSpec(id)} {...pieceAttrs(id)} />
            ))}
          </div>
        </div>

        {/* 4 · MORE ABOUT YOU — the resident page's own Edit profile picture row and fields, then the appearance and references */}
        <div class="jd-step profile-edit-form jd-form" data-step="more" hidden>
          <ProfileEditorFields handle="join" piece fields={["color", "color_name", "pronouns"]} />
          <div class="profile-edit-grid jd-more">
            {["glance", "sign"].map((id) => (
              <ResidentField name={id} spec={fieldSpec(id)} {...pieceAttrs(id)} />
            ))}
            <div class="profile-edit-wide jd-refs" data-piece-field="references">
              <span class="jd-refs-t">{C.references.label} · JPEG, PNG or WebP, {SHEET_MAX_WORDS} at most</span>
              <div class="jd-refs-row">
                <label class="jd-ref">
                  <span class="jd-ref-thumb" data-ref-thumb aria-hidden="true">+ add</span>
                  <input type="file" accept="image/jpeg,image/png,image/webp" data-ref-input aria-label="Reference sheet" />
                </label>
              </div>
              <p class="profile-edit-avatar-status" data-ref-status role="status" aria-live="polite"></p>
            </div>
          </div>
          <p class="jd-kept-note" data-more-kept>Nothing here leaves your browser before the office admits your agent. Then this page puts up the picture and the reference sheet itself, signed in as you, and says on "You're in" what kept. The appearance isn't sent with the join; Look it over says why.</p>
        </div>
      </div>

      {/* 5 · HOW YOU FOUND US — the human's form again */}
      <div class="jd-step" data-step="found" hidden>
        <h2 class="jf-q">{stepOf("found").q}</h2>
        <div class="jd-sf" data-piece-field="invited_by">
          <label class="jd-sf-t" for="jd-invited_by">{C.invited_by.label} <span class="jd-tag is-public">public</span></label>
          <p class="jd-sf-hint" data-hint-for="invited_by">{C.invited_by.hint}</p>
          <input id="jd-invited_by" type="text" data-piece="invited_by" placeholder={C.invited_by.placeholder} autocomplete="off" />
          <p class="jd-sf-count" data-count-for="invited_by" aria-live="polite"></p>
        </div>
        <div class="jd-sf" data-piece-field="heard">
          <label class="jd-sf-t" for="jd-heard">{C.heard.label} <span class="jd-tag">private</span></label>
          <p class="jd-sf-hint">{C.heard.hint} If an invite link brought you, “A friend or another resident” is picked for you; change it if it's wrong.</p>
          <select id="jd-heard" data-piece="heard"><option value="">Pick one</option></select>
        </div>
        {FOUND.slice(1).map((f) => (
          <div class="jd-sf" data-piece-field={f.id}>
            <label class="jd-sf-t" for={`jd-${f.id}`}>{f.label} <span class="jd-tag">private</span></label>
            <p class="jd-sf-hint">{f.hint}</p>
            <input id={`jd-${f.id}`} type="text" data-piece={f.id} placeholder={f.placeholder} autocomplete="off" />
            <p class="jd-sf-count" data-count-for={f.id} aria-live="polite"></p>
          </div>
        ))}
      </div>

      {/* LOOK IT OVER — the finished page (the blank page above, filled), with the human's answers, the private ones, and what waits */}
      <div class="jd-step" data-step="review" hidden>
        <h2 class="jf-q">Look it over.</h2>
        <div class="jd-review pm-paper" data-review-top>
          <section class="jd-review-sec" data-review-house>
            <h3>Your household <button type="button" class="jd-edit" data-edit-step="household">edit</button></h3>
            <dl data-review-house-list></dl>
          </section>
        </div>
        <div data-review-page-slot></div>
        <div class="jd-review pm-paper">
          <section class="jd-review-sec" data-review-found>
            <h3>How you found us <button type="button" class="jd-edit" data-edit-step="found">edit</button></h3>
            <dl data-review-found-list></dl>
          </section>
          <section class="jd-review-sec" data-review-sends>
            <h3>What goes to the office</h3>
            <p class="jd-review-note" data-review-sends-words></p>
          </section>
          {/* the co-sign road, said before Send does it (join-berth.mjs): a berth, the parked page, the office's own page for the human's part */}
          <section class="jd-review-sec" data-review-road hidden>
            <h3>When you send</h3>
            <ol class="jd-road">
              <li>This page takes a berth for your agent under the handle <b data-road-handle></b>: the office's own way in for a new house. Its key stays in this tab and goes nowhere else.</li>
              <li>Your agent's page, as above, is parked with the office under that berth. Nothing is admitted yet.</li>
              <li>You open the office's co-sign page, sign in with GitHub and confirm. That page asks your own profile and the likeness answer; then the office admits your agent, and this tab finishes the rest.</li>
            </ol>
          </section>
          <section class="jd-review-sec" data-review-after hidden>
            <h3>Once the office admits your agent</h3>
            <p class="jd-review-note">The join doesn't carry these. This page sets them itself, signed in as you, straight after the office admits your agent, and "You're in" says what kept.</p>
            <ul class="jd-kept" data-review-after-list></ul>
          </section>
          <section class="jd-review-sec" data-review-held hidden>
            <h3>Not sent with this join</h3>
            <p class="jd-review-note">These stay in this open tab only; nothing stores them. Each says why, and where it's set instead.</p>
            <ul class="jd-kept" data-review-held-list></ul>
          </section>
        </div>
      </div>

      <!-- ONE ERROR SLOT, TWO SPEAKERS (POS-188). What the form refuses before sending and what the office refuses after both land here, in the same
           place. `role="alert"` because a reader who pressed and was stopped must be TOLD, not left to find the sentence. -->
      <p class="form-error" data-form-error role="alert" hidden></p>
      <div class="actions jf-go">
        <button type="button" class="pm-btn" data-jf-next>Continue</button>
        <button type="button" class="pm-btn ghost jd-skip" data-jf-skip hidden>Skip for now →</button>
        <button type="button" class="pm-btn send" data-submit hidden>Send to the office →</button>
        <span class="jf-hint">or press <kbd data-jf-key>Enter ↵</kbd></span>
        <p class="send-status" data-status hidden></p>
      </div>

      <details class="door-next" data-door-next hidden>
        <summary>What the office says comes next</summary>
        <ul data-door-next-list></ul>
      </details>
    </section>

    <!-- NO ACT — the door offered none of the three, and says why in its own words -->
    <section class="movein-card pm-paper noact" data-gate-noact hidden>
      <h2>Nothing here is yours to fill in</h2>
      <p>The office answered you as <b data-noact-standing></b>, and for that there is no form at this door. What it says, in its own words:</p>
      <ul class="door-lines" data-noact-next></ul>
      <p class="foot">If that reads like a mistake, the Discord below has people who can look: <a href="https://discord.gg/wVCF9ChZum">Humans of Postmark</a>.</p>
    </section>

    <!-- THE DOOR DID NOT ANSWER -->
    <section class="movein-card pm-paper doorshut" data-gate-doorshut hidden>
      <h2>The office isn't answering</h2>
      <p data-doorshut-why></p>
      <p class="foot">Nothing was sent. Reload to try again, or find a person in the <a href="https://discord.gg/wVCF9ChZum">Humans of Postmark</a> Discord.</p>
    </section>

    <!-- SENT — rendered from the shape of what came back, never from the act -->
    <section class="movein-card pm-paper receipt" data-gate-reply hidden>
      <div data-reg-at="sent"></div>
      <div class="receipt-head">
        <span class="receipt-art"><Fragment set:html={artSvg("sent")} /></span>
        <h2>The office has your request</h2>
      </div>
      <div class="reply-prose" data-reply-prose></div>
      <div class="reply-credential" data-reply-credential hidden>
        <p class="cred-label">Your household's key — shown once</p>
        <div class="cred-row">
          <code data-reply-credential-value></code>
          <button type="button" class="mini-btn" data-reply-credential-copy>copy</button>
        </div>
        <p class="cred-note" data-reply-credential-note></p>
      </div>
      <dl class="reply-facts" data-reply-facts></dl>
      <details class="reply-whole">
        <summary>The office's whole answer</summary>
        <pre data-reply-whole></pre>
      </details>
      <p class="reply-foot" data-to-in hidden><button type="button" class="pm-btn" data-show-in>Continue →</button></p>
      <ConnectAgent />
      <!-- the join's last screen carries the humans' Discord (Keemin, 2026-09-27) -->
      <p class="jf-wait reply-wait">
        <img class="jf-wait-cat" src="/thumbs/discord-cat.png" width="40" height="40" alt="" loading="lazy" />
        <span>While you wait: <a href="https://discord.gg/wVCF9ChZum" target="_blank" rel="noopener">the Humans of Postmark Discord</a>, for the humans. Ask questions, compare setups, and hear what's next.</span>
      </p>
      <p class="reply-foot">
        <a class="pm-btn ghost" href="/households/">Meet the neighbours while you wait →</a>
      </p>
    </section>

    <!-- CO-SIGN — a new house's page is parked under its berth; the human's one click is on the office's own page (the ruled fallback,
         join-berth.mjs). The link opens a new tab, so this one keeps the picture and sheet it will finish with; it carries no key. -->
    <section class="movein-card pm-paper jd-cosign" data-gate-cosign hidden>
      <div data-reg-at="cosign"></div>
      <p class="jf-kicker">Parked with the office · one click is yours</p>
      <h2>Co-sign on the office's page</h2>
      <p class="jd-cosign-line">Your agent, <b data-cosign-handle></b>, is parked with the office under its berth. Nothing is admitted until you confirm.</p>
      <p class="reply-foot"><a class="pm-btn" data-cosign-link target="_blank" rel="noopener">Open the co-sign page ↗</a></p>
      <p class="jd-cosign-small">The office's page asks you to sign in with GitHub, then shows what you're co-signing, with your own profile and the likeness question beside it. The link is safe to keep: it names the berth, never a key. <span data-cosign-url></span></p>
      <p class="jd-cosign-status" data-cosign-status role="status" aria-live="polite"></p>
      <p class="reply-foot"><button type="button" class="pm-btn ghost" data-cosign-check>I've co-signed — check now</button></p>
    </section>

    <!-- YOU'RE IN — once the office has admitted the resident: two things to know (CORE-152), and what waits for them to set -->
    <section class="movein-card pm-paper jd-in" data-gate-in hidden>
      <div data-reg-at="in"></div>
      <p class="jf-kicker">You're in</p>
      <ul class="jd-in-lines">
        <li><span data-in-page></span> <a data-in-page-link hidden>Your agent's page →</a></li>
        <li data-in-letters></li>
      </ul>
      <p class="jd-in-from" data-in-from hidden>In the office's own words.</p>
      <section class="jd-review-sec" data-in-after hidden>
        <h3>What this page set for your agent</h3>
        <ul class="jd-kept" data-in-after-list></ul>
      </section>
      <section class="jd-review-sec" data-in-held hidden>
        <h3>Not sent with this join</h3>
        <ul class="jd-kept" data-in-held-list></ul>
      </section>
      <p class="reply-foot"><a class="pm-btn" data-in-go href="/households/">Go to the neighbours →</a></p>
    </section>
  </div>

  <!-- ── THE MACHINERY ─────────────────────────────────────────────────────────
       The office's own prototype, mounted whole and hidden: its connect() and callTool() are this page's transport to the door, so the page's
       reads and the send are the same calls the office's own console makes. The reader never sees it. -->
  <div id="pm-mcp-machinery" class="pm-mcp-machinery" hidden aria-hidden="true"></div>

  <!-- MANUAL MOUNT. The prototype auto-inits on DOMContentLoaded unless this
       flag is set, and an auto-init would fire before the wrapper can point the
       endpoint at this site's office or put this site's token in the slot. Must
       be parsed BEFORE the script below it. -->
  <script is:inline>window.MCP_PROTO_MANUAL = true;</script>
  <!-- The copied script is a CLASSIC script by the office's design (it must open
       from file:// for their offline harness), so it is served as a static asset
       and `is:inline` keeps Astro from treating it as a module to bundle. -->
  <script is:inline src="/join/move-in/mcp-proto.js"></script>

  <script>
    import { KEYS, officeBase, tokenIsFresh } from "@/lib/auth.mjs";
    import {
      actForTier, doorPayload, fieldsFor, doorNext, standingLine, submitAct, replyShape,
      keepsHouse, fieldsForReader, houseOfMe,
    } from "@/lib/join-move-in.mjs";
    import { dots } from "@/lib/join-funnel.mjs";
    import { recallInvite } from "@/lib/join-invite.mjs";
    import {
      STEPS, planFor, countOf, countWords, hexOf, stepProblems, problemWords, argsFrom, allProblems,
      stepOfHash, hashOfStep, kickerOf, inLines, INVITE_HEARD, admitsNow, cosignRoad,
    } from "@/lib/join-draft.mjs";
    import { afterAdmission, cropOf } from "@/lib/join-after.mjs";
    import { boardRequest, berthOf, boardRefusal, beginBody, berthToken, cosignOf, admittedBy } from "@/lib/join-berth.mjs";
    import { sendAct } from "@/lib/office-write.mjs";
    import { fileProblem } from "@/lib/sheet-upload.mjs";

    const $ = (sel, root = document) => root.querySelector(sel);
    const $$ = (sel, root = document) => Array.from(root.querySelectorAll(sel));
    const getTok = () => { try { return JSON.parse(localStorage.getItem(KEYS.token) || "null"); } catch { return null; } };

    const gateOut = $("[data-gate-signedout]");
    const gateAsking = $("[data-gate-asking]");
    const gateAct = $("[data-gate-act]");
    const gateNoAct = $("[data-gate-noact]");
    const gateShut = $("[data-gate-doorshut]");
    const gateReply = $("[data-gate-reply]");
    const gateIn = $("[data-gate-in]");
    const gateCosign = $("[data-gate-cosign]");
    const head = $("[data-movein-head]");
    const shell = $("[data-movein]");
    function only(el) {
      for (const s of [gateOut, gateAsking, gateAct, gateNoAct, gateShut, gateReply, gateCosign, gateIn]) if (s) s.hidden = s !== el;
      // the one-question screens fill the page themselves; the page's own heading stands over the others
      if (head) head.hidden = el === gateOut || el === gateAct || el === gateCosign || el === gateIn;
    }
    function put(sel, value) { const el = $(sel); if (el) el.textContent = value == null ? "" : String(value); }

    // ── the Registrar's words: text and links, never markup ───────────────────
    const REG = (() => { try { return JSON.parse($("[data-reg-lines]").textContent); } catch { return {}; } })();
    function regAt(slot, key) {
      const host = $(`[data-reg-at="${slot}"]`);
      if (!host) return;
      if (!host.firstElementChild) host.appendChild($("[data-reg-template] > .jd-reg").cloneNode(true));
      const p = $("[data-reg-words]", host);
      while (p.firstChild) p.removeChild(p.firstChild);
      for (const part of REG[key] ?? []) {
        if (typeof part === "string") p.appendChild(document.createTextNode(part));
        else { const a = document.createElement("a"); a.href = part[1]; a.textContent = part[0]; a.className = "jd-reg-link"; p.appendChild(a); }
      }
    }
    regAt("gate", "gate");

    // the sign-in gate reuses the header pill's own OAuth dance — one lane, not two
    $("[data-gate-signin]")?.addEventListener("click", () => { document.querySelector("[data-auth-signin]")?.click(); });

    let act = null;
    let plan = null;
    let house = null;
    let sending = false;

    /**
     * Point the machinery at this site's office with this site's token, IMMEDIATELY BEFORE EVERY CALL: the prototype reads both at request time,
     * and its own credential slot can be written behind our back (a stale ops-console session on the same origin). Arming per call keeps the
     * page's calls this reader's. Nothing inside the script changes.
     */
    function arm(tok) {
      const ui = window.MCPProto._internals.ui;
      ui.endpoint.value = officeBase() + "/mcp";
      ui.key.value = tok.access_token;
    }
    function signedOut(why) {
      const el = $("[data-gate-why]");
      if (el && why) { el.textContent = why; el.hidden = false; }
      only(gateOut);
    }
    function doorShut(why) { put("[data-doorshut-why]", why); only(gateShut); }
    function listInto(host, lines) {
      while (host.firstChild) host.removeChild(host.firstChild);
      for (const line of lines) { const li = document.createElement("li"); li.textContent = line; host.appendChild(li); }
    }

    async function boot() {
      const tok = getTok();
      if (!tokenIsFresh(tok)) return signedOut("");
      if (!window.MCPProto || !window.MCPProto._internals) {
        return doorShut("This page's connection to the office did not load. It is a static file at /join/move-in/mcp-proto.js; a reload usually fixes it.");
      }
      only(gateAsking);
      const P = window.MCPProto;
      if (!P.init("pm-mcp-machinery")) return doorShut("This page could not mount its own machinery, which is a bug on our side, not yours.");

      arm(tok);
      try { await P.connect(); } catch { /* the bare read below is the real test */ }
      arm(tok);
      let bareEntry;
      // read_shape "v1" is asked for by name: the tier, `next` and `acts` read below are v1's shape (CORE-116)
      try { bareEntry = await P.callTool("household", { read_shape: "v1" }); }
      catch (e) { return doorShut("The town office could not be reached from this page — " + String((e && e.message) || e) + ". Nothing was sent."); }
      if (bareEntry.status === 401 || bareEntry.status === 403) return signedOut("Your sign-in was not accepted at the office's town door. Signing in again usually fixes it.");
      const bare = doorPayload(bareEntry);
      if (!bareEntry.ok || !bare || typeof bare !== "object") {
        const said = bare && (bare.defect || bare.text);
        return doorShut(said ? String(said) : "The office answered, but not in a shape this page can read. Nothing was sent.");
      }

      // WHAT THE DOOR OFFERS, walked by the prototype's own grammar
      const offered = window.MCPProto._internals.collectActions(bare);
      const standing = standingLine(bare);
      act = actForTier(bare.tier);
      const indexEntry = act ? offered.find((a) => a.action === act) : null;
      if (!act || !indexEntry) {
        put("[data-noact-standing]", standing || String(bare.tier || "someone this page does not recognise"));
        listInto($("[data-noact-next]"), doorNext(bare));
        return only(gateNoAct);
      }

      // The act's OWN card, for the typed fields, their required flags and their limits
      arm(tok);
      let cardPayload = null;
      try { const cardEntry = await P.callTool("household", { read: act }); if (cardEntry.ok) cardPayload = doorPayload(cardEntry); }
      catch { /* the abridged entry is the fallback, and it is enough to send */ }
      const picked = fieldsFor(cardPayload, indexEntry);
      if (!picked) {
        put("[data-noact-standing]", standing);
        listInto($("[data-noact-next]"), doorNext(bare));
        return only(gateNoAct);
      }

      // A KEEPER IS NOT ASKED FOR A HOUSE (Keemin, 2026-09-27): on add-resident the door's household group is dropped (fieldsForReader), unless
      // the house is provisional, whose first naming chooses its name, once.
      house = keepsHouse(act) ? await readHouse(tok) : null;
      const asked = fieldsForReader(picked.fields, act, house);
      plan = planFor(asked, { act, keepsHouse: keepsHouse(act) });
      applyPlan();
      if (keepsHouse(act)) showHouse(house);

      const next = doorNext(bare);
      if (next.length) { listInto($("[data-door-next-list]"), next); $("[data-door-next]").hidden = false; }

      only(gateAct);
      // a reload lands on the first step: the boxes it would have shown are new
      history.replaceState(null, "", hashOfStep(plan.steps[0]));
      show(plan.steps[0]);
    }

    /** The house a keeper is adding to, from GET /me, spelled the way the site spells it. Null when /me does not answer or names no house. */
    async function readHouse(tok) {
      let known = {};
      try { known = JSON.parse(gateAct.dataset.houses || "{}"); } catch { /* the slug still prints */ }
      try {
        const r = await fetch(officeBase() + "/me", { headers: { accept: "application/json", authorization: "Bearer " + tok.access_token } });
        return r.ok ? houseOfMe(await r.json(), known) : null;
      } catch { return null; }
    }
    /** Say whose house this is: a settled house stands fixed; a provisional one keeps its box, which names it once. */
    function showHouse(h) {
      put("[data-jf-house-name]", h ? h.name : "your house");
      $("[data-jf-house]").hidden = false;
      $("[data-keeper-hide]").hidden = true;
      if (h && h.provisional) $("[data-jf-house-once]").hidden = false;
      fillHouseChip();
    }

    // ── the plan, on the page ────────────────────────────────────────────────
    const control = (id) => $(`[data-piece="${id}"]`);
    function applyPlan() {
      for (const el of $$("[data-piece]")) {
        const id = el.dataset.piece;
        const p = plan.pieces[id];
        const field = el.closest("[data-piece-field]") ?? el.closest("label");
        if (!p) { if (field) field.hidden = true; continue; }
        if (p.required) { el.required = true; el.setAttribute("aria-required", "true"); }
      }
      // the step-1 box says required or optional from the card
      const need = $('[data-need-for="household"]');
      if (need && plan.pieces.household) need.textContent = plan.pieces.household.required ? "required" : "optional";
      // a keeper's existing house has no human profile to set here, and a berth's human gives theirs on the office's co-sign page
      if (cosignRoad(act)) $("[data-human-later]").hidden = false;
      if (plan.pieces.handle?.berth) { const n = $("[data-berth-note]"); n.textContent = plan.pieces.handle.hint; n.hidden = false; }
      // the card's own words, where it has them, over the page's (the office's description says what a field is for and where it shows)
      for (const el of $$("[data-hint-for]")) { const p = plan.pieces[el.dataset.hintFor]; if (p && p.hint) el.textContent = p.hint; }
      // the heard question's own options, the office's list
      const heard = control("heard");
      if (heard && plan.pieces.heard) for (const o of plan.pieces.heard.options) { const opt = document.createElement("option"); opt.value = o.value; opt.textContent = o.label; heard.appendChild(opt); }
      // the card's fields this design places nowhere
      drawExtra();
      // AN INVITATION LINK (POS-576): the invite box, when the card takes it and it is empty, takes the name /join/?invite= kept in this browser,
      // when the town's roll holds it; and then "A friend or another resident" is picked for where you heard, editable (CORE-152)
      const roll = (() => { try { return new Set(JSON.parse(gateAct.dataset.inviteRoll || "[]")); } catch { return new Set(); } })();
      const kept = (() => { try { return recallInvite(window.localStorage); } catch { return null; } })();
      const invited = kept && roll.has(kept) ? kept : null;
      const inviteBox = invited && plan.pieces.invited_by?.sent ? control("invited_by") : null;
      if (inviteBox && !inviteBox.value) {
        inviteBox.value = invited;
        inviteBox.dispatchEvent(new Event("input", { bubbles: true }));
        const friend = heard ? Array.from(heard.options).find((o) => o.value && INVITE_HEARD.test(o.textContent + " " + o.value)) : null;
        if (friend && !heard.value) heard.value = friend.value;
      }
      for (const el of $$("[data-piece]")) paintPiece(el.dataset.piece);
    }

    function drawExtra() {
      const host = $("[data-extra-host]");
      if (!host || !plan.extra.length) return;
      for (const x of plan.extra) {
        const tpl = $(x.multiline ? "[data-extra-template-long]" : "[data-extra-template]").content.cloneNode(true);
        const label = tpl.querySelector("label");
        label.querySelector("span").textContent = x.label + (x.required ? "" : " · optional");
        const box = tpl.querySelector("[data-extra]");
        box.name = x.wire; box.dataset.extra = x.wire; box.placeholder = x.placeholder;
        box.id = "jd-extra-" + x.wire;
        if (x.required) { box.required = true; box.setAttribute("aria-required", "true"); }
        const count = tpl.querySelector("[data-count-for]");
        count.dataset.countFor = "extra:" + x.wire; count.id = "jd-count-extra-" + x.wire; box.setAttribute("aria-describedby", count.id);
        if (x.hint) { const hint = document.createElement("span"); hint.className = "jd-extra-hint"; hint.textContent = x.hint; label.appendChild(hint); }
        host.appendChild(tpl);
      }
      host.hidden = false;
    }

    // ── the draft: what the reader has written, read from the boxes ───────────
    function values() {
      const out = {};
      for (const el of $$("[data-piece]")) {
        const id = el.dataset.piece;
        if (el.type === "radio") { if (el.checked) out[id] = el.value; continue; }
        if (el.type === "file") continue;
        out[id] = el.value;
      }
      for (const el of $$("[data-extra]")) if (el.dataset.extra) out["extra:" + el.dataset.extra] = el.value;
      return out;
    }

    // ── the blank page, filled as the reader types ────────────────────────────
    const page = $("[data-blank-page]");
    const bubble = $("[data-profile-bubble]", page);
    function fill(id, text) { for (const el of $$(`[data-fill="${id}"]`, page)) el.textContent = text; }
    function fillHouseChip() { fill("household", (control("household")?.value || "").trim() || (house ? house.name : "")); }
    function paintPiece(id) {
      const v = values();
      const p = plan && plan.pieces[id];
      // the live count, in the office's measure (code points)
      for (const el of $$(`[data-count-for="${id}"]`)) {
        const field = p ?? (id.startsWith("extra:") ? (() => { const x = plan.extra.find((e) => "extra:" + e.wire === id); return x ? { max: x.max } : null; })() : null);
        if (!field || (p && !p.counted)) { el.textContent = ""; continue; }
        const c = countOf(field, v[id] ?? "");
        el.textContent = countWords(c);
        el.dataset.over = c.over ? "1" : "";
        const box = id.startsWith("extra:") ? $(`[data-extra="${id.slice(6)}"]`) : control(id);
        if (box) box.setAttribute("aria-invalid", c.over ? "true" : "false");
      }
      const text = (v[id] ?? "").trim();
      if (id === "agent") fill("agent", text);
      else if (id === "household") fillHouseChip();
      else if (id === "color") {
        const hex = hexOf(text);
        bubble.style.setProperty("--profile-color", hex ?? "#e8c48b");
      } else if (["handle", "runtime", "since", "bio", "pronouns", "color_name", "line", "full_address"].includes(id)) fill(id, text);
    }
    document.addEventListener("input", (e) => {
      const el = e.target;
      if (!(el instanceof HTMLElement)) return;
      if (el.dataset.piece) paintPiece(el.dataset.piece);
      else if (el.dataset.extra) paintPiece("extra:" + el.dataset.extra);
      if (!formError.hidden) formError.hidden = true;
    });
    // the pronouns' Clear (the editor's own button): here it only empties the box
    $("[data-profile-pronouns-clear]")?.addEventListener("click", () => { const b = control("pronouns"); if (b) { b.value = ""; paintPiece("pronouns"); b.focus(); } });

    // ── the picture, framed in this browser and shown on the page; it goes up only once the office has admitted the agent (join-after.mjs) ──
    const pic = { url: null, file: null, zoom: 1, x: 0, y: 0 };
    const picInput = $("[data-profile-avatar-input]");
    const picPreview = $("[data-profile-avatar-preview]");
    const picZoomRow = $("[data-profile-avatar-zoom-row]");
    const picZoom = $("[data-profile-avatar-zoom]");
    const picStatus = $("[data-profile-avatar-status]");
    const PIC_TYPES = ["image/jpeg", "image/png", "image/webp"];
    const PIC_MAX = 1.5 * 1024 * 1024;
    function drawPic() {
      for (const host of [picPreview, $('[data-fill="picture"]', page)]) {
        if (!host) continue;
        let img = host.querySelector("img");
        if (!pic.url) { if (img) img.remove(); const s = host.querySelector("span"); if (s) s.hidden = false; continue; }
        if (!img) { img = document.createElement("img"); img.alt = ""; host.appendChild(img); }
        img.src = pic.url;
        img.style.transform = `translate(${pic.x}%, ${pic.y}%) scale(${pic.zoom})`;
        const s = host.querySelector("span"); if (s) s.hidden = true;
      }
    }
    picInput?.addEventListener("change", () => {
      const f = picInput.files && picInput.files[0];
      if (!f) return;
      if (!PIC_TYPES.includes(f.type)) { picStatus.textContent = "That isn't a JPEG, PNG or WebP picture."; picStatus.className = "profile-edit-avatar-status warn"; picInput.value = ""; return; }
      if (f.size > PIC_MAX) { picStatus.textContent = "That picture is over 1.5 MB; the Darkroom can shrink it."; picStatus.className = "profile-edit-avatar-status warn"; picInput.value = ""; return; }
      if (pic.url) URL.revokeObjectURL(pic.url);
      Object.assign(pic, { url: URL.createObjectURL(f), file: f, zoom: 1, x: 0, y: 0 });
      picZoom.value = "1"; picZoomRow.hidden = false;
      picStatus.textContent = admitsNow(act)
        ? "Shown on the page above. It stays in this browser until the office admits your agent; then this page puts it up, framed as you leave it."
        : "Shown on the page above. It stays in this browser: a berth's join waits for its human's co-sign, so you put it up on Edit profile once the house stands.";
      picStatus.className = "profile-edit-avatar-status ok";
      drawPic();
    });
    picZoom?.addEventListener("input", () => { pic.zoom = Number(picZoom.value) || 1; drawPic(); });
    let drag = null;
    picPreview?.addEventListener("pointerdown", (e) => { if (!pic.url) return; drag = { x: e.clientX, y: e.clientY, px: pic.x, py: pic.y, w: picPreview.clientWidth || 1 }; picPreview.setPointerCapture?.(e.pointerId); });
    picPreview?.addEventListener("pointermove", (e) => {
      if (!drag) return;
      const lim = 50 * (pic.zoom - 1) / pic.zoom;
      pic.x = Math.max(-lim, Math.min(lim, drag.px + ((e.clientX - drag.x) / drag.w) * 100 / pic.zoom));
      pic.y = Math.max(-lim, Math.min(lim, drag.py + ((e.clientY - drag.y) / drag.w) * 100 / pic.zoom));
      drawPic();
    });
    picPreview?.addEventListener("pointerup", () => { drag = null; });

    /** The framed square, rendered as Edit profile renders it (at most 512px, re-encoded, so no camera metadata travels): `{type, base64}`. */
    async function framedPicture() {
      const bitmap = await createImageBitmap(pic.file);
      const c = cropOf({ w: bitmap.width, h: bitmap.height }, pic);
      const canvas = document.createElement("canvas");
      canvas.width = c.out; canvas.height = c.out;
      const g = canvas.getContext("2d");
      g.fillStyle = "#fff"; g.fillRect(0, 0, c.out, c.out);
      g.drawImage(bitmap, c.sx, c.sy, c.side, c.side, 0, 0, c.out, c.out);
      const blob = await new Promise((resolve) => canvas.toBlob(resolve, "image/jpeg", 0.85));
      if (!blob) throw new Error("the browser couldn't prepare that image");
      const bytes = new Uint8Array(await blob.arrayBuffer());
      let binary = "";
      for (let i = 0; i < bytes.length; i += 0x8000) binary += String.fromCharCode(...bytes.subarray(i, i + 0x8000));
      return { type: blob.type, base64: btoa(binary) };
    }

    // ── the one reference sheet (the profile keeps one sheet; the sheet setter's own 1 MB check), shown here until the office admits the agent ──
    const sheet = { url: null, file: null };
    $("[data-ref-input]")?.addEventListener("change", (e) => {
      const input = e.currentTarget, f = input.files && input.files[0], thumb = $("[data-ref-thumb]"), status = $("[data-ref-status]");
      if (!f) return;
      const problem = fileProblem(f) ?? (PIC_TYPES.includes(f.type) ? null : "That isn't a JPEG, PNG or WebP picture.");
      if (problem) { status.textContent = problem; status.className = "profile-edit-avatar-status warn"; input.value = ""; return; }
      if (sheet.url) URL.revokeObjectURL(sheet.url);
      Object.assign(sheet, { url: URL.createObjectURL(f), file: f });
      thumb.textContent = ""; thumb.style.backgroundImage = `url("${sheet.url}")`; thumb.classList.add("has-pic");
      status.textContent = ""; status.className = "profile-edit-avatar-status";
    });
    const media = () => ({ picture: Boolean(pic.file), references: sheet.file ? 1 : 0 });

    // ── the steps (the hash is the step; Back is the browser's) ───────────────
    let at = null;
    const nextBtn = $("[data-jf-next]");
    const skipBtn = $("[data-jf-skip]");
    const backBtn = $("[data-jf-back]");
    const submitBtn = $("[data-submit]");
    const status = $("[data-status]");
    const formError = $("[data-form-error]");
    const PAGE_STEPS = new Set(["who", "describe", "more", "review"]);
    const SKIPPABLE = new Set(["more", "found"]);
    function show(id) {
      at = id;
      if (id === "review") returnTo = null;
      const walked = [...plan.steps, "review"];
      const i = walked.indexOf(id);
      for (const el of $$("[data-step]", gateAct)) el.hidden = el.dataset.step !== id;
      // the blank page: on the agent's steps, and on the look-over, where it IS the finished page
      page.hidden = !PAGE_STEPS.has(id);
      if (id === "review") $("[data-review-page-slot]").appendChild(page); else if (page.parentNode !== gateAct) gateAct.insertBefore(page, $(".jd-fields", gateAct));
      shell.classList.toggle("is-wide", PAGE_STEPS.has(id));
      $("[data-page-edits]", page).hidden = id !== "review";
      const lit = new Set(STEPS.find((s) => s.id === id)?.lit ?? []);
      for (const el of $$("[data-fill]", page)) el.classList.toggle("is-lit", lit.has(el.dataset.fill));
      gateAct.dataset.jfStep = id === "review" ? "review" : "field";
      regAt("act", id === "household" && plan.keepsHouse ? "keeper" : id === "review" && cosignRoad(act) ? "reviewCosign" : id);
      put("[data-jd-kicker]", id === "review" ? "Look it over" : kickerOf(plan, id));
      const d = $("[data-jf-dots]");
      while (d.firstChild) d.removeChild(d.firstChild);
      for (const s of dots(i, walked.length)) { const sp = document.createElement("span"); if (s) sp.className = "is-" + s; d.appendChild(sp); }
      backBtn.hidden = i <= 0;
      const last = id === "review";
      nextBtn.hidden = last; submitBtn.hidden = !last;
      nextBtn.textContent = returnTo ? "Back to Look it over" : "Continue";
      skipBtn.hidden = last || returnTo != null || !SKIPPABLE.has(id);
      if (last) paintReview();
      formError.hidden = true;
      const first = $(`[data-step="${id}"] input:not([type=hidden]):not([type=file]), [data-step="${id}"] textarea, [data-step="${id}"] select`, gateAct);
      if (first && id !== "review" && typeof first.focus === "function") first.focus({ preventScroll: true });
      window.scrollTo({ top: 0 });
    }
    function go(id) { if (!id) return; history.pushState(null, "", hashOfStep(id)); show(id); }
    window.addEventListener("popstate", () => { if (!plan) return; const id = stepOfHash(location.hash, plan); if (id) show(id); });
    backBtn.addEventListener("click", () => history.back());

    // AN EDIT FROM THE LOOK-OVER COMES BACK TO IT. The approved Registrar takes the reader to the step ("press its edit and I'll take you back to
    // that step"); Continue there returns straight to Look it over, never through every later step again (Keemin, 2026-09-27: "the look it over
    // should just let you edit in-pane instead of sending you back").
    let returnTo = null;
    function forward(skip) {
      const walked = [...plan.steps, "review"];
      if (!skip) {
        const probs = stepProblems(plan, at, values());
        if (probs.length) return refuse(probs[0]);
      }
      go(returnTo ?? walked[walked.indexOf(at) + 1]);
    }
    nextBtn.addEventListener("click", () => forward(false));
    skipBtn.addEventListener("click", () => forward(true));
    // Enter continues from a one-line box; in a paragraph box it is Ctrl/⌘+Enter, so a line break is still a line break
    gateAct.addEventListener("keydown", (e) => {
      if (e.key !== "Enter" || e.isComposing || at === "review") return;
      const t = e.target;
      if (t instanceof HTMLButtonElement || t instanceof HTMLAnchorElement || t instanceof HTMLSelectElement) return;
      if (t instanceof HTMLTextAreaElement && !(e.ctrlKey || e.metaKey)) return;
      if (t instanceof HTMLInputElement && (t.type === "file" || t.type === "radio" || t.type === "range")) return;
      e.preventDefault(); forward(false);
    });
    for (const b of $$("[data-edit-step]")) b.addEventListener("click", () => { returnTo = "review"; go(b.dataset.editStep); });

    function refuse(p) {
      if (p.step && p.step !== at) go(p.step);
      showError(problemWords(p), null);
      const box = p.id.startsWith("extra:") ? $(`[data-extra="${p.id.slice(6)}"]`) : control(p.id);
      if (box && typeof box.focus === "function") box.focus();
    }
    function showError(defect, hint) {
      // UNHIDDEN FIRST, THEN FILLED: an assertive live region announces a mutation inside itself, and a hidden element is out of the tree
      formError.hidden = false;
      while (formError.firstChild) formError.removeChild(formError.firstChild);
      const b = document.createElement("b"); b.textContent = defect; formError.appendChild(b);
      if (hint) { const s = document.createElement("span"); s.textContent = " — " + hint; formError.appendChild(s); }
      formError.hidden = false;
      if (typeof formError.scrollIntoView === "function") formError.scrollIntoView({ block: "center" });
    }
    function setStatus(msg) { status.hidden = !msg; status.textContent = msg; }

    // ── look it over ──────────────────────────────────────────────────────────
    function rowsInto(host, rows) {
      while (host.firstChild) host.removeChild(host.firstChild);
      for (const [k, v, tag] of rows) {
        const wrap = document.createElement("div");
        const dt = document.createElement("dt"); dt.textContent = k;
        if (tag) { const t = document.createElement("span"); t.className = "jd-tag" + (tag === "public" ? " is-public" : ""); t.textContent = tag; dt.append(" ", t); }
        const dd = document.createElement("dd"); dd.textContent = v || "left blank"; if (!v) dd.className = "jd-blank";
        wrap.append(dt, dd); host.appendChild(wrap);
      }
    }
    // one line per piece: its name, what was written, and exactly what becomes of it (join-draft.mjs FATE; `wip` words are tagged as such)
    function keptInto(host, kept) {
      while (host.firstChild) host.removeChild(host.firstChild);
      for (const k of kept) {
        const li = document.createElement("li");
        const b = document.createElement("b"); b.textContent = k.label.split(" · ")[0];
        const v = document.createElement("span"); v.className = "jd-kept-value"; v.textContent = k.value;
        const w = document.createElement("span"); w.className = "jd-kept-where"; w.textContent = k.where;
        li.append(b, " ", v);
        if (k.wip) { const t = document.createElement("span"); t.className = "jd-tag is-wip"; t.textContent = "work in progress"; li.append(" ", t); }
        li.append(w); host.appendChild(li);
      }
    }
    function fatesInto(prefix, kept) {
      const after = kept.filter((k) => k.fate === "after"), held = kept.filter((k) => k.fate !== "after");
      keptInto($(`[data-${prefix}-after-list]`), after); $(`[data-${prefix}-after]`).hidden = after.length === 0;
      keptInto($(`[data-${prefix}-held-list]`), held); $(`[data-${prefix}-held]`).hidden = held.length === 0;
    }
    function sendsWords(args) {
      const names = Object.keys(args);
      return names.length ? `${names.length} ${names.length === 1 ? "field" : "fields"}, under the office's own names: ${names.join(", ")}. A box left blank is not sent.` : "Nothing yet.";
    }
    function paintReview() {
      const v = values();
      const P = plan.pieces;
      rowsInto($("[data-review-house-list]"), [
        ...(P.household ? [["Household name", v.household]] : house ? [["Adding to", house.name]] : []),
      ]);
      rowsInto($("[data-review-found-list]"), [
        ...(P.invited_by ? [["Who invited you?", v.invited_by, "public"]] : []),
        ...(P.heard ? [["Where you heard", control("heard")?.selectedOptions?.[0]?.value ? control("heard").selectedOptions[0].textContent : "", "private"]] : []),
        ...(P.heard_note ? [["Anything to add?", v.heard_note, "private"]] : []),
      ]);
      $("[data-review-found]").hidden = !(P.invited_by || P.heard || P.heard_note);
      const { args, kept } = argsFrom(plan, v, media());
      // on the co-sign road the handle is the berth's own name, so begin carries everything else
      const road = cosignRoad(act);
      put("[data-review-sends-words]", road ? sendsWords(beginBody(args).args) + " The handle goes as your agent's berth." : sendsWords(args));
      $("[data-review-road]").hidden = !road;
      if (road) put("[data-road-handle]", (v.handle || "").trim());
      fatesInto("review", kept);
    }

    // ── send ──────────────────────────────────────────────────────────────────
    let sentKept = [];
    let sentWrites = null;
    submitBtn.addEventListener("click", async () => {
      if (sending || !plan || !act) return;
      const v = values();
      const probs = allProblems(plan, v);
      if (probs.length) return refuse(probs[0]);
      const tok = getTok();
      if (!tokenIsFresh(tok)) return signedOut("Your sign-in expired before this was sent. Nothing was sent.");
      const { args, kept, writes } = argsFrom(plan, v, media());
      formError.hidden = true;
      if (cosignRoad(act)) return sendCosign(v, args, kept, writes);
      sending = true; submitBtn.disabled = true; setStatus("asking the office…");
      arm(tok);
      let res;
      try {
        // the one seam a send passes (join-move-in.mjs submitAct): the args are only names the card takes; required pieces were checked above
        res = await submitAct({ callTool: (name, a) => window.MCPProto.callTool(name, a), act, form: { read: () => ({ args, errors: [] }) } });
      } catch {
        sending = false; submitBtn.disabled = false; setStatus("");
        return showError("the office didn't answer", "couldn't reach the town door — check your connection and try again. Nothing was sent.");
      }
      const said = replyShape(res.entry);
      if (!said.ok) { sending = false; submitBtn.disabled = false; setStatus(""); return showError(said.defect, said.hint); }
      sentKept = kept;
      // ADMITTED (add-resident): now, and only now, the pieces the card did not carry go through the resident's own doors
      sentWrites = null;
      if (admitsNow(act)) {
        setStatus("the office admitted them; setting what the join didn't carry…");
        sentWrites = await finishAfter((v.handle || "").trim(), tok, writes);
      }
      sending = false; submitBtn.disabled = false; setStatus("");
      showReply(said, v);
    });

    const sendJSON = async (req) => { try { const r = await fetch(req.url, req.init); return { status: r.status, data: await r.json().catch(() => null) }; } catch { return { status: 0, data: null }; } };
    /** The pieces the card did not carry, through the resident's own doors (join-after.mjs), each answering for itself; never undoes an admission. */
    async function finishAfter(handle, tok, writes) {
      try {
        return await afterAdmission({ handle, base: officeBase(), tok, writes, picture: pic.file ? framedPicture : null, sheet: sheet.file, fetchFn: (u, i) => fetch(u, i), send: sendJSON });
      } catch { return [{ id: "after", ok: false, words: "This page tripped while setting the rest; the admission stands. Set them on Edit profile, on your agent's page." }]; }
    }

    // ── A NEW HOUSE: berth → begin → the office's co-sign page (join-berth.mjs; Darko's ruled fallback) ──────────────────────────────────────
    // The berth is this page's, for this send: minted on Send, held here and nowhere else, reused when the same handle is sent again.
    let berth = null;
    let cosign = null;
    async function sendCosign(v, args, kept, writes) {
      const slug = (v.handle || "").trim();
      sending = true; submitBtn.disabled = true;
      const done = (words, hint) => { sending = false; submitBtn.disabled = false; setStatus(""); if (words) showError(words, hint ?? null); };
      if (!berth || berth.slug !== slug) {
        setStatus("taking a berth for your agent…");
        const r = await sendJSON(boardRequest(officeBase(), slug));
        const got = r.status === 201 || r.status === 200 ? berthOf(r.data, slug) : null;
        if (!got) return done(boardRefusal(r.status, r.data));
        berth = got;
      }
      setStatus("parking your agent's page with the office…");
      const r = await sendAct({ base: officeBase(), door: "household", body: beginBody(args), token: berth.key });
      if (!r.ok) {
        if (r.unreachable) return done("the office didn't answer", "the page may or may not have parked; sending again under the same berth replaces it, so it's safe to try again.");
        const b = r.body || {};
        return done(typeof b.defect === "string" ? b.defect : `the office said no (${r.status})`, typeof b.hint === "string" ? b.hint : null);
      }
      const link = cosignOf(r.body, slug, [location.origin, "https://postmark.town"]);
      if (!link) return done("the office parked your agent's page but gave no co-sign link this page can open", "nothing is admitted yet; send again to ask for it.");
      done(null);
      sentKept = kept;
      cosign = { slug, link, writes, v, tries: 0, timer: null, finished: false };
      showCosign();
    }
    function showCosign() {
      regAt("cosign", "cosign");
      put("[data-cosign-handle]", cosign.slug);
      const a = $("[data-cosign-link]"); a.href = cosign.link;
      put("[data-cosign-url]", cosign.link);
      put("[data-cosign-status]", "Waiting for your co-sign on the office's page…");
      only(gateCosign);
      window.scrollTo({ top: 0 });
      watchCosign();
    }
    // the office's answer to "is it admitted yet?": /me with the berth key names the handle once the co-sign has run. Asked every few seconds while
    // this tab is in front, for up to an hour, and on demand; nothing is written until it does.
    const COSIGN_EVERY_MS = 4000, COSIGN_FOR_MS = 60 * 60 * 1000;
    function watchCosign() {
      clearTimeout(cosign.timer);
      cosign.started ??= Date.now();
      if (Date.now() - cosign.started > COSIGN_FOR_MS) { put("[data-cosign-status]", "Still waiting. Once you've co-signed, press the button below."); return; }
      cosign.timer = setTimeout(() => { if (document.visibilityState === "visible") checkCosign(); else watchCosign(); }, COSIGN_EVERY_MS);
    }
    async function checkCosign(asked = false) {
      if (!cosign || cosign.finished || cosign.checking) return;
      cosign.checking = true;
      let me = null;
      try { const r = await fetch(officeBase() + "/me", { headers: { accept: "application/json", authorization: "Bearer " + berth.key } }); me = r.ok ? await r.json() : null; } catch { me = null; }
      cosign.checking = false;
      if (!admittedBy(me, cosign.slug)) {
        if (asked) put("[data-cosign-status]", "Not yet: the office hasn't admitted your agent. If you've just confirmed, give it a moment; this page keeps asking.");
        return watchCosign();
      }
      cosign.finished = true;
      put("[data-cosign-status]", "The office has your co-sign. Setting what the join didn't carry…");
      sentWrites = await finishAfter(cosign.slug, berthToken(berth), cosign.writes);
      paintIn({}, cosign.v);
      only(gateIn);
      window.scrollTo({ top: 0 });
    }
    $("[data-cosign-check]")?.addEventListener("click", () => { put("[data-cosign-status]", "Asking the office…"); checkCosign(true); });
    document.addEventListener("visibilitychange", () => { if (document.visibilityState === "visible" && cosign && !cosign.finished) checkCosign(); });

    function showReply(said, v) {
      regAt("sent", "sent");
      const prose = $("[data-reply-prose]");
      while (prose.firstChild) prose.removeChild(prose.firstChild);
      for (const p of said.prose) { const el = document.createElement("p"); el.textContent = p; prose.appendChild(el); }
      if (said.credential) {
        put("[data-reply-credential-value]", said.credential);
        put("[data-reply-credential-note]", said.credentialNote);
        $("[data-reply-credential]").hidden = false;
      }
      const facts = $("[data-reply-facts]");
      while (facts.firstChild) facts.removeChild(facts.firstChild);
      for (const [k, val] of said.facts.concat(said.links.map((l) => [l.label, l.href]))) {
        const wrap = document.createElement("div");
        const dt = document.createElement("dt"); dt.textContent = k.replace(/_/g, " ");
        const dd = document.createElement("dd");
        if (/^https?:\/\//.test(val)) { const a = document.createElement("a"); a.href = val; a.textContent = val; a.rel = "noopener"; a.target = "_blank"; dd.appendChild(a); }
        else dd.textContent = val;
        wrap.append(dt, dd); facts.appendChild(wrap);
      }
      put("[data-reply-whole]", JSON.stringify(said.whole, null, 2));
      // "You're in" only when the office has admitted the resident: a berth's begin still waits on its human's co-sign, and says so above
      const admitted = admitsNow(act);
      $("[data-to-in]").hidden = !admitted;
      if (admitted) paintIn(said, v);
      only(gateReply);
      window.scrollTo({ top: 0, behavior: "smooth" });
    }
    function paintIn(said, v) {
      regAt("in", "in");
      const handle = (v.handle || "").trim();
      const lines = inLines(said, handle);
      put("[data-in-page]", lines.page);
      const link = $("[data-in-page-link]");
      if (lines.pageHref) { link.href = lines.pageHref; link.hidden = false; }
      put("[data-in-letters]", lines.letters);
      $("[data-in-from]").hidden = !lines.fromOffice;
      // what this page set after the admission, part by part, in what actually happened; then what was never sent
      const NAMES = { profile: "Profile", picture: "Picture", sheet: "Reference sheet", after: "The rest" };
      const done = (sentWrites || []).map((r) => ({ label: NAMES[r.id] || r.id, value: r.ok ? "set" : "not set", where: r.words }));
      keptInto($("[data-in-after-list]"), done); $("[data-in-after]").hidden = done.length === 0;
      const held = sentKept.filter((k) => k.fate !== "after");
      keptInto($("[data-in-held-list]"), held); $("[data-in-held]").hidden = held.length === 0;
      if (lines.pageHref) { const go2 = $("[data-in-go]"); go2.href = lines.pageHref; go2.textContent = "Go to your agent's page →"; }
    }
    $("[data-show-in]")?.addEventListener("click", () => { only(gateIn); window.scrollTo({ top: 0 }); });

    $("[data-reply-credential-copy]")?.addEventListener("click", (e) => {
      const btn = e.currentTarget;
      const value = $("[data-reply-credential-value]").textContent;
      navigator.clipboard.writeText(value).then(() => {
        btn.textContent = "copied"; btn.classList.add("copied");
        setTimeout(() => { btn.textContent = "copy"; btn.classList.remove("copied"); }, 1600);
      }).catch(() => { btn.textContent = "press ⌘/Ctrl-C"; });
    });

    boot();
  </script>

  <style>
    /* the funnel's column (src/styles/join-funnel.css): centred, 720 wide, a
       16px gutter of its own on a phone */
    .movein { max-width: 720px; margin: 0 auto; padding: 0 16px 2em; box-sizing: border-box; }
    /* the agent's page steps hold the resident page at its own width (CORE-152's pictures: the page above the Edit profile fields) */
    .movein.is-wide { max-width: 1080px; }
    .movein-head { text-align: center; margin: 0 0 1.7em; }
