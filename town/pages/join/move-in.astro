    .jd-review-sec :global(dt) { min-width: 14em; font-family: var(--pm-mono); font-size: 0.7rem; letter-spacing: 0.06em; color: var(--pm-ink-soft); }
    .jd-review-sec :global(dd) { margin: 0; color: var(--pm-ink); overflow-wrap: anywhere; }
    .jd-review-sec :global(dd.jd-blank) { color: var(--pm-ink-soft); font-style: italic; }
    .jd-review-note { margin: 0 0 0.5em; font-size: 0.9rem; color: var(--pm-ink-soft); }
    .movein :global(.jd-kept) { margin: 0.4em 0 0; padding-left: 1.1em; display: grid; gap: 0.55em; }
    .movein :global(.jd-kept li) { color: var(--pm-ink); line-height: 1.5; overflow-wrap: anywhere; }
    /* a piece's name in ink, not the paper's wax red (postmark.css's `.pm-paper b`), which reads as a refusal in a list of what happens next */
    .movein :global(.jd-kept li > b) { color: var(--pm-ink); }
    .movein :global(.jd-kept-value) { font-style: italic; }
    .movein :global(.jd-kept-where) { display: block; font-size: 0.86rem; color: var(--pm-ink-soft); }

    /* you're in */
    .jd-in-lines { margin: 0.6em 0 0; padding-left: 1.1em; display: grid; gap: 0.6em; }
    .jd-in-lines li { color: var(--pm-ink); line-height: 1.55; }
