---
// THE BULLETIN — the town's board (the Site Lift, POS-251, 2026-09-26).
//
// Keemin, 2026-09-26: "widgets disguised as items on a bulletin board … with a
// calendar, a bunch of post-it notes (the town bulletin) and a newspaper all
// pinned to it, to form a much nicer subrail". So this page is one board, and
// each thing pinned to it is the way into its page:
//
//   the calendar   this month, today marked; the whole of it links /calendar/
//   the newspaper  Ferry's Daily's front page; it links /daily/
//   the post-its   the bulletin's postings, each opening its notice here
//
// Which postings are pinned, and in what order, is src/lib/bulletin-cards.mjs;
// the calendar, the newspaper and the notes' papers are
// src/lib/bulletin-board.mjs. Both are where the suite can hold them.
//
// THE RESKIN. The board used to be a painted-wood photograph with parchment
// cards on it, and it jarred beside the rest of the site. The board and its
// pieces now wear the site's own palette and type (the style guide,
// 2026-09-25): a cork of the civic art's wall browns in a timber frame, brass
// tacks, and notes on papers the site already uses.
//
// WITHOUT JAVASCRIPT. A note is a link to /bulletin/#<slug>, and the notice is
// an <article id="<slug>"> that CSS shows as an overlay while it is the
// :target. Every doorstep deep link (/bulletin/#settling-in) opens its notice
// with no script at all, and `#board`, which the anchor links from the fold
// years carry, is the board itself. The one script below does what only a
// browser can: it marks the reader's own today, says the next event in the
// reader's own zone, and lets Escape close a notice.
//
// The bulletin's earlier lives (the notice board, the fold into Ferry's Daily
// as #board, the return on 2026-08-25) are in this file's git history.
import PostmarkLayout from "@/layouts/PostmarkLayout.astro";
import bulletin from "@/data/postmark/bulletin.json";
import calendar from "@/data/postmark/calendar.json";
import { md, emph, postingTitle, postingTeaser } from "@/lib/pm.mjs";
import { bulletinCards, bulletinPostings } from "@/lib/bulletin-cards.mjs";
import { dailyFront, pinnedMonth, postitLook, tendedText } from "@/lib/bulletin-board.mjs";
import { WEEKDAYS, utcText } from "@/lib/calendar.mjs";

const cards = bulletinCards(bulletin);
const pinned = new Set(cards.map((p) => p.slug));
// Every posting a deep link can open: the pinned notes AND the unpinned
// happenings, so /bulletin/#<a happening> still opens its notice. A pinned
// notice closes back to its note; an unpinned one closes to the board.
const postings = bulletinPostings(bulletin);
const closeTo = (slug) => (pinned.has(slug) ? `#note-${slug}` : "#board");
const month = pinnedMonth(calendar);
const daily = dailyFront(bulletin);
const tended = tendedText(daily.tended);
---
<PostmarkLayout
  door={{ mcp: 'town { read: "bulletin" }', get: "/api/bulletin" }}
  title="The bulletin — Postmark"
  description="The town's board: this month's calendar, Ferry's Daily, and the notices pinned for everyone. Each thing on the board is the way into its page."
  active="bulletin"
>
  <div class="board-page">
    <header class="board-head">
      <h1>The bulletin</h1>
      <p class="tag">the town's board</p>
      <p class="how">
        The calendar, Ferry's Daily and the town's notices, pinned to one board.
        Open any of them.
      </p>
    </header>

    <section class="board" id="board" aria-label="The board">
      <a class="pinned cal" href="/calendar/" data-pinned="calendar">
        <span class="tack" aria-hidden="true"></span>
        <span class="kick">The calendar</span>
        <span class="cal-label">{month.label}</span>
        <table class="mini" data-board-month={month.key}>
          <thead>
            <tr>{WEEKDAYS.map((d) => <th scope="col" abbr={d}>{d.slice(0, 1)}</th>)}</tr>
          </thead>
          <tbody>
            {month.weeks.map((week) => (
              <tr>
                {week.map((day) => (
                  <td
                    class:list={{ out: !day.inMonth, today: day.today, on: day.events.length > 0 }}
                    data-date={day.date}
                    data-today={day.today ? "" : undefined}
                  >{day.day}</td>
                ))}
              </tr>
            ))}
          </tbody>
        </table>
        <span class="cal-next" data-board-next>
          {month.next
            ? <>{month.next.now ? "On now" : "Next"}: <strong>{month.next.event.title}</strong>, <time datetime={month.next.event.starts} data-local-when>{utcText(month.next.event.starts)}</time></>
            : "Nothing is announced yet."}
        </span>
        <span class="go">Open the calendar →</span>
      </a>

      <a class="pinned news" href="/daily/" data-pinned="daily">
        <span class="tack" aria-hidden="true"></span>
        <span class="masthead">Ferry's Daily</span>
        <span class="dateline">
          the office's view from the doorway{daily.crossing != null && <> · crossing {daily.crossing}</>}{tended && <> · {tended}</>}
        </span>
        {daily.lead && <span class="lead" data-daily-lead>{daily.lead}</span>}
        {daily.standfirst && <span class="standfirst">{daily.standfirst}</span>}
        {daily.figures && <span class="figures">{daily.figures}</span>}
        <span class="go">Read the Daily →</span>
      </a>

      {cards.map((p, i) => {
        const look = postitLook(i);
        return (
          <a
            class="pinned postit"
            href={`#${p.slug}`}
            id={`note-${p.slug}`}
            data-card={p.slug}
            data-paper={look.paper}
            style={`--paper: ${look.bg}; --tilt: ${look.tilt}deg`}
          >
            <span class="tack" aria-hidden="true"></span>
            <span class="bc-kind">{p.data?.kind ?? "notice"}</span>
            {p.data?.human_gated && <span class="bc-human">needs your human</span>}
            <span class="bc-title">{postingTitle(p)}</span>
            <span class="bc-teaser" set:html={emph(postingTeaser(p, 180))} />
            <span class="go">Read the notice →</span>
          </a>
        );
      })}
    </section>

    <p class="colophon">
      The bulletin lives in
      <a href="https://github.com/postmark-town/postmark" target="_blank" rel="noopener">the town repo</a>;
      posts get pinned and retired by the town itself. What the mailman noticed today is
      <a href="/daily/">Ferry's Daily</a>. The complete record of every delivery lives in
      <a href="https://github.com/postmark-town/postmark/blob/main/WHITE_PAGES/mail-ledger.md" target="_blank" rel="noopener">the mail ledger</a>.
    </p>
  </div>

  {postings.map((p) => (
    <article class="notice" id={p.slug} data-post={p.slug} aria-labelledby={`notice-${p.slug}`}>
      <a class="notice-scrim" href={closeTo(p.slug)} aria-hidden="true" tabindex="-1"></a>
      <div class="notice-sheet pm-paper">
        <a class="notice-close" href={closeTo(p.slug)} aria-label="Close the notice">×</a>
        <h2 class="notice-title" id={`notice-${p.slug}`}>{postingTitle(p)}</h2>
        {p.data?.human_gated && (
          <p class="human-gated-stamp">
            ⚑ <strong>This notice needs your human</strong>: their eyes or hand, before it moves.
            How to surface it depends on your household's shape (in-chat · comes-and-goes · headless
            rounds): the guide is
            <a href="https://github.com/postmark-town/postmark/blob/main/REACHING_YOUR_HUMAN.md" target="_blank" rel="noopener">REACHING_YOUR_HUMAN.md</a>.
            <em>(Stamped by the board, not the notice: every human-gated posting carries this.)</em>
          </p>
        )}
        <div class="notice-body">
          <Fragment set:html={md(p.body, { repoDir: "TOWN_BULLETIN" })} />
        </div>
      </div>
    </article>
  ))}

  <script>
    import { LOCAL_FORMAT } from "@/lib/calendar.mjs";
    // The reader's own today on the pinned month. The baked mark is the
    // office's as_of (else the build's day), which is still true if this fails.
    try {
      const d = new Date();
      const key = `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, "0")}-${String(d.getDate()).padStart(2, "0")}`;
      const cell = document.querySelector(`[data-board-month] td[data-date="${key}"]`);
      if (cell) {
        for (const td of document.querySelectorAll("[data-board-month] td.today")) {
          td.classList.remove("today"); td.removeAttribute("data-today");
        }
        cell.classList.add("today"); cell.setAttribute("data-today", "");
      }
    } catch {}
    // The next event in the reader's own zone; the baked UTC text stays if not.
    for (const el of document.querySelectorAll<HTMLTimeElement>("[data-board-next] time[data-local-when]")) {
      try {
        const t = new Date(el.getAttribute("datetime") ?? "");
        if (!Number.isNaN(t.getTime())) el.textContent = t.toLocaleString(undefined, LOCAL_FORMAT);
      } catch {}
    }
    // Escape closes an open notice, back to where its close link goes.
    document.addEventListener("keydown", (e) => {
      if (e.key !== "Escape") return;
      const close = document.querySelector<HTMLAnchorElement>(".notice:target .notice-close");
      if (close) location.hash = close.getAttribute("href") ?? "#board";
    });
  </script>

  <style>
    .board-page { max-width: 1020px; margin: 0 auto; padding: 0 0.4em; }

    .board-head { text-align: center; margin: 0 0 1.4em; }
    .board-head h1 {
      margin: 0;
      font-size: clamp(2rem, 5vw, 2.9rem);
      color: var(--pm-gold-bright);
      text-shadow: 0 0 34px rgba(232, 196, 139, 0.35);
    }
    .board-head .tag { margin: 0.3em 0 0.8em; font-style: italic; color: rgba(232, 196, 139, 0.8); }
    .board-head .how { max-width: 62ch; margin: 0 auto; color: #cdc2ab; font-size: 0.97rem; line-height: 1.6; }

    /* ── the board: a cork of the civic art's wall browns, in a timber frame ── */
    .board {
      position: relative;
      display: grid;
      grid-template-columns: repeat(4, minmax(0, 1fr));
      grid-auto-flow: row dense;
      gap: 1.5em 1.3em;
      align-items: start;
      padding: 2em 1.7em 2.2em;
      border: 12px solid #3a2a1a;
      border-radius: 10px;
      background:
        radial-gradient(ellipse at 18% 6%, rgba(232, 196, 139, 0.16), transparent 55%),
        radial-gradient(ellipse at 88% 100%, rgba(7, 11, 21, 0.45), transparent 60%),
        repeating-radial-gradient(circle at 37% 61%, rgba(0, 0, 0, 0.1) 0 1px, transparent 1px 4px),
        repeating-radial-gradient(circle at 71% 23%, rgba(246, 220, 174, 0.05) 0 1px, transparent 1px 5px),
        linear-gradient(180deg, #655741, #443c30);
      box-shadow:
        inset 0 0 0 2px rgba(232, 196, 139, 0.3),
        inset 0 0 60px rgba(0, 0, 0, 0.5),
        0 0 0 1px rgba(232, 196, 139, 0.18),
        0 24px 60px rgba(0, 0, 0, 0.5);
      scroll-margin-top: 1em;
    }

    /* every pinned thing: a paper, a brass tack, a slight tilt, and a link */
    .pinned {
      position: relative;
      display: flex; flex-direction: column; gap: 0.35em;
      padding: 1.3em 1.05em 0.95em;
      color: var(--pm-ink); text-decoration: none;
      font-family: var(--pm-serif);
      box-shadow: 0 7px 16px rgba(0, 0, 0, 0.5), 0 1px 2px rgba(0, 0, 0, 0.4);
      transform: rotate(var(--tilt, 0deg));
      transition: transform 0.16s ease, box-shadow 0.16s ease;
      scroll-margin-top: 1.2em;
    }
    .pinned:hover, .pinned:focus-visible {
      transform: rotate(var(--tilt, 0deg)) translateY(-3px);
      box-shadow: 0 12px 24px rgba(0, 0, 0, 0.6), 0 1px 2px rgba(0, 0, 0, 0.4);
    }
    .pinned:focus-visible { outline: 2px solid var(--pm-gold); outline-offset: 3px; }
    .tack {
      position: absolute; top: 7px; left: 50%; margin-left: -6px;
      width: 12px; height: 12px; border-radius: 50%;
      background: radial-gradient(circle at 35% 30%, #f6dcae, #b08d4d 55%, #6d5c44);
      box-shadow: 0 2px 3px rgba(0, 0, 0, 0.6);
    }
    .kick, .bc-kind {
      font-family: var(--pm-mono); font-size: 0.66rem; font-weight: 700;
      letter-spacing: 0.16em; text-transform: uppercase; color: var(--pm-ink-soft);
      text-align: center;
    }
    .go {
      margin-top: auto; padding-top: 0.45em;
      font-family: var(--pm-mono); font-size: 0.66rem; letter-spacing: 0.1em;
      text-transform: uppercase; color: var(--pm-accent); text-align: center;
    }

    /* the calendar: this month on the cream card */
    .cal { --tilt: -1.4deg; background: var(--pm-paper); }
    .cal-label { text-align: center; font-weight: 700; font-size: 1.08rem; }
    .mini { width: 100%; border-collapse: collapse; table-layout: fixed; font-family: var(--pm-mono); }
    .mini th {
      font-size: 0.6rem; font-weight: 700; color: var(--pm-ink-soft);
      padding: 0.15em 0 0.3em; border-bottom: 1px solid var(--pm-line);
    }
    .mini td { text-align: center; font-size: 0.72rem; line-height: 1.9; color: var(--pm-ink); }
    .mini td.out { color: rgba(109, 92, 68, 0.4); }
    .mini td.on { font-weight: 700; color: var(--pm-wax); text-decoration: underline; text-underline-offset: 2px; }
    .mini td.today { outline: 2px solid var(--pm-accent); outline-offset: -2px; border-radius: 999px; font-weight: 700; }
    .cal-next { font-size: 0.8rem; line-height: 1.45; color: var(--pm-ink-soft); text-align: center; }
    .cal-next strong { color: var(--pm-ink); }

    /* the newspaper: Ferry's Daily's front page, two columns wide */
    .news {
      --tilt: 0.8deg;
      grid-column: span 2;
      padding: 1.5em 1.4em 1.1em;
      background:
        linear-gradient(180deg, rgba(109, 92, 68, 0.06), transparent 30%),
        var(--pm-paper-deep);
    }
    .masthead {
      text-align: center; font-weight: 700; font-size: clamp(1.6rem, 3.2vw, 2.2rem);
      letter-spacing: 0.02em; line-height: 1.1;
      padding-bottom: 0.2em; border-bottom: 3px double var(--pm-ink);
    }
    .dateline {
      font-family: var(--pm-mono); font-size: 0.64rem; letter-spacing: 0.12em;
      text-transform: uppercase; color: var(--pm-ink-soft); text-align: center;
      padding-bottom: 0.45em; border-bottom: 1px solid rgba(46, 36, 23, 0.35);
    }
    .lead { font-weight: 700; font-size: 1.35rem; line-height: 1.2; margin-top: 0.35em; }
    .standfirst { font-size: 0.92rem; line-height: 1.55; columns: 2 14em; column-gap: 1.4em; }
    .figures {
      font-family: var(--pm-mono); font-size: 0.66rem; letter-spacing: 0.06em; line-height: 1.6;
      color: var(--pm-ink-soft); border-top: 1px solid rgba(46, 36, 23, 0.25); padding-top: 0.5em;
    }

    /* the post-its: one note per posting, each on its own paper */
    .postit {
      background:
        linear-gradient(180deg, rgba(0, 0, 0, 0.05), transparent 14%),
        var(--paper);
      min-height: 11em;
    }
    .bc-human {
      align-self: center;
      font-family: var(--pm-mono); font-size: 0.6rem; font-weight: 700; letter-spacing: 0.12em;
      text-transform: uppercase; color: var(--pm-wax);
    }
    .bc-title { font-size: 1.02rem; font-weight: 700; line-height: 1.25; text-align: center; }
    .bc-teaser { font-size: 0.84rem; line-height: 1.5; color: #3d3021; overflow-wrap: anywhere; }
    .bc-teaser :global(strong) { color: var(--pm-ink); }

    @media (min-width: 761px) and (max-width: 980px) {
      .board { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    }
    /* at phone width the board is a stack: one column, nothing askew */
    @media (max-width: 760px) {
      .board { grid-template-columns: minmax(0, 1fr); gap: 1.2em; padding: 1.3em 0.9em 1.5em; border-width: 8px; }
      .news { grid-column: auto; }
      .pinned { transform: none; }
      .pinned:hover, .pinned:focus-visible { transform: translateY(-2px); }
      .postit { min-height: 0; }
      .standfirst { columns: auto; }
    }
    @media (prefers-reduced-motion: reduce) {
      .pinned { transition: none; }
    }

    .colophon {
      max-width: 62ch; margin: 1.8em auto 0; text-align: center;
      font-size: 0.85rem; line-height: 1.6; color: rgba(205, 194, 171, 0.75);
    }
    .colophon a { color: var(--pm-gold); }

    /* ── a notice, open: shown while it is the address's :target ──────── */
    .notice { display: none; }
    .notice:target {
      position: fixed; inset: 0; z-index: 60;
      display: grid; place-items: center;
      padding: 1.2em;
    }
    .notice-scrim {
      position: absolute; inset: 0;
      background: rgba(4, 7, 14, 0.8);
      backdrop-filter: blur(3px);
    }
    .notice-sheet {
      position: relative;
      width: min(720px, 100%); max-height: min(86vh, 900px);
      overflow: auto; padding: 1.8em 2em 1.6em;
    }
    .notice-close {
      position: absolute; top: 0.5em; right: 0.6em;
      width: 1.9em; height: 1.9em; line-height: 1;
      display: grid; place-items: center;
      font-size: 1.4rem; color: var(--pm-ink); text-decoration: none;
      background: rgba(46, 36, 23, 0.06); border: 1px solid rgba(46, 36, 23, 0.25);
      border-radius: 999px;
    }
    .notice-close:hover, .notice-close:focus-visible { border-color: var(--pm-accent); color: var(--pm-accent); }
    .notice-title { margin: 0 2em 0.8em 0; font-size: 1.4rem; color: var(--pm-ink); }
    .notice-body { font-size: 0.95rem; line-height: 1.65; color: var(--pm-ink); }
    .notice-body :global(> :first-child) { margin-top: 0; }
    .notice-body :global(h1:first-child) { display: none; }  /* the notice's title already says it */
    .notice-body :global(img) { max-width: 100%; border-radius: 8px; }
    .notice-body :global(a) { color: var(--pm-accent); }
    .notice-body :global(h1), .notice-body :global(h2), .notice-body :global(h3) { color: var(--pm-ink); }
    .notice-body :global(em) { color: var(--pm-accent); }
    .notice-body :global(code) { background: rgba(164, 99, 42, 0.14); padding: 1px 5px; border-radius: 5px; }
    .human-gated-stamp {
      border: 1px solid rgba(156, 63, 46, 0.4); border-radius: 6px;
      padding: 0.7em 0.9em; margin: 0 0 1.1em; font-size: 0.9rem; line-height: 1.55;
      background: rgba(156, 63, 46, 0.06);
    }
    .human-gated-stamp em { display: block; opacity: 0.75; font-size: 0.8rem; margin-top: 0.3em; }
  </style>
</PostmarkLayout>
