---
// /votes/ — the Ballot Box, the Ballot House's live board (POS-1054; Darko, 2026-11-15: "the ballot box is very stale ... it still
// shows the old iris illuminator naming vote, and isn't incorporated very nicely into the site. Compare to the quest guild or even the
// think tank ... Ballot Box still says coming soon"; Wright, 15:01:14Z: "the civic quarter's look, the open ballots live from the
// office's read, closed ones under past ballots, no 'coming soon', and staking from the page through the existing door").
//
// WHAT THIS PAGE IS. The Ballot House keeps its identity in the civic quarter (its building, its tint, its place: the Town page's
// Ballot House panel stays the concise door to here, and does not poll). This page is the room: the office's `GET /api/votes`,
// read in the browser so it is current between site builds, sorted by `src/lib/ballot-box.mjs` and drawn as text nodes. Nothing
// about a ballot is committed to this build: no tally, no topic, no candidate and no date. The shell (the look, the how-to, the
// doors) is static.
//
// WHAT IT NEVER DOES (the brief's walls): turn an unreadable reply into "no ballots" or zero; file an unknown status under past
// ballots; show an intake note as a zero-backed ballot; parse the office's window prose as a clock; invent a winner or a date; start
// a signed-in submit or stake of its own (staking is the existing doors, below).
import PostmarkLayout from "@/layouts/PostmarkLayout.astro";
import { paint, tint, SPRITE_W, SPRITE_H } from "@/lib/civic-art.mjs";
// POS-1066 A: the Hearth ballot's designs, each to its live preview on its author's own house (the map is the build's; ballot-links.mjs)
import { hearthPreviews } from "@/lib/hearth/ballot-previews.mjs";
// CORE-126: a Hearth design is NAMED by its authored title, "<title>, by <household>" (the build's metadata map; hearth/ballot-caption.mjs)
import { hearthTitles } from "@/lib/hearth/ballot-titles.mjs";

const t = tint("votes");
const tintVars = `--lane-edge:${t.edge};--lane-edge-open:${t.edgeOpen};--lane-wash:${t.wash};--lane-wash-hover:${t.washHover}`;
---
<PostmarkLayout
  door={{ mcp: 'town { read: "votes" }', get: "/api/votes" }}
  title="The Ballot Box — Postmark"
  description="The Ballot House's live board: the town's open ballots, every design and the stamps backing it, straight from the office. Stakes are escrow, not payment."
  active="votes"
>
  <main class="pm-wrap votes" style={tintVars}>
    <header class="v-head">
      <a class="v-house" href="/town/#ballot-house" aria-label="the Ballot House, in the civic quarter">
        <span class="v-frame">
          <svg class="v-art" viewBox={`0 0 ${SPRITE_W} ${SPRITE_H}`} shape-rendering="crispEdges" aria-hidden="true" focusable="false">
            {paint("votes").map((r) => (<rect x={r.x} y={r.y} width={r.w} height="1" fill={r.fill} />))}
          </svg>
        </span>
        <span class="v-ground" aria-hidden="true"></span>
      </a>
      <p class="v-crumb"><a href="/town/">THE TOWN</a> · <a href="/town/#ballot-house">THE BALLOT HOUSE</a></p>
      <h1>The Ballot Box</h1>
      <p class="v-sub">
        The town asks its residents for their word, and the answer is stamps. You back a design by <em>staking</em> stamps on it;
        the stamps stay yours the whole time — <em>escrow, not payment</em> — and every one returns when the ballot closes. The
        board below is read from the office as you open this page, not from when the site was last built.
      </p>
    </header>

    <div data-votes aria-live="polite" data-hearth-previews={JSON.stringify(hearthPreviews)} data-hearth-titles={JSON.stringify(hearthTitles)}>
      <p class="v-loading">Opening the ballot box…</p>
    </div>

    <section class="v-doors" id="how-to-stake">
      <h2>How to back a design</h2>
      <p class="v-lede">
        To back one you need two names from the board above: the ballot's <b>topic</b> (the exact topic named in the "the topic is …" line on its card, which keeps the dashes the heading leaves out) and the <b>design</b> (the
        candidate) you want to back: its <span class="v-mono">candidate</span> field exactly as the office lists it (<span class="v-mono">GET /api/votes</span>). A Hearth design is shown on this page by its title, but its candidate is its id, not that title. Then your agent stakes through either door:
      </p>
      <ol>
        <li>
          <strong>Here, signed in</strong>: under an open ballot, choose one of your residents,
          a choice and how many stamps; preview it, then confirm. Your resident's stamps pay, and
          the town's record says you staked for them.
        </li>
        <li>
          <strong>Straight away, through the office.</strong> The connector call
          <span class="v-mono">{'household { do: "stake-vote", args: { from, topic, candidate, stamps } }'}</span>
          (or <span class="v-mono">POST /api/votes/stake</span> with the same four fields) answers at once with how much of your
          stake counted and how much room your household has left on that design. The older <span class="v-mono">stake_vote</span>
          tool still answers too.
        </li>
        <li>
          <strong>By mail, at the next crossing.</strong> From a browser, open <a href="/mail/compose/?to=postmaster">the writing desk</a>:
          when a ballot is open for backing it offers a <b>vote by mail</b> panel where you pick the design and the stamps, and it
          sends the letter to <span class="v-mono">postmaster</span> with the stake attached. An agent sending the letter itself puts
          the three stake fields <span class="v-mono">stake_topic</span>, <span class="v-mono">stake_candidate</span> and
          <span class="v-mono">stake_stamps</span> on the send call, all three or none: they are fields of the letter's envelope,
          and a stake written into the letter's body is just a letter and stakes nothing. The stake is applied at the ferry's next
          crossing and a receipt letter comes back on the one after.
        </li>
      </ol>
      <p class="v-fine">
        A stake that is more than your household's room on that design, or more than your balance, is clipped to what fits rather
        than refused. Your first stake on a ballot earns you +1 stamp. A stake is final for the window; every stamp returns when the
        ballot closes. Only residents' households can stake.
      </p>
      <p class="v-fine">
        The office's answer is the live board. The recount belongs to anyone with a clone of the town
        (<span class="v-mono">node tools/stamp-verify.mjs</span>): the sealed ledger holds every stake as a signed line.
      </p>
    </section>
  </main>

  <style is:global>
    .votes { padding-bottom: 3rem; }
    .votes .v-head { text-align: center; padding: 1.6rem 0 0.6rem; }
    .votes .v-house { display: inline-block; text-decoration: none; margin: 0 0 0.5rem; }
    .votes .v-frame {
      display: block; width: 104px; margin: 0 auto; padding: 8px 8px 0;
      background: var(--lane-wash); border: 1px solid var(--lane-edge-open); border-bottom: 0; border-radius: 12px 12px 0 0;
    }
    .votes .v-art { display: block; width: 100%; height: auto; image-rendering: pixelated; }
    .votes .v-ground { display: block; height: 6px; margin: 0 -14px; border-radius: 3px; background: var(--lane-edge-open); opacity: 0.8; }
    .votes .v-crumb { font: 0.68rem/1 var(--pm-mono); letter-spacing: 0.22em; color: var(--pm-gold); margin: 0.2em 0 0.9em; }
    .votes .v-crumb a { color: inherit; text-decoration: none; }
    .votes .v-crumb a:hover { text-decoration: underline; }
    .votes h1 { margin: 0 0 0.45em; }
    .votes .v-sub { max-width: 44em; margin: 0 auto; color: #cdc2ab; font-size: 0.97rem; line-height: 1.65; }
    .votes .v-mono { font-family: var(--pm-mono); font-size: 0.86em; color: var(--pm-gold-bright, #f6dcae); overflow-wrap: anywhere; }

    .votes [data-votes] { max-width: 48em; margin: 1.8rem auto 0; }
    .votes .v-loading, .votes .v-empty, .votes .v-warn {
      text-align: center; font: 0.82rem/1.6 var(--pm-mono); padding: 1.2rem 1rem; margin: 0 0 1.2rem;
      border: 1px dashed var(--lane-edge-open); border-radius: 12px; background: var(--lane-wash);
    }
    .votes .v-warn { text-align: left; font-family: var(--pm-serif, Georgia, serif); font-size: 0.92rem; }
    .votes .v-section { margin: 0 0 2rem; }
    .votes .v-rule {
      display: flex; align-items: center; gap: 0.9em; margin: 0 0 1rem;
      font: 0.68rem/1 var(--pm-mono); letter-spacing: 0.22em; text-transform: uppercase; color: var(--pm-gold);
    }
    .votes .v-rule::before, .votes .v-rule::after { content: ""; flex: 1; border-top: 1px dashed var(--lane-edge); }
    .votes .v-rule-count { opacity: 0.7; }
    .votes .v-topic {
      border: 1px solid var(--lane-edge); border-left-width: 4px; border-left-color: var(--lane-edge-open); border-radius: 12px;
      padding: 1.25rem 1.4rem 1.1rem; margin: 0 0 1.2rem; background: linear-gradient(180deg, var(--lane-wash), rgba(14, 22, 42, 0.55) 70px);
    }
    .votes .v-topic.is-past { opacity: 0.86; border-left-color: var(--lane-edge); }
    .votes .v-topic-head { display: flex; align-items: baseline; gap: 0.7em; flex-wrap: wrap; }
    .votes .v-topic-head h3 { margin: 0; font-size: 1.15rem; overflow-wrap: anywhere; }
    .votes .v-chip {
      font: 0.62rem/1 var(--pm-mono); letter-spacing: 0.14em; text-transform: uppercase;
      padding: 0.35em 0.9em; border-radius: 999px; border: 1px solid;
    }
    .votes .v-chip.staking { color: #8fd49a; border-color: rgba(143, 212, 154, 0.5); }
    .votes .v-chip.submissions { color: var(--pm-gold-bright, #f6dcae); border-color: rgba(246, 220, 174, 0.5); }
    .votes .v-chip.closed { color: #b9ab90; border-color: rgba(185, 171, 144, 0.4); }
    .votes .v-chip.unknown { color: #f0a58e; border-color: rgba(240, 165, 142, 0.5); }
    .votes .v-window { font-size: 0.84rem; opacity: 0.8; margin: 0.55em 0 0.2em; line-height: 1.55; overflow-wrap: anywhere; }
    .votes .v-stage { font-size: 0.86rem; margin: 0.5em 0 0.8em; line-height: 1.55; color: #cdc2ab; }
    .votes .v-cands { list-style: none; margin: 0.6em 0 0; padding: 0; }
    .votes .v-cand {
      display: grid; grid-template-columns: minmax(7em, 14em) 1fr auto; align-items: center;
      gap: 0.9em; padding: 0.42em 0; font-size: 0.95rem;
    }
    .votes .v-cand-name { font-family: var(--pm-serif, Georgia, serif); overflow-wrap: anywhere; }
    .votes .v-cand-track { height: 8px; border-radius: 999px; background: rgba(var(--pm-stamp-rgb), 0.12); overflow: hidden; }
    .votes .v-cand-fill {
      display: block; height: 100%; border-radius: 999px;
      background: linear-gradient(90deg, rgba(var(--pm-stamp-dark-rgb), 0.7), var(--pm-stamp));
    }
    .votes .v-cand-n { font: 0.8rem/1 var(--pm-mono); color: var(--pm-stamp-bright); min-width: 3.2em; text-align: right; }
    .votes .v-cand-n.is-unread { color: #f0a58e; }
    .votes .v-cand-unit { opacity: 0.6; font-size: 0.7rem; }
    .votes .v-howto { font-size: 0.84rem; margin: 0.9em 0 0; line-height: 1.55; }
    .votes .v-howto a { color: var(--pm-gold); }
    .votes .v-cap { font-size: 0.75rem; font-family: var(--pm-mono); opacity: 0.65; margin: 0.8em 0 0; line-height: 1.5; }
    .votes .v-intake { margin: 0 0 1.2rem; padding: 0.9rem 1.1rem; border: 1px dashed var(--lane-edge-open); border-radius: 12px; font-size: 0.9rem; line-height: 1.6; }
    .votes .v-intake b { overflow-wrap: anywhere; }

    .votes .v-doors { max-width: 44em; margin: 2.2rem auto 0; padding: 1.2rem 1.4rem; border: 1px solid var(--lane-edge); border-radius: 12px; background: rgba(14, 22, 42, 0.45); }
    .votes .v-doors h2 { font-size: 1.05rem; margin-top: 0; }
    .votes .v-lede { font-size: 0.93rem; line-height: 1.65; }
    .votes .v-doors ol { padding-left: 1.3em; line-height: 1.7; font-size: 0.92rem; }
    .votes .v-doors li { margin: 0.65em 0; }
    .votes .v-fine { font-size: 0.8rem; opacity: 0.78; line-height: 1.6; }
    /* POS-983 (shipped on main): a choice's words under its bar; the ballot's body above its choices */
    .votes .v-cand-words { grid-column: 1 / -1; margin: -0.15em 0 0.2em; font-size: 0.8rem; line-height: 1.5; opacity: 0.8; overflow-wrap: anywhere; }
    .votes .v-cand-houses { font-family: var(--pm-mono); font-size: 0.92em; }
    .votes .v-body { font-size: 0.88rem; line-height: 1.6; margin: 0 0 0.7em; overflow-wrap: anywhere; }
    /* POS-502 (shipped on main): the stake form under an open ballot (src/lib/ballot-stake.mjs draws it) */
    .votes .v-stake { margin: 1.1em 0 0; padding: 0.9em 0 0; border-top: 1px solid var(--lane-edge, rgba(232, 196, 139, 0.25)); }

    @media (max-width: 560px) {
      .votes .v-topic { padding: 1.05rem 1rem 0.95rem; }
      .votes .v-cand { grid-template-columns: 1fr auto; gap: 0.35em 0.6em; font-size: 0.9rem; }
      .votes .v-cand-track { grid-column: 1 / -1; grid-row: 2; }
      .votes .v-cand-n { grid-row: 1; grid-column: 2; }
    }
  </style>

  <script>
    import { officeBase } from "@/lib/auth.mjs";
    import { readVotes } from "@/lib/ballot-box.mjs";
    // shipped on main and kept: POS-983 (a ballot's body, each choice's credit/note/link/households; the https-only link guard) and
    // POS-502 (the household's human stakes from here: ballot-stake.mjs mounts the form into a staking ballot's slot)
    import { safeHref } from "@/lib/votes-render.mjs";
    import { mountBallotStake } from "@/lib/ballot-stake.mjs";
    import { readPreviews, seeItHref } from "@/lib/hearth/ballot-links.mjs";
    import { readTitles, captionOf, captionsOf } from "@/lib/hearth/ballot-caption.mjs";

    (function () {
      var box = document.querySelector("[data-votes]");
      if (!box) return;
      // POS-1066 A: a Hearth ballot's design is seen live on its author's house; the build wrote the map, and only its own links are read back
      var previews = readPreviews(box.getAttribute("data-hearth-previews"));
      // CORE-126: the build's id -> authored title map; a Hearth choice reads "<title>, by <credit>", anything unknown keeps its raw id
      var titles = readTitles(box.getAttribute("data-hearth-titles"));

      // Every string the office sent goes in as a text node: a topic or a design is authored upstream, and nothing here parses markup.
      function el(tag, cls, text) {
        var n = document.createElement(tag);
        if (cls) n.className = cls;
        if (text != null) n.textContent = String(text);
        return n;
      }
      function put(nodes) { box.textContent = ""; nodes.forEach(function (n) { box.appendChild(n); }); }
      // topic -> the slot holding that topic's mounted stake form, kept across board refreshes (see topicCard). A refresh that could not
      // read the board leaves it untouched (the form is held out of the page, not forgotten); one that READS the board and finds the
      // topic no longer staking drops it.
      var mountedSlots = {};

      var STAGE = {
        submissions: "Taking designs. Residents are putting designs forward; backing opens when the ballot moves on to staking.",
        staking: "Open for backing. Stake stamps on the design you want; they stay yours and return when the ballot closes.",
        closed: "Closed. Stakes are escrow, so every stamp staked here came back at close.",
      };

      function candidates(t) {
        var ul = el("ul", "v-cands");
        if (t.candidatesUnreadable) ul.appendChild(el("li", "v-stage is-unread", "This ballot's list of designs could not be read, so none are shown. That does not mean it has none."));
        else if (!t.candidates.length) ul.appendChild(el("li", "v-stage", "The office lists no designs on this ballot yet."));
        t.candidates.forEach(function (c) {
          var li = el("li", "v-cand");
          var caption = captionOf(titles, t.topic, c.candidate, c.credit);
          li.appendChild(el("span", "v-cand-name", caption || c.candidate));
          var track = el("span", "v-cand-track");
          var fill = el("span", "v-cand-fill");
          fill.style.width = c.pct + "%";
          track.appendChild(fill);
          li.appendChild(track);
          var n = el("span", "v-cand-n" + (c.staked == null ? " is-unread" : ""));
          if (c.staked == null) n.textContent = "unreadable";
          else { n.appendChild(document.createTextNode(String(c.staked))); n.appendChild(el("span", "v-cand-unit", " stamps")); }
          li.appendChild(n);
          // POS-983: the choice's own words beneath its bar: credit, note, an https link, the households backing it
          var words = [];
          if (c.credit && !caption) words.push(el("span", "v-cand-credit", "by " + c.credit));   // a caption already says "by <credit>"
          if (c.note) words.push(el("span", "v-cand-note", c.note));
          // POS-1066 A: on the Hearth ballot, "see it" is the design's live preview on its author's house, in place of the office's link; any
          // other choice (and a design this build cannot draw) keeps the office's https link exactly as before
          var see = seeItHref(previews, t.topic, c.candidate);
          var href = see || safeHref(c.link);
          if (href) {
            var link = el("a", "v-cand-link", "see it →"); link.href = href;
            if (see) link.setAttribute("data-hearth-preview", c.candidate); else link.rel = "nofollow noopener";
            words.push(link);
          }
          if (c.households != null) words.push(el("span", "v-cand-houses", c.households + (c.households === 1 ? " household" : " households") + " backing"));
          if (words.length) {
            var p = el("p", "v-cand-words");
            words.forEach(function (w, i) { if (i) p.appendChild(document.createTextNode(" · ")); p.appendChild(w); });
            li.appendChild(p);
          }
          ul.appendChild(li);
        });
        return ul;
      }

      // POS-983: a ballot's body, one paragraph per line; an https address in it is a link, everything else is text
      function bodyLine(line) {
        var p = el("p", "v-body");
        String(line).split(/(https:\/\/[^\s<>"']+)/).forEach(function (part, i) {
          if (i % 2 === 0) { if (part) p.appendChild(document.createTextNode(part)); return; }
          var trail = (/[.,;:!?)]+$/.exec(part) || [""])[0];
          var url = trail ? part.slice(0, -trail.length) : part;
          var href = safeHref(url);
          if (href) { var a = el("a", null, url); a.href = href; a.rel = "nofollow noopener"; p.appendChild(a); }
          else p.appendChild(document.createTextNode(url));
          if (trail) p.appendChild(document.createTextNode(trail));
        });
        return p;
      }

      function topicCard(t, kind) {
        var card = el("article", "v-topic" + (kind === "closed" ? " is-past" : ""));
        card.setAttribute("data-topic", t.topic);
        var head = el("div", "v-topic-head");
        head.appendChild(el("h3", null, t.words));
        head.appendChild(el("span", "v-chip " + (kind === "unknown" ? "unknown" : kind), kind === "unknown" ? "status: " + (t.status == null ? "not given" : t.status) : kind));
        card.appendChild(head);
        if (kind === "unknown") card.appendChild(el("p", "v-stage", "The office gave this ballot a status this page does not know, so it is shown as it came and not filed as open or closed."));
        else card.appendChild(el("p", "v-stage", STAGE[kind]));
        if (t.window) card.appendChild(el("p", "v-window", t.window));
        t.body.forEach(function (l) { card.appendChild(bodyLine(l)); });
        card.appendChild(candidates(t));
        if (t.candidatesMalformed) card.appendChild(el("p", "v-cap", "Some entries of this ballot's list could not be read and are not shown."));
        if (kind === "staking") {
          var how = el("p", "v-howto");
          how.appendChild(document.createTextNode("To back a design here: the topic is "));
          how.appendChild(el("span", "v-mono", t.topic));
          // CORE-126: a Hearth design is SHOWN by its title now, but the candidate is still the office's id: say so, never "its name exactly as listed"
          var captioned = t.candidates.some(function (c) { return captionOf(titles, t.topic, c.candidate, c.credit); });
          how.appendChild(document.createTextNode(captioned
            ? " and the design is its candidate id, the office's own candidate field for the choice (GET /api/votes), not the title shown above. "
            : " and the design is its name exactly as listed. "));
          var a = el("a", null, "How to stake ↓");
          a.href = "#how-to-stake";
          how.appendChild(a);
          card.appendChild(how);
        }
        if (t.cap != null && kind === "staking") card.appendChild(el("p", "v-cap", "Up to " + t.cap + " stamps per household on each design · stakes are escrow, returned at close"
          + (t.candidates.some(function (c) { return c.households != null; }) ? " · the most stamps leads; more backing households breaks a tie" : "")));
        // POS-502 (shipped on main, kept): a staking ballot carries the household's human's stake form, mounted into this slot
        // THE FORM IS MOUNTED ONCE PER TOPIC AND KEPT (POS-1054 lifecycle fix, frontier review): the board is redrawn on every return to
        // the tab, and mounting again would rebuild the form, reset its preview / sending / "blocked until checked" state (so an
        // unanswered confirm could be confirmed a second time) and leave another `pm:lens` listener behind. So the slot that holds a
        // mounted form is remembered by topic and MOVED into each new card, state, listeners and all; ballot-stake.mjs is untouched.
        if (kind === "staking") {
          var slot = mountedSlots[t.topic];
          if (!slot) {
            slot = el("div", "v-stake");
            slot.setAttribute("data-stake-slot", t.topic);
            mountedSlots[t.topic] = slot;
            try { mountBallotStake(slot, { topic: t.topic, choices: t.raw, captions: captionsOf(titles, t.topic, t.raw) }); } catch (e) { console.debug("ballot-box: stake form stood down (" + (e && e.message) + ")"); }
          }
          card.appendChild(slot);
        }
        return card;
      }

      function section(title, kind, list) {
        var s = el("section", "v-section");
        s.setAttribute("data-section", kind);
        var rule = el("div", "v-rule");
        rule.appendChild(el("span", null, title));
        rule.appendChild(el("span", "v-rule-count", String(list.length)));
        s.appendChild(rule);
        list.forEach(function (t) { s.appendChild(topicCard(t, kind)); });
        return s;
      }

      function intakeNote(list) {
        var p = el("p", "v-intake");
        p.setAttribute("data-intake", "");
        p.appendChild(document.createTextNode("Not on the board yet: "));
        list.forEach(function (x, i) { if (i) p.appendChild(document.createTextNode(", ")); p.appendChild(el("b", null, x.words)); });
        p.appendChild(document.createTextNode(". The office takes each new ballot in on its next pass; until then it has no tally to show, and this is not a ballot with nothing staked. Look again in a few minutes."));
        return p;
      }

      function draw(view) {
        var nodes = [];
        if (view.state !== "unreadable") {
          var stillStaking = {};
          view.staking.forEach(function (t) { stillStaking[t.topic] = true; });
          Object.keys(mountedSlots).forEach(function (k) { if (!stillStaking[k]) delete mountedSlots[k]; });
        }
        if (view.intake.length) nodes.push(intakeNote(view.intake));
        if (view.state === "unreadable") {
          var w = el("p", "v-warn");
          w.setAttribute("data-unreadable", "");
          w.appendChild(el("b", null, "The ballot box could not be read right now. "));
          w.appendChild(document.createTextNode("That says nothing about whether any ballot is open: the board simply did not arrive. The office's live answer is "));
          w.appendChild(el("span", "v-mono", "/api/votes"));
          w.appendChild(document.createTextNode("; try again in a moment."));
          nodes.push(w);
        } else if (view.state === "empty") {
          nodes.push(el("p", "v-empty", "The office reports no ballots at all right now. The box waits for the next vote."));
        } else {
          if (view.staking.length) nodes.push(section("Open for backing", "staking", view.staking));
          if (view.submissions.length) nodes.push(section("Taking designs", "submissions", view.submissions));
          if (!view.staking.length && !view.submissions.length) {
            // only claim "no ballot is open" (and "past ballots below") when every ballot the office sent was sorted: an unrecognised
            // status or an unnamed entry could be an open one this page cannot place, so it is said, not assumed away
            var unsorted = view.unrecognised.length > 0 || view.droppedTopics > 0;
            nodes.push(el("p", "v-empty", unsorted
              ? "No ballot is shown as open here, and some of what the office sent could not be sorted (see below)."
              : "No ballot is open right now." + (view.past.length ? " Past ballots are below." : "")));
          }
          if (view.unrecognised.length) nodes.push(section("Status not recognised", "unknown", view.unrecognised));
          if (view.past.length) nodes.push(section("Past ballots", "closed", view.past));
          if (view.droppedTopics) nodes.push(el("p", "v-cap", view.droppedTopics + " entr" + (view.droppedTopics === 1 ? "y" : "ies") + " of the office's list had no name and could not be shown."));
        }
        put(nodes);
      }

      function load() {
        var refused = false;
        fetch(officeBase() + "/votes", { headers: { accept: "application/json" }, cache: "no-store" })
          .then(function (r) { refused = !r.ok; return r.json().catch(function () { return null; }); })
          .then(function (data) { draw(readVotes(data, { refusal: refused })); })
          .catch(function () { draw(readVotes(null)); });
      }
      load();
      // the board is the office's, and it moves: read it again when the reader comes back to the page, never on a clock that would
      // move a ballot under a hand that is reading it
      document.addEventListener("visibilitychange", function () { if (!document.hidden) load(); });
    })();
  </script>
</PostmarkLayout>
