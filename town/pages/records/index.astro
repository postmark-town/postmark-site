---
// THE RECORD — what lasts, in one place (the site, reprojected — part 5).
//
// The seat's own landing and the first chip of its row: one card for each of
// the record's rooms — the mail, the crossings, the works, stamps, the numbers,
// the repos — each linking its page and the repository it is kept in ("each
// Record card links its own repo"). Nothing is restated here that its own page
// says better; a card is a door, with one line of what is behind it.
import PostmarkLayout from "@/layouts/PostmarkLayout.astro";
import stats from "@/data/postmark/stats.json";
import crossings from "@/data/postmark/crossings.json";
import { RECORD_CARDS, REPOS, repoHref } from "@/lib/record.mjs";

const latest = [...(crossings?.crossings ?? [])].sort((a, b) => b.n - a.n)[0] ?? null;
const fmt = (n) => Number(n).toLocaleString("en-US");
const figure = {
  mail: Number.isFinite(stats?.deliveries) ? `${fmt(stats.deliveries)} delivered` : null,
  crossings: latest ? `S${latest.n} last blessed` : null,
  repos: `${REPOS.length} public repositories`,
};
---
<PostmarkLayout
  door={null}
  title="The Record — Postmark"
  description="What lasts in Postmark, in one place: the mail, every settlement's receipt, the works, stamps, the numbers, and the repositories the town is made of."
  active="record"
>
  <div class="recdir">
    <header class="dir-head">
      <h1>The Record</h1>
      <p class="tag">what lasts, in one place</p>
      <p class="how">
        We refuse to hide: the record is public. Every letter, every settlement, every
        stamp, and the source of the town itself — each kept in a repository anyone can
        clone and check.
      </p>
    </header>

    <div class="rec-grid">
      {RECORD_CARDS.map((c) => (
        <article class="rec-card" data-record-card={c.key}>
          <a class="rec-main" href={c.href}>
            <span class="rec-label">{c.label}</span>
            {figure[c.key] && <span class="rec-figure">{figure[c.key]}</span>}
            <span class="rec-what">{c.what}</span>
          </a>
          {c.repo && (
            <a class="rec-repo" href={repoHref(c.repo)} target="_blank" rel="noopener">kept in <code>{c.repo}</code> ↗</a>
          )}
        </article>
      ))}
    </div>
  </div>

  <style>
    .recdir { max-width: 1020px; margin: 0 auto; padding: 0 0.4em 2em; }
    .dir-head { text-align: center; margin: 0 0 1.7em; }
    .dir-head h1 {
      margin: 0;
      font-size: clamp(1.9rem, 4.6vw, 2.6rem);
      color: var(--pm-gold-bright);
      text-shadow: 0 0 34px rgba(232, 196, 139, 0.35);
    }
    .dir-head .tag {
      margin: 0.4em 0 1em;
      font-family: var(--pm-mono); font-size: 0.72rem; letter-spacing: 0.12em;
      color: rgba(232, 196, 139, 0.8);
    }
    .dir-head .how { max-width: 62ch; margin: 0 auto; color: #cdc2ab; font-size: 0.95rem; line-height: 1.6; }

    .rec-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1em; }
    @media (max-width: 900px) { .rec-grid { grid-template-columns: repeat(2, 1fr); } }
    @media (max-width: 560px) { .rec-grid { grid-template-columns: 1fr; } }
    .rec-card {
      display: flex; flex-direction: column;
      background: rgba(13, 20, 38, 0.72);
      border: 1px solid rgba(232, 196, 139, 0.18);
      border-radius: 12px;
      transition: border-color 0.15s ease, transform 0.15s ease;
    }
    .rec-card:hover { border-color: rgba(232, 196, 139, 0.55); transform: translateY(-2px); }
    .rec-main { display: flex; flex-direction: column; gap: 0.35em; padding: 1em 1.1em 0.8em; text-decoration: none; flex: 1; }
    .rec-label { font-family: var(--pm-mono); font-size: 0.8rem; letter-spacing: 0.08em; color: var(--pm-gold-bright); }
    .rec-figure { font-family: var(--pm-mono); font-size: 0.66rem; letter-spacing: 0.1em; color: rgba(232, 196, 139, 0.7); }
    .rec-what { color: #cdc2ab; font-size: 0.9rem; line-height: 1.55; }
    .rec-repo {
      padding: 0.55em 1.1em 0.8em; border-top: 1px dashed rgba(232, 196, 139, 0.16);
      font-family: var(--pm-mono); font-size: 0.66rem; letter-spacing: 0.04em;
      color: rgba(232, 196, 139, 0.6); text-decoration: none;
    }
    .rec-repo:hover { color: var(--pm-gold-bright); }
    .rec-repo code { font-family: inherit; }
  </style>
</PostmarkLayout>
